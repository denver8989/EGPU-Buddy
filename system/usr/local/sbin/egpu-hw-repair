#!/usr/bin/env bash
# SteamOS EGPU Buddy — hardware check and repair after an update. Runs as root from install.sh, which is what every
# update (plugin "Update", the boot self-heal of a staged update) ends with, so a machine that a first setup got wrong
# is put right without the user doing anything.
#
# Why it exists: until 0.7.110 the Game Mode session and the attach helper assumed the Legion Go 2's built-in GPU
# address (0000:c2:00.0), and Safe Detach assumed the eGPU was card0. On other handhelds (first reported on a ROG Xbox
# Ally X with an XG Mobile 2025) that left the handheld screen unusable, Safe Detach failing (rc 6), and with it the
# beta driver trial. The scripts are fixed; this removes what the broken runs left behind.
#
#   egpu-hw-repair            check, repair, record /var/lib/nvegpu/hardware, leave a notice for the plugin
#   egpu-hw-repair --dry-run  print what would be done
#   egpu-hw-repair --xorg     only the X11 desktop guard and the Gen3 driver option (steps 4-5); egpu-hotplug-mount runs
#                             it when an XG Mobile attaches, before the driver loads
set -u
DRY=0; [ "${1:-}" = --dry-run ] && DRY=1; ONLY_XORG=0; [ "${1:-}" = --xorg ] && ONLY_XORG=1
[ "$(id -u)" = 0 ] || [ $DRY = 1 ] || { echo "run as root"; exit 1; }
LOG=/var/log/egpu-hw-repair.log; HW=/var/lib/nvegpu/hardware; TRIAL=/var/lib/nvegpu/driver-trial
U=$(getent passwd 1000 | cut -d: -f1); UH=$(getent passwd 1000 | cut -d: -f6); UH=${UH:-/home/deck}
log(){ printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG" 2>/dev/null; echo "$*"; }
do_(){ if [ $DRY = 1 ]; then echo "would: $*"; else "$@"; fi; }
fixed=()

DET=/usr/local/sbin/egpu-detect
profile=$($DET --device 2>/dev/null || echo generic)
dock=$($DET --dock 2>/dev/null || echo none)
igpu=$($DET --igpu 2>/dev/null || true)
product=$(cat /sys/class/dmi/id/product_name 2>/dev/null)
model="$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) $product"
chip=$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo 2>/dev/null | head -1)   # e.g. Z1 Extreme vs Z2 Extreme
# XG Mobile: detected on its own, not as part of the Ally profile (a Legion Go can be docked to one). Attached now, or seen
# at an earlier attach (egpu-hotplug-mount records it): updates usually run with nothing attached.
xgm=$(case "$dock" in xg-mobile-*) echo "$dock" ;; *) cat /var/lib/nvegpu/xg-mobile-seen 2>/dev/null ;; esac)
if [ $ONLY_XORG = 0 ]; then
log "hardware: $model | $chip | profile $profile | dock $dock | XG Mobile ${xgm:-never seen} | built-in GPU ${igpu:-?}"
[ $DRY = 1 ] || { mkdir -p "$(dirname "$HW")"; printf 'model=%s\nchip=%s\nprofile=%s\ndock=%s\nxg_mobile=%s\nigpu=%s\nchecked=%s\n' "$model" "$chip" "$profile" "$dock" "${xgm:-no}" "$igpu" "$(date +%s)" > "$HW"; }

# 1. Game Mode environment written by an attach that used the Legion Go 2's iGPU address on another machine. It is
#    rewritten at the next attach; left in place it pins KWIN_DRM_DEVICES to a GPU that does not exist here.
envf="$UH/.config/environment.d/10-egpu-gamescope-output.conf"
if [ -n "$igpu" ] && [ "$igpu" != 0000:c2:00.0 ] && grep -q '0000:c2:00\.0' "$envf" 2>/dev/null; then
  do_ rm -f "$envf"; log "removed $envf (it named the Legion Go 2's built-in GPU; this machine's is $igpu)"
  fixed+=("Game Mode screen settings from the first setup")
fi

# 2. A beta driver trial that stopped at Safe Detach changed nothing (the trial says so itself). Clear the failure so
#    the plugin offers the trial again instead of showing the old error, now that Safe Detach can work here.
if [ "$(sed -n 's/^state=//p' "$TRIAL" 2>/dev/null | tail -1)" = failed ] &&
   sed -n 's/^message=//p' "$TRIAL" 2>/dev/null | grep -q '^Nothing was changed: Safe Detach did not finish'; then
  do_ mv -f "$TRIAL" "$TRIAL.failed-$(date +%Y%m%d-%H%M%S)"; log "cleared the failed beta driver trial (Safe Detach could not finish on this machine before)"
  fixed+=("the failed beta driver attempt (you can try it again)")
fi

# 2b. ROG Ally or XG Mobile: the NVIDIA Game Mode fix (GBM-scanout gamescope) switched off by the session shim's crash
#     guard. Before 0.7.111 the guard could not tell a GPU hang from the build crashing; on these machines the eGPU hung
#     (link retrains), so the build was marked as crashing and Game Mode ran Valve's gamescope from then on: the
#     corrupted picture the fix exists to prevent. The mark matches the binary's timestamp and size, which an update keeps,
#     so it never cleared. Clear it (and the once-per-OS-build rebuild record) so the fix is used again; the guard now
#     asks the GPU before marking. A Legion Go with the AORUS box keeps its mark handling unchanged.
GSBAD="$UH/.local/state/nv-egpu-buddy/gamescope-bad"
if { [ "$profile" = rog-ally ] || [ -n "$xgm" ]; } && [ -s "$GSBAD" ]; then
  do_ rm -f "$GSBAD" /var/lib/nvegpu/gamescope-rebuilt-for
  log "cleared the 'GBM-scanout gamescope is crashing' mark ($(cat "$GSBAD" 2>/dev/null)): the NVIDIA Game Mode fix is used again"
  fixed+=("the NVIDIA Game Mode picture fix, which GPU crashes had switched off")
fi

# 3. A proprietary-connector XG Mobile left switched on by an interrupted run while nothing is attached: the embedded
#    controller keeps the value across reboots. Switch it off only when no NVIDIA GPU is on the bus.
if [ "$dock" = xg-mobile-legacy ] && ! lspci -Dn 2>/dev/null | grep -qE ' 0300: 10de:'; then
  sw=$($DET --xgm-power off 2>/dev/null; echo $?)
  [ "$sw" = 0 ] && log "XG Mobile switch: off (nothing attached)"
fi
fi   # ONLY_XORG

# 4. ROG Ally or XG Mobile (each detected on its own): the X11 desktop must stay on the built-in GPU. Its Radeon is a "display controller" (class 0x0380), not a
#    VGA device, so Xorg takes the NVIDIA eGPU as the primary GPU, fails on it ("Cannot run in framebuffer mode") and the
#    eGPU hung in that same instant (NVRM TLB invalidation / FSP timeouts, then off the bus: Ally X report, switching to
#    Desktop with the eGPU attached; that eGPU was an XG Mobile's laptop GPU, so a Legion Go docked to one gets this too).
#    Name the built-in GPU explicitly and do not add other GPUs. Only the X11 desktop reads this; Game Mode and the
#    Wayland desktop do not. Not written on any other machine (a Legion Go with the AORUS box keeps the X11 defaults).
XORG=/etc/X11/xorg.conf.d/10-egpu-buddy-builtin-gpu.conf
if { [ "$profile" = rog-ally ] || [ -n "$xgm" ]; } && [ -n "$igpu" ]; then
  IFS=':.' read -r _dom _bus _dev _fn <<<"$igpu"
  busid="PCI:$((16#$_bus))@$((16#$_dom)):$((16#$_dev)):$((16#$_fn))"
  want=$(printf '%s\n' "# EGPU Buddy (egpu-hw-repair, ROG Ally / XG Mobile): the X11 desktop uses the built-in GPU, never the eGPU" \
    'Section "ServerFlags"' '    Option "AutoAddGPU" "false"' 'EndSection' \
    'Section "Device"' '    Identifier "EGPU Buddy built-in GPU"' '    Driver "amdgpu"' "    BusID \"$busid\"" 'EndSection' \
    'Section "Screen"' '    Identifier "EGPU Buddy screen"' '    Device "EGPU Buddy built-in GPU"' '    Option "NoOutputInitialSize" "1920 1080"' 'EndSection' \
    'Section "ServerLayout"' '    Identifier "EGPU Buddy layout"' '    Screen "EGPU Buddy screen"' 'EndSection')
  if [ "$(cat "$XORG" 2>/dev/null)" != "$want" ]; then
    if [ $DRY = 1 ]; then echo "would: write $XORG ($busid)"
    else mkdir -p "$(dirname "$XORG")" && printf '%s\n' "$want" > "$XORG" && log "wrote $XORG: X11 desktop on the built-in GPU ($busid)"; fi
  fi
elif [ -f "$XORG" ]; then
  do_ rm -f "$XORG"; log "removed $XORG (neither a ROG Ally nor an XG Mobile)"
fi
# 5. ROG Ally or XG Mobile: let the NVIDIA driver keep the PCIe link at Gen3. Its RMPcieLinkSpeed policy allows Gen3 only
#    with NVreg_EnablePCIeGen3=1; on a platform it does not recognise it pulls a Gen3 link down to Gen2 about 10 s after
#    init and as the GPU leaves P0, and that retrain is what dropped XG Mobile links off the bus (Xid 79, "GPU has fallen
#    off the bus"). Found from the driver source by the xgm-egpu project (CREDITS.md). The Ally X / XG Mobile 2025 link is
#    Gen3 x4 and its laptop GPU changes power state constantly. Read at the next driver load (every Attach reloads it).
#    A Legion Go with the AORUS box keeps the driver options it was tested with.
GEN3=/etc/modprobe.d/zz-nvidia-egpu-pcie-gen3.conf
if [ "$profile" = rog-ally ] || [ -n "$xgm" ]; then
  want3=$(printf '%s\n' "# EGPU Buddy (egpu-hw-repair, ROG Ally / XG Mobile): the driver must not retrain the link down from Gen3" \
    "options nvidia NVreg_EnablePCIeGen3=1")
  if [ "$(cat "$GEN3" 2>/dev/null)" != "$want3" ]; then
    if [ $DRY = 1 ]; then echo "would: write $GEN3"
    else printf '%s\n' "$want3" > "$GEN3" && log "wrote $GEN3: NVreg_EnablePCIeGen3=1 (active from the next Attach)"; fi
  fi
elif [ -f "$GEN3" ]; then
  do_ rm -f "$GEN3"; log "removed $GEN3 (neither a ROG Ally nor an XG Mobile)"
fi
# 6. ROG Ally or XG Mobile: nouveau must never take the eGPU. The NVIDIA driver image's own blacklist did not stop it during
#    a beta driver trial (ROG Xbox Ally X report: nouveau bound the RTX 5070 Ti at the attach rescan, "already bound to
#    nouveau", no driver, Game Mode crash-looping on a black screen). /etc is read whatever image is merged. A Legion Go
#    with the AORUS box keeps the driver set-up it was tested with.
NONV=/etc/modprobe.d/zz-egpu-xgm-no-nouveau.conf
if [ "$profile" = rog-ally ] || [ -n "$xgm" ]; then
  wantn=$(printf '%s\n' "# EGPU Buddy (egpu-hw-repair, ROG Ally / XG Mobile): the eGPU is driven by the NVIDIA driver, never nouveau" \
    "blacklist nouveau" "install nouveau /bin/false")
  if [ "$(cat "$NONV" 2>/dev/null)" != "$wantn" ]; then
    if [ $DRY = 1 ]; then echo "would: write $NONV"
    else printf '%s\n' "$wantn" > "$NONV" && log "wrote $NONV: nouveau blocked"; fi
  fi
elif [ -f "$NONV" ]; then
  do_ rm -f "$NONV"; log "removed $NONV (neither a ROG Ally nor an XG Mobile)"
fi
[ $ONLY_XORG = 1 ] && exit 0

if [ ${#fixed[@]} -gt 0 ] && [ $DRY = 0 ]; then
  name=$(echo $model); name=${name:-this machine}; [ "$profile" = rog-ally ] && name="your ${product%% RC7*}"; name=${name%% }; [ "$name" = "your" ] && name="your ROG Ally"; [ -n "$xgm" ] && name="$name with XG Mobile"
  mkdir -p /run/nvegpu
  printf 'Update fixed setup issues for %s: %s. Attach the eGPU again to use them.\n' "$name" "$(IFS=';'; echo "${fixed[*]}" | sed 's/;/, /g')" > /run/nvegpu/notice
  chown "$U": /run/nvegpu/notice 2>/dev/null || true
fi
exit 0
