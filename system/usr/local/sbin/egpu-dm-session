#!/usr/bin/env bash
# Pin (and unpin) the login manager's autologin session, on whatever login manager this system uses.
# Why: a Safe Detach / attach restarts the session, and the login manager then re-logs in with its OWN default. CachyOS uses
# plasmalogin (/etc/plasmalogin.conf.d), SteamOS uses sddm (/etc/sddm.conf.d) and its Game Mode session file is named
# differently (gamescope-wayland.desktop vs gamescope-session.desktop). Everything here is looked up, nothing is hardcoded:
# without this, a desktop Safe Detach on SteamOS comes back in Game Mode and the detach cannot finish.
#   egpu-dm-session pin plasma|plasmax11|gamescope|bigpicture   write our drop-in (sorts last, wins)
#   egpu-dm-session unpin                             remove it again (system default is back)
#   egpu-dm-session release-stale                     remove it if nothing needs it any more (see there)
#   egpu-dm-session show                              directory + session currently pinned
set -u
[ "$(id -u)" = 0 ] || { echo "run as root" >&2; exit 1; }
# Must sort AFTER every file the OS ships, because the last Session= wins. SteamOS ships
# /etc/sddm.conf.d/zz-steamos-autologin.conf, and "zz-egpu..." sorts BEFORE "zz-steamos...", so the
# old name was silently outranked and the pin did nothing on SteamOS.
DROP=zzz-egpu-buddy-session.conf
# Bazzite (sddm + steamos-manager): the system's default is zz-holo-autologin.conf and a one-off "Switch to Game Mode /
# Desktop" is zzt-holo-temp-login.conf (deleted again at the next login). Our pin must sort between the two: after the
# default (so a relogin after a cable pull or Safe Detach follows it), before the one-off switch (so the user's explicit
# switch still wins). Every other system keeps the name above.
BZ=0; (. /etc/os-release 2>/dev/null; case "${ID:-} ${NAME:-}" in *[Bb]azzite*) exit 0 ;; esac; exit 1) && BZ=1
[ $BZ = 1 ] && DROP=zzs-egpu-buddy-session.conf
# ROG Ally / XG Mobile under SteamOS's sddm: the same order as Bazzite's. SteamOS's default is zz-steamos-autologin.conf and
# "Return to Gaming Mode" is the one-off zzt-steamos-temp-login.conf; "zzz-" outranked that one-off too, so with the eGPU
# attached on the desktop every Return to Gaming Mode logged straight back into the desktop until a forced shutdown
# (ROG Xbox Ally X + XG Mobile report on 0.7.181). "zzs-" sorts after the default and before the one-off switch.
AX=0; { [ "$(/usr/local/sbin/egpu-detect --device 2>/dev/null)" = rog-ally ] || [ -e /var/lib/nvegpu/xg-mobile-seen ]; } && AX=1
[ $AX = 1 ] && [ $BZ = 0 ] && [ "$(systemctl show -p Id --value display-manager.service 2>/dev/null)" = sddm.service ] && DROP=zzs-egpu-buddy-session.conf
old_drop(){ [ "$DROP" = zzs-egpu-buddy-session.conf ] && rm -f "$1/zzz-egpu-buddy-session.conf"; return 0; }   # the earlier name

dm_dir(){
  local dm d=""
  dm=$(systemctl show -p Id --value display-manager.service 2>/dev/null || true)
  case "$dm" in
    plasmalogin.service) d=/etc/plasmalogin.conf.d ;;
    sddm.service)        d=/etc/sddm.conf.d ;;
  esac
  [ -n "$d" ] || for c in /etc/plasmalogin.conf.d /etc/sddm.conf.d; do [ -d "$c" ] && { d=$c; break; }; done
  [ -n "$d" ] || return 1
  install -d -m 0755 "$d"; printf '%s\n' "$d"
}

session_file(){   # $1 = plasma|gamescope|bigpicture -> the .desktop this system really has
  local want n c
  case "$1" in
    plasma)     want="plasma.desktop plasmawayland.desktop plasmax11.desktop" ;;
    plasmax11)  want="plasmax11.desktop plasma.desktop" ;;   # the X11 desktop kept (egpu-desktop-detach)
    gamescope)  want="gamescope-session.desktop gamescope-wayland.desktop" ;;
    bigpicture) want="egpu-bigpicture.desktop gamescope-session.desktop gamescope-wayland.desktop" ;;
    *) return 1 ;;
  esac
  # Bazzite: Game Mode is gamescope-session-ogui-steam or gamescope-session-steam, whichever the system boots into
  if [ $BZ = 1 ] && { [ "$1" = gamescope ] || [ "$1" = bigpicture ]; }; then
    n=$(sed -n 's/^Session=//p' /etc/sddm.conf.d/zz-holo-autologin.conf 2>/dev/null | tail -1)
    case "$n" in gamescope-*) ;; *) n=$(sed -n 's/^Session=//p' /usr/lib/sddm/sddm.conf.d/holo.conf 2>/dev/null | tail -1) ;; esac
    case "$n" in gamescope-*) want="$n $want" ;; esac
    want="$want gamescope-session-ogui-steam.desktop gamescope-session-steam.desktop"
  fi
  for n in $want; do
    for c in /usr/local/share/wayland-sessions /usr/share/wayland-sessions /usr/local/share/xsessions /usr/share/xsessions; do
      [ -f "$c/$n" ] && { printf '%s\n' "$n"; return 0; }
    done
  done
  return 1
}

case "${1:-show}" in
  pin)
    d=$(dm_dir) || { echo "no login manager configuration directory found" >&2; exit 2; }
    f=$(session_file "${2:?pin needs plasma|gamescope|bigpicture}") || { echo "no session file for '$2' on this system" >&2; exit 3; }
    old_drop "$d"; printf '[Autologin]\nRelogin=true\nSession=%s\n' "$f" > "$d/$DROP"
    echo "pinned $f in $d"
    ;;
  unpin)
    d=$(dm_dir) || exit 0
    old_drop "$d"; rm -f "$d/$DROP"; echo "unpinned (system default restored in $d)"
    ;;
  release-stale)
    # Our pin only has a job while an eGPU is attached to a desktop session (losing it then must come back to the desktop)
    # or for the one relogin of a Safe Detach. With no NVIDIA eGPU on the bus and no detach running it only outranks the
    # system's own choice: "Return to Gaming Mode" then logs straight back into the desktop (ROG Xbox Ally X after a cable
    # pull, 0.7.136). The boot policy's own desktop pin (opt-in /etc/nv-egpu-buddy/boot-desktop) is the user's choice: kept.
    d=$(dm_dir) || exit 0
    old_drop "$d"; [ -f "$d/$DROP" ] || { echo "not pinned"; exit 0; }
    [ -e /etc/nv-egpu-buddy/boot-desktop ] && { echo "kept: the boot policy pins the desktop (boot-desktop)"; exit 0; }
    lspci -Dn 2>/dev/null | grep -qE ' 03(00|02|80): 10de:' && { echo "kept: an NVIDIA eGPU is attached"; exit 0; }
    { [ -e /run/nvegpu/gm-detach-pending ] || pgrep -f '/usr/local/sbin/egpu-(safe|desktop)-detach' >/dev/null 2>&1; } && { echo "kept: a Safe Detach is running"; exit 0; }
    s=$(sed -n 's/^Session=//p' "$d/$DROP" 2>/dev/null)
    rm -f "$d/$DROP"; echo "released a leftover pin (${s:-?}): the system's own session choice applies again"
    ;;
  watch-temp)
    # ROG Ally / XG Mobile under SteamOS's sddm only (egpu-dm-watch.path, on every change in the sddm directory).
    # 0.7.182 assumed "Return to Gaming Mode" writes a one-off Game Mode file the pin could rank below. It does not:
    # "Switch to Desktop" writes the one-off DESKTOP file zzt-steamos-temp-login.conf (it stays until sddm restarts at
    # boot), and "Return to Gaming Mode" removes it and logs out, so the system default (Game Mode) applies - which our
    # desktop pin outranks whatever its name. So: once that file has been seen and then goes (or turns to Game Mode), the
    # user asked for Game Mode: the pin goes too. A cable pull leaves the file alone, so it still returns to the desktop.
    [ $BZ = 0 ] && [ "$DROP" = zzs-egpu-buddy-session.conf ] || exit 0
    d=$(dm_dir) || exit 0; T=$d/zzt-steamos-temp-login.conf; S=/run/nvegpu/steamos-desktop-switch
    if [ -f "$T" ] && ! grep -qs '^Session=gamescope' "$T"; then mkdir -p /run/nvegpu; : > "$S"; exit 0; fi
    [ -e "$S" ] || exit 0
    rm -f "$S"
    [ -f "$d/$DROP" ] || exit 0
    { [ -e /run/nvegpu/gm-detach-pending ] || pgrep -f '/usr/local/sbin/egpu-(safe|desktop)-detach' >/dev/null 2>&1; } && exit 0
    rm -f "$d/$DROP"; logger -t egpu-buddy "Return to Gaming Mode: the desktop login pin was released" 2>/dev/null
    echo "released the desktop pin: the user returned to Gaming Mode"
    ;;
  migrate)
    # an update moves a pin left under the earlier name to the current one (run by install.sh)
    d=$(dm_dir) || exit 0
    [ "$DROP" = zzs-egpu-buddy-session.conf ] && [ -f "$d/zzz-egpu-buddy-session.conf" ] && [ ! -f "$d/$DROP" ] &&
      mv -f "$d/zzz-egpu-buddy-session.conf" "$d/$DROP" && echo "pin moved to $DROP"
    exit 0
    ;;
  show)
    d=$(dm_dir) || { echo "none"; exit 0; }
    echo "$d: $(sed -n 's/^Session=//p' "$d/$DROP" 2>/dev/null || echo 'not pinned')"
    ;;
  *) echo "usage: egpu-dm-session pin plasma|gamescope|bigpicture | unpin | show" >&2; exit 64 ;;
esac
