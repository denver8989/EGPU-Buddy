#!/usr/bin/env python3
"""egpu-mod-maniac — "Mod Maniac diagnostic help" (plugin > Setup & updates > Extras; off by default).

  egpu-mod-maniac on  <user home> [--no-restart]   switch every OTHER Decky plugin off, for a clean test
  egpu-mod-maniac off <user home> [--no-restart]   switch back on exactly the plugins this switched off
  egpu-mod-maniac status <user home>               JSON: on, what it switched off, every other plugin

It uses Decky Loader's own list (homebrew/settings/loader.json, "disabled_plugins": the list behind Decky's own
"disable plugin"): no plugin file is touched, nothing is uninstalled. Only what THIS tool switched off is recorded
(/var/lib/nvegpu/mod-maniac.json) and switched back on; a plugin the user had off before stays off. EGPU Buddy itself is
never in the list. Decky reads that list when it starts, and keeps its settings in memory while it runs, so Decky is
stopped, the list is written, and Decky is started again (always, also when the write fails). Runs as root, started by
the plugin as its own unit (it must survive the Decky stop).
"""
import glob, json, os, subprocess, sys, time

STATE = "/var/lib/nvegpu/mod-maniac.json"
OURS = {"EGPU Buddy", "NV GPU Buddy"}
UNIT = "plugin_loader.service"


def jload(p):
    try: return json.load(open(p, encoding="utf-8"))
    except (OSError, ValueError): return {}


def others(home):
    """Decky's name for every other installed plugin (plugin.json "name", else the folder name, as Decky does)."""
    out = []
    for d in sorted(glob.glob(f"{home}/homebrew/plugins/*/")):
        folder = os.path.basename(d.rstrip("/"))
        name = jload(os.path.join(d, "plugin.json")).get("name") or folder
        if name in OURS or folder in ("EGPU-Buddy", "NV-GPU-Buddy") or not os.path.exists(os.path.join(d, "plugin.json")):
            continue
        out.append(name)
    return out


def write_list(path, names):
    """loader.json with the new list: every other setting kept, same owner and mode, swapped in whole."""
    cfg = jload(path); cfg["disabled_plugins"] = names
    st = os.stat(path) if os.path.exists(path) else os.stat(os.path.dirname(path))
    tmp = path + ".egpu-tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=4, ensure_ascii=False)
    os.chown(tmp, st.st_uid, st.st_gid); os.chmod(tmp, 0o644 if not os.path.exists(path) else st.st_mode & 0o777)
    os.replace(tmp, path)


def status(home):
    st = jload(STATE); off = jload(f"{home}/homebrew/settings/loader.json").get("disabled_plugins") or []
    print(json.dumps({"on": bool(st.get("on")), "disabled_by_us": st.get("disabled") or [], "since": st.get("since", 0),
                      "others": [{"name": n, "disabled": n in off} for n in others(home)]}))


def switch(home, on, restart):
    path = f"{home}/homebrew/settings/loader.json"
    if not os.path.isdir(f"{home}/homebrew/settings"):
        print("Decky Loader's settings folder was not found", file=sys.stderr); return 2
    st = jload(STATE)
    if on and st.get("on"):
        print("already on"); return 0
    if not on and not st.get("on"):
        print("already off"); return 0
    sysd = lambda *a: subprocess.run(["timeout", "30", "systemctl", *a], capture_output=True).returncode
    was_up = restart and sysd("is-active", "--quiet", UNIT) == 0
    if was_up: sysd("stop", UNIT)
    rc = 0
    try:
        off = jload(path).get("disabled_plugins") or []
        if on:
            mine = [n for n in others(home) if n not in off]
            os.makedirs(os.path.dirname(STATE), exist_ok=True)
            # the record first: if the list is written and the record is not, nothing could switch the plugins back on
            tmp = STATE + ".tmp"; json.dump({"on": True, "disabled": mine, "since": int(time.time())}, open(tmp, "w")); os.replace(tmp, STATE)
            write_list(path, off + mine)
            print(f"on: {len(mine)} plugin(s) switched off")
        else:
            mine = set(st.get("disabled") or [])
            write_list(path, [n for n in off if n not in mine])
            os.remove(STATE)
            print(f"off: {len(mine)} plugin(s) switched back on")
    except OSError as e:
        print(f"could not change Decky's plugin list: {e}", file=sys.stderr); rc = 1
        if on:   # nothing was switched off: no record of it either
            try: os.remove(STATE)
            except OSError: pass
    finally:
        if was_up: sysd("start", UNIT)
    return rc


if __name__ == "__main__":
    a = sys.argv[1:]
    if len(a) >= 2 and a[0] in ("on", "off", "status") and os.path.isdir(a[1]):
        if os.geteuid() != 0 and a[0] != "status": print("run as root", file=sys.stderr); sys.exit(1)
        sys.exit(status(a[1]) or 0 if a[0] == "status" else switch(a[1], a[0] == "on", "--no-restart" not in a))
    print(__doc__, file=sys.stderr); sys.exit(2)
