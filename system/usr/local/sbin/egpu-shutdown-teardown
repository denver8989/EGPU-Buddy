#!/usr/bin/env bash
# egpu-shutdown-teardown — take the NVIDIA eGPU down on the way to power-off / reboot, the same way a detach does.
#
# Runs as the ExecStop of egpu-buddy-shutdown.service, ordered so it stops AFTER the display manager, the user
# sessions (gamescope, Steam, PipeWire), Decky and bolt have gone, while the USB4 tunnel is still up. That is exactly
# the state Game Mode detach reaches before it hands over to `egpu-safe-detach --teardown-only` (compositor already
# off the eGPU), so this runs that same, proven teardown and nothing else: eGPU audio unbound (with its open-card
# guard), /dev/nvidia* users released, the driver stack unloaded, the GPU functions PCI-removed, tunnel ports released.
# No new teardown logic lives here.
#
# Why: nothing took the eGPU down at shutdown, and the kernel was left to shut it down behind a live tunnel. Reported
# on a Legion Go 2 + RTX 5060 Ti (issue #1): it never powers off; the panel and the eGPU stay on.
set -u
LOG=/var/log/egpu-shutdown.log
log(){ printf '%s %s\n' "$(date '+%F %T' 2>/dev/null)" "$*" >>"$LOG" 2>/dev/null; sync -d "$LOG" 2>/dev/null || true; }
PO=/var/lib/nvegpu/poweroff-guarded
# --boot (the unit's start, before the login screen): a power-off that hung and was restarted by the guard below is
# finished now. Only when the marker is fresh (< 150 s: hang 60 s + 10 s + boot) and the kernel left a crash record
# newer than it, or cannot keep one (then the age alone decides).
if [ "${1:-}" = --boot ]; then
  [ -e "$PO" ] || exit 0
  age=$(( $(date +%s) - $(stat -c %Y "$PO") )); new=$(find /sys/fs/pstore /var/lib/systemd/pstore -type f -newer "$PO" 2>/dev/null | head -1)
  bk=$(cat /sys/module/pstore/parameters/backend 2>/dev/null)
  rm -f "$PO"
  if [ "$age" -ge 0 ] && [ "$age" -lt 150 ] && { [ -n "$new" ] || [ -z "$bk" ] || [ "$bk" = "(null)" ]; }; then
    log "the power-off before this boot hung and restarted (${age}s ago${new:+, crash record $new}): powering off now"
    systemctl --no-block poweroff
  fi
  exit 0
fi

# Only on a real power-off / reboot / halt. A plain `systemctl stop` or a reinstall must never detach the eGPU.
going_down(){
  [ "$(systemctl is-system-running 2>/dev/null)" = stopping ] && return 0
  systemctl list-jobs --no-legend 2>/dev/null | grep -qE '(poweroff|reboot|halt|kexec)\.target'
}
[ -e /etc/nv-egpu-buddy/skip-shutdown-teardown ] && { log "skip flag present — eGPU left to the kernel"; exit 0; }
going_down || exit 0
# "Turn the TV off at power-off" (TV options, off by default): power-off and halt only, a restart leaves the TV on
if grep -qs '"off_at_poweroff": true' /var/lib/nvegpu/screen-net.json && systemctl list-jobs --no-legend 2>/dev/null | grep -qE '(poweroff|halt)\.target'; then
  log "TV: $(timeout 15 /usr/local/sbin/egpu-screen tvoff --poweroff 2>&1 | tail -1)"
fi
# an ASUS XG Mobile is told the host is going away, as G-Helper does at shutdown (does nothing without one)
[ -x /usr/local/sbin/egpu-xgm ] && timeout 5 /usr/local/sbin/egpu-xgm notify-shutdown >/dev/null 2>&1
# AMD / Intel install, after a Safe Detach this boot: the reboot hung at the logo after the journal had stopped (Legion
# Go S + RX 9070 XT + Trebleet, reports NQ7KNJ, AP3WSW; reboots without a detach were clean). Kernel stuck in its own
# device shutdown, out of reach of any log. So: a task blocked for 60 s panics, the panic writes the kernel log to pstore
# (the next report shows it) and restarts the machine 10 s later instead of hanging. A power-off that hangs this way
# restarts, and that boot powers off again before the login screen (--boot).
# 2026-11-12 (report V2ZU2F): the same hang without a Safe Detach, after a Steam Link stream. What every slow restart
# had in common: Valve's CEC service restarted during the session (Safe Detach and the stream TV hold both do), leaving
# the eGPU's CEC adapter configured. So on every AMD shutdown the eGPU's CEC adapters are released first (logical
# addresses cleared, as Safe Detach and a cable pull do: an idle adapter is not touched by the driver's teardown), and
# the guard is armed on every AMD shutdown, not only after a Safe Detach.
if [ "$(cat /etc/nv-egpu-buddy/gpu-vendor 2>/dev/null)" = amd ]; then
  rm -f /run/nvegpu/cec-hold; [ -x /usr/local/sbin/egpu-cec-release ] && timeout 10 /usr/local/sbin/egpu-cec-release --yank >/dev/null 2>&1
  log "AMD: the eGPU's CEC adapters released before the shutdown"
  sysctl -q -w kernel.hung_task_timeout_secs=60 kernel.hung_task_panic=1 kernel.panic=10 2>/dev/null
  log "AMD: a hang in the kernel's shutdown now panics (log to pstore) and restarts"
  # Report JVJHES: after a Steam Link stream every restart waits ~2 min after the log stops, on every warm restart until
  # a hard power-off. What is still running and holding a GPU now, and anything stuck in the kernel, is what the final
  # shutdown waits on: logged here while the log can still be written.
  log "AMD: still running: $(ps -eo comm= --ppid 2 -N 2>/dev/null | sort -u | tr '\n' ' ' | cut -c1-600)"
  log "AMD: GPU users: $(timeout 5 fuser -v /dev/dri/* 2>&1 | awk 'NR>1{print $(NF)}' | sort -u | tr '\n' ' ')"
  for pid in $(ps -eo pid=,stat= 2>/dev/null | awk '$2 ~ /^D/{print $1}'); do
    log "AMD: stuck in the kernel: $pid $(cat /proc/$pid/comm 2>/dev/null): $(tr '\n' ' ' </proc/$pid/stack 2>/dev/null | cut -c1-400)"; done
  # a power-off after a Safe Detach (where the hang is known): remembered, so the boot after a guard restart powers off
  # again at once (--boot). Not on every power-off: without a crash store the age alone decides, and a quick power-on
  # after a normal power-off would switch the device off again.
  [ -e /run/nvegpu/detached-this-boot ] && systemctl list-jobs --no-legend 2>/dev/null | grep -q 'poweroff\.target' && { mkdir -p "${PO%/*}"; : > "$PO"; sync; }
fi
lspci -Dn 2>/dev/null | grep -qE ' 0300: 10de:' || exit 0

log "=== shutdown: egpu-safe-detach --teardown-only ==="
/usr/local/sbin/egpu-safe-detach --teardown-only >>"$LOG" 2>&1; rc=$?
log "=== teardown rc=$rc; eGPU on bus: $(lspci -Dn 2>/dev/null | grep -cE ' 0300: 10de:') ==="
# never fail the stop job: shutdown continues either way, and the log says what happened
exit 0
