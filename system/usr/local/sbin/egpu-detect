#!/usr/bin/env bash
# SteamOS EGPU Buddy — vendor-neutral eGPU detection. Source it for the functions, or run it:
#   egpu-detect            -> "BDF VENDOR CARD" of the eGPU (exit 1 when none)   VENDOR = nvidia|amd|intel|other
#   egpu-detect --igpu     -> BDF of the built-in GPU
#   egpu-detect --device   -> device profile: legion-go-2 (the tested machine, device-specific fixes apply) | rog-ally | generic
#   egpu-detect --dock     -> xg-mobile-usb4 | xg-mobile-legacy | usb4 | none   (which dock the eGPU is in, see egpu_dock;
#                             independent of --device: an XG Mobile on a Legion Go is legion-go-2 + xg-mobile-usb4)
#   egpu-detect --untested -> one line per difference from the tested configuration (exit 0 = differs, lines printed; 1 = matches the tested machine)
#   egpu-detect --machine  -> NV GPU Buddy track (experimental): what kind of machine this is, see egpu_machine
#   egpu-detect --selftest -> check the logic against a fake sysfs tree
# The eGPU is the display-class PCI device that does NOT drive the built-in panel and sits behind a
# bridge chain (root port -> dock switch -> GPU). Override: EGPU_PCI_BDF in /etc/nv-egpu-buddy/egpu.conf.
# ponytail: depth>=3 also matches an internal dGPU that has its own PCIe switch (desktop Navi); this
# project targets handhelds. Upgrade path = walk ancestors for a Thunderbolt/USB4 tunnel port.

EGPU_SYSFS_ROOT=${EGPU_SYSFS_ROOT:-}
[ -r /etc/nv-egpu-buddy/egpu.conf ] && [ -z "$EGPU_SYSFS_ROOT" ] && . /etc/nv-egpu-buddy/egpu.conf

_egpu_is_display() { case "$(cat "$1/class" 2>/dev/null)" in 0x0300*|0x0302*|0x0380*) return 0 ;; esac; return 1; }

egpu_igpu_bdf() {
  local c dev
  for c in "$EGPU_SYSFS_ROOT"/sys/class/drm/card*-eDP-*; do
    [ -e "$c" ] || continue
    dev=$(readlink -f "${c%-eDP-*}/device") && { basename "$dev"; return 0; }
  done
  # no panel connector visible (headless, or the panel's card is mid-reset): shallowest display device
  for dev in "$EGPU_SYSFS_ROOT"/sys/bus/pci/devices/*; do
    _egpu_is_display "$dev" || continue
    [ "$(_egpu_depth "$dev")" -le 2 ] && { basename "$dev"; return 0; }
  done
  return 1
}

# number of PCI functions in the device's path below the host bridge (iGPU = 2, tunneled GPU >= 3)
_egpu_depth() { readlink -f "$1" | grep -oE '[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]' | wc -l; }

egpu_vendor_name() { case "$1" in 0x10de) echo nvidia ;; 0x1002) echo amd ;; 0x8086) echo intel ;; *) echo other ;; esac; }

# prints "BDF VENDOR CARD" (CARD empty until a DRM driver has bound)
egpu_find() {
  local igpu dev bdf card
  igpu=$(egpu_igpu_bdf || true)
  for dev in "$EGPU_SYSFS_ROOT"/sys/bus/pci/devices/*; do
    bdf=$(basename "$dev")
    if [ -n "${EGPU_PCI_BDF:-}" ]; then [ "$bdf" = "$EGPU_PCI_BDF" ] || continue
    else
      _egpu_is_display "$dev" || continue
      [ "$bdf" != "$igpu" ] || continue
      [ "$(_egpu_depth "$dev")" -ge 3 ] || continue
    fi
    card=$(ls "$dev/drm" 2>/dev/null | grep -m1 -E '^card[0-9]+$' || true)
    echo "$bdf $(egpu_vendor_name "$(cat "$dev/vendor" 2>/dev/null)") $card"
    return 0
  done
  return 1
}

# Device profile. The tested NVIDIA scripts are, in effect, the Legion Go 2 profile; anything else gets only detected,
# generic behaviour. Device-specific fixes must be gated on this, never applied blindly.
egpu_device_profile() {
  case "$(cat "$EGPU_SYSFS_ROOT"/sys/class/dmi/id/product_family 2>/dev/null)" in
    "Legion Go 8ASP2") echo legion-go-2 ;;
    *) case "$(cat "$EGPU_SYSFS_ROOT"/sys/class/dmi/id/product_name 2>/dev/null)" in
         # Ally RC71L and Ally X RC72LA (Z1 / Z1 Extreme), ROG Xbox Ally RC73YA and Ally X RC73XA (Z2 A / Z2 Extreme).
         # "ROG Xbox Ally X" has no "ROG Ally" in it, so match the word and the model codes. The chip is not part of the
         # profile: nothing here depends on it, and egpu-hw-repair records it for support reports.
         *Ally*|*RC71*|*RC72*|*RC73*) echo rog-ally ;;
         *) echo generic ;;
       esac ;;
  esac
}

# ASUS's eGPU switch: asus-nb-wmi on older kernels, asus-armoury on newer ones. Present only on machines with the
# proprietary XG Mobile connector (original Ally RC71L, Flow laptops); it powers that dock on and off.
egpu_asus_switch() {
  local d; for d in "$EGPU_SYSFS_ROOT"/sys/devices/platform/asus-nb-wmi "$EGPU_SYSFS_ROOT"/sys/class/firmware-attributes/asus-armoury/attributes/egpu_enable; do
    [ -e "$d/egpu_enable" ] && { echo "$d"; return 0; }
    [ -e "$d/current_value" ] && { echo "$d"; return 0; }
  done; return 1
}

# Which dock: the 2025 XG Mobile is a USB4 device (Thunderbolt name "GC3...", vendor ASUS) and attaches like any USB4
# dock; the older ones sit on the proprietary connector, need egpu_enable=1 before they appear on the bus and =0 before
# unplugging. Learned from the XG Mobile projects credited in CREDITS.md (facts reimplemented here, no code taken).
egpu_dock() {
  local d n v sw
  for d in "$EGPU_SYSFS_ROOT"/sys/bus/thunderbolt/devices/*-*; do
    case "${d##*/}" in *-0|*:*) continue ;; esac
    n=$(cat "$d/device_name" 2>/dev/null); v=$(cat "$d/vendor_name" 2>/dev/null)
    [ -n "$n" ] || continue
    case "$v $n" in *ASUS*GC3*|*Asus*GC3*|*" GC3"*) echo xg-mobile-usb4; return 0 ;; esac
    echo usb4; return 0
  done
  if sw=$(egpu_asus_switch); then
    # egpu_connected = the dock's lock switch is closed (asus-nb-wmi only; asus-armoury has no such attribute)
    [ "$(cat "$sw/egpu_connected" 2>/dev/null || echo 1)" = 1 ] && { echo xg-mobile-legacy; return 0; }
  fi
  echo none
}

# Power the proprietary-connector XG Mobile on/off. Only for xg-mobile-legacy: a USB4 XG Mobile has no switch to flip.
# The write can block for half a minute or more while the firmware powers the dock, and a write that times out has
# usually taken effect, so it runs under a timeout and the caller checks the bus, not the exit code. The value is kept by
# the embedded controller across reboots: it is set only when the dock is locked in, and cleared after the GPU is removed.
egpu_asus_power() {
  local sw f v; sw=$(egpu_asus_switch) || return 1
  f="$sw/egpu_enable"; [ -e "$f" ] || f="$sw/current_value"
  case "$1" in on) v=1 ;; off) v=0 ;; *) return 2 ;; esac
  [ "$(cat "$f" 2>/dev/null)" = "$v" ] && return 0
  timeout 90 sh -c "echo $v > '$f'" 2>/dev/null || true
  [ "$(cat "$f" 2>/dev/null)" = "$v" ]
}

# The one configuration this project has been verified on. Anything else is untested and the user must be told so.
# The hardware this project was verified on (TESTED.md): Legion Go 2 (8ASP2, 8AHP2), Legion Go 1 (8APU1), ROG Xbox Ally X;
# RTX 5060 Ti, RTX 3080, RTX 5070 Ti Laptop (XG Mobile), RX 6800 XT, RX 9070 XT; CachyOS, SteamOS, Bazzite. Anything else
# gets the "not tested on this hardware" acceptance before an install.
TESTED_GPU_IDS="0x10de:0x2d04 0x10de:0x2f80 0x10de:0x2206 0x10de:0x2216 0x10de:0x2f18 0x1002:0x73bf 0x1002:0x7550"
TESTED_DISTROS="cachyos steamos bazzite"
egpu_untested() {
  local r=1 fam gpu vend id name distro
  fam=$(cat "$EGPU_SYSFS_ROOT"/sys/class/dmi/id/product_family 2>/dev/null); fam=${fam:-$(cat "$EGPU_SYSFS_ROOT"/sys/class/dmi/id/product_name 2>/dev/null)}
  case "$fam" in Legion\ Go\ 8ASP2|Legion\ Go\ 8AHP2|Legion\ Go\ 8APU1|ROG\ Xbox\ Ally*) ;; *)
    echo "device: ${fam:-unknown} (tested: Legion Go 1 and 2, ROG Xbox Ally X)"; r=0 ;; esac
  if read -r gpu vend _ < <(egpu_find 2>/dev/null); then
    id=$(cat "$EGPU_SYSFS_ROOT/sys/bus/pci/devices/$gpu/vendor" 2>/dev/null):$(cat "$EGPU_SYSFS_ROOT/sys/bus/pci/devices/$gpu/device" 2>/dev/null)
    name=$(lspci -s "$gpu" 2>/dev/null | sed 's/^[^:]*: //; s/ (rev.*//'); name=${name:-$id}
    case " $TESTED_GPU_IDS " in *" $id "*) ;; *) echo "eGPU: $name (tested: RTX 5060 Ti, RTX 3080, RTX 5070 Ti Laptop, RX 6800 XT, RX 9070 XT)"; r=0 ;; esac
  fi
  distro=$(. "$EGPU_SYSFS_ROOT"/etc/os-release 2>/dev/null; echo "${ID:-unknown}")
  case " $TESTED_DISTROS " in *" $distro "*) ;; *) echo "distro: $distro (tested: CachyOS, SteamOS, Bazzite)"; r=0 ;; esac
  return $r
}

# connected outputs of a DRM card, e.g. "DP-1 HDMI-A-1"
egpu_connected_outputs() {
  local n; for n in "$EGPU_SYSFS_ROOT"/sys/class/drm/"$1"-*; do
    [ "$(cat "$n/status" 2>/dev/null)" = connected ] && echo "${n##*/"$1"-}"
  done
}

_egpu_selftest() {
  local t; t=$(mktemp -d); trap 'rm -rf "$t"' RETURN
  mk() { # path class vendor
    mkdir -p "$t/sys/devices/$1" "$t/sys/bus/pci/devices" "$t/sys/class/drm"
    echo "$2" > "$t/sys/devices/$1/class"; echo "$3" > "$t/sys/devices/$1/vendor"
    ln -s "$t/sys/devices/$1" "$t/sys/bus/pci/devices/${1##*/}"; }
  mk pci0000:00/0000:00:08.1 0x060400 0x1022
  mk pci0000:00/0000:00:08.1/0000:c2:00.0 0x038000 0x1002
  mkdir -p "$t/sys/devices/pci0000:00/0000:00:08.1/0000:c2:00.0/drm/card1"
  mkdir -p "$t/sys/class/drm/card1-eDP-1"; ln -s "$t/sys/devices/pci0000:00/0000:00:08.1/0000:c2:00.0/drm/card1" "$t/sys/class/drm/card1"
  ln -s ../../../0000:c2:00.0 "$t/sys/devices/pci0000:00/0000:00:08.1/0000:c2:00.0/drm/card1/device"
  EGPU_SYSFS_ROOT=$t; unset EGPU_PCI_BDF
  [ "$(egpu_igpu_bdf)" = 0000:c2:00.0 ] || { echo "FAIL igpu"; return 1; }
  egpu_find >/dev/null && { echo "FAIL: iGPU-only tree reported an eGPU"; return 1; }
  mk pci0000:00/0000:00:01.1/0000:60:00.0/0000:61:00.0/0000:62:00.0 0x030000 0x1002
  mkdir -p "$t/sys/devices/pci0000:00/0000:00:01.1/0000:60:00.0/0000:61:00.0/0000:62:00.0/drm/card0"
  [ "$(egpu_find)" = "0000:62:00.0 amd card0" ] || { echo "FAIL amd: $(egpu_find)"; return 1; }
  echo 0x10de > "$t/sys/devices/pci0000:00/0000:00:01.1/0000:60:00.0/0000:61:00.0/0000:62:00.0/vendor"
  [ "$(egpu_find)" = "0000:62:00.0 nvidia card0" ] || { echo "FAIL nvidia: $(egpu_find)"; return 1; }
  mkdir -p "$t/sys/class/drm/card0-DP-1" "$t/sys/class/drm/card0-DP-2"; echo connected > "$t/sys/class/drm/card0-DP-2/status"; echo disconnected > "$t/sys/class/drm/card0-DP-1/status"
  [ "$(egpu_connected_outputs card0)" = DP-2 ] || { echo "FAIL outputs"; return 1; }
  # ROG Ally X shape: the panel GPU is card0, the eGPU is card1; the USB4 dock is an ASUS GC34X
  mkdir -p "$t/sys/bus/thunderbolt/devices/0-0" "$t/sys/bus/thunderbolt/devices/0-1"
  echo ASUSTeK > "$t/sys/bus/thunderbolt/devices/0-1/vendor_name"; echo GC34X > "$t/sys/bus/thunderbolt/devices/0-1/device_name"
  [ "$(egpu_dock)" = xg-mobile-usb4 ] || { echo "FAIL dock: $(egpu_dock)"; return 1; }
  mkdir -p "$t/sys/class/dmi/id"; echo "ROG Xbox Ally X RC73XA_RC73XA" > "$t/sys/class/dmi/id/product_name"
  [ "$(egpu_device_profile)" = rog-ally ] || { echo "FAIL profile: $(egpu_device_profile)"; return 1; }
  # the dock is detected on its own: a Legion Go 2 docked to the same XG Mobile is legion-go-2 + xg-mobile-usb4
  echo "Legion Go 8ASP2" > "$t/sys/class/dmi/id/product_family"
  [ "$(egpu_device_profile)" = legion-go-2 ] && [ "$(egpu_dock)" = xg-mobile-usb4 ] || { echo "FAIL Legion Go 2 + XG Mobile: $(egpu_device_profile) $(egpu_dock)"; return 1; }
  echo "AORUS RTX506T AI BOX" > "$t/sys/bus/thunderbolt/devices/0-1/device_name"; echo GIGABYTE > "$t/sys/bus/thunderbolt/devices/0-1/vendor_name"
  [ "$(egpu_dock)" = usb4 ] || { echo "FAIL AORUS dock: $(egpu_dock)"; return 1; }
  echo "selftest OK"
}

# ---- NV GPU Buddy track (experimental). Additive: nothing above uses it, so every eGPU install behaves as before.
# It only SUGGESTS a track to the installer, which asks the user to confirm; the choice is then recorded and nothing
# re-detects it later. Prints one of:
#   handheld          a handheld (name list, profile, XG Mobile, tablet-shaped with a panel): always the eGPU app
#   nv-desktop BDF    built-in NVIDIA card, no built-in panel
#   nv-laptop BDF     built-in NVIDIA card next to a built-in panel
#   pc-no-nv          desktop-shaped, no panel, no NVIDIA card yet ("card coming" candidate)
#   egpu              anything else, or unsure: today's eGPU app
# "Built-in" = the kernel's own fact: neither the card nor any bridge above it is "removable" (the kernel marks
# everything behind an external-facing Thunderbolt/USB4 port so). No handheld has a built-in NVIDIA card, so this holds
# for handhelds that do not exist yet. Kernel < 5.12 = unsure = egpu. Any USB4/Thunderbolt device connected = egpu too:
# old TB3 firmware may not mark its port external-facing, so a docked card there could look built-in.
EGPU_HANDHELD_RE='Jupiter|Galileo|Steam Deck|Legion Go|ROG Ally|Xbox Ally|RC71|RC72|RC73|Claw|AYA ?NEO|Loki|G1617|G1618|G1619|ONEXPLAYER|ONE-NETBOOK|AOKZOE|Win600|ZOTAC.*ZONE|Pocket Go|Zeenix'

egpu_is_handheld() {
  local id; id="$(cat "$EGPU_SYSFS_ROOT"/sys/class/dmi/id/{sys_vendor,product_name,product_family} 2>/dev/null | tr '\n' ' ')"
  printf '%s' "$id" | grep -qiE "$EGPU_HANDHELD_RE" && return 0
  [ "$(egpu_device_profile)" = generic ] || return 0
  [ -e "$EGPU_SYSFS_ROOT"/var/lib/nvegpu/xg-mobile-seen ] && return 0
  egpu_asus_switch >/dev/null && return 0   # proprietary XG Mobile connector (Ally, Flow laptops)
  # 30 tablet, 31 convertible, 32 detachable: the shapes handhelds report, here only together with a built-in panel
  case "$(cat "$EGPU_SYSFS_ROOT"/sys/class/dmi/id/chassis_type 2>/dev/null)" in
    30|31|32) _egpu_has_panel && return 0 ;; esac
  return 1
}

_egpu_has_panel() { local c; for c in "$EGPU_SYSFS_ROOT"/sys/class/drm/card*-eDP-* "$EGPU_SYSFS_ROOT"/sys/class/drm/card*-LVDS-*; do [ -e "$c" ] && return 0; done; return 1; }

# 0 = removable (behind USB4/TB) or unsure; 1 = fixed in the machine. Since 5.12 the kernel marks a PCI device
# "removable" when it or a bridge above it sits behind an external-facing port; fixed devices get no attribute at all.
_egpu_removable() {
  local d k; k=${EGPU_KVER:-$(uname -r)}
  printf '%s\n5.12\n' "${k%%[!0-9.]*}" | sort -V -C 2>/dev/null && [ "${k%%[!0-9.]*}" != 5.12 ] && return 0   # older kernel: unsure
  d=$(readlink -f "$1") || return 0
  while case "${d##*/}" in pci*|"") false ;; esac; do   # the card, then each bridge up to the host bridge
    [ "$(cat "$d/removable" 2>/dev/null)" = removable ] && return 0
    d=${d%/*}
  done
  return 1
}

egpu_machine() {
  local dev nv="" kind
  egpu_is_handheld && { echo handheld; return 0; }
  [ "$(egpu_dock)" = none ] || { echo egpu; return 0; }
  for dev in "$EGPU_SYSFS_ROOT"/sys/bus/pci/devices/*; do
    _egpu_is_display "$dev" || continue
    _egpu_removable "$dev" && { echo egpu; return 0; }   # an eGPU on the bus: the eGPU app is the right one
    [ "$(cat "$dev/vendor" 2>/dev/null)" = 0x10de ] && nv=${nv:-$(basename "$dev")}
  done
  if [ -n "$nv" ]; then
    _egpu_has_panel && kind=nv-laptop || kind=nv-desktop
    echo "$kind $nv"; return 0
  fi
  # desktop chassis types (SMBIOS 3.x): desktop, low-profile, pizza box, mini tower, tower, all-in-one... mini PC, stick
  case "$(cat "$EGPU_SYSFS_ROOT"/sys/class/dmi/id/chassis_type 2>/dev/null)" in
    3|4|5|6|7|13|15|16|17|23|24|35|36) _egpu_has_panel || { echo pc-no-nv; return 0; } ;; esac
  echo egpu
}

_egpu_selftest_machine() {
  local t; t=$(mktemp -d); trap 'rm -rf "$t"' RETURN
  EGPU_SYSFS_ROOT=$t; unset EGPU_PCI_BDF
  dmi() { mkdir -p "$t/sys/class/dmi/id"; echo "$1" > "$t/sys/class/dmi/id/sys_vendor"; echo "$2" > "$t/sys/class/dmi/id/product_name"; echo "$3" > "$t/sys/class/dmi/id/product_family"; echo "$4" > "$t/sys/class/dmi/id/chassis_type"; }
  gpu() { # path class vendor removable(each level)
    local p="" part; for part in $(echo "$1" | tr / ' '); do p="$p/$part"; mkdir -p "$t/sys/devices$p"
      case "$part" in pci*) ;; *) [ "$4" = removable ] && echo removable > "$t/sys/devices$p/removable" ;; esac; done
    mkdir -p "$t/sys/bus/pci/devices"; echo "$2" > "$t/sys/devices$p/class"; echo "$3" > "$t/sys/devices$p/vendor"
    ln -sfn "$t/sys/devices$p" "$t/sys/bus/pci/devices/${p##*/}"; }
  panel() { mkdir -p "$t/sys/class/drm/card1-eDP-1"; }
  reset() { rm -rf "$t/sys" "$t/var"; }
  chk() { local got; got=$(egpu_machine); [ "$got" = "$1" ] || { echo "FAIL machine $2: got '$got' want '$1'"; return 1; }; }
  # tower, RTX card in the x16 slot behind the chipset switch (depth 3: egpu_find would call it an eGPU, egpu_machine must not)
  reset; dmi "Micro-Star International Co., Ltd." "MS-7D75" "Default string" 3
  gpu pci0000:00/0000:00:01.1/0000:01:00.0/0000:02:00.0 0x030000 0x10de fixed; chk "nv-desktop 0000:02:00.0" tower || return 1
  # same tower before the card: AMD APU graphics only, no panel
  reset; dmi "ASUSTeK COMPUTER INC." "ProArt B650" "" 3; gpu pci0000:00/0000:00:08.1/0000:0e:00.0 0x030000 0x1002 fixed; chk pc-no-nv tower-no-card || return 1
  # NVIDIA laptop (Optimus 3D controller) next to the panel GPU
  reset; dmi "LENOVO" "82WK" "Legion Pro 5 16IRX8" 10; panel
  gpu pci0000:00/0000:00:02.0 0x030000 0x8086 fixed; gpu pci0000:00/0000:00:01.0/0000:01:00.0 0x030200 0x10de fixed
  chk "nv-laptop 0000:01:00.0" laptop || return 1
  # Legion Go 2 + RTX 5060 Ti dock (the real tree from the owner's machine): handheld
  reset; dmi "LENOVO" "83N0" "Legion Go 8ASP2" 30; panel
  gpu pci0000:00/0000:00:08.1/0000:c2:00.0 0x038000 0x1002 fixed
  gpu pci0000:00/0000:00:01.1/0000:01:00.0/0000:02:00.0/0000:03:00.0 0x030000 0x10de removable; chk handheld legion-go-2 || return 1
  # Legion Go 1, no dock
  reset; dmi "LENOVO" "83E1" "Legion Go 8APU1" 30; panel; gpu pci0000:00/0000:00:08.1/0000:c1:00.0 0x030000 0x1002 fixed; chk handheld legion-go-1 || return 1
  # ROG Xbox Ally X + XG Mobile
  reset; dmi "ASUSTeK COMPUTER INC." "ROG Xbox Ally X RC73XA_RC73XA" "ROG Xbox Ally" 31; panel; chk handheld ally || return 1
  # a handheld nobody has heard of yet, docked to an NVIDIA eGPU: not on the name list, tablet with a panel
  reset; dmi "NEWCO" "NX-1" "Gamer One" 30; panel
  gpu pci0000:00/0000:00:01.1/0000:01:00.0/0000:02:00.0 0x030000 0x10de removable; chk handheld unknown-handheld || return 1
  # the same unknown handheld reporting itself as a laptop: the docked card is removable -> eGPU app, never nv-laptop
  echo 10 > "$t/sys/class/dmi/id/chassis_type"; chk egpu unknown-handheld-as-laptop || return 1
  # Steam Deck: name list
  reset; dmi "Valve" "Galileo" "Sephiroth" 1; panel; chk handheld steam-deck || return 1
  # XG Mobile seen once on this machine
  reset; dmi "NEWCO" "NX-2" "" 10; mkdir -p "$t/var/lib/nvegpu"; touch "$t/var/lib/nvegpu/xg-mobile-seen"; chk handheld xg-mobile-seen || return 1
  # laptop with built-in NVIDIA AND a docked eGPU: the eGPU app
  reset; dmi "Dell Inc." "XPS 15 9530" "XPS" 10; panel; gpu pci0000:00/0000:00:01.0/0000:01:00.0 0x030200 0x10de fixed
  gpu pci0000:00/0000:00:07.0/0000:20:00.0/0000:21:00.0 0x030000 0x10de removable; chk egpu laptop+egpu || return 1
  # old kernel: no "removable" attribute -> unsure -> egpu
  reset; dmi "MSI" "MS-7C02" "" 3; gpu pci0000:00/0000:00:01.1/0000:01:00.0 0x030000 0x10de fixed
  EGPU_KVER=5.10.0 chk egpu old-kernel || return 1
  EGPU_KVER=5.12.0-1 chk "nv-desktop 0000:01:00.0" kernel-5.12 || return 1
  # a USB4 dock is connected (e.g. TB3 firmware that does not mark its port): egpu, whatever the card looks like
  mkdir -p "$t/sys/bus/thunderbolt/devices/0-1"; echo Razer > "$t/sys/bus/thunderbolt/devices/0-1/vendor_name"; echo "Core X" > "$t/sys/bus/thunderbolt/devices/0-1/device_name"
  chk egpu tb-dock-connected || return 1
  # unknown chassis, no NVIDIA: egpu
  reset; dmi "X" "Y" "" 2; chk egpu unknown-chassis || return 1
  echo "machine selftest OK"
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  case "${1:-}" in
    --igpu) egpu_igpu_bdf ;;
    --device) egpu_device_profile ;;
    --dock) egpu_dock ;;
    --xgm-power) [ "$(egpu_dock)" = xg-mobile-legacy ] || [ "${2:-}" = off ] || exit 0; egpu_asus_power "${2:-}" ;;
    --untested) egpu_untested ;;
    --machine) egpu_machine ;;
    --selftest) _egpu_selftest && _egpu_selftest_machine ;;
    *) egpu_find ;;
  esac
fi
