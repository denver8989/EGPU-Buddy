#!/usr/bin/env python3
"""egpu-touchpad - the handheld's touchscreen as a full touchpad while its screen is off (opt-in, Extras).

While the built-in screen is dark because another screen is in use (XR glasses, a monitor or a TV; with or without an
eGPU), the touchscreen is taken exclusively (EVIOCGRAB) and every finger is passed on to a virtual multi-touch touchpad
(uinput). libinput - KDE and Game Mode's gamescope both use it - then gives the whole touchpad: pointer, two-finger
scroll, pinch, three/four-finger gestures. Taps are turned into clicks here (one finger: left, two: right), because
libinput leaves tap-to-click off by default. Three fingers drag (press, move, lift to drop: windows, files). Four
fingers are handled here as KDE shortcuts: swipe up or down shows the window previews (Present Windows), a long swipe left or right switches
desktop. Five fingers spread out show the desktop, pinched in bring the windows back. Four and five fingers are for the
KDE desktop only; in Game Mode they do nothing. When the built-in screen comes back on, the touchscreen is released at once.

  egpu-touchpad            run (systemd: egpu-touchpad.service; started by the option, stopped when it is turned off)
  egpu-touchpad selftest   the tap and rotation rules without hardware

Privacy: nothing about touches is recorded. Fingers go only to the virtual touchpad, in memory, as they happen. Nothing
is written to the log (only "touchpad on" / "touchpad off" and errors), to a file or to the network, and the touchscreen
is only taken while the built-in screen is dark. The selftest checks that no finger activity reaches the log.
One exception, for device compatibility (some touchscreens stop sensing while their screen is off): a single yes/no,
"did any touch reach the touchscreen while the touchpad was on", in REACHED (dated to when the touchpad came on, not
to the touch) and in the "touchpad off" line. No position, count or time of any touch.

Keep the screen on for touch (setting keep_screen, Game Mode only): for touchscreens that stop sensing while their screen
is off. gamescope drives only the screen it shows on, so the handheld's own graphics leave its panel to the kernel's
framebuffer: one still dark touchpad picture is put there once at about 3 % backlight, and nothing is redrawn after
that (no rendering, nothing on the eGPU). The screen counts as dark for the touchpad while it shows the picture.
Turned off (backlight put back) when the touchpad goes off, the desktop starts or the option is switched off.

Settings: /var/lib/nvegpu/touchpad.json {"rotate": 0|90|180|270, "speed": 2.0}. speed: pointer speed (1 = the true size).
rotate: for a touchscreen mounted rotated relative to how the screen is used (default: 0, or 90 when the digitizer is
portrait and the screen landscape).
"""
import fcntl, glob, json, math, os, select, struct, subprocess, sys, time

EV_SYN, EV_KEY, EV_ABS = 0, 1, 3
SYN_REPORT, SYN_DROPPED = 0, 3
ABS_X, ABS_Y, ABS_MT_SLOT, ABS_MT_POSITION_X, ABS_MT_POSITION_Y, ABS_MT_TRACKING_ID = 0, 1, 0x2F, 0x35, 0x36, 0x39
BTN_LEFT, BTN_RIGHT, BTN_TOUCH = 0x110, 0x111, 0x14A
BTN_TOOL_FINGER, BTN_TOOL_QUINTTAP, BTN_TOOL_DOUBLETAP, BTN_TOOL_TRIPLETAP, BTN_TOOL_QUADTAP = 0x145, 0x148, 0x14D, 0x14E, 0x14F
TOOLS = {1: BTN_TOOL_FINGER, 2: BTN_TOOL_DOUBLETAP, 3: BTN_TOOL_TRIPLETAP, 4: BTN_TOOL_QUADTAP, 5: BTN_TOOL_QUINTTAP}
INPUT_PROP_POINTER, INPUT_PROP_DIRECT = 0, 1
EVIOCGRAB = 0x40044590
PIC = "/run/egpu-touchpad-picture"   # while the Game Mode touchpad picture is up: its framebuffer and the backlight to put back
ART = "/usr/local/share/egpu-buddy/touchpad-%dx%d.gray.gz"   # 8-bit grey, drawn for 1920x1200 and 1920x1080
REACHED = "/run/egpu-touchpad-reached"   # "yes" once any touch arrived since the touchpad came on (support report)
UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_ABSBIT, UI_SET_PROPBIT = 0x40045564, 0x40045565, 0x40045567, 0x4004556E
UI_SET_RELBIT, EV_REL, REL_X, REL_Y, REL_HWHEEL, REL_WHEEL, REL_WHEEL_HI_RES, REL_HWHEEL_HI_RES = 0x40045566, 2, 0, 1, 6, 8, 11, 12
GM_SUFFIX = " - Game Mode"   # the Game Mode touchpad: on its own udev seat, read only by our own libinput (GmPointer)
SEAT_RULE = "/run/udev/rules.d/70-egpu-touchpad-gamemode.rules"
UI_DEV_SETUP, UI_ABS_SETUP, UI_DEV_CREATE, UI_DEV_DESTROY = 0x405C5503, 0x401C5504, 0x5501, 0x5502
EVENT = struct.Struct("llHHi")   # struct input_event on 64-bit
ON = "/var/lib/nvegpu/touchpad.json"
NAME = os.environ.get("EGPU_TOUCHPAD_NAME", "EGPU Buddy touchpad (handheld screen)")   # tests use another name
TAP_MS, TAP_MOVE = 220, 0.03       # a tap: shorter than this, moving less than this share of the touchpad


def log(*a):
    print("egpu-touchpad:", *a, flush=True)


def settings():
    try:
        return json.load(open(ON))
    except (OSError, ValueError):
        return {}


def absinfo(fd, code):
    buf = bytearray(24)
    fcntl.ioctl(fd, 0x80184540 + code, buf)   # EVIOCGABS(code)
    return list(struct.unpack("6i", buf))      # value, min, max, fuzz, flat, resolution


def touchscreen():
    """The handheld's own touchscreen: a direct-touch multi-touch device (never an XR glasses' IMU or a controller)."""
    for ev in sorted(glob.glob("/sys/class/input/event*")):
        try:
            prop = int(open(ev + "/device/properties").read().split()[-1], 16)
            absbits = int("".join(open(ev + "/device/capabilities/abs").read().split()), 16)
        except (OSError, ValueError):
            continue
        if prop & (1 << INPUT_PROP_DIRECT) and absbits & (1 << ABS_MT_POSITION_X) and absbits & (1 << ABS_MT_SLOT):
            return "/dev/input/" + os.path.basename(ev), open(ev + "/device/name").read().strip()
    return None, ""


def panel_size_mm():
    for e in glob.glob("/sys/class/drm/card*-eDP-*/edid"):
        try:
            b = open(e, "rb").read()
            if len(b) >= 23 and b[21] and b[22]:
                return b[21] * 10, b[22] * 10
        except OSError:
            pass
    return None


def screen_state():
    """(built-in screen dark, another screen showing a picture) from the kernel's own view: no compositor needed."""
    dark, other = True, False
    for c in glob.glob("/sys/class/drm/card*-*"):
        conn = os.path.basename(c).split("-", 1)[1]
        rd = lambda f: open(f"{c}/{f}").read().strip() if os.path.exists(f"{c}/{f}") else ""
        if conn.startswith("Writeback") or rd("status") != "connected":
            continue
        lit = rd("enabled") == "enabled" and rd("dpms") == "On"
        if conn.startswith("eDP"):
            if os.path.exists(PIC):   # lit only by our touchpad picture
                continue
            bl = [open(p).read().strip() for p in glob.glob("/sys/class/backlight/*/bl_power")]
            dark = not lit or (bool(bl) and all(v != "0" for v in bl))
        elif lit:
            other = True
    return dark, other


def rotation(info_x, info_y):
    r = settings().get("rotate")
    if r in (0, 90, 180, 270):
        return r
    portrait_digitizer = (info_y[2] - info_y[1]) > (info_x[2] - info_x[1])
    return 90 if portrait_digitizer else 0


def rotate(x, y, rot, xr, yr):
    """Digitizer (x, y) -> touchpad (x, y); xr / yr: (min, max) of the digitizer's axes."""
    if rot == 90:
        return y, xr[1] - (x - xr[0])
    if rot == 180:
        return xr[1] - (x - xr[0]), yr[1] - (y - yr[0])
    if rot == 270:
        return yr[1] - (y - yr[0]), x
    return x, y


class Tap:
    """One left click for a short one-finger tap, a right click for a short two-finger tap."""
    def __init__(self, span):
        self.span = span; self.reset()

    def reset(self):
        self.t0, self.most, self.start, self.moved = None, 0, {}, 0.0

    def down(self, slot, x, y, t):
        if self.t0 is None:
            self.t0 = t
        self.start.setdefault(slot, (x, y))

    def move(self, slot, x, y):
        if slot in self.start:
            sx, sy = self.start[slot]
            self.moved = max(self.moved, max(abs(x - sx), abs(y - sy)) / self.span)

    def fingers(self, n):
        self.most = max(self.most, n)

    def up_all(self, t):
        click = None
        if self.t0 is not None and (t - self.t0) * 1000 <= TAP_MS and self.moved <= TAP_MOVE:
            click = {1: BTN_LEFT, 2: BTN_RIGHT}.get(self.most)
        self.reset()
        return click


class Pad:
    def __init__(self, src, name):
        self.src = os.open(src, os.O_RDONLY | os.O_NONBLOCK)
        ix, iy = absinfo(self.src, ABS_MT_POSITION_X), absinfo(self.src, ABS_MT_POSITION_Y)
        islot, itrack = absinfo(self.src, ABS_MT_SLOT), absinfo(self.src, ABS_MT_TRACKING_ID)
        self.rot = rotation(ix, iy)
        self.xr, self.yr = (ix[1], ix[2]), (iy[1], iy[2])
        ox, oy = (iy, ix) if self.rot in (90, 270) else (ix, iy)
        mm = panel_size_mm()
        sp = 2.0
        if mm and not ox[5]:   # units per millimetre: libinput's gesture and scroll thresholds are in mm
            w, h = (mm[1], mm[0]) if self.rot in (90, 270) else mm
            ox[5], oy[5] = max(1, round((ox[2] - ox[1]) / max(w, 1))), max(1, round((oy[2] - oy[1]) / max(h, 1)))
        # speed: report fewer units per mm, so libinput sees a bigger pad and moves the pointer further per finger mm
        sp = settings().get("speed", 2.0)
        sp = float(sp) if isinstance(sp, (int, float)) and 0.25 <= sp <= 8 else 2.0
        ox[5], oy[5] = max(1, round(ox[5] / sp)), max(1, round(oy[5] / sp))
        self.ui = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        fcntl.ioctl(self.ui, UI_SET_EVBIT, EV_KEY); fcntl.ioctl(self.ui, UI_SET_EVBIT, EV_ABS); fcntl.ioctl(self.ui, UI_SET_EVBIT, EV_SYN)
        for k in (BTN_LEFT, BTN_RIGHT, BTN_TOUCH, *TOOLS.values()):
            fcntl.ioctl(self.ui, UI_SET_KEYBIT, k)
        fcntl.ioctl(self.ui, UI_SET_PROPBIT, INPUT_PROP_POINTER)
        for code, info in ((ABS_X, ox), (ABS_Y, oy), (ABS_MT_POSITION_X, ox), (ABS_MT_POSITION_Y, oy), (ABS_MT_SLOT, islot), (ABS_MT_TRACKING_ID, itrack)):
            fcntl.ioctl(self.ui, UI_SET_ABSBIT, code)
            fcntl.ioctl(self.ui, UI_ABS_SETUP, struct.pack("Hxx6i", code, 0, *info[1:]))   # struct uinput_abs_setup
        self.gm = game_mode()
        fcntl.ioctl(self.ui, UI_DEV_SETUP, struct.pack("4H80sI", 0x06, 0x1209, 0x7444, 1, (NAME + (GM_SUFFIX if self.gm else "")).encode(), 0))
        fcntl.ioctl(self.ui, UI_DEV_CREATE)
        self.guard = guardian(self.ui)
        self.gp = None
        if self.gm:
            node = uinput_node(self.ui)
            try:
                self.gp = GmPointer(node, NAME) if node else None
            except OSError as e:
                log("Game Mode pointer:", e)
        fcntl.ioctl(self.src, EVIOCGRAB, 1)
        self.last_ev, self.t_on, self.reached = time.monotonic(), time.time(), False
        try:
            os.remove(REACHED)
        except OSError:
            pass
        self.lastpos = mt_positions(self.src, islot[2] + 1)
        self.slot, self.slots, self.held, self.out = 0, {}, set(), {}
        self.drag, self.wait_clear, self.drag_tid, self.peak, self.pressed, self.drag_t0 = False, False, 60000, 0, False, 0.0
        self.tap = Tap(max(ox[2] - ox[1], oy[2] - oy[1], 1))
        self.size, self.swipe = (max(ox[2] - ox[1], 1), max(oy[2] - oy[1], 1)), None
        self.lim = (ox[1], ox[2], oy[1], oy[2])
        cfg = settings()
        self.three, self.invert = cfg.get("drag", "three") != "tap", bool(cfg.get("invert_scroll"))
        self.tdrag, self.last_tap, self.anchor = None, -1.0, None
        # KDE turns libinput's own tap-to-click on for touchpads; taps are clicks here already (also in Game Mode),
        # so switch KDE's off for this touchpad or every tap clicks twice
        for d in glob.glob("/sys/class/input/event*/device/name"):
            if open(d).read().strip() == NAME:
                ev = d.split("/")[4]
                for prop in ("tapToClick", "tapAndDrag"):
                    self.kde("set-property", "org.kde.KWin", f"/org/kde/KWin/InputDevice/{ev}", "org.kde.KWin.InputDevice", prop, "b", "false", delay=2)
        log(f"touchpad on: {name} (rotation {self.rot}, speed {sp}, {'three-finger drag' if self.three else 'double tap to drag'}"
            f"{', inverted scroll' if self.invert else ''})")

    def emit(self, t, c, v):
        os.write(self.ui, EVENT.pack(0, 0, t, c, v))

    def kde(self, *call, delay=0, script='sleep "$0"; exec busctl --user "$@"'):
        """busctl --user <call> (or a short sh script) in the logged-in user's KDE session (no-op outside KDE)."""
        for bus in sorted(glob.glob("/run/user/*/bus")):
            uid = os.stat(bus).st_uid
            if uid >= 1000:
                subprocess.Popen(["setpriv", f"--reuid={uid}", f"--regid={uid}", "--init-groups", "env",
                                  f"DBUS_SESSION_BUS_ADDRESS=unix:path={bus}", "sh", "-c", script,
                                  str(delay), *call], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return

    def gamemode(self):
        return game_mode()

    def desktop(self):
        """The KDE desktop is up (not Game Mode); checked once per gesture."""
        return subprocess.run(["pgrep", "-x", "kwin_wayland"], stdout=subprocess.DEVNULL).returncode == 0

    def shortcut(self, name):
        self.kde("call", "org.kde.kglobalaccel", "/component/kwin", "org.kde.kglobalaccel.Component", "invokeShortcut", "s", name)

    def show_desktop(self, on):
        # KWin 6.8 ignores org.kde.KWin.showDesktop; its "Show Desktop" shortcut is a toggle, so flip it only when the
        # current state differs from the one wanted
        self.kde("true" if on else "false", script='[ "$(busctl --user get-property org.kde.KWin /KWin org.kde.KWin showingDesktop)" = "b $1" ] '
                 '|| exec busctl --user call org.kde.kglobalaccel /component/kwin org.kde.kglobalaccel.Component invokeShortcut s "Show Desktop"')

    def handle(self, ev):
        """Collect one frame of the touchscreen (multi-touch protocol B), then send it on as one touchpad frame."""
        _, _, t, c, v = EVENT.unpack(ev)
        self.last_ev = time.monotonic()
        if t == EV_ABS:
            if c == ABS_MT_SLOT:
                self.slot = v
            elif c == ABS_MT_TRACKING_ID:
                if v < 0:
                    self.slots.pop(self.slot, None)
                else:   # the kernel does not repeat a position equal to the slot's last one: start from it
                    self.slots[self.slot] = [*self.lastpos.get(self.slot, (None, None)), v]
                    if not self.reached:   # once: yes/no only, file dated to when the touchpad came on
                        self.reached = True
                        try:
                            open(REACHED, "w").write("yes\n"); os.utime(REACHED, (self.t_on, self.t_on))
                        except OSError:
                            pass
            elif c in (ABS_MT_POSITION_X, ABS_MT_POSITION_Y):
                i = 0 if c == ABS_MT_POSITION_X else 1
                self.slots.setdefault(self.slot, [None, None, self.slot])[i] = v
                lp = list(self.lastpos.get(self.slot, (None, None))); lp[i] = v; self.lastpos[self.slot] = tuple(lp)
        elif (t == EV_KEY and c == BTN_TOUCH and v == 0) or (t == EV_SYN and c == SYN_DROPPED):
            # nothing touches (or events were lost): every finger is up, so a lost lift cannot leave a drag held
            self.slots.clear()
            if c == SYN_DROPPED:
                self.frame({}, time.monotonic())
        elif t == EV_SYN and c == SYN_REPORT:
            pts = {s: rotate(p[0], p[1], self.rot, self.xr, self.yr) + (p[2],) for s, p in self.slots.items() if None not in p[:2]}
            self.frame(pts, time.monotonic())
        # the touchscreen's own keys and single-touch axes: rebuilt from the fingers in frame()

    def frame(self, pts, now):
        n = len(pts)
        self.peak = max(self.peak, n) if n else 0   # most fingers since all were lifted
        cx, cy = (sum(p[0] for p in pts.values()) // n, sum(p[1] for p in pts.values()) // n) if n else (0, 0)
        # four and five fingers are KDE desktop shortcuts: in Game Mode (no KWin) they do nothing
        early = self.drag and not self.pressed   # a drag that has not clicked yet can still become a gesture
        if n in (4, 5) and not self.swipe and not self.wait_clear and (early or not self.drag) and self.peak == n and not self.desktop():
            self.drag = False
            self.wait_clear = True; self.tap.reset()
        # four-finger swipe: up/down toggles Present Windows, a long left/right swipe switches desktop (once per swipe)
        # five fingers: spread out shows the desktop, pinched in brings the windows back (once per gesture)
        if n in (4, 5) and self.peak == n and not self.swipe and (early or not self.drag) and not self.wait_clear:
            self.drag = False
            self.swipe = [cx, cy, False, None, 1.0]; self.tap.reset()   # [start x, start y, fired, five-finger spread, ratio]
        if self.swipe and n == 0:
            self.swipe = None
        spread = sum(math.hypot(p[0] - cx, p[1] - cy) for p in pts.values()) / n if n else 0
        if self.swipe and n == 5 and self.swipe[3] is None:
            self.swipe[3:] = [max(spread, 1), 1.0]
        if self.swipe and n == 5 and not self.swipe[2]:
            self.swipe[4] = spread / self.swipe[3]
            if spread >= 1.25 * self.swipe[3] or spread <= 0.8 * self.swipe[3]:
                self.swipe[2] = True; self.show_desktop(spread > self.swipe[3])
        if self.swipe and n == 4 and not self.swipe[2] and self.swipe[3] is None:
            dx, dy = cx - self.swipe[0], cy - self.swipe[1]
            act = None
            if abs(dx) > abs(dy) and abs(dx) >= 0.3 * self.size[0]:   # ponytail: fixed thresholds, a knob if people ask
                act = "Switch One Desktop to the Right" if dx < 0 else "Switch One Desktop to the Left"
            elif abs(dy) > abs(dx) and abs(dy) >= 0.15 * self.size[1]:
                act = "Expose"   # Present Windows: previews of this desktop's windows
            if act:
                self.swipe[2] = True; self.shortcut(act)
        # three-finger drag: three fingers down press the button on what is under the pointer, moving them drags it,
        # lifting them drops it. The pointer follows the middle of the three (as in the first, owner-approved version).
        if self.three and not self.drag and not self.wait_clear and not self.swipe and n == 3 and self.peak == 3:
            self.drag, self.drag_tid, self.pressed, self.drag_t0 = True, self.drag_tid % 65000 + 1, False, now
        if self.drag and not self.pressed and now - self.drag_t0 >= 0.06:   # the grab clicks 60 ms in: a 4th/5th finger
            self.pressed = True                                               # landing before that makes it a gesture
            self.tap.reset()
        if self.drag and n < 2:   # lifted (one finger leaving a moment early does not end it)
            self.drag, self.wait_clear = False, n > 0
        if self.wait_clear and n == 0:
            self.wait_clear = False
        if self.drag:
            target = {0: (self.drag_tid, cx, cy)}
        elif self.wait_clear or self.swipe:
            target = {}
        else:
            target = {s: (p[2], p[0], p[1]) for s, p in pts.items()}
            for s, (_, x, y) in target.items():
                self.tap.down(s, x, y, now); self.tap.move(s, x, y)
            self.tap.fingers(n)
            # inverted scroll: two fingers are mirrored through where they landed, so scrolling runs the other way while a
            # pinch (their distance) stays the same; new tracking ids on the way in and out keep the pointer from jumping
            if self.invert and n == 2:
                key = {s: p[2] for s, p in pts.items()}
                if not self.anchor or self.anchor[0] != key:
                    self.anchor = (key, {s: (p[0], p[1]) for s, p in pts.items()})
                lx0, lx1, ly0, ly1 = self.lim
                target = {s: ((tid + 32768) % 65536, min(lx1, max(lx0, 2 * self.anchor[1][s][0] - x)),
                              min(ly1, max(ly0, 2 * self.anchor[1][s][1] - y))) for s, (tid, x, y) in target.items()}
            else:
                self.anchor = None
        # double tap to drag (when three-finger drag is off): tap, touch again and hold or move: the button is held; lifting
        # keeps it held (locked), the next tap lets go
        click = self.tap.up_all(now) if n == 0 and not self.drag and not self.swipe else None
        if not self.three:
            started = n == 1 and self.peak == 1 and not getattr(self, "was", 0)
            if started and self.tdrag == "locked":
                self.tdrag = "relock"
            elif started and now - self.last_tap < 0.3:
                self.tdrag, self.tdrag_t0 = "armed", now
            if self.tdrag == "armed" and n == 1 and (now - self.tdrag_t0 > 0.18 or self.tap.moved > TAP_MOVE):
                self.tdrag = "held"; self.tap.reset()
            if n >= 2 and self.tdrag in ("held", "relock", "locked"):
                self.tdrag = None
            if n == 0:
                if self.tdrag == "held" or (self.tdrag == "relock" and not click):
                    self.tdrag = "locked"
                elif self.tdrag == "relock":
                    self.tdrag, click = None, None   # the tap that lets go clicks nothing more
                elif self.tdrag == "armed":
                    self.tdrag = None
            if click == BTN_LEFT:
                self.last_tap = now
        self.was = n
        if any(s in self.out and self.out[s][0] != t[0] for s, t in target.items()):
            # a slot changes touch (drag start, inverted scroll): end every touch in a frame of its own first. A new
            # tracking id over a live one is a protocol bug to libinput ("double tracking ID") and can leave a touch
            # stuck down in KDE (2026-11-10)
            for s in self.out:
                self.emit(EV_ABS, ABS_MT_SLOT, s); self.emit(EV_ABS, ABS_MT_TRACKING_ID, -1)
            for k in sorted(self.held & {BTN_TOUCH, *TOOLS.values()}):
                self.emit(EV_KEY, k, 0)
            self.held -= {BTN_TOUCH, *TOOLS.values()}
            self.emit(EV_SYN, SYN_REPORT, 0)
            self.out = {}
        for s in set(self.out) - set(target):
            self.emit(EV_ABS, ABS_MT_SLOT, s); self.emit(EV_ABS, ABS_MT_TRACKING_ID, -1)
        for s, (tid, x, y) in target.items():
            old = self.out.get(s)
            if old is None or old[0] != tid:
                self.emit(EV_ABS, ABS_MT_SLOT, s); self.emit(EV_ABS, ABS_MT_TRACKING_ID, tid)
            if old is None or old[0] != tid or old[1:] != (x, y):
                self.emit(EV_ABS, ABS_MT_SLOT, s); self.emit(EV_ABS, ABS_MT_POSITION_X, x); self.emit(EV_ABS, ABS_MT_POSITION_Y, y)
        if target:
            _, x, y = target[min(target)]
            self.emit(EV_ABS, ABS_X, x); self.emit(EV_ABS, ABS_Y, y)
        self.out = target
        want = ({TOOLS[min(len(target), 5)], BTN_TOUCH} if target else set()) | ({BTN_LEFT} if self.drag and self.pressed or self.tdrag in ("held", "locked", "relock") else set())
        for k in self.held - want:
            self.emit(EV_KEY, k, 0)
        for k in want - self.held:
            self.emit(EV_KEY, k, 1)
        self.held = want
        self.emit(EV_SYN, SYN_REPORT, 0)
        if click:
                self.emit(EV_KEY, click, 1); self.emit(EV_SYN, SYN_REPORT, 0)
                self.emit(EV_KEY, click, 0); self.emit(EV_SYN, SYN_REPORT, 0)

    def watchdog(self, now):
        """A button may never stay held without fingers moving: a held drag lets go after 3 s with no touchscreen event, a
        double-tap lock (no finger on the glass) after 5 s. Fingers still down are then ignored until all are lifted."""
        idle = now - self.last_ev
        if (self.drag or self.tdrag in ("held", "relock")) and idle > 3 or self.tdrag == "locked" and idle > 5:
            self.drag, self.tdrag = False, None
            self.frame({}, now)
            self.wait_clear = bool(self.slots)

    def pump(self, timeout):
        fds = [self.src] + ([self.gp.fd] if getattr(self, "gp", None) else [])
        r, _, _ = select.select(fds, [], [], timeout)
        if getattr(self, "gp", None) and self.gp.fd in r:
            self.gp.pump()
        if self.src in r:
            data = os.read(self.src, EVENT.size * 64)
            for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
                self.handle(data[i:i + EVENT.size])

    def close(self):
        try:   # let go of every finger and button first: a device removed with the button down leaves KDE holding it
            for sl in self.out:
                self.emit(EV_ABS, ABS_MT_SLOT, sl); self.emit(EV_ABS, ABS_MT_TRACKING_ID, -1)
            for k in self.held | {BTN_LEFT, BTN_RIGHT}:
                self.emit(EV_KEY, k, 0)
            self.emit(EV_SYN, SYN_REPORT, 0); time.sleep(0.1)
        except OSError:
            pass
        if getattr(self, "gp", None):
            self.gp.close(); self.gp = None
        for f, op in ((self.src, lambda: fcntl.ioctl(self.src, EVIOCGRAB, 0)), (self.ui, lambda: fcntl.ioctl(self.ui, UI_DEV_DESTROY))):
            try:
                op()
            except OSError:
                pass
            os.close(f)
        try:
            os.close(self.guard)   # the guardian finds the device gone and exits
        except (OSError, AttributeError):
            pass
        try:
            os.remove(REACHED)
        except OSError:
            pass
        log(f"touchpad off: touchscreen released (a touch reached the touchscreen while on: {'yes' if getattr(self, 'reached', False) else 'no'})")


def uinput_node(ui):
    """/dev/input/eventN of a uinput device, once udev has handled it (and put it on its seat)."""
    buf = bytearray(64)
    fcntl.ioctl(ui, (2 << 30) | (64 << 16) | (0x55 << 8) | 44, buf)   # UI_GET_SYSNAME
    sysn = buf.split(b"\0")[0].decode()
    node = None
    for _ in range(40):
        ev = glob.glob(f"/sys/devices/virtual/input/{sysn}/event*")
        if ev and os.path.exists("/dev/input/" + os.path.basename(ev[0])):
            node = "/dev/input/" + os.path.basename(ev[0]); break
        time.sleep(0.05)
    subprocess.run(["udevadm", "settle", "-t", "2"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return node


class GmPointer:
    """Game Mode: gamescope moves the pointer by libinput's raw, unaccelerated motion, so the touchpad was slower, coarser
    and laggier than on the desktop. Here the virtual touchpad sits on its own seat (gamescope does not see it) and the
    same libinput the desktop uses reads it in this process: its accelerated pointer motion, finger scrolling and buttons
    go to gamescope through a plain virtual mouse, so the pointer moves exactly as on the desktop. Nothing is recorded."""
    def __init__(self, node, name, tap=False):
        import ctypes, ctypes.util
        li = self.li = ctypes.CDLL(ctypes.util.find_library("input") or "libinput.so.10")
        OPEN = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_void_p)
        CLOSE = ctypes.CFUNCTYPE(None, ctypes.c_int, ctypes.c_void_p)
        class Iface(ctypes.Structure):
            _fields_ = [("open_restricted", OPEN), ("close_restricted", CLOSE)]
        def _open(path, flags, _):
            try: return os.open(path, flags)
            except OSError as e: return -e.errno
        self.iface = Iface(OPEN(_open), CLOSE(lambda fd, _: os.close(fd)))
        V, D, I, U = ctypes.c_void_p, ctypes.c_double, ctypes.c_int, ctypes.c_uint32
        for f, r, a in (("libinput_path_create_context", V, [V, V]), ("libinput_path_add_device", V, [V, ctypes.c_char_p]),
                        ("libinput_get_fd", I, [V]), ("libinput_dispatch", I, [V]), ("libinput_get_event", V, [V]),
                        ("libinput_event_get_type", I, [V]), ("libinput_event_destroy", None, [V]),
                        ("libinput_event_get_pointer_event", V, [V]), ("libinput_event_pointer_get_dx", D, [V]),
                        ("libinput_event_pointer_get_dy", D, [V]), ("libinput_event_pointer_get_dx_unaccelerated", D, [V]),
                        ("libinput_event_pointer_get_dy_unaccelerated", D, [V]), ("libinput_event_pointer_get_button", U, [V]),
                        ("libinput_event_pointer_get_button_state", I, [V]), ("libinput_event_pointer_has_axis", I, [V, I]),
                        ("libinput_event_pointer_get_scroll_value", D, [V, I]), ("libinput_device_config_tap_set_enabled", I, [V, I]),
                        ("libinput_unref", V, [V])):
            getattr(li, f).restype = r; getattr(li, f).argtypes = a
        self.ui = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        fcntl.ioctl(self.ui, UI_SET_EVBIT, EV_KEY); fcntl.ioctl(self.ui, UI_SET_EVBIT, EV_REL); fcntl.ioctl(self.ui, UI_SET_EVBIT, EV_SYN)
        for k in (BTN_LEFT, BTN_RIGHT):
            fcntl.ioctl(self.ui, UI_SET_KEYBIT, k)
        for r in (REL_X, REL_Y, REL_WHEEL, REL_HWHEEL, REL_WHEEL_HI_RES, REL_HWHEEL_HI_RES):
            fcntl.ioctl(self.ui, UI_SET_RELBIT, r)
        fcntl.ioctl(self.ui, UI_DEV_SETUP, struct.pack("4H80sI", 0x06, 0x1209, 0x7445, 1, (name + " pointer").encode()[:79], 0))
        fcntl.ioctl(self.ui, UI_DEV_CREATE)
        self.guard = guardian(self.ui)   # buttons let go even if this process dies
        self.ctx = li.libinput_path_create_context(ctypes.byref(self.iface), None)
        dev = li.libinput_path_add_device(self.ctx, node.encode()) if self.ctx else None
        if not dev:
            self.close(); raise OSError("libinput could not read the Game Mode touchpad")
        li.libinput_device_config_tap_set_enabled(dev, 1 if tap else 0)   # screen touchpad: taps are clicks already (Pad)
        self.fd, self.rx, self.ry, self.wv, self.wh, self.held = li.libinput_get_fd(self.ctx), 0.0, 0.0, 0, 0, set()

    def ev(self, t, c, v):
        os.write(self.ui, EVENT.pack(0, 0, t, c, v))

    def pump(self):
        li = self.li
        li.libinput_dispatch(self.ctx)
        out = False
        while True:
            e = li.libinput_get_event(self.ctx)
            if not e:
                break
            t = li.libinput_event_get_type(e)
            pe = li.libinput_event_get_pointer_event(e) if 400 <= t < 500 else None
            if t == 400:   # motion, accelerated: whole pixels out, the rest carried over (gamescope takes raw mouse counts
                # as pixels and ignores a mouse's DPI, so finer steps are not possible)
                # slow movement is slowed down for precision; gamescope only has whole pixels, so that felt like nothing
                # then a jump: never less than 0.22 x the raw motion, about 3/4 of what normal speed gives (libinput scales
                # touchpads by ~0.3; ponytail: fixed floor, a knob if asked)
                for ax, get, raw in (("rx", li.libinput_event_pointer_get_dx, li.libinput_event_pointer_get_dx_unaccelerated),
                                     ("ry", li.libinput_event_pointer_get_dy, li.libinput_event_pointer_get_dy_unaccelerated)):
                    v, r = get(pe), raw(pe) * 0.22
                    setattr(self, ax, getattr(self, ax) + (v if abs(v) >= abs(r) else r))
                dx, dy = int(self.rx), int(self.ry); self.rx -= dx; self.ry -= dy
                if dx: self.ev(EV_REL, REL_X, dx); out = True
                if dy: self.ev(EV_REL, REL_Y, dy); out = True
            elif t == 402:
                b, st = li.libinput_event_pointer_get_button(pe), li.libinput_event_pointer_get_button_state(pe)
                if b in (BTN_LEFT, BTN_RIGHT):
                    if out:   # motion so far in a report of its own
                        self.ev(EV_SYN, SYN_REPORT, 0)
                    self.ev(EV_KEY, b, st); self.ev(EV_SYN, SYN_REPORT, 0)   # press and release never share a report
                    (self.held.add if st else self.held.discard)(b); out = False
            elif t == 405:   # two-finger scroll: 15 libinput units = one wheel notch = 120 hi-res
                for axis, hi, lo, acc in ((0, REL_WHEEL_HI_RES, REL_WHEEL, "wv"), (1, REL_HWHEEL_HI_RES, REL_HWHEEL, "wh")):
                    if li.libinput_event_pointer_has_axis(pe, axis):
                        v = li.libinput_event_pointer_get_scroll_value(pe, axis) * 8
                        hv = int(-v if axis == 0 else v)
                        if hv:
                            self.ev(EV_REL, hi, hv); out = True
                            n = getattr(self, acc) + hv; whole = int(n / 120)
                            if whole: self.ev(EV_REL, lo, whole)
                            setattr(self, acc, n - whole * 120)
            li.libinput_event_destroy(e)
        if out:
            self.ev(EV_SYN, SYN_REPORT, 0)

    def close(self):
        try:
            for b in self.held:
                self.ev(EV_KEY, b, 0)
            self.ev(EV_SYN, SYN_REPORT, 0); time.sleep(0.1)
        except OSError:
            pass
        if getattr(self, "ctx", None):
            self.li.libinput_unref(self.ctx); self.ctx = None
        for f in ("ui", "guard"):
            try:
                os.close(getattr(self, f))
            except (OSError, AttributeError):
                pass


def mt_positions(fd, n):
    """Each slot's current position (EVIOCGMTSLOTS), so a touch at a slot's old spot is not lost after starting."""
    vals = []
    for code in (ABS_MT_POSITION_X, ABS_MT_POSITION_Y):
        buf = bytearray(struct.pack("I", code) + bytes(4 * n))
        try:
            fcntl.ioctl(fd, (2 << 30) | (len(buf) << 16) | (0x45 << 8) | 0x0A, buf)
        except OSError:
            return {}
        vals.append(struct.unpack(f"{n}i", buf[4:]))
    return {s: (vals[0][s], vals[1][s]) for s in range(n)}


def guardian(ui):
    """A small child process that shares the virtual touchpad. If the touchpad process dies in any way (even kill -9),
    it lets go of every finger and button while the device still exists, waits for the desktop to take that in, then
    exits. A device removed with its button down can leave KDE holding that press for good (2026-11-10)."""
    import signal
    r, w = os.pipe()
    if os.fork():
        os.close(r); return w   # the touchpad keeps the write end: when it dies (or closes it), the guardian reads end-of-file
    try:
        os.close(w)
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        signal.signal(signal.SIGTERM, lambda *_: None)   # a stop signal only wakes it: it still releases first
        signal.signal(signal.SIGHUP, lambda *_: None)
        while True:
            try:
                if not os.read(r, 1):
                    break
            except InterruptedError:
                pass
        ev = lambda t, c, v: os.write(ui, EVENT.pack(0, 0, t, c, v))
        for sl in range(16):
            ev(EV_ABS, ABS_MT_SLOT, sl); ev(EV_ABS, ABS_MT_TRACKING_ID, -1)
        for k in (BTN_LEFT, BTN_RIGHT, BTN_TOUCH, *TOOLS.values()):
            ev(EV_KEY, k, 0)
        ev(EV_SYN, SYN_REPORT, 0)
        time.sleep(0.5)
    except OSError:
        pass
    os._exit(0)


_gm = [0.0, False]


def game_mode():
    """gamescope running and no KDE desktop. Looked up at most every 10 s (a /proc scan each second cost ~0.5 % of a core)."""
    if time.monotonic() - _gm[0] < 10:
        return _gm[1]
    comms = set()
    for c in glob.glob("/proc/[0-9]*/comm"):
        try:
            comms.add(open(c).read().strip())
        except OSError:
            pass
    _gm[:] = time.monotonic(), any(c.startswith("gamescope") for c in comms) and "kwin_wayland" not in comms
    return _gm[1]


def picture_art(w, h):
    """The touchpad picture as w*h grey bytes: the drawing for that size (turned for a portrait panel), else the closest
    one centred on black. ponytail: two drawn sizes; other panels get the nearer one cropped/padded, draw more if needed."""
    import gzip
    sizes = [(1920, 1200), (1920, 1080)]
    port = h > w
    lw, lh = (h, w) if port else (w, h)
    aw, ah = min(sizes, key=lambda z: abs(z[0] / z[1] - lw / lh))
    g = gzip.open(ART % (aw, ah)).read()
    if (aw, ah) != (lw, lh):   # centre on a black canvas of the panel's size
        out = bytearray(lw * lh); ox, oy = (lw - aw) // 2, (lh - ah) // 2
        for y in range(max(0, -oy), min(ah, lh - oy)):
            x0 = max(0, -ox); x1 = min(aw, lw - ox)
            out[(y + oy) * lw + x0 + ox:(y + oy) * lw + x1 + ox] = g[y * aw + x0:y * aw + x1]
        g = bytes(out)
    if port:   # ponytail: portrait panels turned 90° clockwise (Steam Deck / Legion Go 1 style); add the panel's own orientation if one shows upside down
        g = b"".join(g[r::lw][::-1] for r in range(lw))
    return g


def picture_on():
    """Light the handheld panel with the touchpad picture through its framebuffer. Only works while nothing else drives
    that graphics chip (Game Mode with gamescope on another card); otherwise it is undone at once."""
    for c in glob.glob("/sys/class/drm/card*-eDP-*"):
        dev = os.path.realpath(c.rsplit("-eDP-", 1)[0] + "/device")
        fb = next((f for f in glob.glob("/sys/class/graphics/fb[0-9]*") if os.path.realpath(f + "/device") == dev), None)
        if not fb:
            continue
        try:
            w, h = map(int, open(fb + "/virtual_size").read().split(","))
            stride = int(open(fb + "/stride").read()) if os.path.exists(fb + "/stride") else w * 4
            if int(open(fb + "/bits_per_pixel").read()) != 32:
                continue
            g = picture_art(w, h)
            px = bytearray(len(g) * 4); px[0::4] = g; px[1::4] = g; px[2::4] = g
            bl = {b: open(b + "/brightness").read().strip() for b in glob.glob("/sys/class/backlight/*")
                  if os.path.realpath(b).startswith(dev)} or {b: open(b + "/brightness").read().strip() for b in glob.glob("/sys/class/backlight/*")}
            json.dump({"fb": fb, "bl": bl}, open(PIC, "w"))
            with open("/dev/" + os.path.basename(fb), "r+b") as f:
                for y in range(h):
                    f.seek(y * stride); f.write(px[y * w * 4:(y + 1) * w * 4])
            for b in bl:
                mx = int(open(b + "/max_brightness").read())
                open(b + "/brightness", "w").write(str(max(1, mx * 3 // 100)))
            open(fb + "/blank", "w").write("0")
            time.sleep(0.5)
            if open(c + "/dpms").read().strip() != "On":
                log("touchpad picture: the handheld screen is in use, not shown"); picture_off(); return False
            log("touchpad picture on")
            return True
        except (OSError, ValueError) as e:
            log("touchpad picture: could not show it:", e); picture_off(); return False
    return False


def picture_off():
    try:
        d = json.load(open(PIC))
    except (OSError, ValueError):
        return
    for b, v in d.get("bl", {}).items():
        try:
            open(b + "/brightness", "w").write(v)
        except OSError:
            pass
    try:
        open(d["fb"] + "/blank", "w").write("4")
    except (OSError, KeyError):
        pass
    try:
        os.remove(PIC)
    except OSError:
        pass
    log("touchpad picture off")


def seat_rule():
    """The Game Mode touchpads on a seat of their own: gamescope and KDE read seat0 only, GmPointer reads them."""
    try:
        os.makedirs(os.path.dirname(SEAT_RULE), exist_ok=True)
        open(SEAT_RULE, "w").write(f'SUBSYSTEM=="input", ATTRS{{name}}=="*{GM_SUFFIX}", ENV{{ID_SEAT}}="seat-egpu-touchpad"\n')
        subprocess.run(["udevadm", "control", "--reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as e:
        log("could not add the Game Mode seat rule:", e)


def run():
    import signal
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda *_: sys.exit(0))   # stop (systemd, timeout, hangup) runs close() below
    seat_rule()
    pad, tried = None, False
    picture_off()   # left from a stop that could not clean up
    try:
        while True:
            dark, other = screen_state()
            active = dark and other
            want = bool(active and settings().get("keep_screen") and game_mode())
            if want and not os.path.exists(PIC) and not tried:
                tried = True; picture_on()   # once per touchpad session: no retry loop if the screen is in use
            elif not want and os.path.exists(PIC):
                picture_off()
            if not active:
                tried = False
            if active and pad is None:
                src, name = touchscreen()
                if src:
                    try:
                        pad = Pad(src, name)
                    except OSError as e:
                        log("could not take the touchscreen:", e); time.sleep(5)
            elif pad is not None and (not active or pad.gm != game_mode()):   # off, or Game Mode <-> desktop
                pad.close(); pad = None
            if pad:
                deadline = time.monotonic() + 1
                while time.monotonic() < deadline:
                    try:
                        pad.pump(0.2); pad.watchdog(time.monotonic())
                    except OSError:   # the touchscreen went away (suspend, unplug): release and look again
                        pad.close(); pad = None; break
            else:
                time.sleep(1)
    finally:
        if pad:
            pad.close()
        picture_off()


LEGION_NAME = "EGPU Buddy Legion Go 2 controller touchpad"


def legion_hidraw():
    """The Legion Go 2 controller's input interface (hid-lenovo-go, 17EF:61EB-61EE, interface 2), or None."""
    for h in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            u = open(h + "/device/uevent").read()
        except OSError:
            continue
        if re_go2(u) and ":1.2/" in os.path.realpath(h + "/device"):
            return "/dev/" + os.path.basename(h)
    return None


def re_go2(uevent):
    return any(f"17EF:0000{p}" in uevent for p in ("61EB", "61EC", "61ED", "61EE")) and "hid-lenovo-go" in uevent


class LegionPad:
    """Game Mode only (opt-in, Legion Go 2): the controller's right touchpad as a real touchpad. Steam receives it but
    moves no pointer in Game Mode (it works on the desktop), so its position is read from the controller's own input
    reports (shared read, InputPlumber and Steam keep theirs) and put on a virtual touchpad that the desktop's libinput
    turns into pointer, tap-to-click and scrolling, through GmPointer. Positions are never stored or logged."""
    def __init__(self, hid):
        self.hid = os.open(hid, os.O_RDONLY | os.O_NONBLOCK)
        self.ui = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        fcntl.ioctl(self.ui, UI_SET_EVBIT, EV_KEY); fcntl.ioctl(self.ui, UI_SET_EVBIT, EV_ABS); fcntl.ioctl(self.ui, UI_SET_EVBIT, EV_SYN)
        for k in (BTN_LEFT, BTN_RIGHT, BTN_TOUCH, BTN_TOOL_FINGER):   # both buttons: libinput takes it for a touchpad, not a clickpad
            fcntl.ioctl(self.ui, UI_SET_KEYBIT, k)
        fcntl.ioctl(self.ui, UI_SET_PROPBIT, INPUT_PROP_POINTER)
        for code in (ABS_X, ABS_Y):   # 0-1024 at 36 units per mm (the controller's own touchpad device)
            fcntl.ioctl(self.ui, UI_SET_ABSBIT, code)
            fcntl.ioctl(self.ui, UI_ABS_SETUP, struct.pack("Hxx6i", code, 0, 0, 1024, 0, 0, 36))
        fcntl.ioctl(self.ui, UI_DEV_SETUP, struct.pack("4H80sI", 0x06, 0x1209, 0x7446, 1, (LEGION_NAME + GM_SUFFIX).encode(), 0))
        fcntl.ioctl(self.ui, UI_DEV_CREATE)
        self.guard = guardian(self.ui)
        self.down, self.last = False, None
        try:
            self.gp = GmPointer(uinput_node(self.ui), LEGION_NAME, tap=True)
        except OSError:
            self.close(); raise

    def ev(self, t, c, v):
        os.write(self.ui, EVENT.pack(0, 0, t, c, v))

    def report(self, d):
        if len(d) < 30 or d[:3] != b"\x04\x3c\x74":
            return
        x, y = int.from_bytes(d[26:28], "big"), int.from_bytes(d[28:30], "big")
        touching = x != 0 and y != 0 and max(x, y) <= 1024
        if touching:
            if (x, y) == self.last and self.down:
                return
            if not self.down:
                self.ev(EV_KEY, BTN_TOUCH, 1); self.ev(EV_KEY, BTN_TOOL_FINGER, 1); self.down = True
            self.ev(EV_ABS, ABS_X, x); self.ev(EV_ABS, ABS_Y, y); self.last = (x, y)
        elif self.down:
            self.ev(EV_KEY, BTN_TOUCH, 0); self.ev(EV_KEY, BTN_TOOL_FINGER, 0); self.down, self.last = False, None
        else:
            return
        self.ev(EV_SYN, SYN_REPORT, 0)

    def pump(self, timeout):
        r, _, _ = select.select([self.hid, self.gp.fd], [], [], timeout)
        if self.gp.fd in r:
            self.gp.pump()
        if self.hid in r:
            while True:
                try:
                    d = os.read(self.hid, 64)
                except BlockingIOError:
                    break
                if not d:
                    raise OSError("controller gone")
                self.report(d)

    def close(self):
        try:
            if self.down:
                self.ev(EV_KEY, BTN_TOUCH, 0); self.ev(EV_KEY, BTN_TOOL_FINGER, 0); self.ev(EV_SYN, SYN_REPORT, 0)
        except OSError:
            pass
        if getattr(self, "gp", None):
            self.gp.close(); self.gp = None
        for f, op in ((self.ui, lambda: fcntl.ioctl(self.ui, UI_DEV_DESTROY)),):
            try:
                op()
            except OSError:
                pass
            os.close(f)
        for f in ("hid", "guard"):
            try:
                os.close(getattr(self, f))
            except (OSError, AttributeError):
                pass
        log("Legion controller touchpad: off")


def legion():
    import signal
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda *_: sys.exit(0))
    seat_rule()
    pad = None
    try:
        while True:
            hid = legion_hidraw() if game_mode() else None
            if hid and pad is None:
                try:
                    pad = LegionPad(hid); log("Legion controller touchpad: on (Game Mode)")
                except OSError as e:
                    log("Legion controller touchpad: could not start:", e); time.sleep(10)
            elif not hid and pad is not None:
                pad.close(); pad = None
            if pad:
                end = time.monotonic() + 2
                try:
                    while time.monotonic() < end:
                        pad.pump(0.5)
                except OSError:
                    pad.close(); pad = None
            else:
                time.sleep(2)
    finally:
        if pad:
            pad.close()


def selftest():
    t = Tap(1000)
    t.down(0, 10, 10, 0.0); t.fingers(1); assert t.up_all(0.1) == BTN_LEFT
    t.down(0, 10, 10, 0.0); t.down(1, 50, 50, 0.01); t.fingers(2); assert t.up_all(0.15) == BTN_RIGHT
    t.down(0, 10, 10, 0.0); t.fingers(1); assert t.up_all(0.5) is None              # held: no click
    t.down(0, 10, 10, 0.0); t.move(0, 300, 10); t.fingers(1); assert t.up_all(0.1) is None   # moved: no click
    t.down(0, 0, 0, 0.0); t.fingers(3); assert t.up_all(0.1) is None                # three fingers: libinput's gesture
    logged = []
    globals()["log"] = lambda *a: logged.append(a)   # nothing about touches may reach the log
    class Fake(Pad):   # frame() without hardware: record what the virtual touchpad would get
        def __init__(self):
            self.out, self.held, self.drag, self.wait_clear, self.drag_tid, self.tap, self.log, self.peak = {}, set(), False, False, 60000, Tap(1000), [], 0
            self.pressed, self.drag_t0 = False, 0.0
            self.size, self.swipe, self.cuts = (1000, 1000), None, []
            self.on_desktop = True; self.last_ev = 0.0; self.lastpos = {}; self.upmm = (10, 10)
            self.lim, self.three, self.invert, self.tdrag, self.last_tap, self.anchor = (0, 1000, 0, 1000), True, False, None, -1.0, None
        def emit(self, t, c, v):
            self.log.append((t, c, v))
            st = self.__dict__.setdefault("mt", {"slot": 0, "live": {}, "bugs": []})
            if t == EV_ABS and c == ABS_MT_SLOT:
                st["slot"] = v
            elif t == EV_ABS and c == ABS_MT_TRACKING_ID:
                if v >= 0 and st["slot"] in st["live"]:
                    st["bugs"].append(("new tracking id over a live one", st["slot"], v))
                if v < 0: st["live"].pop(st["slot"], None)
                else: st["live"][st["slot"]] = v
        def gamemode(self):
            return not self.on_desktop
        def kde(self, *call, delay=0, **kw):
            self.cuts.append(call[-1])
        def desktop(self):
            return self.on_desktop
    f = Fake()
    f.frame({0: (100, 100, 5)}, 0.0); f.frame({}, 0.05)
    assert (EV_KEY, BTN_LEFT, 1) in f.log, "one-finger tap clicks"
    f.log.clear()
    pts = {0: (100, 100, 6), 1: (200, 100, 7), 2: (300, 100, 8)}
    f.frame(pts, 1.0); assert f.drag and (EV_KEY, BTN_LEFT, 1) not in f.log, "the pointer follows at once, the click waits"
    f.frame(pts, 1.07)
    assert (EV_KEY, BTN_LEFT, 1) in f.log and f.drag and list(f.out) == [0] and f.out[0][1:] == (200, 100), "three fingers press at their middle"
    f.frame({s: (x + 50, y + 20, t) for s, (x, y, t) in pts.items()}, 1.2)
    assert f.out[0][1:] == (250, 120) and (EV_KEY, BTN_LEFT, 0) not in f.log, "moving drags with the button held"
    f.frame({0: (150, 120, 6), 1: (250, 120, 7)}, 1.25)
    assert f.drag and BTN_LEFT in f.held, "one finger leaving early does not drop"
    f.frame({0: (150, 120, 6)}, 1.3)
    assert (EV_KEY, BTN_LEFT, 0) in f.log and not f.drag and f.out == {}, "lifting drops; the last finger moves nothing"
    f.frame({}, 1.4); assert not f.wait_clear
    four = lambda dx, dy: {s: (100 * s + 300 + dx, 500 + dy, 20 + s) for s in range(4)}
    f.log.clear(); f.frame({s: p for s, p in four(0, 0).items() if s < 3}, 2.0)   # lands as three first
    f.frame(four(0, 0), 2.03)
    assert (EV_KEY, BTN_LEFT, 1) not in f.log, "a late 4th finger: no click"
    assert not f.drag and f.out == {} and f.swipe, "four fingers: a swipe, not a drag, nothing forwarded"
    f.frame(four(0, -200), 2.1); f.frame(four(0, -300), 2.15)
    assert f.cuts == ["Expose"], "swipe up shows the window previews once"
    f.frame({s: p for s, p in four(0, -300).items() if s < 3}, 2.2)
    assert not f.drag, "a four-finger swipe losing a finger does not start a drag"
    f.frame({}, 2.3); f.cuts.clear()
    f.frame(four(0, 0), 3.0); f.frame(four(-200, 0), 3.1); assert f.cuts == [], "a short sideways swipe does nothing"
    f.frame(four(-350, 0), 3.2); assert f.cuts == ["Switch One Desktop to the Right"], "a long swipe left: next desktop"
    f.frame({}, 3.3); f.cuts.clear()
    f.frame(four(0, 0), 4.0); f.frame(four(400, 10), 4.1); f.frame({}, 4.2)
    assert f.cuts == ["Switch One Desktop to the Left"], "a long swipe right: previous desktop"
    five = lambda rad: {s: (500 + round(rad * math.cos(s * 1.2566)), 500 + round(rad * math.sin(s * 1.2566)), 30 + s) for s in range(5)}
    f.cuts.clear(); f.frame({s: p for s, p in five(100).items() if s < 4}, 5.0); f.frame(five(100), 5.02)
    f.frame(five(115), 5.1); assert f.cuts == [], "a small spread does nothing"
    f.frame(five(120), 5.2); f.frame(five(200), 5.3); f.frame({}, 5.4)
    assert f.cuts == ["true"] and not f.drag, "five fingers spread out: show the desktop, once"
    f.cuts.clear(); f.frame(five(200), 6.0); f.frame(five(120), 6.1); f.frame({}, 6.2)
    assert f.cuts == ["false"], "five fingers pinched in: windows back"
    f.on_desktop = False; f.cuts.clear(); f.frame(four(0, 0), 6.5); f.frame(four(0, -300), 6.6); f.frame({}, 6.7)
    assert f.cuts == [] and f.out == {}, "Game Mode: four fingers do nothing"
    f.on_desktop = True
    # double tap to drag, with three-finger drag off
    f.three, f.held = False, set()
    f.frame({0: (100, 100, 40)}, 7.0); f.frame({}, 7.05)                     # tap: a click
    f.frame({0: (100, 100, 41)}, 7.15); f.frame({0: (100, 100, 41)}, 7.4)   # touch again and hold
    assert f.tdrag == "held" and BTN_LEFT in f.held, "double tap and hold: button held"
    f.frame({0: (300, 100, 41)}, 7.5); f.frame({}, 7.6)
    assert f.tdrag == "locked" and BTN_LEFT in f.held, "lifting keeps it held (locked)"
    f.frame({0: (300, 100, 42)}, 8.0); f.frame({0: (400, 100, 42)}, 8.3); f.frame({}, 8.4)
    assert f.tdrag == "locked" and BTN_LEFT in f.held, "moving again keeps dragging"
    f.log.clear(); f.frame({0: (400, 100, 43)}, 9.0); f.frame({}, 9.05)
    assert f.tdrag is None and BTN_LEFT not in f.held and (EV_KEY, BTN_LEFT, 1) not in f.log, "a tap lets go, no extra click"
    f.frame({0: (100, 100, 44)}, 10.0); f.frame({}, 10.05); f.log.clear(); f.frame({0: (100, 100, 45)}, 10.15); f.frame({}, 10.2)
    assert f.tdrag is None and f.log.count((EV_KEY, BTN_LEFT, 1)) == 1, "a quick double tap is a double click"
    f.frame(pts, 11.0); f.frame(pts, 11.2); assert not f.drag, "three-finger drag off"
    f.frame({}, 11.3)
    # inverted scroll: two fingers mirrored through where they landed, distance kept
    f.invert = True; f.frame({0: (400, 400, 50), 1: (600, 400, 51)}, 12.0); f.frame({0: (400, 300, 50), 1: (600, 300, 51)}, 12.1)
    assert f.out[0][1:] == (400, 500) and f.out[1][1:] == (600, 500) and f.out[0][0] != 50, "two fingers up scroll the other way"
    f.frame({}, 12.2)
    f.three, f.invert, f.rot, f.xr, f.yr, f.slot = True, False, 0, (0, 1000), (0, 1000), 0
    f.frame({}, 20.0); f.slots = {i: [100 * i + 100, 100, 70 + i] for i in range(3)}
    f.frame({i: (100 * i + 100, 100, 70 + i) for i in range(3)}, 20.1); f.frame({i: (100 * i + 100, 100, 70 + i) for i in range(3)}, 20.2); assert f.drag
    f.handle(EVENT.pack(0, 0, EV_KEY, BTN_TOUCH, 0)); f.handle(EVENT.pack(0, 0, EV_SYN, SYN_REPORT, 0))
    assert not f.drag and BTN_LEFT not in f.held, "nothing touching ends a drag even if a lift was lost"
    f.slots = {i: [100, 100, 80 + i] for i in range(3)}; f.frame({i: (100, 100, 80 + i) for i in range(3)}, 21.0); f.frame({i: (100, 100, 80 + i) for i in range(3)}, 21.1)
    f.handle(EVENT.pack(0, 0, EV_SYN, SYN_DROPPED, 0)); assert not f.drag and BTN_LEFT not in f.held, "lost events end a drag"
    f.slots = {i: [100, 100, 90 + i] for i in range(3)}; f.wait_clear = False; f.tdrag = None
    f.frame({i: (100, 100, 90 + i) for i in range(3)}, 30.0); f.frame({i: (100, 100, 90 + i) for i in range(3)}, 30.1); assert f.drag
    f.last_ev = 30.1; f.watchdog(32.0); assert f.drag, "a short still moment keeps the drag"
    f.watchdog(33.5); assert not f.drag and BTN_LEFT not in f.held and f.wait_clear, "watchdog: a still drag lets go"
    f.frame({i: (150, 100, 90 + i) for i in range(3)}, 33.6); assert not f.drag and BTN_LEFT not in f.held, "fingers still down stay ignored"
    f.slots = {}; f.frame({}, 33.7); assert not f.wait_clear
    f.three = False; f.tdrag = "locked"; f.held = {BTN_LEFT}; f.last_ev = 40.0; f.watchdog(46.0)
    assert f.tdrag is None and BTN_LEFT not in f.held, "watchdog: a forgotten double-tap lock lets go"
    f.three = True
    g = Fake(); g.frame({0: (100, 100, 200)}, 50.0); g.frame({0: (101, 100, 200), 1: (200, 100, 201)}, 50.01)
    g.frame({0: (102, 100, 200), 1: (201, 100, 201), 2: (300, 100, 202)}, 50.02)   # a real hand: 1, 2, then 3 fingers
    g.frame({0: (102, 100, 200), 1: (201, 100, 201), 2: (300, 100, 202)}, 50.1)
    assert g.drag and BTN_LEFT in g.held and not g.mt["bugs"], f"drag start ends old touches first: {g.mt['bugs'][:3]}"
    g.frame({}, 50.1)
    # device-compatibility flag: yes/no only, dated to when the touchpad came on, never to the touch, nothing logged
    import tempfile
    globals()["REACHED"] = os.path.join(tempfile.mkdtemp(), "reached")
    fr = Fake(); fr.reached, fr.t_on, fr.slot, fr.slots = False, 1000.0, 0, {}
    fr.handle(EVENT.pack(0, 0, EV_ABS, ABS_MT_TRACKING_ID, 5))
    assert fr.reached and open(REACHED).read() == "yes\n" and os.stat(REACHED).st_mtime == 1000.0, "touch-reached flag"
    os.remove(REACHED); os.rmdir(os.path.dirname(REACHED))
    assert not logged, f"finger activity reached the log: {logged}"
    assert not f.mt["bugs"], f"multi-touch protocol bug: {f.mt['bugs'][:3]}"
    assert rotate(0, 0, 90, (0, 1000), (0, 2000)) == (0, 1000) and rotate(1000, 2000, 90, (0, 1000), (0, 2000)) == (2000, 0)
    assert rotate(5, 7, 0, (0, 9), (0, 9)) == (5, 7) and rotate(0, 0, 180, (0, 9), (0, 9)) == (9, 9)
    print("selftest ok")


if __name__ == "__main__":
    selftest() if sys.argv[1:] == ["selftest"] else legion() if sys.argv[1:] == ["legion"] else run()
