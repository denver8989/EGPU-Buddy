#!/usr/bin/env python3
"""egpu-touchpad - the handheld's touchscreen as a full touchpad while its screen is off (opt-in, Extras).

While the built-in screen is dark because another screen is in use (XR glasses, a monitor or a TV; with or without an
eGPU), the touchscreen is taken exclusively (EVIOCGRAB) and every finger is passed on to a virtual multi-touch touchpad
(uinput). libinput - KDE and Game Mode's gamescope both use it - then gives the whole touchpad: pointer, two-finger
scroll, pinch, three/four-finger gestures. Taps are turned into clicks here (one finger: left, two: right), because
libinput leaves tap-to-click off by default. Three fingers drag (press, move, lift to drop: windows, files). Four
fingers are handled here as KDE shortcuts: swipe up or down toggles the Overview, a long swipe left or right switches
desktop. Five fingers spread out show the desktop, pinched in bring the windows back. When the built-in screen comes back on, the touchscreen is released at once.

  egpu-touchpad            run (systemd: egpu-touchpad.service; started by the option, stopped when it is turned off)
  egpu-touchpad selftest   the tap and rotation rules without hardware

Settings: /var/lib/nvegpu/touchpad.json {"rotate": 0|90|180|270, "speed": 2.0}. speed: pointer speed (1 = the true size).
rotate: for a touchscreen mounted rotated relative to how the screen is used (default: 0, or 90 when the digitizer is
portrait and the screen landscape).
"""
import fcntl, glob, json, math, os, select, struct, subprocess, sys, time

EV_SYN, EV_KEY, EV_ABS = 0, 1, 3
SYN_REPORT = 0
ABS_X, ABS_Y, ABS_MT_SLOT, ABS_MT_POSITION_X, ABS_MT_POSITION_Y, ABS_MT_TRACKING_ID = 0, 1, 0x2F, 0x35, 0x36, 0x39
BTN_LEFT, BTN_RIGHT, BTN_TOUCH = 0x110, 0x111, 0x14A
BTN_TOOL_FINGER, BTN_TOOL_QUINTTAP, BTN_TOOL_DOUBLETAP, BTN_TOOL_TRIPLETAP, BTN_TOOL_QUADTAP = 0x145, 0x148, 0x14D, 0x14E, 0x14F
TOOLS = {1: BTN_TOOL_FINGER, 2: BTN_TOOL_DOUBLETAP, 3: BTN_TOOL_TRIPLETAP, 4: BTN_TOOL_QUADTAP, 5: BTN_TOOL_QUINTTAP}
INPUT_PROP_POINTER, INPUT_PROP_DIRECT = 0, 1
EVIOCGRAB = 0x40044590
UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_ABSBIT, UI_SET_PROPBIT = 0x40045564, 0x40045565, 0x40045567, 0x4004556E
UI_DEV_SETUP, UI_ABS_SETUP, UI_DEV_CREATE, UI_DEV_DESTROY = 0x405C5503, 0x401C5504, 0x5501, 0x5502
EVENT = struct.Struct("llHHi")   # struct input_event on 64-bit
ON = "/var/lib/nvegpu/touchpad.json"
TAP_MS, TAP_MOVE = 220, 0.03       # a tap: shorter than this, moving less than this share of the touchpad


def log(*a):
    print("egpu-touchpad:", *a, flush=True)


def settings():
    try:
        return json.load(open(ON))
    except (OSError, ValueError):
        return {}


def absinfo(fd, code):
    buf = bytearray(24)
    fcntl.ioctl(fd, 0x80184540 + code, buf)   # EVIOCGABS(code)
    return list(struct.unpack("6i", buf))      # value, min, max, fuzz, flat, resolution


def touchscreen():
    """The handheld's own touchscreen: a direct-touch multi-touch device (never an XR glasses' IMU or a controller)."""
    for ev in sorted(glob.glob("/sys/class/input/event*")):
        try:
            prop = int(open(ev + "/device/properties").read().split()[-1], 16)
            absbits = int("".join(open(ev + "/device/capabilities/abs").read().split()), 16)
        except (OSError, ValueError):
            continue
        if prop & (1 << INPUT_PROP_DIRECT) and absbits & (1 << ABS_MT_POSITION_X) and absbits & (1 << ABS_MT_SLOT):
            return "/dev/input/" + os.path.basename(ev), open(ev + "/device/name").read().strip()
    return None, ""


def panel_size_mm():
    for e in glob.glob("/sys/class/drm/card*-eDP-*/edid"):
        try:
            b = open(e, "rb").read()
            if len(b) >= 23 and b[21] and b[22]:
                return b[21] * 10, b[22] * 10
        except OSError:
            pass
    return None


def screen_state():
    """(built-in screen dark, another screen showing a picture) from the kernel's own view: no compositor needed."""
    dark, other = True, False
    for c in glob.glob("/sys/class/drm/card*-*"):
        conn = os.path.basename(c).split("-", 1)[1]
        rd = lambda f: open(f"{c}/{f}").read().strip() if os.path.exists(f"{c}/{f}") else ""
        if conn.startswith("Writeback") or rd("status") != "connected":
            continue
        lit = rd("enabled") == "enabled" and rd("dpms") == "On"
        if conn.startswith("eDP"):
            bl = [open(p).read().strip() for p in glob.glob("/sys/class/backlight/*/bl_power")]
            dark = not lit or (bool(bl) and all(v != "0" for v in bl))
        elif lit:
            other = True
    return dark, other


def rotation(info_x, info_y):
    r = settings().get("rotate")
    if r in (0, 90, 180, 270):
        return r
    portrait_digitizer = (info_y[2] - info_y[1]) > (info_x[2] - info_x[1])
    return 90 if portrait_digitizer else 0


def rotate(x, y, rot, xr, yr):
    """Digitizer (x, y) -> touchpad (x, y); xr / yr: (min, max) of the digitizer's axes."""
    if rot == 90:
        return y, xr[1] - (x - xr[0])
    if rot == 180:
        return xr[1] - (x - xr[0]), yr[1] - (y - yr[0])
    if rot == 270:
        return yr[1] - (y - yr[0]), x
    return x, y


class Tap:
    """One left click for a short one-finger tap, a right click for a short two-finger tap."""
    def __init__(self, span):
        self.span = span; self.reset()

    def reset(self):
        self.t0, self.most, self.start, self.moved = None, 0, {}, 0.0

    def down(self, slot, x, y, t):
        if self.t0 is None:
            self.t0 = t
        self.start.setdefault(slot, (x, y))

    def move(self, slot, x, y):
        if slot in self.start:
            sx, sy = self.start[slot]
            self.moved = max(self.moved, max(abs(x - sx), abs(y - sy)) / self.span)

    def fingers(self, n):
        self.most = max(self.most, n)

    def up_all(self, t):
        click = None
        if self.t0 is not None and (t - self.t0) * 1000 <= TAP_MS and self.moved <= TAP_MOVE:
            click = {1: BTN_LEFT, 2: BTN_RIGHT}.get(self.most)
        self.reset()
        return click


class Pad:
    def __init__(self, src, name):
        self.src = os.open(src, os.O_RDONLY | os.O_NONBLOCK)
        ix, iy = absinfo(self.src, ABS_MT_POSITION_X), absinfo(self.src, ABS_MT_POSITION_Y)
        islot, itrack = absinfo(self.src, ABS_MT_SLOT), absinfo(self.src, ABS_MT_TRACKING_ID)
        self.rot = rotation(ix, iy)
        self.xr, self.yr = (ix[1], ix[2]), (iy[1], iy[2])
        ox, oy = (iy, ix) if self.rot in (90, 270) else (ix, iy)
        mm = panel_size_mm()
        if mm and not ox[5]:   # units per millimetre: libinput's gesture and scroll thresholds are in mm
            w, h = (mm[1], mm[0]) if self.rot in (90, 270) else mm
            ox[5], oy[5] = max(1, round((ox[2] - ox[1]) / max(w, 1))), max(1, round((oy[2] - oy[1]) / max(h, 1)))
        # speed: report fewer units per mm, so libinput sees a bigger pad and moves the pointer further per finger mm
        sp = settings().get("speed", 2.0)
        sp = sp if isinstance(sp, (int, float)) and 0.25 <= sp <= 8 else 2.0
        ox[5], oy[5] = max(1, round(ox[5] / sp)), max(1, round(oy[5] / sp))
        self.ui = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        fcntl.ioctl(self.ui, UI_SET_EVBIT, EV_KEY); fcntl.ioctl(self.ui, UI_SET_EVBIT, EV_ABS); fcntl.ioctl(self.ui, UI_SET_EVBIT, EV_SYN)
        for k in (BTN_LEFT, BTN_RIGHT, BTN_TOUCH, *TOOLS.values()):
            fcntl.ioctl(self.ui, UI_SET_KEYBIT, k)
        fcntl.ioctl(self.ui, UI_SET_PROPBIT, INPUT_PROP_POINTER)
        for code, info in ((ABS_X, ox), (ABS_Y, oy), (ABS_MT_POSITION_X, ox), (ABS_MT_POSITION_Y, oy), (ABS_MT_SLOT, islot), (ABS_MT_TRACKING_ID, itrack)):
            fcntl.ioctl(self.ui, UI_SET_ABSBIT, code)
            fcntl.ioctl(self.ui, UI_ABS_SETUP, struct.pack("Hxx6i", code, 0, *info[1:]))   # struct uinput_abs_setup
        fcntl.ioctl(self.ui, UI_DEV_SETUP, struct.pack("4H80sI", 0x06, 0x1209, 0x7444, 1, b"EGPU Buddy touchpad (handheld screen)", 0))
        fcntl.ioctl(self.ui, UI_DEV_CREATE)
        fcntl.ioctl(self.src, EVIOCGRAB, 1)
        self.slot, self.slots, self.held, self.out = 0, {}, set(), {}
        self.drag, self.wait_clear, self.drag_tid, self.peak = False, False, 60000, 0
        self.tap = Tap(max(ox[2] - ox[1], oy[2] - oy[1], 1))
        self.size, self.swipe, self.t3 = (max(ox[2] - ox[1], 1), max(oy[2] - oy[1], 1)), None, None
        log(f"touchpad on: {name} (rotation {self.rot})")

    def emit(self, t, c, v):
        os.write(self.ui, EVENT.pack(0, 0, t, c, v))

    def kde(self, *call):
        """A D-Bus call in the logged-in user's KDE session (no-op outside the KDE desktop)."""
        log("gesture:", call[-1])
        for bus in sorted(glob.glob("/run/user/*/bus")):
            uid = os.stat(bus).st_uid
            if uid >= 1000:
                subprocess.Popen(["setpriv", f"--reuid={uid}", f"--regid={uid}", "--init-groups", "env",
                                  f"DBUS_SESSION_BUS_ADDRESS=unix:path={bus}", "busctl", "--user", "call", *call],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return

    def shortcut(self, name):
        self.kde("org.kde.kglobalaccel", "/component/kwin", "org.kde.kglobalaccel.Component", "invokeShortcut", "s", name)

    def show_desktop(self, on):
        self.kde("org.kde.KWin", "/KWin", "org.kde.KWin", "showDesktop", "b", "true" if on else "false")

    def handle(self, ev):
        """Collect one frame of the touchscreen (multi-touch protocol B), then send it on as one touchpad frame."""
        _, _, t, c, v = EVENT.unpack(ev)
        if t == EV_ABS:
            if c == ABS_MT_SLOT:
                self.slot = v
            elif c == ABS_MT_TRACKING_ID:
                if v < 0:
                    self.slots.pop(self.slot, None)
                else:
                    self.slots[self.slot] = [None, None, v]
            elif c in (ABS_MT_POSITION_X, ABS_MT_POSITION_Y):
                self.slots.setdefault(self.slot, [None, None, self.slot])[0 if c == ABS_MT_POSITION_X else 1] = v
        elif t == EV_SYN and c == SYN_REPORT:
            pts = {s: rotate(p[0], p[1], self.rot, self.xr, self.yr) + (p[2],) for s, p in self.slots.items() if None not in p[:2]}
            self.frame(pts, time.monotonic())
        # the touchscreen's own keys and single-touch axes: rebuilt from the fingers in frame()

    def frame(self, pts, now):
        n = len(pts)
        self.peak = max(self.peak, n) if n else 0   # most fingers since all were lifted
        cx, cy = (sum(p[0] for p in pts.values()) // n, sum(p[1] for p in pts.values()) // n) if n else (0, 0)
        # four-finger swipe: up/down toggles the Overview, a long left/right swipe switches desktop (once per swipe)
        # five fingers: spread out shows the desktop, pinched in brings the windows back (once per gesture)
        if n in (4, 5) and self.peak == n and not self.swipe and not self.drag and not self.wait_clear:
            self.swipe = [cx, cy, False, None]; self.tap.reset()   # [start x, start y, fired, five-finger spread]
        if self.swipe and n == 0:
            self.swipe = None
        spread = sum(math.hypot(p[0] - cx, p[1] - cy) for p in pts.values()) / n if n else 0
        if self.swipe and n == 5 and self.swipe[3] is None:
            self.swipe[3] = max(spread, 1)
        if self.swipe and n == 5 and not self.swipe[2]:
            if spread >= 1.4 * self.swipe[3] or spread <= 0.7 * self.swipe[3]:
                self.swipe[2] = True; self.show_desktop(spread > self.swipe[3])
        if self.swipe and n == 4 and not self.swipe[2] and self.swipe[3] is None:
            dx, dy = cx - self.swipe[0], cy - self.swipe[1]
            act = None
            if abs(dx) > abs(dy) and abs(dx) >= 0.3 * self.size[0]:   # ponytail: fixed thresholds, a knob if people ask
                act = "Switch One Desktop to the Right" if dx < 0 else "Switch One Desktop to the Left"
            elif abs(dy) > abs(dx) and abs(dy) >= 0.15 * self.size[1]:
                act = "Overview"
            if act:
                self.swipe[2] = True; self.shortcut(act)
        # three-finger drag: three fingers down press the button on what is under the pointer, moving them drags it,
        # lifting them drops it. The pointer follows the middle of the three. It waits 80 ms so a four-finger swipe
        # whose fingers land as three first does not become a drag.
        self.t3 = (self.t3 or now) if n == 3 and self.peak == 3 else None
        pending = self.t3 is not None and not self.drag and not self.wait_clear and not self.swipe
        if pending and now - self.t3 >= 0.08:
            self.drag, self.drag_tid, pending = True, self.drag_tid % 65000 + 1, False
            self.tap.reset()
        if self.drag and n < 2:   # lifted (one finger leaving a moment early does not end it)
            self.drag, self.wait_clear = False, n > 0
        if self.wait_clear and n == 0:
            self.wait_clear = False
        if self.drag:
            target = {0: (self.drag_tid, cx, cy)}
        elif self.wait_clear or self.swipe or pending:
            target = {}
        else:
            target = {s: (p[2], p[0], p[1]) for s, p in pts.items()}
            for s, (_, x, y) in target.items():
                self.tap.down(s, x, y, now); self.tap.move(s, x, y)
            self.tap.fingers(n)
        for s in set(self.out) - set(target):
            self.emit(EV_ABS, ABS_MT_SLOT, s); self.emit(EV_ABS, ABS_MT_TRACKING_ID, -1)
        for s, (tid, x, y) in target.items():
            old = self.out.get(s)
            if old is None or old[0] != tid:
                self.emit(EV_ABS, ABS_MT_SLOT, s); self.emit(EV_ABS, ABS_MT_TRACKING_ID, tid)
            if old is None or old[0] != tid or old[1:] != (x, y):
                self.emit(EV_ABS, ABS_MT_SLOT, s); self.emit(EV_ABS, ABS_MT_POSITION_X, x); self.emit(EV_ABS, ABS_MT_POSITION_Y, y)
        if target:
            _, x, y = target[min(target)]
            self.emit(EV_ABS, ABS_X, x); self.emit(EV_ABS, ABS_Y, y)
        self.out = target
        want = ({TOOLS[min(len(target), 5)], BTN_TOUCH} if target else set()) | ({BTN_LEFT} if self.drag else set())
        for k in self.held - want:
            self.emit(EV_KEY, k, 0)
        for k in want - self.held:
            self.emit(EV_KEY, k, 1)
        self.held = want
        self.emit(EV_SYN, SYN_REPORT, 0)
        if n == 0 and not self.drag:
            click = self.tap.up_all(now)
            if click:
                self.emit(EV_KEY, click, 1); self.emit(EV_SYN, SYN_REPORT, 0)
                self.emit(EV_KEY, click, 0); self.emit(EV_SYN, SYN_REPORT, 0)

    def pump(self, timeout):
        r, _, _ = select.select([self.src], [], [], timeout)
        if r:
            data = os.read(self.src, EVENT.size * 64)
            for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
                self.handle(data[i:i + EVENT.size])

    def close(self):
        for f, op in ((self.src, lambda: fcntl.ioctl(self.src, EVIOCGRAB, 0)), (self.ui, lambda: fcntl.ioctl(self.ui, UI_DEV_DESTROY))):
            try:
                op()
            except OSError:
                pass
            os.close(f)
        log("touchpad off: touchscreen released")


def run():
    pad = None
    try:
        while True:
            dark, other = screen_state()
            active = dark and other
            if active and pad is None:
                src, name = touchscreen()
                if src:
                    try:
                        pad = Pad(src, name)
                    except OSError as e:
                        log("could not take the touchscreen:", e); time.sleep(5)
            elif not active and pad is not None:
                pad.close(); pad = None
            if pad:
                deadline = time.monotonic() + 1
                while time.monotonic() < deadline:
                    try:
                        pad.pump(0.2)
                    except OSError:   # the touchscreen went away (suspend, unplug): release and look again
                        pad.close(); pad = None; break
            else:
                time.sleep(1)
    finally:
        if pad:
            pad.close()


def selftest():
    t = Tap(1000)
    t.down(0, 10, 10, 0.0); t.fingers(1); assert t.up_all(0.1) == BTN_LEFT
    t.down(0, 10, 10, 0.0); t.down(1, 50, 50, 0.01); t.fingers(2); assert t.up_all(0.15) == BTN_RIGHT
    t.down(0, 10, 10, 0.0); t.fingers(1); assert t.up_all(0.5) is None              # held: no click
    t.down(0, 10, 10, 0.0); t.move(0, 300, 10); t.fingers(1); assert t.up_all(0.1) is None   # moved: no click
    t.down(0, 0, 0, 0.0); t.fingers(3); assert t.up_all(0.1) is None                # three fingers: libinput's gesture
    class Fake(Pad):   # frame() without hardware: record what the virtual touchpad would get
        def __init__(self):
            self.out, self.held, self.drag, self.wait_clear, self.drag_tid, self.tap, self.log, self.peak = {}, set(), False, False, 60000, Tap(1000), [], 0
            self.size, self.swipe, self.t3, self.cuts = (1000, 1000), None, None, []
        def emit(self, t, c, v):
            self.log.append((t, c, v))
        def kde(self, *call):
            self.cuts.append(call[-1])
    f = Fake()
    f.frame({0: (100, 100, 5)}, 0.0); f.frame({}, 0.05)
    assert (EV_KEY, BTN_LEFT, 1) in f.log, "one-finger tap clicks"
    f.log.clear()
    pts = {0: (100, 100, 6), 1: (200, 100, 7), 2: (300, 100, 8)}
    f.frame(pts, 1.0); assert not f.drag and f.out == {}, "three fingers wait a moment before pressing"
    f.frame(pts, 1.1)
    assert (EV_KEY, BTN_LEFT, 1) in f.log and f.drag and list(f.out) == [0] and f.out[0][1:] == (200, 100), "three fingers press at their middle"
    f.frame({s: (x + 50, y + 20, t) for s, (x, y, t) in pts.items()}, 1.2)
    assert f.out[0][1:] == (250, 120) and (EV_KEY, BTN_LEFT, 0) not in f.log, "moving drags with the button held"
    f.frame({0: (150, 120, 6)}, 1.3)
    assert (EV_KEY, BTN_LEFT, 0) in f.log and not f.drag and f.out == {}, "lifting drops; the last finger moves nothing"
    f.frame({}, 1.4); assert not f.wait_clear
    four = lambda dx, dy: {s: (100 * s + 300 + dx, 500 + dy, 20 + s) for s in range(4)}
    f.log.clear(); f.frame({s: p for s, p in four(0, 0).items() if s < 3}, 2.0)   # lands as three first
    f.frame(four(0, 0), 2.03)
    assert not f.drag and f.out == {} and f.swipe, "four fingers: a swipe, not a drag, nothing forwarded"
    f.frame(four(0, -200), 2.1); f.frame(four(0, -300), 2.15)
    assert f.cuts == ["Overview"], "swipe up toggles the Overview once"
    f.frame({s: p for s, p in four(0, -300).items() if s < 3}, 2.2)
    assert not f.drag, "a four-finger swipe losing a finger does not start a drag"
    f.frame({}, 2.3); f.cuts.clear()
    f.frame(four(0, 0), 3.0); f.frame(four(-200, 0), 3.1); assert f.cuts == [], "a short sideways swipe does nothing"
    f.frame(four(-350, 0), 3.2); assert f.cuts == ["Switch One Desktop to the Right"], "a long swipe left: next desktop"
    f.frame({}, 3.3); f.cuts.clear()
    f.frame(four(0, 0), 4.0); f.frame(four(400, 10), 4.1); f.frame({}, 4.2)
    assert f.cuts == ["Switch One Desktop to the Left"], "a long swipe right: previous desktop"
    five = lambda rad: {s: (500 + round(rad * math.cos(s * 1.2566)), 500 + round(rad * math.sin(s * 1.2566)), 30 + s) for s in range(5)}
    f.cuts.clear(); f.frame({s: p for s, p in five(100).items() if s < 4}, 5.0); f.frame(five(100), 5.02)
    f.frame(five(130), 5.1); assert f.cuts == [], "a small spread does nothing"
    f.frame(five(160), 5.2); f.frame(five(200), 5.3); f.frame({}, 5.4)
    assert f.cuts == ["true"] and not f.drag, "five fingers spread out: show the desktop, once"
    f.cuts.clear(); f.frame(five(200), 6.0); f.frame(five(120), 6.1); f.frame({}, 6.2)
    assert f.cuts == ["false"], "five fingers pinched in: windows back"
    assert rotate(0, 0, 90, (0, 1000), (0, 2000)) == (0, 1000) and rotate(1000, 2000, 90, (0, 1000), (0, 2000)) == (2000, 0)
    assert rotate(5, 7, 0, (0, 9), (0, 9)) == (5, 7) and rotate(0, 0, 180, (0, 9), (0, 9)) == (9, 9)
    print("selftest ok")


if __name__ == "__main__":
    selftest() if sys.argv[1:] == ["selftest"] else run()
