#!/usr/bin/env bash
# SteamOS EGPU Buddy — attach / detach / surprise handling for a NON-NVIDIA eGPU (AMD, Intel: Mesa drivers).
# EXPERIMENTAL: written without test hardware. The NVIDIA path (egpu-hotplug-mount.sh, egpu-safe-detach,
# egpu-gamemode-detach, egpu-surprise-recover) is separate and is never entered from here.
# What differs from NVIDIA: the kernel driver is shared with the built-in GPU, so nothing is loaded or
# unloaded; no BAR resize / link pin / FLR; detach = move the session to the panel, then PCI-remove the eGPU only.
#   egpu-generic attach [--manual] [--force] | bringup [--boot] | resume | detach | surprise | keep-tuned | presleep
# Portable by construction: GPUs, DRM cards, the panel connector and the desktop user are detected, not assumed.
set -u
. /usr/local/sbin/egpu-detect                              # also reads /etc/nv-egpu-buddy/egpu.conf (EGPU_USER, EGPU_PCI_BDF)
UN=${EGPU_USER:-$(loginctl list-sessions --no-legend 2>/dev/null | awk '$4=="seat0"{print $3; exit}')}; UN=${UN:-$(id -nu 1000 2>/dev/null)}
U=$(id -u "$UN" 2>/dev/null) || { echo "cannot resolve the desktop user"; exit 1; }
RUNENV="XDG_RUNTIME_DIR=/run/user/$U DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$U/bus"
PANEL=$(ls -d /sys/class/drm/card[0-9]*-eDP-* 2>/dev/null | head -1); PANEL=${PANEL##*/card[0-9]-}; PANEL=${PANEL:-eDP-1}
ST=/run/nvegpu; mkdir -p $ST; LOG=/var/log/egpu-generic.log
USER_BIN=$(getent passwd "$UN" | cut -d: -f6)/.local/bin
PRIV=/usr/local/sbin/nv-egpu-buddy-privileged

# THE PLATFORM FIXES ARE NOT NVIDIA FIXES. The AMD SoC resets the machine instantly on an
# unrecoverable interconnect error - a "data fabric sync flood", 0x08000800 - and PCIe tunnelling
# between an AMD USB4 host and a Thunderbolt peripheral is a documented trigger for it. Nothing about
# that depends on who made the graphics card, so an AMD or Intel eGPU on this hardware is exposed to
# exactly the same instant reboot as an NVIDIA one. Apply the same mitigations here:
#   - keep the USB4 root ports out of runtime suspend (they otherwise drop the tunnel)
#   - mask AER surprise-down and the tunnel ports' fatal errors, so a cable pull reports instead of
#     escalating to the fabric
#   - clear any latched DPC containment left by a previous event
# They are all config-space operations on the bridges and are vendor-neutral by construction.
platform_guards(){
  [ -x "$PRIV" ] || return 0
  "$PRIV" pin-tunnel-ports on  2>/dev/null | while read -r l; do log "tunnel port: $l"; done
  "$PRIV" mask-tunnel-ports    2>/dev/null | while read -r l; do log "tunnel port: $l"; done
  "$PRIV" mask-surprise-down   2>/dev/null | while read -r l; do log "$l"; done
  "$PRIV" dpc-off >/dev/null 2>&1 || true
}
log(){ printf '%s %s: %s\n' "$(date '+%F %T')" "${verb:-?}" "$*" >> "$LOG"; }
status(){ printf '{"state":"%s","message":"%s"}\n' "$1" "$2" > $ST/gm-status.json; }
as_deck(){ runuser -u "$UN" -- env $RUNENV "$@"; }
[ "$(id -u)" = 0 ] || { echo "run as root"; exit 1; }
# Walled off: the AMD / Intel install only. On an NVIDIA install this path does nothing at all, whatever is plugged in.
[ "$(cat /etc/nv-egpu-buddy/gpu-vendor 2>/dev/null)" = amd ] || exit 0
verb=${1:-}; manual=0; force=""; boot=0
for a in "${@:2}"; do case "$a" in --manual) manual=1 ;; --force) force=--force ;; --boot) boot=1 ;; esac; done
SEEN=/var/lib/nvegpu/egpu-seen; MARK=$ST/generic-attached; MOVED=$ST/generic-session-moved; PENDING=$ST/gm-detach-pending; DMODE=/run/user/$U/egpu-detach-mode
# resume waits its turn (the dock re-announces itself on wake at the same moment); every other verb skips a duplicate
# (keep-tuned runs for as long as the eGPU is attached: it never takes the lock, or every attach / detach would be skipped)
[ "$verb" = keep-tuned ] || [ "$verb" = presleep ] || { exec 9>/run/egpu-generic.lock; if [ "$verb" = resume ]; then flock -w 60 9; else flock -n 9; fi; } || { log "another instance running — skip"; exit 0; }

game_mode(){ pgrep -x 'gamescope(-wl)?' >/dev/null 2>&1 || as_deck systemctl --user is-active gamescope-session.target >/dev/null 2>&1; }
igpu_card(){ basename "$(ls -d /sys/bus/pci/devices/"$(egpu_igpu_bdf)"/drm/card[0-9]* 2>/dev/null | head -1)"; }
render_of(){ ls "/sys/class/drm/$1/device/drm" 2>/dev/null | grep -m1 renderD; }
# all-ways-egpu Method 2 (reimplemented, same as the NVIDIA path): compositors pick their primary GPU from the
# read-only boot_vga flag, so bind-mount 1 over the eGPU's flag and 0 over the built-in GPU's.
BIND=/run/egpu-bootvga
clear_boot_vga(){ [ -r $BIND/bind-paths ] && { tac $BIND/bind-paths | while read -r p; do [ -n "$p" ] && umount -l "$p" 2>/dev/null; done; rm -f $BIND/bind-paths; }; }
set_boot_vga(){ local d f; mkdir -p $BIND; echo 1 > $BIND/1; echo 0 > $BIND/0; clear_boot_vga
  for d in /sys/bus/pci/devices/*; do _egpu_is_display "$d" || continue
    for f in $(find "$d/" -maxdepth 3 -name 'boot_*' 2>/dev/null); do
      if [ "${d##*/}" = "$1" ]; then mount -n --bind -o ro $BIND/1 "$f" 2>/dev/null && echo "$f" >> $BIND/bind-paths
      elif grep -q 1 "$f" 2>/dev/null; then mount -n --bind -o ro $BIND/0 "$f" 2>/dev/null && echo "$f" >> $BIND/bind-paths; fi
    done; done; }
user_env_igpu(){ local ic; ic=$(igpu_card)
  as_deck systemctl --user set-environment "KWIN_DRM_DEVICES=/dev/dri/${ic:-card1}" >/dev/null 2>&1
  as_deck systemctl --user unset-environment DRI_PRIME WLR_DRM_DEVICES KWIN_RENDER_NODES MESA_VK_DEVICE_SELECT >/dev/null 2>&1; }
# Arm the login manager's fallback at the SESSION that is running, through the shared tool.
# This used to write /etc/plasmalogin.conf* directly, which meant it did nothing at all on SteamOS (no
# plasmalogin) and hand-wrote a file named after SteamOS's own autologin drop-in. Both matter: KWin is
# pinned to the eGPU, so it dies with the cable, and the login manager then autologins into ITS default
# - Game Mode on SteamOS - within the same second, long before anything here can react. egpu-dm-session
# knows both login managers and names its drop-in so it out-sorts the ones the distro ships.
pin_plasma(){ pgrep -U 1000 -x kwin_wayland >/dev/null || return 0
  [ -x /usr/local/sbin/egpu-dm-session ] || return 0
  /usr/local/sbin/egpu-dm-session pin plasma >/dev/null 2>&1 &&
    log "login fallback -> plasma (losing the card returns to the desktop, not Game Mode)"; }
unpin_session(){ [ -x /usr/local/sbin/egpu-dm-session ] && /usr/local/sbin/egpu-dm-session unpin >/dev/null 2>&1 || true; }
audio(){ [ -x "$USER_BIN/egpu-audio.sh" ] && as_deck "$USER_BIN/egpu-audio.sh" "$1" >/dev/null 2>&1 || true; }
panel_output_back(){   # the panel must come back as an OUTPUT, not just back-lit: the attach path
  local wd                                   # disables it for external-only and nothing re-enables it,
  wd=$(basename "$(ls -1 /run/user/$U/wayland-[0-9] 2>/dev/null | head -1)" 2>/dev/null)  # which leaves a
  [ -n "$wd" ] || return 0                   # lit but blank screen on the only display left.
  as_deck env WAYLAND_DISPLAY="$wd" DISPLAY=:0 kscreen-doctor output."$PANEL".enable output."$PANEL".priority.1 >/dev/null 2>&1
  as_deck env WAYLAND_DISPLAY="$wd" DISPLAY=:0 kscreen-doctor --dpms on >/dev/null 2>&1 || true
  log "panel re-enabled: $(cat /sys/class/drm/card*-"$PANEL"/enabled 2>/dev/null | head -1)"; }
# AMD cards change their own PCIe link speed by load (pp_dpm_pcie): idle -> the lowest level (as low as 2.5 GT/s x1).
# Behind USB4 that becomes a trap: a game streaming to the card is starved by the narrow link, the card stays under 30%
# busy, so the driver keeps the link low and the frame rate collapses (Legion Go 1 + RX 6800 XT, "GPU usage under 30%").
# The NVIDIA path has always pinned the eGPU link for the same reason (a link that renegotiates on its own stalls); here
# it is done through amdgpu's own controls, which are made for a running card: the top PCIe level held, and the
# full-screen 3D power profile so the clocks ramp at once. Both vanish with the card (unplug, Safe Detach).
amd_tune(){ local D=/sys/bus/pci/devices/$1 top idx
  [ -w "$D/power_dpm_force_performance_level" ] && [ -r "$D/pp_dpm_pcie" ] || { log "amdgpu power controls not available on $1"; return 0; }
  top=$(sed -n 's/^\([0-9]*\):.*/\1/p' "$D/pp_dpm_pcie" | tail -1)
  # only a card that reports its PCIe levels the way the tested one does (RX 6800 XT: numbered levels, the current one
  # marked "*"). An RX 9070 XT (Navi 48) reported none ("PCIe held at ,"), was switched to manual all the same, and hung
  # under load after 5-30 min: sdma ring timeouts, GPU resets, pink / green screens (Legion Go 1 + RX 9070 XT, CachyOS;
  # stable with all-ways-eGPU, which never touches the power level). Such a card keeps its own power management.
  [ -n "$top" ] && grep -q '\*' "$D/pp_dpm_pcie" 2>/dev/null || {
    log "amdgpu: $1 reports no PCIe levels ($(tr '\n' ' ' < "$D/pp_dpm_pcie" 2>/dev/null | cut -c1-120)): left on its own power management"; return 1; }
  echo manual > "$D/power_dpm_force_performance_level" 2>/dev/null || { log "amdgpu: manual power level refused"; return 0; }
  [ -n "$top" ] && echo "$top" > "$D/pp_dpm_pcie" 2>/dev/null
  idx=$(awk '/3D_FULL_SCREEN/{gsub(/[^0-9]/,"",$1); print $1; exit}' "$D/pp_power_profile_mode" 2>/dev/null)
  [ -n "$idx" ] && echo "$idx" > "$D/pp_power_profile_mode" 2>/dev/null
  log "amdgpu tuned for an eGPU: PCIe held at $(grep '\*' "$D/pp_dpm_pcie" 2>/dev/null | tr -s ' ' | head -1), profile $(grep '\*' "$D/pp_power_profile_mode" 2>/dev/null | awk '{print $2}' | head -1)"; }
# The tuning does not stay: a Game Mode start sets the card back to "auto" (Legion Go 1 + RX 6800 XT, 0.7.178: manual at
# the attach, auto 20 s later when Game Mode came up on the eGPU, and auto for the whole game - 13-20 % busy, clock stuck,
# frame rate swinging between 60 and 20). A small keeper puts it back whenever it was reset, for as long as the eGPU is
# attached; it ends by itself on unplug, Safe Detach or a cable pull.
start_keeper(){ systemd-run --no-block --collect --quiet --unit=egpu-amd-tune-keeper /usr/local/sbin/egpu-generic keep-tuned >/dev/null 2>&1 || true; }
session_on_card(){ local p; for p in $(pgrep -x 'gamescope(-wl)?') $(pgrep -U "$U" -x kwin_wayland); do
    ls -l "/proc/$p/fd" 2>/dev/null | grep -qE "/dev/dri/$1\$" && return 0; done; return 1; }
# The NVIDIA path's dock bring-up (egpu-hotplug-mount.sh / egpu-boot-enumerate.sh), minus everything NVIDIA: authorize a
# dock boltd left waiting, keep the tunnel ports awake, then plain rescans until the card is on the bus. NEVER the NVIDIA
# path's last resort (de-authorize + re-authorize = a cable pull in software): that dropped a working RX 6800 XT mid-attach.
# The bus is only poked for a machine that has had an eGPU before ($SEEN): a plain dock or a USB4 drive is left alone.
bring_up(){ local tb sec any=0 _
  for tb in /sys/bus/thunderbolt/devices/*-*; do [ -e "$tb/device_name" ] && any=1; done
  [ "$any" = 1 ] || return 0
  egpu_find >/dev/null && return 0                          # on the bus already (the usual case): nothing to do
  if [ "$boot" = 1 ] && [ ! -e /run/egpu-rearmed ] && dmesg 2>/dev/null | grep -qi 'data fabric sync flood'; then
    log "the system reset itself with the eGPU connected on the last boot: bus left alone at boot (plug in again or press Attach)"; return 0; fi
  for _ in $(seq 1 6); do grep -qx 0 /sys/bus/thunderbolt/devices/*-*/authorized 2>/dev/null || break; sleep 1; done   # boltd first
  sec=$(cat /sys/bus/thunderbolt/devices/domain0/security 2>/dev/null)
  for tb in /sys/bus/thunderbolt/devices/*-*; do
    [ -e "$tb/device_name" ] && [ "$(cat "$tb/authorized" 2>/dev/null)" = 0 ] || continue
    case "$sec" in user|none|dponly) echo 1 > "$tb/authorized" 2>/dev/null && log "authorized $(cat "$tb/device_name") (security=$sec)" ;;
      *) log "$(cat "$tb/device_name") is not authorized (security '$sec' needs a key): authorize it once from the desktop (boltctl enroll)" ;; esac
  done
  command -v boltctl >/dev/null 2>&1 && for tb in /sys/bus/thunderbolt/devices/*-*; do [ -e "$tb/unique_id" ] && boltctl enroll --policy auto "$(cat "$tb/unique_id")" >/dev/null 2>&1; done
  [ -e $SEEN ] || [ "$boot" = 0 ] || { log "boot: a Thunderbolt device but no eGPU has attached on this machine yet: bus left alone"; return 0; }
  platform_guards
  for _ in $(seq 1 8); do egpu_find >/dev/null && { log "eGPU on the bus after the dock bring-up"; return 0; }; echo 1 > /sys/bus/pci/rescan 2>/dev/null; sleep 3; done
  egpu_find >/dev/null || log "no GPU behind the Thunderbolt device after 24 s of rescans (a dock, or the card is still starting: press Attach)"; }
logout_plasma(){ as_deck qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout 2>/dev/null || as_deck qdbus org.kde.Shutdown /Shutdown org.kde.Shutdown.logout 2>/dev/null; }

case "$verb" in
bringup|attach)
  if [ "$verb" = bringup ]; then
    bring_up
    if [ "$boot" = 1 ]; then   # before the login screen: protect + tune the card; Game Mode starts on it by itself (the wrapper)
      read -r bdf vendor card < <(egpu_find) || exit 0; [ "$vendor" != nvidia ] || exit 0
      platform_guards; echo on > "/sys/bus/pci/devices/$bdf/power/control" 2>/dev/null; [ "$vendor" = amd ] && { amd_tune "$bdf"; start_keeper; }
      echo "$bdf" > $MARK; mkdir -p /var/lib/nvegpu; : > $SEEN; log "boot: $vendor eGPU $bdf ready"; exit 0
    fi
  fi
  # Runs on every display hotplug of the built-in GPU too (XR glasses on the handheld's USB-C reconnect about once a
  # second while Game Mode is on another screen): a read-only look first, and nothing touched unless an AMD / Intel
  # eGPU is there and not yet set up. NVIDIA has its own path (egpu-hotplug-mount.sh).
  read -r bdf vendor card < <(egpu_find) || exit 0
  [ "$vendor" != nvidia ] || exit 0
  # "already moved" only while the running session really has THIS card open: a cable pull whose recovery did not run
  # left the mark behind, and every later plug-in was then skipped without a word (first real AMD eGPU, 2026-10-24)
  # (only an old mark: right after an attach the session is still restarting onto the card, and the monitor's hot-plug
  # events land here too; treating those as stale would restart Game Mode in a loop)
  if [ -e $MOVED ] && [ -n "$card" ] && [ $(( $(date +%s) - $(stat -c %Y $MOVED 2>/dev/null || date +%s) )) -gt 90 ] && ! session_on_card "$card"; then log "stale attach mark (the session is not on $card): attaching again"; rm -f $MOVED $MARK; fi
  # a press of Attach always tries again unless the session really is on the card
  [ "$manual" = 1 ] && [ -e $MOVED ] && ! session_on_card "$card" && rm -f $MOVED
  [ -e $MOVED ] && exit 0
  # platform guards first: the tunnel must be awake and its fatal errors masked BEFORE the card is
  # touched, or a link event during bring-up can take the whole machine down with a fabric flood.
  platform_guards
  [ -e $PENDING ] && { log "skip: detach in progress"; exit 0; }
  read -r bdf vendor card < <(egpu_find) || { log "no eGPU on the bus"; exit 0; }
  [ "$vendor" != nvidia ] || exit 0                       # NVIDIA has its own path
  for _ in $(seq 1 30); do [ -n "$card" ] && break; sleep 1; read -r bdf vendor card < <(egpu_find) || exit 0; done
  [ -n "$card" ] || { log "$vendor $bdf: no kernel driver bound a DRM card within 30s — leaving it alone"; exit 0; }
  [ -e $MOVED ] && { log "session already moved to $bdf"; exit 0; }   # display hotplug events re-enter here: never relogin twice
  echo on > "/sys/bus/pci/devices/$bdf/power/control" 2>/dev/null     # no runtime suspend across the tunnel
  [ "$vendor" = amd ] && { amd_tune "$bdf"; start_keeper; }
  out=""; for _ in $(seq 1 15); do out=$(egpu_connected_outputs "$card" | head -1); [ -n "$out" ] && break; sleep 2; done
  log "$vendor eGPU $bdf ($card) link x$(cat /sys/bus/pci/devices/$bdf/current_link_width 2>/dev/null) output=${out:-none}"
  echo "$bdf" > $MARK; mkdir -p /var/lib/nvegpu; : > $SEEN
  [ -n "$out" ] || { log "no display on the eGPU: it stays available for rendering (DRI_PRIME), session untouched"; exit 0; }
  if game_mode; then touch $MOVED; exec 9>&-
    # as on NVIDIA: sound follows the picture and the monitor is asked to wake (DDC/CI / CEC). A deferred switch (a game
    # is running) leaves no "moved" mark behind, or the later Attach would be skipped as already done.
    /usr/local/sbin/egpu-gamemode-switch $force >/dev/null 2>&1; rc=$?; log "gamemode-switch rc=$rc"
    if [ $rc = 0 ]; then audio follow; /usr/local/sbin/egpu-screen wake "$out" 2>/dev/null | while read -r l; do log "screen $l"; done
    else rm -f $MOVED; fi
    exit $rc; fi
  # boot / login screen: no session to move. Game Mode picks the eGPU by itself (session wrapper); never touch the greeter's GPU.
  pgrep -U 1000 -x kwin_wayland >/dev/null || { log "no running session — nothing to move"; exit 0; }
  pgrep -u "$UN" -x plasmashell >/dev/null || { log "login screen, not a user desktop — nothing to move"; exit 0; }
  touch $MOVED; set_boot_vga "$bdf"; pin_plasma
  # eGPU first = KWin renders on it; the built-in GPU stays in the list so kscreen can switch the panel off properly
  as_deck systemctl --user set-environment "KWIN_DRM_DEVICES=/dev/dri/$card:/dev/dri/$(igpu_card)" \
    "DRI_PRIME=pci-$(printf '%s' "$bdf" | tr ':.' '__')!" >/dev/null 2>&1
  logout_plasma && log "session logout issued — autologin restarts Plasma with the eGPU as primary" || log "logout failed; log out and in to move the desktop to the eGPU"
  ( for _ in $(seq 1 30); do sleep 2; as_deck kscreen-doctor -o 2>/dev/null | grep -q "$out" && break; done; sleep 4
    as_deck kscreen-doctor output."$out".enable output."$out".priority.1 >/dev/null 2>&1; sleep 1
    as_deck kscreen-doctor output."$PANEL".disable >/dev/null 2>&1 && log "external-only: $out primary, panel off"
      audio follow ) &
  ;;
resume)
  # after sleep: the same protections and tuning as at attach (a resumed card starts from its defaults again), then, while
  # Game Mode is on the eGPU display, the handheld panel back off (resume lights it) and the monitor asked to wake
  # The card did not come back: sleep can take the whole USB4 dock off and bring it back without its PCIe tunnel - the dock
  # authorized, no GPU behind it, until a replug (Legion Go 1 + RX 6800 XT, 0.7.178). Give the tunnel its normal time, then
  # the dock bring-up, then the NVIDIA path's last resort (de-authorize + authorize the dock = a replug in software). That
  # step is kept out of plug-in for AMD cards because it once dropped a card that was still starting; here no AMD / Intel
  # card is on the bus at all, so there is nothing it can drop.
  if ! egpu_find >/dev/null && [ -e $SEEN ] && ls /sys/bus/thunderbolt/devices/*-*/device_name >/dev/null 2>&1; then
    for _ in $(seq 1 15); do egpu_find >/dev/null && break; sleep 1; done
    if ! egpu_find >/dev/null; then
      log "the eGPU did not come back after sleep: dock bring-up"
      bring_up
      if ! egpu_find >/dev/null; then
        for tb in /sys/bus/thunderbolt/devices/*-*; do
          [ -e "$tb/device_name" ] && [ "$(cat "$tb/authorized" 2>/dev/null)" = 1 ] || continue
          log "still no GPU behind $(cat "$tb/device_name"): re-authorizing the dock (rebuilds its PCIe tunnel)"
          "$PRIV" dpc-off >/dev/null 2>&1 || true
          echo 0 > "$tb/authorized" 2>/dev/null; sleep 2; echo 1 > "$tb/authorized" 2>/dev/null; sleep 3
        done
        for _ in $(seq 1 10); do echo 1 > /sys/bus/pci/rescan 2>/dev/null; sleep 2; egpu_find >/dev/null && break; done
      fi
      egpu_find >/dev/null || { log "the eGPU did not come back after sleep; unplug and plug it in again"; exit 0; }
      log "eGPU back after sleep: attaching"; exec 9>&-; exec "$0" attach
    fi
  fi
  read -r bdf vendor card < <(egpu_find) || exit 0; [ "$vendor" != nvidia ] || exit 0
  platform_guards; echo on > "/sys/bus/pci/devices/$bdf/power/control" 2>/dev/null; [ "$vendor" = amd ] && { amd_tune "$bdf"; start_keeper; }
  [ -n "$card" ] && session_on_card "$card" || exit 0
  # (no DDC/CI "wake" of the monitor here: the AMD driver brings the display back itself, and asking the monitor to power
  # on and select its input made it re-sync - seconds more of black after every wake (Legion Go 1 + RX 6800 XT, MSI MP275).
  # That wake is an NVIDIA workaround for a link that does not re-train; the NVIDIA path keeps it.)
  g=$(pgrep -n -x 'gamescope(-wl)?') || exit 0
  oc=$(tr '\0' '\n' </proc/$g/environ 2>/dev/null | sed -n 's/^OUTPUT_CONNECTOR=//p'); case "${oc%%,*}" in ""|"*"|eDP-*) exit 0 ;; esac
  /usr/local/sbin/egpu-panel off >/dev/null 2>&1 && log "resume: handheld panel off again (Game Mode on ${oc%%,*})"
  ;;
presleep)
  # Right before sleep: the AMD eGPU back to the driver's own power management (automatic level, link not held, default
  # profile) and the keeper stopped, so the driver suspends the card exactly as it would without EGPU Buddy. Sleep with
  # the tuning held froze the machine during a game and was slow to wake outside one (Legion Go 1 + RX 6800 XT, 0.7.185).
  # The resume step puts the tuning and the keeper back.
  systemctl stop egpu-amd-tune-keeper.service >/dev/null 2>&1 || true
  read -r bdf vendor card < <(egpu_find) || exit 0; [ "$vendor" = amd ] || exit 0
  D=/sys/bus/pci/devices/$bdf
  echo auto > "$D/power_dpm_force_performance_level" 2>/dev/null
  idx=$(awk '/BOOTUP_DEFAULT/{gsub(/[^0-9]/,"",$1); print $1; exit}' "$D/pp_power_profile_mode" 2>/dev/null)
  [ -n "$idx" ] && echo "$idx" > "$D/pp_power_profile_mode" 2>/dev/null
  log "before sleep: $bdf back to its own power management ($(cat "$D/power_dpm_force_performance_level" 2>/dev/null))"
  ;;
keep-tuned)
  # every 5 s while the AMD eGPU is attached: power level back to manual + the link held, if anything reset it
  # (started before the attach has written its mark: give it up to a minute)
  for _ in $(seq 1 12); do [ -e $MARK ] && break; sleep 5; done
  while [ -e $MARK ] && [ ! -e $PENDING ]; do
    read -r bdf vendor card < <(egpu_find) || exit 0; [ "$vendor" = amd ] || exit 0
    lvl=$(cat "/sys/bus/pci/devices/$bdf/power_dpm_force_performance_level" 2>/dev/null) || exit 0
    [ "$lvl" = manual ] || { log "the power level was set back to '$lvl' (Game Mode start?): tuning again"; amd_tune "$bdf" || exit 0; }
    sleep 5
  done
  ;;
detach)
  read -r bdf vendor card < <(egpu_find) || { status IDLE "No eGPU connected."; exit 0; }
  [ "$vendor" != nvidia ] || exit 0
  trap 'rm -f $PENDING $DMODE' EXIT
  date +%s > $PENDING; as_deck touch $DMODE; status DETACHING "Moving the session to the handheld screen. Do not unplug."
  clear_boot_vga; user_env_igpu
  if game_mode; then
    rm -f /run/user/1000/nv-egpu-buddy-gamescope-starts; G0=$(pgrep -n -x 'gamescope(-wl)?'); as_deck systemctl --user restart gamescope-session.target >/dev/null 2>&1 &
    for _ in $(seq 1 45); do sleep 2; g=$(pgrep -n -x 'gamescope(-wl)?'); [ -n "$g" ] && [ "$g" != "$G0" ] && break; done
  elif pgrep -U 1000 -x kwin_wayland >/dev/null; then
    K0=$(pgrep -U 1000 -x kwin_wayland | head -1); pin_plasma; logout_plasma
    for _ in $(seq 1 45); do sleep 2; k=$(pgrep -U 1000 -x kwin_wayland | head -1); [ -n "$k" ] && [ "$k" != "$K0" ] && break; done
  fi
  status DO_NOT_UNPLUG "Releasing the eGPU. Do not unplug yet."
  nodes="/dev/dri/$card /dev/dri/$(render_of "$card")"
  for _ in $(seq 1 20); do fuser $nodes >/dev/null 2>&1 || break; sleep 2; done
  if fuser $nodes >/dev/null 2>&1; then log "still held by: $(fuser $nodes 2>/dev/null | tr -s ' ') -> TERM"; fuser -k -TERM $nodes >/dev/null 2>&1; sleep 3; fi
  if fuser $nodes >/dev/null 2>&1; then status FAILED "A program is still using the eGPU. Close games and try again."; log "abort: nodes busy"; exit 5; fi
  for fn in /sys/bus/pci/devices/"${bdf%.*}".[1-7] "/sys/bus/pci/devices/$bdf"; do [ -e "$fn/remove" ] && echo 1 > "$fn/remove" 2>/dev/null; done
  rm -f $MARK $MOVED
  if egpu_find >/dev/null; then status FAILED "The eGPU did not leave the bus. Do not unplug; reboot first."; log "remove failed"; exit 6; fi
  log "eGPU $bdf removed"; status SAFE_COMPLETE "Safe to unplug the cable."
  ;;
surprise)
  [ -e $PENDING ] && exit 0; [ -e $MARK ] || exit 0
  # The kernel announces the removal while the card is still listed for a moment (the driver lets go first), so the
  # first look always found it "still there" and the recovery silently never ran. Give the removal up to 10 s to finish.
  for _ in $(seq 1 20); do egpu_find >/dev/null || break; sleep 0.5; done
  egpu_find >/dev/null && { log "remove event, but the eGPU is still on the bus: a function of it went away, nothing to recover"; exit 0; }
  log "surprise removal of $(cat $MARK)"; rm -f $MARK $MOVED; clear_boot_vga; user_env_igpu
  /usr/local/sbin/nv-egpu-buddy-privileged panel-on >/dev/null 2>&1
  panel_output_back; audio restore
  # Steam dies with the session that was rendering on the card, and the display manager's relogin races
  # it. The NVIDIA path's repair is vendor-neutral, so reuse it: it waits for the session to settle,
  # starts Steam once, then clears the "Unable to open a connection to X" dialog if one appears.
  [ -x /usr/local/sbin/egpu-surprise-recover ] && systemd-run --no-block --collect --quiet \
    --unit="egpu-steam-watch-$(date +%s)" /usr/local/sbin/egpu-surprise-recover --steam-watch >/dev/null 2>&1 || true
  if game_mode; then sleep 3; rm -f /run/user/1000/nv-egpu-buddy-gamescope-starts; as_deck systemctl --user restart gamescope-session.target >/dev/null 2>&1; status IDLE "eGPU unplugged. Game Mode is back on the handheld screen."
  else pin_plasma; fi                                      # KWin exits when its primary GPU vanishes; autologin brings Plasma back on the panel
  ;;
*) echo "usage: egpu-generic attach [--manual] [--force] | bringup [--boot] | resume | detach | surprise"; exit 2 ;;
esac
