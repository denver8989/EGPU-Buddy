#!/bin/bash
# egpu-kernel-cmdline --check | --written | --pending | --repair | --apply [--dry-run] | --remove
# The kernel parameters the eGPU path needs (README "Kernel command line"), and how to persist them per bootloader.
# --check prints the parameters missing from the RUNNING kernel (exit 1 if any). --apply writes them into the
# bootloader config (backup kept) and regenerates it; a reboot is needed afterwards.
set -u
# hpmemprefsize=16G: one value for both cards. It is the size the RTX 5060 Ti is proven at, and the
# RTX 3080 reaches a full 16GiB BAR1 at this value too, so neither card needs a special case.
#
# Note it is a PER-EMPTY-HOTPLUG-PORT reserve, not a pool, and a Thunderbolt switch has four
# downstream ports — so raising it does not help a starved card, it starves it further by handing
# more of the root-port window to ports with nothing behind them. What actually places a large BAR
# is the re-enumeration in egpu-boot-enumerate.sh: ask the card for the big BAR first, keep the
# tunnel link up, and hand back every downstream port at once.
WANT="nvidia-drm.modeset=1 pci=realloc=on,hpmemsize=512M,hpmemprefsize=16G,noaer pcie_aspm=off thunderbolt.host_reset=0 thunderbolt.clx=0 iommu=pt pcie_ports=native"

# Intel Arc in an enclosure: the xe driver asks its SR-IOV mailbox at probe, and over a Thunderbolt
# tunnel that mailbox does not answer - the driver then waits out a three-minute fallback and gives up
# with -ETIMEDOUT, which looks exactly like "the eGPU does not work". Disabling virtual functions skips
# that path. Added ONLY on systems that actually have the xe driver, so nothing else sees an unknown
# parameter. Intel does not officially support Arc in an eGPU enclosure at all; this is the workaround
# the reports converge on, and it is untested here.
_intel_gpu_present(){
  local d
  for d in /sys/bus/pci/devices/*; do
    [ "$(cat "$d/vendor" 2>/dev/null)" = 0x8086 ] || continue
    case "$(cat "$d/class" 2>/dev/null)" in 0x0300*|0x0302*|0x0380*) return 0 ;; esac
  done
  return 1
}
# The module ships on distros that have no Intel GPU at all (CachyOS does), so gate on the DEVICE being
# present, not on the driver existing - otherwise this would rewrite the kernel command line of every
# working NVIDIA machine for no reason.
if _intel_gpu_present; then
  WANT="$WANT xe.max_vfs=0"
fi
# Bazzite only: its handheld image has no NVIDIA driver, so nouveau (in the initramfs too) would take an eGPU that is
# connected at boot before this project's patched driver can. Every other system keeps exactly its parameters.
if (. /etc/os-release 2>/dev/null; case "${ID:-} ${NAME:-}" in *[Bb]azzite*) exit 0 ;; esac; exit 1); then
  WANT="$WANT rd.driver.blacklist=nouveau modprobe.blacklist=nouveau"
fi
# AMD / Intel install with an RX 9070 / 9070 XT (1002:7550) recorded on this machine by egpu-generic: none of the above.
# These parameters were tuned for NVIDIA cards; with them the card got a 256 MiB BAR behind a USB4 dock (16 GiB hot-plug
# reserves on the dock's empty ports) and its copy engine hung in games, still after the full BAR was restored (0.7.210),
# while the same Legion Go 1 + Minisforum DEG2 + RX 9070 XT on CachyOS's own parameters (all-ways-eGPU) is stable.
# --remove takes our line back out (Limine; see below). Every other machine keeps exactly its parameters.
NAVI48=/var/lib/nvegpu/generic-navi48
if [ "$(cat /etc/nv-egpu-buddy/gpu-vendor 2>/dev/null)" = amd ] && [ -e $NAVI48 ]; then
  WANT=""
fi
# The boot-verbosity parameters SteamOS's own configuration carries. Regenerating the GRUB config
# puts them where steamenv_boot strips them, so we re-add them somewhere it does not touch.
QUIET="loglevel=3 quiet splash plymouth.ignore-serial-consoles"
MODE=${1:---check}; DRY=0; [ "${2:-}" = --dry-run ] && DRY=1
missing(){ local cur; cur=$(cat /proc/cmdline); for p in $WANT; do case " $cur " in *" $p "*) ;; *) printf '%s ' "$p";; esac; done; }
merge(){ # $1 = existing cmdline string -> string with our params (replacing any pci=/nvidia-drm.modeset=/pcie_aspm=/iommu= token)
  local out=""; for t in $1; do case "$t" in pci=*|nvidia-drm.modeset=*|pcie_aspm=*|thunderbolt.host_reset=*|thunderbolt.clx=*|iommu=*|pcie_ports=*) ;; *) out="$out $t";; esac; done
  printf '%s %s' "${out# }" "$WANT"; }
# --pending: exit 0 when the parameters are WRITTEN to the bootloader configuration but the running kernel does not
# have them yet (= a reboot is all that is missing). The plugin shows "reboot" then, not another "apply".
written(){ local cfg
  if command -v rpm-ostree >/dev/null 2>&1; then cfg=$(rpm-ostree kargs 2>/dev/null)
  elif [ -f /etc/default/limine ]; then   # the generated entries, when found: /etc/default/limine alone is only the source
    cfg=""; c=$(find /boot /efi /boot/efi -maxdepth 4 -iname limine.conf 2>/dev/null | head -1); [ -n "$c" ] && cfg=$(cat "$c" 2>/dev/null)
    [ -n "$cfg" ] || cfg=$(cat /etc/default/limine 2>/dev/null)
  else cfg=$(cat /etc/default/grub /etc/default/grub.d/*.cfg /boot/loader/entries/*.conf 2>/dev/null); fi
  for p in $WANT; do case "$cfg" in *"$p"*) ;; *) return 1;; esac; done; return 0; }
# --written: exit 0 when the bootloader CONFIGURATION carries all parameters (they survive the next kernel update).
# A running kernel can have them from hand-edited boot entries while the configuration they are regenerated from
# does not (found on the development machine, 2026-09-19): then --check passes and the next kernel update drops them.
# --repair: 0.7.141 could leave Limine entries with no root= (see the Limine branch). Run at every boot by selfheal:
# when our marked line is there and an entry lacks root=, rebuild it (as root, from the command line this boot used).
if [ "$MODE" = --repair ]; then
  [ -f /etc/default/limine ] && grep -q 'SteamOS EGPU Buddy' /etc/default/limine || exit 0
  c=$(find /boot /efi /boot/efi -maxdepth 4 -iname limine.conf 2>/dev/null | head -1); [ -n "$c" ] || exit 0
  grep -iE '^[[:space:]]*(kernel_)?cmdline:' "$c" | grep -qv 'root=' || exit 0
  echo "Limine entries without root= found: rebuilding"; exec bash "$0" --apply
fi
if [ "$MODE" = --written ]; then written && { echo "kernel parameters persisted"; exit 0; }; echo "kernel parameters are NOT in the bootloader configuration"; exit 1; fi
if [ "$MODE" = --pending ]; then [ -n "$(missing)" ] && written && { echo "kernel parameters written; reboot to activate"; exit 0; }; exit 1; fi
if [ "$MODE" = --check ]; then m=$(missing); [ -z "$m" ] && { echo "kernel command line: ok"; exit 0; }; echo "missing kernel parameters: $m"; exit 1; fi
# --remove (the RX 9070 case above only): take our marked Limine line back out. Only the form that APPENDS to a line of
# the user's that carries root= - removing the full-line form would leave Limine without root= (0.7.141). Backup kept;
# the regenerated entries are checked for root= and the backup goes back if one has none.
if [ "$MODE" = --remove ]; then
  [ -z "$WANT" ] || { echo "not an RX 9070 AMD install: parameters kept"; exit 0; }
  [ "$(id -u)" = 0 ] || { echo "--remove needs root"; exit 1; }
  L=/etc/default/limine; MARK='# SteamOS EGPU Buddy: eGPU kernel parameters'
  [ -f $L ] && grep -qxF "$MARK" $L || { echo "no EGPU Buddy kernel parameters in the bootloader configuration"; exit 0; }
  [ "$(grep -A1 -xF "$MARK" $L | sed -n 2p | cut -c1-26)" = 'KERNEL_CMDLINE[default]+="' ] ||
    { echo "our Limine line is a full command line, not an addition: left as it is"; exit 0; }
  grep -vxF "$MARK" $L | grep -E '^KERNEL_CMDLINE\[default\]\+?=.*root=' | grep -qvF 'hpmemprefsize' ||
    { echo "no other Limine line carries root=: left as it is"; exit 0; }
  TS=$(date +%Y%m%d-%H%M%S); B="$L.bak-egpu-buddy-$TS"; cp -a $L "$B"
  awk -v mark="$MARK" '$0==mark {skip=1; next} skip {skip=0; next} {print}' "$B" > $L
  regen=""; for c in limine-update limine-mkinitcpio; do command -v $c >/dev/null 2>&1 && timeout 300 $c >/dev/null 2>&1 && { regen=$c; break; }; done
  esp=$(sed -n 's/^ESP_PATH="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' $L | tail -1)
  conf=$(find ${esp:-} /boot /efi /boot/efi -maxdepth 4 -iname limine.conf 2>/dev/null | head -1)
  if [ -z "$regen" ] || [ -z "$conf" ] || grep -iE '^[[:space:]]*(kernel_)?cmdline:' "$conf" | grep -qv 'root='; then
    cp -a "$B" $L; for c in limine-update limine-mkinitcpio; do command -v $c >/dev/null 2>&1 && timeout 300 $c >/dev/null 2>&1 && break; done
    echo "the Limine entries could not be regenerated cleanly (${regen:-no tool}): $L put back, parameters kept"; exit 1
  fi
  echo "removed the EGPU Buddy kernel parameters from $L (backup $B), Limine entries regenerated ($regen): restart once to use them"
  exit 0
fi
[ "$MODE" = --apply ] || { echo "usage: $0 --check | --apply [--dry-run] | --remove"; exit 2; }
[ -n "$WANT" ] || { echo "no kernel parameters to add on this machine"; exit 0; }
[ "$(id -u)" = 0 ] || { echo "--apply needs root"; exit 1; }
TS=$(date +%Y%m%d-%H%M%S); did=0
edit(){ # $1 file, $2 sed script
  [ -f "$1" ] || return 1
  if [ $DRY = 1 ]; then echo "would edit $1:"; sed -E "$2" "$1" | diff "$1" - | grep '^>' | cut -c1-200; return 0; fi
  cp -a "$1" "$1.bak-egpu-buddy-$TS"; sed -E -i "$2" "$1"
  # a pattern that matched nothing is not a success: say so instead of "reboot needed" on every boot
  if cmp -s "$1" "$1.bak-egpu-buddy-$TS"; then rm -f "$1.bak-egpu-buddy-$TS"; echo "$1: no change (no matching line, or already up to date)"; return 1; fi
  echo "edited $1 (backup $1.bak-egpu-buddy-$TS)"; }
if command -v rpm-ostree >/dev/null 2>&1; then                       # Bazzite / rpm-ostree images
  args=(); for p in $WANT; do args+=(--append-if-missing="$p"); done
  cur=$(rpm-ostree kargs 2>/dev/null); case "$cur" in *pci=*) args+=(--delete-if-present="$(echo "$cur" | tr ' ' '\n' | grep '^pci=' | head -1)");; esac
  if [ $DRY = 1 ]; then echo "would run: rpm-ostree kargs ${args[*]}"; else rpm-ostree kargs "${args[@]}" && did=1; fi
elif [ -f /etc/default/limine ]; then                                 # CachyOS Limine (limine-entry-tool regenerates limine.conf)
  # CachyOS writes its line as KERNEL_CMDLINE[default]+="..." (an append), which a plain = match never sees.
  # So ours is a separate, marked line of our own: replaced on every apply, the user's line untouched.
  # BUT when the file has NO [default] line of its own, limine-entry-tool builds the whole command line itself
  # (root=, rootflags=...), and ANY KERNEL_CMDLINE[default] we add REPLACES that: 0.7.141 booted a CachyOS Legion
  # Go 2 with no root= ("Timed out waiting for device /dev/gpt-auto-root"). Then ours must be a FULL line, built
  # from the command line this system booted with, and the regenerated limine.conf is checked: any entry without
  # root= puts the backup back.
  L=/etc/default/limine; MARK='# SteamOS EGPU Buddy: eGPU kernel parameters'
  if [ $DRY = 1 ]; then echo "would add our parameters to $L"
  else B="$L.bak-egpu-buddy-$TS"; cp -a "$L" "$B"
    # take our tokens out of the user's lines (an older apply put them there), then drop our old marked line
    awk -v mark="$MARK" '
      $0==mark {skip=1; next}
      skip {skip=0; next}
      /^KERNEL_CMDLINE\[default\]\+?="/ { n=split($0,a," "); o=""; for(k=1;k<=n;k++){t=a[k]; sub(/^"/,"",t); sub(/"$/,"",t)
          if (t ~ /^(pci|nvidia-drm\.modeset|pcie_aspm|thunderbolt\.host_reset|thunderbolt\.clx|iommu|pcie_ports)=/ && k>1) { if (a[k] ~ /"$/) o=o "\""; continue }
          o = o (o=="" ? "" : " ") a[k] }
        gsub(/ "$/,"\"",o); print o; next }
      {print}' "$B" > "$L"
    ok=1
    if grep -qE '^KERNEL_CMDLINE\[default\]\+?=.*root=' "$L"; then
      printf '%s\nKERNEL_CMDLINE[default]+=" %s"\n' "$MARK" "$WANT" >> "$L"
    else
      base=$(merge "$(tr ' ' '\n' </proc/cmdline | grep -vE '^(BOOT_IMAGE|initrd)=' | tr '\n' ' ')")
      case " $base " in *" root="*) printf '%s\nKERNEL_CMDLINE[default]="%s"\n' "$MARK" "$base" >> "$L" ;;
        *) ok=0; cp -a "$B" "$L"; echo "the running kernel has no root= to build a Limine line from: Limine left as it was" ;; esac
    fi
    if [ $ok = 1 ]; then
      echo "wrote our parameters to $L (backup $B)"
      regen(){ regen=""; for c in limine-update limine-mkinitcpio; do command -v $c >/dev/null 2>&1 && $c >/dev/null 2>&1 && { regen=$c; break; }; done; }
      regen
      esp=$(sed -n 's/^ESP_PATH="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$L" | tail -1)
      conf=$(find ${esp:-} /boot /efi /boot/efi -maxdepth 4 -iname limine.conf 2>/dev/null | head -1)
      if [ -n "$conf" ] && grep -iE '^[[:space:]]*(kernel_)?cmdline:' "$conf" | grep -qv 'root='; then
        cp -a "$B" "$L"; regen; regen=""; echo "a regenerated Limine entry had no root=: put $L back and regenerated"
      elif [ -n "$conf" ] && grep -q 'hpmemprefsize' "$conf"; then echo "Limine entries regenerated (${regen:-?}): $conf"; did=1
      elif [ -n "$regen" ]; then echo "$regen ran but ${conf:-limine.conf} does not carry the parameters yet"; did=1
      else echo "could not regenerate Limine entries: run limine-update (or limine-mkinitcpio) by hand"; fi
    else regen=""; fi
  fi
elif [ -f /etc/default/grub ] && command -v steamos-readonly >/dev/null 2>&1; then   # SteamOS: GRUB drop-in
  # An OS update replaces /etc/default/grub, but grub-mkconfig also reads /etc/default/grub.d/*.cfg and SteamOS keeps
  # files listed in /etc/atomic-update.conf.d across updates (install.sh lists this one). Verified on the 3.8.14 image.
  d=/etc/default/grub.d/egpu-buddy.cfg
  # An older apply may have written these straight into /etc/default/grub. Leaving them there
  # puts two copies on the command line, and when a VALUE changes (16G -> 32G) it is not defined
  # which one wins. Take ours out of the base file; the drop-in below is the single source.
  if [ $DRY = 0 ] && grep -q 'hpmemprefsize\|nvidia-drm.modeset' /etc/default/grub 2>/dev/null; then
    cur=$(sed -n 's/^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"$/\1/p' /etc/default/grub | head -1)
    stripped=""
    for t in $cur; do case "$t" in pci=*|nvidia-drm.modeset=*|pcie_aspm=*|thunderbolt.host_reset=*|thunderbolt.clx=*|iommu=*|pcie_ports=*) ;; *) stripped="$stripped $t" ;; esac; done
    cp -a /etc/default/grub "/etc/default/grub.bak-egpu-buddy-$TS"
    sed -E -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=\".*\"|GRUB_CMDLINE_LINUX_DEFAULT=\"${stripped# }\"|" /etc/default/grub
    echo "removed an older copy of the parameters from /etc/default/grub (backup kept)"
  fi
  if [ $DRY = 1 ]; then echo "would write $d"; else mkdir -p /etc/default/grub.d
    # SteamOS's steamenv_boot strips "loglevel=3 quiet splash plymouth.ignore-serial-consoles" from
    # the line it boots, wherever they sit — measured: with our parameters after them they were
    # dropped, and with our parameters before them they were dropped again, while everything in
    # GRUB_CMDLINE_LINUX survived. Every boot became a wall of console text. So they are restored
    # through GRUB_CMDLINE_LINUX, which is left alone. Harmless if the platform also adds its own.
    # GRUB_TIMEOUT_STYLE too: a config regenerated by grub-mkconfig on SteamOS comes out with NO
    # timeout directive at all, and GRUB then waits at a menu FOREVER. On a handheld with no
    # keyboard that is indistinguishable from a dead machine — it happened to a user, who had to
    # find a keyboard to boot. SteamOS's own config is not produced by grub-mkconfig, so it never
    # had this problem until we regenerated it.
    printf '# SteamOS EGPU Buddy: kernel parameters the eGPU path needs (kept across OS updates)\nGRUB_CMDLINE_LINUX_DEFAULT="%s ${GRUB_CMDLINE_LINUX_DEFAULT}"\nGRUB_CMDLINE_LINUX="${GRUB_CMDLINE_LINUX} %s"\nGRUB_TIMEOUT=0\nGRUB_TIMEOUT_STYLE=hidden\n' "$WANT" "$QUIET" > "$d"; echo "wrote $d"; did=1; fi
  cfg=$(ls /efi/EFI/steamos/grub.cfg /boot/efi/EFI/steamos/grub.cfg /boot/grub/grub.cfg 2>/dev/null | head -1)
  if [ $DRY = 0 ] && [ -n "$cfg" ]; then
    if grub-mkconfig -o "$cfg" >/dev/null 2>&1; then
      echo "grub config regenerated: $cfg"
      # Never leave a config that stops at a menu: this device may have no keyboard.
      if ! grep -qE '^[[:space:]]*set timeout=' "$cfg"; then
        sed -i '1i set timeout=0' "$cfg"
        sed -i '1i set timeout_style=hidden' "$cfg"
        echo "the regenerated config had no timeout: pinned it to boot straight through"
      fi
      # ...and restore the steamenv header block if grub-mkconfig did not produce one. SteamOS's
      # bootloader strips the verbosity parameters out of the kernel line and puts back either
      # $steamenv_quiet or $steamenv_noisy, chosen by $steamenv_verbosity — all defined in that
      # header. A regenerated config without it therefore strips them and adds nothing, and every
      # boot becomes a wall of console text. The SAME block sets timeout=0, so its absence is also
      # what left a handheld sitting at a boot menu with no keyboard. One missing block, both faults.
      if ! grep -q 'steamenv_init' "$cfg" 2>/dev/null && grep -q '^menuentry ' "$cfg" 2>/dev/null; then
        awk 'BEGIN{done=0}
             /^menuentry / && !done {
               print "## start header steamenv sub block (restored by SteamOS EGPU Buddy)"
               print "insmod steamenv"
               print "steamenv_loader_mode=auto"
               print "steamenv_kernel_mode=keep"
               print "steamenv_quiet=\"loglevel=3 splash quiet plymouth.ignore-serial-consoles fbcon=vc:4-6\""
               print "steamenv_noisy=\"loglevel=5 sysrq_always_enabled splash=verbose fbcon=nodefer\""
               print "steamenv_verbosity=\"\""
               print "timeout=0"
               print "timeout_style=menu"
               print "steamenv_init"
               print "## end steamenv header sub block"
               print ""
               done=1
             }
             {print}' "$cfg" > "$cfg.egpu-new" && mv "$cfg.egpu-new" "$cfg"
        echo "the regenerated config had no steamenv header: restored it (quiet boot + no menu)"
      fi
    else
      echo "could not regenerate the GRUB config; kernel parameters are written but not active yet"
    fi
  fi
elif [ -f /etc/default/grub ]; then                                   # GRUB (Arch)
  cur=$(sed -n 's/^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"$/\1/p' /etc/default/grub | head -1); new=$(merge "$cur")
  edit /etc/default/grub "s|^GRUB_CMDLINE_LINUX_DEFAULT=\".*\"|GRUB_CMDLINE_LINUX_DEFAULT=\"$new\"|" && did=1
  cfg=$(ls /boot/grub/grub.cfg /boot/efi/EFI/*/grub.cfg /boot/grub2/grub.cfg 2>/dev/null | head -1)
  [ $DRY = 1 ] || { [ -n "$cfg" ] && grub-mkconfig -o "$cfg" >/dev/null 2>&1 && echo "grub config regenerated: $cfg" || echo "regenerate your GRUB config (grub-mkconfig -o <grub.cfg>) to apply"; }
elif ls /boot/loader/entries/*.conf /efi/loader/entries/*.conf /boot/efi/loader/entries/*.conf >/dev/null 2>&1; then   # systemd-boot
  # CachyOS regenerates its entries from /etc/sdboot-manage.conf on every kernel update, and kernel-install from
  # /etc/kernel/cmdline: write those too, or the next kernel update drops the parameters again
  if [ -f /etc/sdboot-manage.conf ]; then cur=$(sed -n 's/^LINUX_OPTIONS="\(.*\)"$/\1/p' /etc/sdboot-manage.conf | head -1); new=$(merge "$cur")
    edit /etc/sdboot-manage.conf "s|^LINUX_OPTIONS=\".*\"|LINUX_OPTIONS=\"$new\"|" || true; fi
  if [ -f /etc/kernel/cmdline ]; then new=$(merge "$(head -1 /etc/kernel/cmdline)"); edit /etc/kernel/cmdline "1s|.*|$new|" || true; fi
  for f in /boot/loader/entries/*.conf /efi/loader/entries/*.conf /boot/efi/loader/entries/*.conf; do [ -f "$f" ] || continue
    cur=$(sed -n 's/^options[[:space:]]*//p' "$f" | head -1); new=$(merge "$cur"); edit "$f" "s|^options[[:space:]].*|options $new|" && did=1; done
else
  echo "no supported bootloader config found (rpm-ostree, /etc/default/limine, /etc/default/grub, /boot/loader/entries). Add these parameters by hand:"; echo "  $WANT"; exit 3
fi
[ $DRY = 1 ] && exit 0
[ $did = 1 ] || { [ "${regen-x}" != "" ] && written; } || { echo "the kernel parameters could not be written; add them by hand: $WANT"; exit 1; }
echo "reboot to activate the new kernel parameters"
