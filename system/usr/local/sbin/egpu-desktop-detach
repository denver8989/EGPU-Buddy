#!/usr/bin/env bash
# egpu-desktop-detach — Desktop Safe Detach on a ROG Ally, or any handheld that has used an ASUS XG Mobile, under SDDM
# (SteamOS). Called by egpu-safe-detach-ui instead of its KWin handoff; every other device keeps that handoff unchanged.
#
# Why: the handoff restarts KWin to move it off the eGPU. Under SDDM a KWin restart ends the login session, SDDM logs in
# again, twice per detach, and the eGPU was never released: the picture showed on the TV and the handheld, then on the
# TV only with the handheld black (ROG Xbox Ally X reports on 0.7.116 and 0.7.117). So instead, the way Game Mode's
# fallback on this hardware does it (egpu-gamemode-detach): pin the next login to the DESKTOP, stop the login session so
# nothing holds the eGPU, remove the eGPU, start the session again. It comes back as the desktop on the handheld screen,
# never Game Mode. The EXIT trap starts the session again whatever happens.
set -u; U=1000; RUNENV="XDG_RUNTIME_DIR=/run/user/$U DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$U/bus"
[ "$(id -u)" = 0 ] || { echo "run as root"; exit 1; }
{ [ "$(/usr/local/sbin/egpu-detect --device 2>/dev/null)" = rog-ally ] || [ -e /var/lib/nvegpu/xg-mobile-seen ]; } ||
  { echo "only for a ROG Ally / XG Mobile; other devices use the desktop handoff"; exit 2; }
# stopping the session ends the caller (the desktop app runs inside it): run in our own unit
# $1 = wayland|x11: the desktop the user is on, the one the next login keeps
if [ "${1:-}" != --run ]; then
  case "${1:-wayland}" in wayland|x11) ;; *) echo "usage: egpu-desktop-detach [wayland|x11]"; exit 64 ;; esac
  exec systemd-run --collect --quiet --unit="egpu-desktop-detach-$(date +%s)" /usr/local/sbin/egpu-desktop-detach --run "${1:-wayland}"
fi
DESK=plasma; [ "${2:-}" = x11 ] && DESK=plasmax11
ST=/run/nvegpu; mkdir -p $ST; LOG=/var/log/egpu-gamemode.log; HELPER=/usr/local/sbin/egpu-safe-detach
log(){ printf '%s desktop-detach: %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }
# full-length copy for support reports (the report shortens lines of the detach log): /run/nvegpu is in every snapshot
dlog(){ log "$*"; printf '%s\n' "$*" >> $ST/gm-driver.log; }; rm -f $ST/gm-driver.log $ST/gm-dmabuf.log
as_deck(){ runuser -u deck -- env $RUNENV "$@"; }
# the desktop app reads the user's status file; it is gone while the session is down, so /run/nvegpu carries it too
status(){ printf '{"state":"%s","message":"%s"}\n' "$1" "$2" > $ST/gm-status.json
  [ -d /run/user/$U ] && { mkdir -p /run/user/$U/nv-egpu-buddy; cp $ST/gm-status.json /run/user/$U/nv-egpu-buddy/safe-detach-status.json; chown -R deck: /run/user/$U/nv-egpu-buddy; } 2>/dev/null; }
DM_STOPPED=0; FBCON=""
fbcon_back(){ for v in $FBCON; do echo 1 > "$v/bind" 2>/dev/null; done; FBCON=""; }
trap 'fbcon_back; [ "$DM_STOPPED" = 1 ] && systemctl start display-manager.service >/dev/null 2>&1' EXIT
# the desktop pin is released once the desktop is back, on success and failure alike: left behind, it sent every
# "Return to Gaming Mode" back to the desktop until a reboot (ROG Xbox Ally X report on 0.7.120)
unpin_when_back(){ for _ in $(seq 1 60); do pgrep -U $U -x 'kwin_wayland|kwin_x11' >/dev/null 2>&1 && break; sleep 1; done
  pgrep -U $U -x 'kwin_wayland|kwin_x11' >/dev/null 2>&1 && /usr/local/sbin/egpu-dm-session unpin >/dev/null 2>&1; }
fail(){ log "FAILED: $1"; /usr/local/sbin/egpu-snapshot "desktop-detach-failed-rc$2" >/dev/null 2>&1; $HELPER --restore >/dev/null 2>&1
  fbcon_back; [ "$DM_STOPPED" = 1 ] && { DM_STOPPED=0; systemctl start display-manager.service >/dev/null 2>&1; }
  unpin_when_back; sleep 5; status DO_NOT_UNPLUG "$1"; exit "$2"; }

gpu=$(lspci -Dn 2>/dev/null | awk '$2=="0300:" && $3 ~ /^10de:/{print $1; exit}')
[ -n "$gpu" ] || { status SAFE_COMPLETE "No eGPU attached."; exit 0; }
systemctl is-active --quiet display-manager.service || fail "The login manager is not running; nothing was changed." 3
log "start (gpu=$gpu)"
status DETACHING "Restarting the desktop on the handheld screen without the eGPU; the screen goes dark for a moment. Do not unplug yet."
systemctl stop egpu-xgm-powercap 2>/dev/null   # XG Mobile power target loop: no nvidia-smi polling while the GPU is handed off
/usr/local/sbin/egpu-dm-session pin $DESK >/dev/null 2>&1 || fail "Could not keep the next login on the desktop; nothing was changed." 4
$HELPER --prep >/dev/null 2>&1 || fail "Could not hide the NVIDIA userspace; nothing was changed." 5
# audio off the eGPU's HDMI first, then WirePlumber stopped (it keeps the card open): as Game Mode's Safe Detach does
as_deck bash -c 'pactl set-default-sink "$(pactl list short sinks | awk "!/pci-0000_0[0-9a-f]_00.1/ && /alsa_output/{print \$2; exit}")" >/dev/null 2>&1; p=$(printf %s "'"${gpu%.*}"'" | tr : _); for c in $(pactl list short cards | awk -v p="$p" "index(\$2,p){print \$2}"); do pactl set-card-profile "$c" off; done; systemctl --user stop wireplumber' >/dev/null 2>&1
DM_STOPPED=1; systemctl stop display-manager.service >/dev/null 2>&1
# the user manager outlives the login session: let its desktop units go, then whatever still holds the eGPU (Steam, a game)
as_deck systemctl --user stop graphical-session.target >/dev/null 2>&1
nodes="/dev/nvidia0 /dev/nvidiactl /dev/nvidia-modeset /dev/nvidia-uvm $(ls -d /sys/bus/pci/devices/$gpu/drm/* 2>/dev/null | sed -n 's#.*/\(card[0-9]*\|renderD[0-9]*\)$#/dev/dri/\1#p' | tr '\n' ' ')"
held(){ fuser $nodes 2>/dev/null | tr -s ' \n' ' ' | grep -q '[0-9]'; }
for _ in $(seq 1 15); do held || break; sleep 1; done
if held; then
  for hp in $(fuser $nodes 2>/dev/null | tr -s ' \n' ' '); do [ "$(stat -c %u /proc/$hp 2>/dev/null)" = $U ] && kill -TERM "$hp" 2>/dev/null; done
  for _ in $(seq 1 10); do held || break; sleep 1; done
fi
# processes holding NVIDIA's shared GPU buffers (any dma-buf: nvidia-drm's read "drm", see below) or its libraries
holders(){ local p
  for p in /proc/[0-9]*; do
    n=$(grep -l '^exp_name:' "$p"/fdinfo/* 2>/dev/null | wc -l)
    nv=$(grep -lE 'libnvidia|libGLX_nvidia|libEGL_nvidia|libcuda|nvidia_drv' "$p/maps" 2>/dev/null)
    [ "$n" -gt 0 ] || [ -n "$nv" ] || continue
    printf '%s %s %s %s %s\n' "${p#/proc/}" "$(stat -c %u "$p" 2>/dev/null)" "$n" "$([ -n "$nv" ] && echo nvlib || echo -)" "$(cat "$p/comm" 2>/dev/null)"
  done; }
# what must never be stopped (owner's rule: anything else that holds the eGPU may be, if the system is not harmed)
me=$$; anc=" $me "; while [ "$me" -gt 1 ] 2>/dev/null; do me=$(awk '{print $4}' /proc/$me/stat 2>/dev/null); [ -n "$me" ] || break; anc="$anc$me "; done
protected(){ local p=$1 c; [ "$p" -le 1 ] 2>/dev/null && return 0; case "$anc" in *" $p "*) return 0 ;; esac
  c=$(cat /proc/$p/comm 2>/dev/null); [ -n "$c" ] || return 0   # gone, or a kernel thread
  case "$c" in systemd*|init|dbus-daemon|dbus-broker*|sddm*|polkitd|udevadm|egpu-*|nv-egpu-*|kthreadd) return 0 ;; esac
  return 1; }
inuse(){ cat /sys/module/nvidia_drm/refcnt /sys/module/nvidia_uvm/refcnt 2>/dev/null | grep -qv '^0$'; }
# no process holds the eGPU now, but the driver can stay in use a little longer while the desktop's GPU memory is freed;
# the unload then failed straight away ("nvidia stack still loaded", Ally X on 0.7.120): wait for the users to drop to 0
for _ in $(seq 1 20); do inuse || break; sleep 1; done
# still in use with no process on it (Ally X on 0.7.122: nvidia_drm=2): with the session stopped the screen drops to text
# mode and the text console takes the framebuffers, the eGPU's too. Game Mode never drops to text, so its detach is not
# affected. Unbind the console for the removal (NVIDIA's way to unload nvidia-drm with fbdev on); bound again after it.
if inuse; then
  dlog "driver still in use with no process on it: $(for m in nvidia_drm nvidia_modeset nvidia; do printf '%s=%s ' $m "$(cat /sys/module/$m/refcnt 2>/dev/null)"; done)· consoles: $(for v in /sys/class/vtconsole/vtcon*; do printf '%s(%s,bind=%s) ' "${v##*/}" "$(cat $v/name)" "$(cat $v/bind)"; done)· framebuffers: $(cat /sys/class/graphics/fb*/name 2>/dev/null | tr '\n' ' ')"
  for v in /sys/class/vtconsole/vtcon*; do [ "$(cat "$v/bind" 2>/dev/null)" = 1 ] && grep -qi 'frame buffer' "$v/name" && echo 0 > "$v/bind" 2>/dev/null && FBCON="$FBCON $v"; done
  for _ in $(seq 1 5); do inuse || break; sleep 1; done
  dlog "text console released (${FBCON:- none was bound}); driver users now: $(cat /sys/module/nvidia_drm/refcnt 2>/dev/null)"
  # Still held: GPU buffers shared with another process or driver. nvidia-drm exports them through the kernel's
  # drm_gem_prime_export(), which labels every such buffer "drm" (exp_name, "white lie for debug" in drm_prime.c) while
  # pinning nvidia_drm as its owner. Searching for "nvidia" never found one (0.7.124 reported "0" and no process on
  # Ally X reports while nvidia_drm stayed at 1-2), and fuser on the device nodes cannot see them either: a shared-buffer
  # handle is not a device file. So: every process that holds any shared buffer, and every user process with the NVIDIA
  # driver libraries still loaded. The login session is stopped, so a user process left holding the eGPU is stale; it
  # is asked to quit, then stopped. (The desktop on this hardware ran on both GPUs, sharing buffers between them.)
  if inuse; then
    mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug 2>/dev/null
    # the holder table last: snapshots keep the end of each /run/nvegpu log
    { echo "--- /sys/kernel/debug/dma_buf/bufinfo (exporter names read \"drm\" for nvidia-drm and amdgpu alike)"
      head -80 /sys/kernel/debug/dma_buf/bufinfo 2>/dev/null
      echo "--- nvidia_drm users: $(cat /sys/module/nvidia_drm/refcnt 2>/dev/null)"; echo "pid uid shared-buffers nvidia-libs name"; holders; } > $ST/gm-dmabuf.log 2>&1
    dlog "still in use: shared buffers in the kernel: $(grep -cE '^[0-9]{8}' /sys/kernel/debug/dma_buf/bufinfo 2>/dev/null); holders: $(holders | awk '{printf "%s(%s,uid %s,%s bufs,%s) ", $1, $5, $2, $3, $4}')"
    # Owner's rule: stop anything that holds the eGPU, as long as stopping it does not harm the system. So not only the
    # user's leftovers: any holder, except the processes the system needs to keep running (init and systemd's own
    # services, the message bus, the login manager and logind, udev) and this detach with the processes that started
    # it and EGPU Buddy's own tools. A service stopped here is one systemd can start again; Decky is restarted below.
    decky_was_up=0; systemctl is-active --quiet plugin_loader.service 2>/dev/null && decky_was_up=1
    for sig in TERM KILL; do
      victims=$(holders | while read -r p _; do protected "$p" || echo "$p"; done)
      [ -n "$victims" ] || break
      dlog "asking the processes that still hold the eGPU to quit ($sig): $(for v in $victims; do printf '%s(%s) ' $v "$(cat /proc/$v/comm 2>/dev/null)"; done)"
      kill -$sig $victims 2>/dev/null
      for _ in $(seq 1 10); do inuse || break; sleep 1; done
      inuse || break
    done
    [ "$decky_was_up" = 1 ] && ! systemctl is-active --quiet plugin_loader.service 2>/dev/null && { systemctl start plugin_loader.service >/dev/null 2>&1; dlog "Decky plugin loader started again"; }
    dlog "driver users after that: nvidia_drm=$(cat /sys/module/nvidia_drm/refcnt 2>/dev/null) nvidia_uvm=$(cat /sys/module/nvidia_uvm/refcnt 2>/dev/null)$(inuse && printf '; still held by: %s' "$(holders | awk '{printf "%s(%s,uid %s) ", $1, $5, $2}')")"
  fi
fi
# what each screen shows, for the log: connected = cable in, lit = a picture is being sent to it
screens(){ for c in /sys/class/drm/card*-*; do [ -e "$c/status" ] || continue; case "${c##*/}" in *Writeback*) continue ;; esac
  printf '%s=%s%s ' "${c##*/}" "$(cat "$c/status")" "$([ "$(cat "$c/enabled" 2>/dev/null)" = enabled ] && echo ',lit')"; done; }
log "screens with the session stopped: $(screens)"
{ echo "driver users: $(for m in nvidia_drm nvidia_modeset nvidia_uvm nvidia; do printf '%s=%s ' $m "$(cat /sys/module/$m/refcnt 2>/dev/null)"; done)"
  echo "holders before teardown (session stopped):"; for hp in $(fuser $nodes 2>/dev/null | tr -s ' \n' ' '); do echo "  $hp $(cat /proc/$hp/comm 2>/dev/null) cmd=$(tr '\0' ' ' </proc/$hp/cmdline 2>/dev/null | cut -c1-80)"; done; } > $ST/gm-holders.log 2>&1
# Owner's rule: Desktop Safe Detach must finish whatever still holds the eGPU, as long as the session can recover. When
# the orderly teardown cannot unload the driver and no process holds the eGPU any more (everything that could be stopped
# was), only the kernel does (GPU buffers another driver still references). Then remove the eGPU the way an unplug does:
# the hot-unplug driver is built for exactly that (controlled PCIe removal sets inRemoval and unplugs the DRM device with
# its users still attached; nv_pci_remove waits a bounded time for the usage count, then forces the removal), and the
# same machine already recovered from a real unplug in the middle of a desktop session (Ally X, 2026-10-18 19:29). The
# login session is stopped, so nothing is drawing on the eGPU. The next Attach takes the after-a-surprise-removal path
# (surprise-pending: unbind, reset, bind) in case the driver could not be unloaded meanwhile.
force_remove(){
  local aud=${gpu%.*}.1 i
  dlog "forced removal: the orderly teardown could not unload the driver and nothing but the kernel holds the eGPU ($(for m in nvidia_drm nvidia_modeset nvidia_uvm nvidia; do printf '%s=%s ' $m "$(cat /sys/module/$m/refcnt 2>/dev/null)"; done)); removing it as an unplug would"
  /usr/local/sbin/egpu-snapshot desktop-detach-forced-removal >/dev/null 2>&1
  date +%s > $ST/surprise-pending; date +%s > $ST/deliberate-removal   # ours, not a cable pull: the recovery stays out
  [ -e "/sys/bus/pci/devices/$aud/remove" ] && echo 1 > "/sys/bus/pci/devices/$aud/remove" 2>/dev/null
  timeout 150 sh -c "echo 1 > /sys/bus/pci/devices/$gpu/remove" 2>/dev/null
  for i in $(seq 1 30); do [ -e "/sys/bus/pci/devices/$gpu" ] || break; sleep 1; done
  # kept 30 s more: the device leaves sysfs at once, and the cable-pull recovery (started by udev, a few seconds later)
  # found the marker already gone and ran on this removal as if the cable had been pulled (2026-10-19). A timer unit
  # clears it, so it cannot outlive a script that is stopped; if that fails, cleared now
  systemd-run --no-block --collect --quiet --on-active=30 /usr/bin/rm -f $ST/deliberate-removal >/dev/null 2>&1 || rm -f $ST/deliberate-removal
  [ -e "/sys/bus/pci/devices/$gpu" ] && { dlog "forced removal: the eGPU is still on the bus"; return 1; }
  for i in $(seq 1 20); do modprobe -r nvidia_drm nvidia_modeset nvidia_uvm nvidia_peermem nvidia 2>/dev/null; lsmod | grep -q '^nvidia' || break; sleep 1; done
  /usr/local/sbin/nv-egpu-buddy-privileged pin-tunnel-ports auto >/dev/null 2>&1
  dlog "forced removal: eGPU off the bus; NVIDIA driver $(lsmod | grep -q '^nvidia' && echo "still loaded ($(lsmod | awk '/^nvidia/{printf "%s=%s ", $1, $3}')), the next Attach resets it" || echo unloaded)"
  return 0; }
if ! $HELPER --teardown-only > $ST/gm-helper.log 2>&1; then
  why=$(grep -oE 'still held by:.*|still loaded:.*|ABORTING.*' $ST/gm-helper.log | head -1 | cut -c1-120)
  # only when the eGPU is still there, the driver is what blocks, and no process holds it (a process would be on fire)
  # never with the eGPU's sound card still bound: removing it then hangs in snd_card_free (the documented reboot case)
  aud_bound=0; [ -L "/sys/bus/pci/devices/${gpu%.*}.1/driver" ] && aud_bound=1
  if case "$why" in *"still loaded"*) true ;; *) false ;; esac && [ "$aud_bound" = 0 ] &&
     lspci -Dn 2>/dev/null | grep -qE '0300: 10de:' && lsmod | grep -q '^nvidia' && ! held && [ -z "$(holders 2>/dev/null | awk '{print $1}' | while read -r p; do protected "$p" || echo "$p"; done)" ]; then
    force_remove || fail "eGPU teardown failed and the forced removal did not take; the GPU is still attached. Do not unplug. ($why)" 7
  else
    fail "eGPU teardown failed; the GPU is still attached. Do not unplug. ($why)" 7
  fi
fi
$HELPER --restore >/dev/null 2>&1; fbcon_back
DM_STOPPED=0; systemctl start display-manager.service >/dev/null 2>&1
/usr/local/sbin/egpu-panel on >/dev/null 2>&1
log "eGPU removed with the session stopped; desktop starting again on the handheld screen"
lspci -Dn 2>/dev/null | grep -qE '0300: 10de:' && fail "NVIDIA GPU still present after teardown. Do not unplug." 8
unpin_when_back
# not a success while an external screen still shows a picture: only the handheld's own panel (eDP) may be lit now.
# (A picture frozen on a monitor of the removed eGPU cannot be seen from here; the screens line above shows what was lit.)
sleep 5; log "screens after: $(screens)"
ext=$(for c in /sys/class/drm/card*-*; do case "${c##*/}" in *eDP*|*Writeback*) continue ;; esac
  n=${c##*/}; [ "$(cat "$c/enabled" 2>/dev/null)" = enabled ] && printf '%s ' "${n#*-}"; done)
[ -z "$ext" ] || { /usr/local/sbin/egpu-snapshot desktop-detach-screen-still-lit >/dev/null 2>&1; log "FAILED: external screen still lit: $ext"
  status DO_NOT_UNPLUG "Safe Detach did not finish: ${ext% } still shows a picture. Please send a support report."; exit 9; }
/usr/local/sbin/egpu-snapshot desktop-detach-done >/dev/null 2>&1
status SAFE_COMPLETE "The eGPU is off the PCI bus. You may unplug it (or Attach again without replugging)."; log "done"; exit 0
