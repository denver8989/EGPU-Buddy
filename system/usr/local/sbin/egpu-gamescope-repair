#!/usr/bin/env bash
# egpu-gamescope-repair — keep the GBM-scanout gamescope (the NVIDIA scan-out corruption fix) working across SteamOS
# updates and channel switches, with the pieces that already exist: build-steamos.sh builds it in the SteamOS build root,
# egpu-gamemode-switch reloads Game Mode (it refuses while a game runs).
#   egpu-gamescope-repair --needed   exit 0 when a rebuild is needed for this OS build (used by the self-heal at boot)
#   egpu-gamescope-repair            rebuild if needed, then reload Game Mode onto it once no game is running
# Started by: the self-heal (the private build cannot run on this OS), and egpu-buddy-gamescope-repair.path (the session
# shim marked it as crashing on this OS build). Builds at most ONCE per OS build: if the rebuilt one still fails, Game
# Mode stays on Valve's gamescope (working, but with the corruption) and the log says so - that needs a project update.
set -u
UH=/home/deck; LOG=/var/log/egpu-gamescope-repair.log
PRIV=$UH/.local/gamescope-gbm/usr/bin/gamescope; BAD=$UH/.local/state/nv-egpu-buddy/gamescope-bad
DONE=/var/lib/nvegpu/gamescope-rebuilt-for
BZTRIES=/var/lib/nvegpu/gamescope-bazzite-tries   # Bazzite only: line 1 the OS build, line 2 the builds tried for it
bz_tries(){ if [ "$(sed -n 1p "$BZTRIES" 2>/dev/null)" = "$OS" ]; then sed -n 2p "$BZTRIES"; else echo 0; fi; }
BUILD=$UH/.local/share/steamos-egpu-buddy/packaging/gamescope-gbm/build-steamos.sh
BR=/home/.egpu-buddy/buildroot
log(){ printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; echo "$*"; }
os_id(){ ( . /etc/os-release 2>/dev/null; printf '%s' "${BUILD_ID:-${VERSION_ID:-}}" ); printf -- '-%s' "$(uname -r)"; }
# Bazzite: the build lives in /usr/local (system-wide, user-independent) and is rebuilt in a Fedora container matching
# the running Bazzite (podman; the device has no compiler).
BZ=0
if grep -qsiE '^(ID|NAME)="?bazzite' /etc/os-release; then
  BZ=1; PRIV=/usr/local/lib/egpu-buddy/gamescope-gbm/usr/bin/gamescope
  BUILD=$UH/.local/share/steamos-egpu-buddy/packaging/gamescope-gbm/build-bazzite.sh
fi
# the gamescope version Bazzite ships right now (its Open Gaming Collective tag, e.g. 3.16.31-ogc2) and the one ours was
# built from: the fix is always built INTO the version Bazzite has, so a different one means "rebuild"
# CachyOS (and other pacman systems that are not SteamOS / Bazzite), NVIDIA install: EGPU Buddy's gamescope is built
# INTO THE GAMESCOPE THE SYSTEM HAS (packaging/gamescope-gbm/build-system.sh: Valve's source at the installed version +
# our commits, three-way merged), so a system update that brings a new gamescope gets our changes again. Up to 3 tries
# per gamescope version; "our changes do not apply" (exit 3) stops until the next version. The user is told what was
# detected and what happens (Game Mode toast + desktop notification). Game Mode keeps working all the while: the last
# good build of ours, else the system gamescope.
CY=0
if [ "$BZ" = 0 ] && ! command -v steamos-readonly >/dev/null 2>&1 && command -v pacman >/dev/null 2>&1 &&
   [ "$(cat /etc/nv-egpu-buddy/gpu-vendor 2>/dev/null)" != amd ] && [ "$(cat /etc/nv-egpu-buddy/track 2>/dev/null)" != nv-gpu-buddy ]; then
  CY=1; BUILD=$UH/.local/share/steamos-egpu-buddy/packaging/gamescope-gbm/build-system.sh
fi
CYTRIES=/var/lib/nvegpu/gamescope-system-tries   # line 1 the gamescope version, line 2 the builds tried for it
CYCANNOT=/var/lib/nvegpu/gamescope-system-cannot # the version our changes do not apply to
cy_ver(){ pacman -Q gamescope 2>/dev/null | awk '{print $2}' | sed 's/^[0-9]*://; s/-[^-]*$//'; }
cy_built(){ cat "$UH/.local/gamescope-gbm/BUILT-FROM" 2>/dev/null; }
cy_tries(){ if [ "$(sed -n 1p "$CYTRIES" 2>/dev/null)" = "$(cy_ver)" ]; then sed -n 2p "$CYTRIES"; else echo 0; fi; }
tell(){ # what the guard detected / does, to the user: Game Mode toast (the plugin shows it) and a desktop notification
  python3 -c 'import json,sys; p=sys.argv[1]
try: d=json.load(open(p))
except Exception: d={}
d["notice"]=sys.argv[2]; json.dump(d,open(p,"w"))' "$UH/.config/egpu-buddy/plugin.json" "$1" 2>/dev/null; chown "$(stat -c %U "$UH")": "$UH/.config/egpu-buddy/plugin.json" 2>/dev/null
  # the desktop's notification (5 s at most, in the background: in Game Mode nothing answers and it waited for ever)
  ( timeout 5 runuser -u "$(stat -c %U "$UH")" -- env DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(stat -c %u "$UH")/bus \
    notify-send -a "EGPU Buddy" -i video-display "EGPU Buddy" "$1" >/dev/null 2>&1 & ) || true
  log "told the user: $1"; }
bz_tag(){ /usr/bin/gamescope --version 2>&1 | grep -oE 'gamescope version [^ ]+' | head -1 | awk '{print $3}' | sed 's/+$//'; }
bz_built_from(){ cat /usr/local/lib/egpu-buddy/gamescope-gbm/BUILT-FROM 2>/dev/null; }
OS=$(os_id)
# (the crash mark keeps the shim's own id format; only "rebuilt once for this OS build" also carries Bazzite's image version)
[ "$BZ" = 1 ] && OS="$OS-$( . /etc/os-release 2>/dev/null; printf '%s' "${VERSION:-}" | tr ' ' _ )-gamescope-$(bz_tag)"

reason(){
  if [ "$BZ" = 1 ]; then                                              # Bazzite: a Fedora container builds it
    command -v podman >/dev/null 2>&1 && [ -f "$BUILD" ] || return 1
    # at most two builds per Bazzite build (BZTRIES), not one: the first can fail for a reason that is gone the next time
    # (Bazzite 44.20261026, gamescope 3.17.0-ogc1: an EGPU Buddy update replaced the build files during the build, and the
    # single try recorded before it left Game Mode on Bazzite's own gamescope, the picture corruption back, for good)
    [ "$(bz_tries)" -ge 2 ] 2>/dev/null && return 1
    [ -e /etc/nv-egpu-buddy/gamescope-wanted ] || return 1            # the installer chose ours (Bazzite's own lacks the fix)
    [ -n "$(bz_tag)" ] || return 1
    [ -x "$PRIV" ] || { echo "not built for this Bazzite yet (gamescope $(bz_tag))"; return 0; }
    [ "$(bz_built_from)" = "$(bz_tag)" ] || { echo "Bazzite's gamescope is now $(bz_tag) (ours was built into $(bz_built_from))"; return 0; }
    # the same gamescope version on a new Fedora base (Bazzite 44 -> 45) runs ours on libraries it was not built against
    local bf nf; bf=$(cut -d' ' -f1 /usr/local/lib/egpu-buddy/gamescope-gbm/BUILD-ID 2>/dev/null); nf="fedora-$( . /etc/os-release 2>/dev/null; printf '%s' "${VERSION_ID:-}")"
    [ -z "$bf" ] || [ "$bf" = "$nf" ] || { echo "Bazzite is now on $nf (ours was built on $bf)"; return 0; }
  elif [ "$CY" = 1 ]; then                                            # CachyOS: built into the installed version
    local v; v=$(cy_ver); [ -n "$v" ] && [ -f "$BUILD" ] || return 1
    [ "$(cat "$CYCANNOT" 2>/dev/null)" = "$v" ] && return 1           # our changes do not apply to it: wait for a new one
    [ "$(cy_tries)" -ge 3 ] 2>/dev/null && return 1                   # tried 3 times for this version
    for t in git meson ninja cc cmake glslangValidator; do command -v $t >/dev/null 2>&1 || { echo "cannot build: $t missing (pacman -S --needed base-devel git meson ninja cmake glslang)" >&2; return 1; }; done
    [ "$(cy_built)" = "$v" ] && [ -x "$PRIV" ] && ! ldd "$PRIV" 2>/dev/null | grep -q 'not found' &&
      ! case "$(cat "$BAD" 2>/dev/null)" in "$(os_id) "*) true ;; *) false ;; esac && return 1
    local b; b=$(cy_built)
    if [ "$b" = "$v" ]; then echo "EGPU Buddy's gamescope for $v does not run any more"; else echo "a system update installed gamescope $v (EGPU Buddy's was built into ${b:-an older version})"; fi
    return 0
  else
  command -v steamos-readonly >/dev/null 2>&1 || return 1            # SteamOS only; other systems build it with the installer
  [ -x "$BR/usr/bin/makepkg" ] && [ -f "$BUILD" ] || return 1         # no build root / payload: nothing this can do
  [ "$(cat "$DONE" 2>/dev/null)" = "$OS" ] && return 1                # already rebuilt for this OS build
  [ -x "$PRIV" ] || return 1                                          # never installed (e.g. --no-gamescope, AMD): not ours to add
  fi
  if ldd "$PRIV" 2>/dev/null | grep -q 'not found'; then echo "cannot start on this OS (missing libraries)"; return 0; fi
  case "$(cat "$BAD" 2>/dev/null)" in "$(os_id) "*) echo "kept crashing on this OS build"; return 0 ;; esac
  return 1
}
if [ "${1:-}" = --needed ]; then r=$(reason) || exit 1; echo "gamescope repair needed: $r"; exit 0; fi

# ---- --verify: is Game Mode on the eGPU REALLY running the NVIDIA picture fix? Started ~40 s after every Game Mode start
# (egpu-gamemode-switch) and attach (egpu-hotplug-mount). Why: the checks above only fire when the GBM build cannot start
# or keeps crashing. On a ROG Xbox Ally X it was installed and fine, yet Valve's gamescope ran (UI corruption) and every
# check passed. The cause is read from the breadcrumbs the session wrapper and the gamescope shim leave with their PID
# (each one execs the next, so gamescope keeps that PID). Checking and logging happen everywhere (read-only); REPAIRS are
# armed on a ROG Ally or with an XG Mobile only, once per cause and OS build (no loops). Where the fix runs (a Legion Go
# with the AORUS box), this finds it running and does nothing.
VDONE=/var/lib/nvegpu/gamescope-verify-tried; GSVER=/var/lib/nvegpu/gamescope-os-version-noticed
ally_xgm(){ [ "$(/usr/local/sbin/egpu-detect --device 2>/dev/null)" = rog-ally ] || [ -e /var/lib/nvegpu/xg-mobile-seen ]; }
usd(){ runuser -u "$(stat -c %U "$UH")" -- env XDG_RUNTIME_DIR=/run/user/$(stat -c %u "$UH") \
  DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(stat -c %u "$UH")/bus systemctl --user "$@" 2>/dev/null; }
reload_when_idle(){   # the same rules as the reload after a rebuild below: never while a game, attach or detach runs
  for _ in $(seq 1 720); do
    pgrep -n -x 'gamescope(-wl)?' >/dev/null || { log "verify: Game Mode is not running; the repair applies at its next start"; return 0; }
    if ! /usr/local/sbin/egpu-game-running && [ ! -e /run/nvegpu/gm-attach-pending ] && ! grep -qE '"state":"(SWITCHING|DETACHING)"' /run/nvegpu/gm-status.json 2>/dev/null; then
      log "verify: no game running: reloading Game Mode"; /usr/local/sbin/egpu-gamemode-switch >> "$LOG" 2>&1 && log "verify: reloaded" || log "verify: reload did not complete (rc $?)"; return 0
    fi
    sleep 30
  done
  log "verify: a game kept running for 6 hours; the repair applies at the next Game Mode start"
}
# 3. SteamOS moved past the gamescope the fix is built from: the fix keeps working (it is a whole gamescope of its own), but
#    it no longer has what the newer one adds. Say so once per OS gamescope version: that needs an EGPU Buddy update.
os_gamescope_note(){
  local osv fixv; osv=$(pacman -Q gamescope 2>/dev/null | awk '{print $2}'); osv=${osv%%-*}
  fixv=$(timeout 5 "$PRIV" --version 2>&1 | grep -oE 'gamescope version [0-9.]+' | grep -oE '[0-9]+(\.[0-9]+)+' | head -1)
  [ -n "$osv" ] && [ -n "$fixv" ] || return 0
  [ "$(printf '%s\n%s\n' "$fixv" "$osv" | sort -V | tail -1)" = "$fixv" ] && return 0      # the fix is as new or newer
  [ "$(cat "$GSVER" 2>/dev/null)" = "$osv" ] && return 0
  echo "$osv" > "$GSVER"
  log "verify: SteamOS now ships gamescope $osv, newer than the NVIDIA picture fix's gamescope $fixv"
  mkdir -p /run/nvegpu; printf '%s\n' "SteamOS updated gamescope to $osv. The NVIDIA picture fix keeps working on its own gamescope ($fixv); an EGPU Buddy update will bring it up to date." > /run/nvegpu/notice
  chown "$(stat -c %U "$UH")": /run/nvegpu/notice 2>/dev/null || true
}
if [ "${1:-}" = --verify ]; then
  [ "$(id -u)" = 0 ] || { echo "run as root"; exit 1; }
  exec 8>/run/egpu-gamescope-repair.lock; flock -n 8 || { log "verify: a repair is already running"; exit 0; }
  g=$(pgrep -n -x 'gamescope(-wl)?') || exit 0
  ls -l /proc/$g/fd 2>/dev/null | grep -q '/dev/nvidia' || exit 0      # on the handheld's own GPU: the fix is not used there
  [ -x "$PRIV" ] && os_gamescope_note
  exe=$(readlink -f /proc/$g/exe)
  [ "$exe" = "$(readlink -f "$PRIV")" ] && { log "verify: the NVIDIA picture fix is running (gamescope $g)"; exit 0; }
  R=/run/user/$(stat -c %u "$UH")/nv-egpu-buddy
  wpid=$(sed -n 's/^pid=//p' "$R/session-wrapper" 2>/dev/null); spid=$(sed -n 's/^pid=//p' "$R/gamescope-shim" 2>/dev/null)
  # handheld screen with the games on the eGPU: gamescope composites on the handheld's GPU by design (Valve's gamescope)
  [ "$wpid" = "$g" ] && grep -qx 'HANDHELD_GPU=1' "$R/session-wrapper" 2>/dev/null && { log "verify: Game Mode is on the handheld screen with the games on the eGPU; the picture fix is not used on that route"; exit 0; }
  if [ ! -x "$PRIV" ]; then cause=not-installed
  elif [ "$wpid" != "$g" ]; then cause=wrapper
  elif [ "$spid" != "$g" ]; then cause=shim
  elif [ -s "$BAD" ]; then cause=marked
  elif ldd "$PRIV" 2>/dev/null | grep -q 'not found'; then cause=libraries
  else cause=other; fi
  log "verify: Game Mode on the eGPU is NOT running the NVIDIA picture fix (gamescope $g = $exe); cause: $cause"
  ally_xgm || { log "verify: automatic repair is armed on a ROG Ally / XG Mobile only; nothing changed on this machine"; exit 0; }
  [ "$(cat "$VDONE" 2>/dev/null)" = "$OS $cause" ] && { log "verify: already tried for '$cause' on this OS build; the support report has the details"; exit 0; }
  mkdir -p "$(dirname "$VDONE")"; echo "$OS $cause" > "$VDONE"
  case "$cause" in
    wrapper)
      # the session unit must start EGPU Buddy's wrapper (it patches the stock session and puts the shim in front of
      # gamescope). If something else is in effect, add a drop-in that sorts after every other one; check it took.
      SDD=$UH/.config/systemd/user/gamescope-session.service.d; LAST=$SDD/zzz-nv-egpu-buddy-ally.conf
      eff=$(usd show -p ExecStart --value gamescope-session.service)
      log "verify: session unit ExecStart: ${eff:0:200} · drop-ins: $(usd show -p DropInPaths --value gamescope-session.service | cut -c1-300)"
      if [ -n "$eff" ] && [[ "$eff" != *nv-egpu-gamescope-session* ]] && [ -f "$SDD/10-nv-egpu-buddy.conf" ]; then
        printf '%s\n' "# EGPU Buddy (egpu-gamescope-repair --verify, ROG Ally / XG Mobile): another drop-in replaced our ExecStart; this sorts last" \
          '[Service]' 'ExecStart=' "ExecStart=$UH/.local/bin/nv-egpu-gamescope-session" > "$LAST" && chown "$(stat -c %U "$UH")": "$LAST"
        usd daemon-reload
        if [[ "$(usd show -p ExecStart --value gamescope-session.service)" == *nv-egpu-gamescope-session* ]]; then
          log "verify: the session starts through EGPU Buddy's wrapper again ($LAST)"; reload_when_idle
        else rm -f "$LAST"; usd daemon-reload; log "verify: that did not take; took it out again"; fi
      else
        log "verify: the unit already names the wrapper (or none could be read), but the wrapper did not start this gamescope; not changing anything"
      fi ;;
    shim)
      if [ -x "$UH/.local/lib/nv-egpu-buddy/gamescope-shim/gamescope" ]; then
        log "verify: the wrapper ran but gamescope was found outside the shim (PATH: $(sed -n 's/^PATH=//p' "$R/session-wrapper" | cut -c1-200)); not changing anything"
      else
        log "verify: the gamescope shim is missing: re-applying EGPU Buddy's files"
        SELFHEAL_FORCE=1 bash "$UH/.local/share/steamos-egpu-buddy/selfheal.sh" >> "$LOG" 2>&1 || true; reload_when_idle
      fi ;;
    marked)
      log "verify: clearing the 'crashing' mark ($(cat "$BAD" 2>/dev/null)) so the GBM build is used again"
      rm -f "$BAD"; reload_when_idle ;;
    libraries)
      log "verify: the GBM build cannot start on this OS: rebuilding it"; rm -f "$DONE"; flock -u 8; exec "$0" ;;
    *) log "verify: no automatic repair for '$cause'; the support report has the details" ;;
  esac
  exit 0
fi
[ "$(id -u)" = 0 ] || { echo "run as root"; exit 1; }
r=$(reason) || { log "nothing to repair"; exit 0; }
log "=== GBM-scanout gamescope: $r (OS $OS) ==="

# never build over a binary that is running (CachyOS: a new folder and a link switch, the running one is not touched)
[ "$CY" = 1 ] || for g in $(pgrep -x 'gamescope(-wl)?'); do
  [ "$(readlink -f /proc/$g/exe 2>/dev/null)" = "$(readlink -f "$PRIV" 2>/dev/null)" ] && { log "the private build is running; nothing to repair"; exit 0; }
done
# the driver build / re-pack use the same build root (pacman lock): wait for them
for _ in $(seq 1 240); do
  systemctl is-active --quiet egpu-buddy-driver-build.service egpu-buddy-driver-repack.service || break; sleep 30
done
NETCHK=https://steamdeck-packages.steamos.cloud/; { [ "$BZ" = 1 ] || [ "$CY" = 1 ]; } && NETCHK=https://github.com/   # where the build fetches from
for _ in $(seq 1 40); do curl -sI -o /dev/null --max-time 8 "$NETCHK" 2>/dev/null && break; sleep 30; done

if [ "$BZ" = 1 ]; then   # Bazzite: count the try BEFORE building (a hang or a failure is retried once, never in a loop)
  n=$(bz_tries); printf '%s\n%s\n' "$OS" "$(( ${n:-0} + 1 ))" > "$BZTRIES"
elif [ "$CY" = 1 ]; then # CachyOS: counted per gamescope version (3 tries), before building
  n=$(cy_tries); printf '%s\n%s\n' "$(cy_ver)" "$(( ${n:-0} + 1 ))" > "$CYTRIES"
else
echo "$OS" > "$DONE"    # recorded BEFORE building: a build that hangs or fails is not retried in a loop on this OS build
fi
bz_build(){ # Bazzite: build in fedora:<this Bazzite's Fedora version>, then swap it in atomically (a running gamescope keeps
            # the old binary busy, so it is never copied over in place)
  local T=/var/lib/nvegpu/gamescope-build V tag rc; V=$( . /etc/os-release; echo "${VERSION_ID:-44}" ); tag=$(bz_tag)
  rm -rf "${T:?}"; mkdir -p "$T"
  # a private copy of the build files: an EGPU Buddy update replaces the installed copy, and did so in the middle of a
  # build ("cat: /gs/bazzite/BASE-TAG: No such file or directory")
  local G=/var/lib/nvegpu/gamescope-build-src; rm -rf "${G:?}"; cp -a "$(dirname "$BUILD")" "$G" || return 1
  podman run --rm --network host --security-opt label=disable -v "$G:/gs:ro" -v "$T:/out" \
    "registry.fedoraproject.org/fedora:$V" bash /gs/build-bazzite.sh /out "$tag"; rc=$?
  rm -rf "${G:?}"
  [ "$rc" = 3 ] && printf '%s\n2\n' "$OS" > "$BZTRIES"   # the fix does not apply to this version: a second try cannot change that
  if [ "$rc" != 0 ]; then
    # the fix could not be built into THIS version: Game Mode must not keep an older gamescope of ours; it uses Bazzite's own
    rm -rf "${T:?}" /usr/local/lib/egpu-buddy/gamescope-gbm/usr /usr/local/lib/egpu-buddy/gamescope-gbm/BUILT-FROM
    [ "$rc" = 3 ] && log "the NVIDIA picture fix does not apply to Bazzite's gamescope $tag yet: Game Mode uses Bazzite's own gamescope (needs an EGPU Buddy update)"
    return 1
  fi
  [ -x "$T/usr/bin/gamescope" ] && ! ldd "$T/usr/bin/gamescope" 2>/dev/null | grep -q 'not found' || return 1
  local D=/usr/local/lib/egpu-buddy/gamescope-gbm; mkdir -p "$D"; rm -rf "${D:?}/usr.new" "${D:?}/usr.old"; cp -a "$T/usr" "$D/usr.new"
  [ -d "$D/usr" ] && mv "$D/usr" "$D/usr.old"; mv "$D/usr.new" "$D/usr"; cp "$T/BUILT-FROM" "$T/BUILD-ID" "$D/" 2>/dev/null
  rm -rf "${D:?}/usr.old" "${T:?}"
  command -v restorecon >/dev/null && restorecon -R "$D" 2>/dev/null; rm -f "$BAD"; return 0; }
cy_build(){ # CachyOS: built as the user into ~/.local/gamescope-egpu-<version>, then ~/.local/gamescope-gbm/usr points at
            # it (a link switch: a running gamescope keeps its own files). The build it replaces stays as the fallback.
  local v u D G rc; v=$(cy_ver); u=$(stat -c %U "$UH"); D="$UH/.local/gamescope-egpu-$v"; G="$UH/.local/gamescope-gbm"
  local S="$UH/.cache/egpu-buddy/gamescope-src"
  local B=/var/lib/nvegpu/gamescope-build-src; rm -rf "${B:?}"; cp -a "$(dirname "$BUILD")" "$B" && chown -R "$u": "$B" || return 1
  rm -rf "${D:?}"; runuser -u "$u" -- mkdir -p "$D" "$UH/.cache/egpu-buddy"
  runuser -u "$u" -- env HOME="$UH" GAMESCOPE_SRC="$S" nice -n 10 bash "$B/build-system.sh" "$v" "$D/usr"; rc=$?
  rm -rf "${B:?}" "${S:?}"
  if [ "$rc" = 3 ]; then echo "$v" > "$CYCANNOT"; rm -rf "${D:?}"; return 3; fi
  [ "$rc" = 0 ] && [ -x "$D/usr/bin/gamescope" ] && ! ldd "$D/usr/bin/gamescope" 2>/dev/null | grep -q 'not found' || { rm -rf "${D:?}"; return 1; }
  runuser -u "$u" -- mkdir -p "$G"
  # the build being replaced: a folder (the shipped one) is kept as usr.previous; an older link just goes
  if [ -d "$G/usr" ] && [ ! -L "$G/usr" ]; then rm -rf "${G:?}/usr.previous"; mv "$G/usr" "$G/usr.previous"; fi
  ln -sfn "$D/usr" "$G/usr.new" && mv -T "$G/usr.new" "$G/usr" && cp "$D/BUILT-FROM" "$G/BUILT-FROM" && chown -h "$u": "$G/usr" "$G/BUILT-FROM"
  for o in "$UH"/.local/gamescope-egpu-*; do [ "$o" = "$D" ] || rm -rf "${o:?}"; done   # one build of ours at a time
  rm -f "$BAD"; return 0; }
if [ "$BZ" = 1 ]; then bz_build >> "$LOG" 2>&1; brc=$?
elif [ "$CY" = 1 ]; then
  tell "$r. Building EGPU Buddy's gamescope for it in the background (about 5-10 minutes, try $(cy_tries) of 3). Game Mode keeps working meanwhile."
  cy_build >> "$LOG" 2>&1; brc=$?
  case $brc in
    0) tell "EGPU Buddy's gamescope is ready for gamescope $(cy_ver) (NVIDIA picture fix, touchpad picture with XR glasses). Game Mode uses it from its next start." ;;
    3) tell "EGPU Buddy's changes do not fit gamescope $(cy_ver) yet. Game Mode keeps using $( [ -x "$PRIV" ] && echo "the previous EGPU Buddy gamescope" || echo "the system gamescope") until an EGPU Buddy update." ;;
    *) tell "Building EGPU Buddy's gamescope for $(cy_ver) failed (try $(cy_tries) of 3$( [ "$(cy_tries)" -lt 3 ] && echo ", it tries again at the next start or update")). Game Mode keeps working with $( [ -x "$PRIV" ] && echo "the previous EGPU Buddy gamescope" || echo "the system gamescope"). Log: $LOG" ;;
  esac
  [ "$brc" = 0 ] || exit 0
else bash "$BUILD" "$(stat -c %U "$UH")" >> "$LOG" 2>&1; brc=$?; fi
if [ "$brc" != 0 ]; then
  log "rebuild failed: Game Mode keeps using Valve's gamescope on this OS build (NVIDIA picture corruption above ~2560 px)"; exit 0
fi
rm -f "$BAD"; log "rebuilt: $("$PRIV" --version 2>&1 | grep -o 'gamescope version [^ ]*' | head -1)"
# CachyOS: no Game Mode reload (the owner's rule: no Game Mode restart for an update); the next start uses it
[ "$CY" = 1 ] && exit 0

# reload Game Mode onto it - only when Game Mode is on the eGPU and fell back to Valve's gamescope, and no game runs
for _ in $(seq 1 720); do
  g=$(pgrep -n -x 'gamescope(-wl)?') || { log "Game Mode is not running; the rebuilt gamescope is used next time it starts"; exit 0; }
  if [ "$BZ" = 1 ]; then   # Bazzite: our hook set the variable (eGPU screen); it named Bazzite's own while ours was not built yet
    tr '\0' '\n' </proc/$g/environ 2>/dev/null | grep -q '^NV_EGPU_BUDDY_GAMESCOPE_BIN=' || { log "Game Mode is not on the eGPU; nothing to reload"; exit 0; }
  else
  tr '\0' '\n' </proc/$g/environ 2>/dev/null | grep -qxF "NV_EGPU_BUDDY_GAMESCOPE_BIN=$PRIV" || { log "Game Mode is not on the eGPU; nothing to reload"; exit 0; }
  fi
  [ "$(readlink -f /proc/$g/exe)" = "$(readlink -f "$PRIV")" ] && { log "already running the rebuilt gamescope"; exit 0; }
  if ! /usr/local/sbin/egpu-game-running && [ ! -e /run/nvegpu/gm-attach-pending ] && ! grep -qE '"state":"(SWITCHING|DETACHING)"' /run/nvegpu/gm-status.json 2>/dev/null; then
    log "no game running: reloading Game Mode onto the rebuilt gamescope"
    /usr/local/sbin/egpu-gamemode-switch >> "$LOG" 2>&1 && log "reloaded" || log "reload did not complete (rc $?)"
    exit 0
  fi
  sleep 30
done
log "a game kept running for 6 hours; the rebuilt gamescope is used the next time Game Mode starts"
