#!/bin/bash
# egpu-game-running [--pid]: exit 0 (and with --pid print the newest one) when a launched game is running.
# Steam wraps every launched game in "reaper". Bazzite's Game Mode also runs OpenGamepadUI, which keeps a
# reaper of its own alive the whole session ("A game is running" all the time, Legion Go 2, 2026-10-22).
# Only where OpenGamepadUI runs: a reaper counts when Steam started it for a game (argv: reaper SteamLaunch
# AppId=...) and no OpenGamepadUI runs under it. Everywhere else: any reaper, as before.
ogui=$(pgrep -x opengamepadui 2>/dev/null)
best=""
for p in $(pgrep -x reaper 2>/dev/null); do
  if [ -n "$ogui" ]; then
    a1=$(tr '\0' '\n' </proc/$p/cmdline 2>/dev/null | sed -n 2p); [ "$a1" = SteamLaunch ] || continue
    under=0; for o in $ogui; do q=$o; for _ in 1 2 3 4 5 6 7 8; do q=$(awk '{print $4}' /proc/$q/stat 2>/dev/null); [ -n "$q" ] && [ "$q" -gt 1 ] || break; [ "$q" = "$p" ] && { under=1; break; }; done; done
    [ $under = 1 ] && continue
  fi
  best=$p
done
[ -n "$best" ] || exit 1
[ "${1:-}" = --pid ] && echo "$best"; exit 0
