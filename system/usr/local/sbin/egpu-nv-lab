#!/usr/bin/env python3
"""egpu-nv-lab status | master on|off | set KEY on|off  — NVIDIA settings > Advanced Tinkering (experimental, opt-in).

Runs as the user (never root: the plugin calls it through runuser). Everything here is userspace and reversible:
  * status: a read-only capability report (nvidia-smi only; no privileged or runtime action) and the lab switches.
  * the switches write ~/.config/egpu-buddy/nvidia-lab.env, which EGPU Buddy's NVIDIA settings loader (egpu-nvt)
    hands to each game AFTER the normal NVIDIA settings (a normal setting always wins). Master off removes the file:
    games are then exactly as without the lab. No driver, Proton or game file is ever changed.
Sources (checked 2026-11-12): NVIDIA "DLSS / Smooth Motion / Reflex" (driver-installation-guide/615/gaming.html),
dxvk-nvapi README (Vulkan Reflex layer), NVIDIA README "Smooth Motion" (575: RTX 50, 580.82: RTX 40).
"""
import glob, json, os, re, subprocess, sys, time

CFG = os.path.expanduser("~/.config/egpu-buddy")
STATE = os.path.join(CFG, "nvidia-lab.json")
ENV = os.path.join(CFG, "nvidia-lab.env")

# key: (label, env lines, needs(cc, driver) -> reason or "", description). Each starts OFF.
def _need_ada(cc, drv):
    if cc < 8.9: return "needs an RTX 40 or 50 card"
    if cc >= 10 and drv < (575,): return "needs NVIDIA driver 575 or newer"
    if cc < 10 and drv < (580, 82): return "needs NVIDIA driver 580.82 or newer"
    return ""
def _need_rtx(cc, drv): return "" if cc >= 7.5 else "needs an RTX card"
def _need_615(cc, drv): return "" if drv >= (615,) else "needs NVIDIA driver 615 or newer"

LAB = {
    "dlss_latest": ("DLSS: newest model in every game",
                    ["DXVK_NVAPI_DRS_NGX_DLSS_SR_OVERRIDE=on", "DXVK_NVAPI_DRS_NGX_DLSS_RR_OVERRIDE=on",
                     "DXVK_NVAPI_DRS_NGX_DLSS_SR_OVERRIDE_RENDER_PRESET_SELECTION=render_preset_latest",
                     "DXVK_NVAPI_DRS_NGX_DLSS_RR_OVERRIDE_RENDER_PRESET_SELECTION=render_preset_latest"],
                    _need_rtx, "Proton games with DLSS use NVIDIA's newest Super Resolution and Ray Reconstruction preset "
                    "instead of the one the game picks. Needs a recent Proton (its DXVK-NVAPI must know the preset)."),
    "dlss_update": ("DLSS: newest DLSS files from NVIDIA",
                    ["PROTON_ENABLE_NGX_UPDATER=1"], _need_rtx,
                    "Proton downloads NVIDIA's current DLSS files and uses them instead of the ones the game shipped. "
                    "The game's own files are not changed."),
    "smooth_motion": ("Smooth Motion (driver frame generation)",
                      ["NVPRESENT_ENABLE_SMOOTH_MOTION=1"], _need_ada,
                      "The driver adds generated frames to games without DLSS Frame Generation (Vulkan, so Proton games "
                      "too). Do not use it together with a game's own DLSS Frame Generation. Shown FPS includes "
                      "generated frames; latency rises."),
    "vk_reflex": ("Reflex for Vulkan games",
                  ["DXVK_NVAPI_VKREFLEX=1"], _need_615,
                  "Turns on DXVK-NVAPI's Reflex layer for Vulkan games in Proton (DirectX games have Reflex without it). "
                  "Only does something where the layer is installed; newer DXVK-NVAPI (0.9.3) may not need it."),
}

def _edid(b):
    """Read-only facts from a screen's EDID: name, colour depth, refresh range (VRR hint), HDR and wide colour."""
    r = {}
    if len(b) < 128 or b[:8] != bytes.fromhex("00ffffffffffff00"): return r
    if b[20] & 0x80: r["bpc"] = {1: 6, 2: 8, 3: 10, 4: 12, 5: 14, 6: 16}.get((b[20] >> 4) & 7)
    for i in range(54, 126, 18):
        d = b[i:i + 18]
        if d[:3] != b"\0\0\0": continue
        if d[3] == 0xFC: r["name"] = d[5:18].split(b"\n")[0].decode("ascii", "replace").strip()
        if d[3] == 0xFD: r["range"] = (d[5] + (255 if d[4] & 1 else 0), d[6] + (255 if d[4] & 2 else 0))
    for e in range(128, len(b) - 127, 128):
        x = b[e:e + 128]
        if x[0] != 0x02: continue
        i, end = 4, x[2]
        while 4 <= i < end:
            tag, ln = x[i] >> 5, x[i] & 31; blk = x[i + 1:i + 1 + ln]
            if tag == 7 and blk:
                if blk[0] == 6 and len(blk) > 1:   # HDR static metadata
                    eo = blk[1]; r["hdr"] = [n for bit, n in ((4, "HDR10 (PQ)"), (8, "HLG")) if eo & bit]
                    if len(blk) > 3 and blk[3]: r["peak_nits"] = round(50 * 2 ** (blk[3] / 32))
                if blk[0] == 5 and len(blk) > 1 and blk[1] & 0xC0: r["bt2020"] = True
            if tag == 3 and blk[:3] == bytes.fromhex("d85dc4") and len(blk) > 9:   # HDMI Forum VSDB: VRR range
                lo, hi = blk[8] & 0x3F, ((blk[8] & 0xC0) << 2) | blk[9]
                if lo and hi: r["hdmi_vrr"] = (lo, hi)
            i += 1 + ln
    return r

def _displays():
    out = []
    for c in sorted(glob.glob("/sys/class/drm/card*-*")):
        try:
            if open(c + "/status").read().strip() != "connected": continue
            e = _edid(open(c + "/edid", "rb").read())
            modes = open(c + "/modes").read().split()
        except OSError:
            continue
        conn = os.path.basename(c).split("-", 1)[1]
        bits = [f"{conn}: {e.get('name', 'unknown')}", f"preferred mode {modes[0]}" if modes else ""]
        if e.get("bpc"): bits.append(f"{e['bpc']}-bit colour")
        v = e.get("hdmi_vrr") or e.get("range")
        if v: bits.append(("VRR " if e.get("hdmi_vrr") else "refresh range ") + f"{v[0]}-{v[1]} Hz")
        bits.append(("HDR: " + ", ".join(e["hdr"]) + (f", ~{e['peak_nits']} nits" if e.get("peak_nits") else "")) if e.get("hdr") else "no HDR")
        if e.get("bt2020"): bits.append("wide colour (BT.2020)")
        out.append(" · ".join(b for b in bits if b))
    return out

PERF = os.path.expanduser("~/.local/state/egpu-buddy/perf-lab")

def _perf_lines(st):
    a = st.get("perf_armed")
    if not a: return []
    # autostart_log = seconds after the game starts: loading screens and intros are not measured. The HUD is made
    # invisible (alpha 0, one item) rather than hidden: MangoHud 0.8.4's no_display switches the logging off too, so a
    # real game never wrote a log (found 2026-11-13; vkcube: no_display -> no file, alpha=0 -> full log)
    return ["MANGOHUD=1", f"MANGOHUD_CONFIG=fps_only,alpha=0,background_alpha=0,autostart_log={a.get('delay', 1)},log_duration={a['secs']},log_interval=0,output_folder={PERF}"]

def _summary(path):
    """One recording (MangoHud CSV): average FPS, 1% low, 99th percentile frame time, GPU load / clock / power / temp."""
    rows, cols = [], None
    for line in open(path, errors="replace"):
        f = line.strip().split(",")
        if cols is None:
            if f and f[0] == "fps": cols = f
            continue
        if len(f) == len(cols): rows.append(dict(zip(cols, f)))
    num = lambda k: sorted(float(r[k]) for r in rows if r.get(k, "").replace(".", "", 1).isdigit())
    ft, fps = num("frametime"), num("fps")
    if not ft: return None
    avg = lambda v: round(sum(v) / len(v), 1) if v else None
    p99 = ft[min(len(ft) - 1, int(len(ft) * 0.99))]
    return {"file": os.path.basename(path), "game": os.path.basename(path).rsplit("_", 2)[0],
            "when": time.strftime("%Y-%m-%d %H:%M", time.localtime(os.path.getmtime(path))), "frames": len(ft),
            "fps": round(1000 * len(ft) / sum(ft), 1), "low1": round(1000 / p99, 1), "p99_ms": round(p99, 1),
            "gpu_load": avg(num("gpu_load")), "clock": avg(num("gpu_core_clock")), "power": avg(num("gpu_power")),
            "temp": avg(num("gpu_temp")),
            "fps_cv": round((sum((x - sum(fps) / len(fps)) ** 2 for x in fps) / len(fps)) ** 0.5 / (sum(fps) / len(fps)), 3) if fps and sum(fps) else None}

# --- Performance Lab diagnosis -----------------------------------------------------------------------------------
# While a recording is armed a sampler (egpu-nv-lab _sample, its own user unit) reads every second what MangoHud does
# not log: the NVIDIA GPU's throttle reasons, PCIe link and traffic (nvidia-smi dmon), VRAM, and the load of every CPU
# core. When MangoHud's log appears, the samples of its time window are saved next to it (<log>.lab.json) and the run
# gets a plain diagnosis. Nothing here changes a setting.
SMI_Q = ("utilization.gpu,clocks.gr,clocks.max.gr,power.draw,power.limit,temperature.gpu,memory.used,memory.total,"
         "pcie.link.gen.current,pcie.link.width.current,pcie.link.gen.max,pcie.link.width.max,"
         "clocks_event_reasons.sw_power_cap,clocks_event_reasons.sw_thermal_slowdown,"
         "clocks_event_reasons.hw_thermal_slowdown,clocks_event_reasons.hw_power_brake_slowdown,clocks_event_reasons.hw_slowdown")
SMI_K = ["util", "clock", "clock_max", "power", "power_limit", "temp", "vram", "vram_total", "gen", "width", "gen_max", "width_max",
         "power_cap", "sw_thermal", "hw_thermal", "power_brake", "hw_slowdown"]

def _usb4_gbs():
    """Practical PCIe payload of the eGPU's USB4 / Thunderbolt tunnel in GB/s per direction (about 80 % of the link)."""
    for d in sorted(glob.glob("/sys/bus/thunderbolt/devices/*-*")):
        if re.search(r"-0$|:", os.path.basename(d)) or not os.path.exists(d + "/device_name"): continue
        try:
            per = float(re.findall(r"[\d.]+", open(d + "/rx_speed").read())[0]); lanes = int(open(d + "/rx_lanes").read())
            return round(per * lanes * 0.8 / 8, 1)
        except (OSError, IndexError, ValueError): pass
    return None

def _cpu_times():
    out = []
    for l in open("/proc/stat"):
        if re.match(r"cpu\d", l):
            v = [int(x) for x in l.split()[1:]]; out.append((v[3] + v[4], sum(v)))
    return out

def _sample(armed_t):
    """Runs while a recording is armed (max 3 h): keeps the last 3 minutes of 1 s samples; when MangoHud's log appears,
    saves the samples of its time window beside it and stops."""
    import collections, threading
    ring, pcie, stop = collections.deque(maxlen=180), {"rx": 0, "tx": 0}, time.time() + 3 * 3600
    def dmon():
        try:
            pr = subprocess.Popen(["nvidia-smi", "dmon", "-s", "t", "-d", "1"], stdout=subprocess.PIPE, text=True)
            for l in pr.stdout:
                f = l.split()
                if len(f) >= 3 and f[0].isdigit(): pcie["rx"], pcie["tx"] = int(f[1]) if f[1].isdigit() else 0, int(f[2]) if f[2].isdigit() else 0
        except OSError: pass
    threading.Thread(target=dmon, daemon=True).start()
    prev = _cpu_times()
    while time.time() < stop:
        time.sleep(1)
        st = _state()
        if not st.get("perf_armed"): return   # cancelled
        cur = _cpu_times()
        cores = [round(100 * (1 - (c[0] - p[0]) / max(1, c[1] - p[1]))) for c, p in zip(cur, prev)]; prev = cur
        smp = {"t": time.time(), "cpu_max": max(cores or [0]), "cpu_avg": round(sum(cores) / max(1, len(cores))), "rx": pcie["rx"], "tx": pcie["tx"]}
        try:
            v = subprocess.run(["nvidia-smi", f"--query-gpu={SMI_Q}", "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=5).stdout.splitlines()[0].split(",")
            for k, x in zip(SMI_K, v):
                x = x.strip(); smp[k] = (x == "Active") if k in SMI_K[12:] else (float(x) if re.fullmatch(r"[\d.]+", x) else None)
        except (OSError, IndexError, subprocess.TimeoutExpired): smp["util"] = None
        ring.append(smp)
        logs = [p for p in glob.glob(PERF + "/*.csv") if not p.endswith("_summary.csv") and os.path.getmtime(p) > armed_t and not os.path.exists(p + ".lab.json")]
        if logs:   # MangoHud may write as it goes: the recording is over once the log has not changed for 5 s
            log = max(logs, key=os.path.getmtime); end = os.path.getmtime(log)
            if time.time() - end < 5: continue
            secs = (st.get("perf_armed") or {}).get("secs", 60)
            win = [x for x in ring if end - secs - 2 <= x["t"] <= end + 1]
            json.dump({"samples": win, "usb4_gbs": _usb4_gbs()}, open(log + ".lab.json", "w")); return

def _pct(v, q): v = sorted(v); return v[min(len(v) - 1, int(len(v) * q))] if v else None

def _diagnose(run, lab):
    """Plain findings for one run: [{"level": "problem"|"limit"|"ok", "text", "hint"}]. Measured, never guessed: a rule
    only fires when its own counters say so, and the thresholds are written next to it."""
    out, S = [], (lab or {}).get("samples") or []
    say = lambda lvl, text, hint="": out.append({"level": lvl, "text": text, "hint": hint})
    fps, low1 = run.get("fps") or 0, run.get("low1") or 0
    nv = [x for x in S if x.get("util") is not None]
    if S and (not nv or (sum(x["util"] for x in nv) / len(nv) < 5 and fps > 5)):
        say("problem", "The game did not use the eGPU (NVIDIA GPU idle while the game ran)", "Check that the game renders on the eGPU (Game Mode on the eGPU's screen, or the eGPU render option for this game).")
        return out
    share = lambda k: sum(1 for x in nv if x.get(k)) / len(nv) if nv else 0
    util = sum(x["util"] for x in nv) / len(nv) if nv else (run.get("gpu_load") or 0)
    gpu_bound = util >= 90
    if share("power_cap") >= 0.2:
        pl = max((x.get("power_limit") or 0) for x in nv)
        say("limit", f"GPU held back by its power limit ({pl:.0f} W) {share('power_cap'):.0%} of the time", "Normal at full load; a higher power limit (NVIDIA settings) gives a little more, an undervolt the same at less power.")
    if share("sw_thermal") + share("hw_thermal") >= 0.05:
        say("problem", f"GPU slowed down by heat (up to {max((x.get('temp') or 0) for x in nv):.0f} °C)", "More airflow around the eGPU dock, or a lower power limit.")
    if share("power_brake") + share("hw_slowdown") >= 0.05:
        say("problem", "GPU slowed down by the dock's power supply (hardware power brake)", "The dock's power supply cannot hold the card's peak: a lower power limit avoids the brake.")
    cpu1 = [x["cpu_max"] for x in S if "cpu_max" in x]
    cpua = [x["cpu_avg"] for x in S if "cpu_avg" in x]
    hint = "Higher resolution or quality costs nothing here; lower CPU-heavy settings (view distance, crowds, physics) or use frame generation."
    if cpu1 and util < 85 and sum(1 for c in cpu1 if c >= 90) / len(cpu1) >= 0.5:   # one thread holds the game back
        say("limit", f"Limited by the CPU: its busiest core at {_pct(cpu1, 0.5)}% while the GPU waited ({util:.0f}% busy)", hint)
    elif cpua and util < 85 and sum(1 for c in cpua if c >= 60) / len(cpua) >= 0.5:
        # every core busy: with two threads per core (SMT), 60 % across all threads is about every physical core in use
        say("limit", f"Limited by the CPU: all {os.cpu_count()} threads {_pct(cpua, 0.5)}% busy on average while the GPU waited ({util:.0f}% busy)", hint)
    cap = (lab or {}).get("usb4_gbs")
    rx, tx = [x.get("rx", 0) / 1000 for x in S], [x.get("tx", 0) / 1000 for x in S]
    if cap and S:
        busy = max(_pct(rx, 0.9) or 0, _pct(tx, 0.9) or 0)
        if busy >= 0.75 * cap:
            say("limit", f"Limited by the USB4 link: {busy:.1f} GB/s of about {cap:.1f} GB/s", "Textures or frames are streaming across the cable: lower texture quality, or render and show on the eGPU's own screen.")
    gens = [x for x in nv if x.get("gen") and x.get("gen_max") and x["util"] >= 50]
    if gens and min(x["gen"] for x in gens) < gens[0]["gen_max"] and sum(1 for x in gens if x["gen"] < x["gen_max"]) / len(gens) >= 0.3:
        say("problem", f"PCIe link ran below its speed under load (Gen {min(x['gen'] for x in gens):.0f} of {gens[0]['gen_max']:.0f})", "Reseat the cable, try another USB4 port, and send a support report if it stays.")
    vr = [x for x in nv if x.get("vram") and x.get("vram_total")]
    if vr and max(x["vram"] / x["vram_total"] for x in vr) >= 0.95:
        say("problem", f"Video memory full ({max(x['vram'] for x in vr) / 1024:.1f} of {vr[0]['vram_total'] / 1024:.1f} GB): the overflow crosses the USB4 link", "Lower texture quality or resolution.")
    if fps and low1 and low1 < 0.5 * fps:
        say("problem", f"Uneven frame times: 1% low {low1:.0f} FPS against {fps:.0f} average (stutter)", "Shader compilation on a first run is common; record again. If it stays, the findings above say where it comes from.")
    if fps and not gpu_bound and cpu1 and _pct(cpu1, 0.5) < 85 and (_pct(cpua, 0.5) or 0) < 60 and run.get("fps_cv") is not None and run["fps_cv"] < 0.03:
        say("limit", f"Frame rate held at about {fps:.0f} FPS by a cap or vsync, not by the hardware", "Raise or remove the frame limit (Steam's performance menu or the game) to use the headroom.")
    if gpu_bound and all(o["text"].startswith("GPU held back by its power limit") for o in out):   # nothing else in the way
        say("ok", f"GPU-limited ({util:.0f}% busy): the eGPU is the bottleneck, as it should be", "Lower resolution or quality, or DLSS, for more FPS.")
    if not out:
        say("ok", "No bottleneck found in this run", "")
    return out

def _perf(st):
    os.makedirs(PERF, exist_ok=True)
    logs = sorted((p for p in glob.glob(PERF + "/*.csv") if not p.endswith("_summary.csv")), key=os.path.getmtime, reverse=True)
    a = st.get("perf_armed")
    if a and any(os.path.getmtime(p) > a["t"] for p in logs):   # recorded: one launch only, so disarm
        st.pop("perf_armed", None); _write(st)
    for old in logs[10:]:
        os.remove(old); os.path.exists(old + ".lab.json") and os.remove(old + ".lab.json")
    runs = [x for x in (_summary(p) for p in logs[:10]) if x]
    for r in runs:
        try: lab = json.load(open(os.path.join(PERF, r["file"]) + ".lab.json"))
        except (OSError, ValueError): lab = None
        r["findings"] = _diagnose(r, lab); r["measured"] = bool(lab)
    return {"armed": bool(st.get("perf_armed")), "secs": (st.get("perf_armed") or {}).get("secs"), "runs": runs}

def _gpu():
    try:
        out = subprocess.run(["nvidia-smi", "--query-gpu=name,compute_cap,driver_version,pcie.link.gen.current,"
                              "pcie.link.width.current,pcie.link.gen.max,pcie.link.width.max", "--format=csv,noheader"],
                             capture_output=True, text=True, timeout=10).stdout.strip().splitlines()[0]
        n, cc, drv, g, w, gm, wm = [x.strip() for x in out.split(",")]
        return {"name": n, "cc": float(cc), "driver": drv, "link": f"PCIe {g}.0 x{w} (card max {gm}.0 x{wm})"}
    except (OSError, IndexError, ValueError, subprocess.TimeoutExpired):
        return None

def _arch(cc):
    return {7.5: "Turing", 8.6: "Ampere", 8.7: "Ampere", 8.9: "Ada Lovelace", 12.0: "Blackwell"}.get(cc, f"compute {cc}")

def _state():
    try: return json.load(open(STATE))
    except (OSError, ValueError): return {"master": False, "on": []}

def _write(st):
    os.makedirs(CFG, exist_ok=True)
    json.dump(st, open(STATE, "w"))
    def put(path, keys, extra=()):
        lines = ([l for k in keys if k in LAB for l in LAB[k][1]] + list(extra)) if st["master"] else []
        if lines: open(path, "w").write("# EGPU Buddy NVIDIA settings > Advanced Tinkering (egpu-nv-lab); master off removes it\n" + "\n".join(lines) + "\n")
        elif os.path.exists(path): os.remove(path)
    put(ENV, st["on"], _perf_lines(st))
    games = st.get("games", {})
    for f in glob.glob(os.path.join(CFG, "nvidia-lab-*.env")):   # per game: nvidia-lab-<appid>.env (the shim reads it first)
        if os.path.basename(f)[11:-4] not in games: os.remove(f)
    for gid, g in games.items(): put(os.path.join(CFG, f"nvidia-lab-{gid}.env"), g.get("on", []))

def _steam_games():
    """Installed Steam games (appid, name) from every Steam library, tools and runtimes left out."""
    roots, out = [os.path.expanduser("~/.local/share/Steam")], {}
    try:
        roots += re.findall(r'"path"\s+"([^"]+)"', open(os.path.expanduser("~/.local/share/Steam/steamapps/libraryfolders.vdf")).read())
    except OSError:
        pass
    for r in dict.fromkeys(roots):
        for m in glob.glob(os.path.join(r, "steamapps", "appmanifest_*.acf")):
            try: t = open(m, errors="replace").read()
            except OSError: continue
            gid, name = re.search(r'"appid"\s+"(\d+)"', t), re.search(r'"name"\s+"([^"]+)"', t)
            if gid and name and not re.search(r"Proton|Steam Linux Runtime|Steamworks|Redistributable|SteamVR", name[1]):
                out[gid[1]] = name[1]
    return sorted(out.items(), key=lambda x: x[1].lower())

def status():
    st, g = _state(), _gpu()
    cc, drv = (g["cc"], tuple(int(x) for x in re.findall(r"\d+", g["driver"])[:2])) if g else (0.0, (0,))
    report = []
    if g:
        report += [f"{g['name']} · {_arch(cc)} · driver {g['driver']}", g["link"],
                   "DLSS Frame Generation in games: " + ("yes (the game's own)" if cc >= 8.9 else "not on this card"),
                   "Reflex in DirectX games: through Proton's DXVK-NVAPI, no switch needed" if cc >= 7.5 else "Reflex: needs an RTX card"]
        if 8.6 <= cc < 8.9:
            report.append("RTX 30 frame generation (dlssg-open): not offered yet - a 3-commit proof of concept that patches "
                          "Proton's files; kept for later testing")
    else:
        report.append("No NVIDIA GPU answering right now (eGPU unplugged or driver not loaded)")
    labs = [{"key": k, "label": v[0], "desc": v[3], "on": k in st["on"], "why_not": v[2](cc, drv) if g else "no NVIDIA GPU right now"}
            for k, v in LAB.items()]
    return {"master": st["master"], "report": report, "labs": labs, "active": os.path.exists(ENV),
            "displays": _displays(), "games": _steam_games() if st["master"] else [],
            "per_game": {k: v.get("on", []) for k, v in st.get("games", {}).items()}, "perf": _perf(st) if st["master"] else {"armed": False, "runs": []},
            "planned": ["Display overrides (HDR / VRR), with automatic undo",
                        "Driver Lab trials (installing a checked candidate through the driver switch)"]}

def main(a):
    try:   # AMD / Intel install: never (CLAUDE.md: AMD installs run no NVIDIA code)
        if open("/etc/nv-egpu-buddy/gpu-vendor").read().strip() == "amd": print("not on an AMD / Intel install"); return 3
    except OSError:
        pass
    st = _state()
    if a[:1] == ["status"]:
        print(json.dumps(status())); return 0
    if len(a) == 2 and a[0] == "master" and a[1] in ("on", "off"):
        st["master"] = a[1] == "on"; _write(st); print(f"Advanced Tinkering {a[1]}"); return 0
    if len(a) == 3 and a[0] == "set" and a[1] in LAB and a[2] in ("on", "off"):
        if not st["master"]: print("turn Advanced Tinkering on first"); return 1
        st["on"] = [k for k in st["on"] if k != a[1]] + ([a[1]] if a[2] == "on" else []); _write(st)
        print(f"{LAB[a[1]][0]}: {a[2]} (next game launch)"); return 0
    if len(a) == 4 and a[0] == "game" and re.fullmatch(r"\d{1,20}", a[1]) and a[2] in LAB and a[3] in ("on", "off"):
        if not st["master"]: print("turn Advanced Tinkering on first"); return 1
        g = st.setdefault("games", {}).setdefault(a[1], {"on": []})
        g["on"] = [k for k in g["on"] if k != a[2]] + ([a[2]] if a[3] == "on" else [])
        if not g["on"]: st["games"].pop(a[1])
        _write(st); print(f"{LAB[a[2]][0]}: {a[3]} for this game (next launch)"); return 0
    if a[:2] == ["perf", "arm"] and len(a) == 3 and a[2].isdigit() and 0 < int(a[2]) <= 900:   # perf arm DELAY (seconds)
        a = a[:2]; delay = int(sys.argv[3])
    else:
        delay = 90
    if a[:1] == ["perf"] and len(a) == 2 and a[1] in ("arm", "cancel", "clear"):
        if not st["master"]: print("turn Advanced Tinkering on first"); return 1
        if a[1] == "arm": st["perf_armed"] = {"secs": 60, "delay": delay, "t": time.time()}
        else: st.pop("perf_armed", None)
        if a[1] == "clear": [os.remove(p) for p in glob.glob(PERF + "/*.csv") + glob.glob(PERF + "/*.lab.json")]
        _write(st)
        if a[1] == "arm":   # the sampler: its own unit, so it outlives this call (ends with the recording, a cancel, or 3 h)
            subprocess.run(["systemctl", "--user", "stop", "egpu-perf-sampler.service"], capture_output=True, timeout=10)
            subprocess.run(["systemd-run", "--user", "--collect", "--quiet", "--unit", "egpu-perf-sampler", "--nice=5",
                            sys.executable, os.path.realpath(__file__), "_sample", str(st["perf_armed"]["t"])], capture_output=True, timeout=20)
        print({"arm": f"Recording armed: the next game you start is recorded for 60 s from {delay} s after it starts (no overlay)", "cancel": "Recording cancelled",
               "clear": "Recordings deleted"}[a[1]]); return 0
    if len(a) == 2 and a[0] == "_sample":
        os.makedirs(PERF, exist_ok=True); _sample(float(a[1])); return 0
    print(__doc__.strip().splitlines()[0]); return 2

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
