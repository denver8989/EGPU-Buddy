#!/usr/bin/env python3
"""egpu-screen - read and wake external screens over DDC/CI (HDMI and DisplayPort).

  egpu-screen list              one line per connected external screen
  egpu-screen state CONNECTOR   exit 0 in use / unknown, 1 = on another input
  egpu-screen wake [CONNECTOR]  power on screens still on our input (all if none given)
  egpu-screen wake --input ...  also switch screens on another input back to us
  egpu-screen settle            the only external screen? turn it on and onto our input
  egpu-screen tvctl on|off      TV control tricks on or off
  egpu-screen tvset cec_remote|off_at_detach on|off   TV remote (CEC) / TV off at Safe Detach (opt-in)
  egpu-screen tvkey up|down|mute|on|off  TV volume / mute / power (eGPU CEC through SteamOS's cecd, else a paired LG TV)
  egpu-screen tvoff             Safe Detach: TV to standby, only when that option is on
  egpu-screen tvremote          JSON: the routes that work now
  egpu-screen only CONNECTOR    desktop only: that screen alone shows an image (every other KWin screen off)
  egpu-screen replug [CONNECTOR] desktop only: software unplug + replug, for a monitor stuck on "no signal"
  egpu-screen watch             desktop session: settle on plug-in; with 2+ screens, leave a TV that is
                                on another input (or off) out of the desktop until it is switched to us
  egpu-screen find              LG webOS TVs on the local network (one IP per line)
  egpu-screen pair IP CONNECTOR pair that TV with the screen on CONNECTOR (the TV asks to allow it)

Two cable standards, any brand: DDC/CI (monitors, some TVs; read directly, no ddcutil) and
HDMI-CEC (TVs) through the kernel's /dev/cec* when the connection exposes it (AMD/Intel DP-CEC
tunnelling on USB-C/DP->HDMI adapters, USB-CEC adapters; NVIDIA exposes none) via cec-ctl.
Optional third route, the "TV control tricks" extra (off by default): an LG webOS TV paired over the
network - read its input, wake it (wake-on-LAN), switch it to our HDMI. Used before CEC/DDC when set up.
A screen that answers none reads "unknown" and is treated as in use - never hidden on a guess.
"""
import base64, concurrent.futures, fcntl, glob, json, os, pwd, re, socket, ssl, struct, subprocess, sys, time

I2C_SLAVE = 0x0703
STORE = "/var/lib/nvegpu/screen-inputs.json"  # EDID -> input code seen while in use
ADAPTERS = re.compile(r"NVIDIA i2c adapter|AMDGPU DM|i915 gmbus|DPDDC|nvkm|radeon", re.I)
INPUTS = {0x01: "VGA", 0x03: "DVI", 0x04: "DVI", 0x0F: "DisplayPort-1", 0x10: "DisplayPort-2",
          0x11: "HDMI-1", 0x12: "HDMI-2", 0x13: "HDMI-3", 0x14: "HDMI-4",
          0x1B: "USB-C", 0x1C: "USB-C-2"}


def _bus(n, addr):
    fd = os.open(f"/dev/i2c-{n}", os.O_RDWR)
    fcntl.ioctl(fd, I2C_SLAVE, addr)
    return fd


def _edid(n):
    try:
        fd = _bus(n, 0x50)
        try:
            os.write(fd, b"\0")
            return os.read(fd, 128)
        finally:
            os.close(fd)
    except OSError:
        return b""


def _ddc(n, payload, reply=0):
    msg = bytes([0x51, 0x80 | len(payload)]) + payload
    chk = 0x6E
    for b in msg:
        chk ^= b
    fd = _bus(n, 0x37)
    try:
        os.write(fd, msg + bytes([chk]))
        time.sleep(0.06)
        return os.read(fd, reply) if reply else b""
    finally:
        os.close(fd)


def getvcp(n, code):
    for _ in range(3):
        try:
            r = _ddc(n, bytes([0x01, code]), 11)
            if len(r) == 11 and r[2] == 0x02 and r[3] == 0 and r[4] == code:
                return (r[8] << 8) | r[9]
        except OSError:
            pass
        time.sleep(0.05)
    return None


def setvcp(n, code, value):
    try:
        _ddc(n, bytes([0x03, code, value >> 8, value & 0xFF]))
        return True
    except OSError:
        return False


def screens():
    """Yield (connector, bus or None, edid) for every connected non-panel output."""
    buses = {}
    for d in glob.glob("/sys/bus/i2c/devices/i2c-*"):
        try:
            if ADAPTERS.search(open(d + "/name").read()):
                n = int(d.rsplit("-", 1)[1])
                e = _edid(n)
                if len(e) == 128:
                    buses.setdefault(e, n)
        except (OSError, ValueError):
            pass
    for node in sorted(glob.glob("/sys/class/drm/card*-*")):
        conn = re.sub(r"^card\d+-", "", os.path.basename(node))
        if conn.startswith(("eDP", "LVDS", "DSI", "Writeback")):
            continue
        try:
            if open(node + "/status").read().strip() != "connected":
                continue
            edid = open(node + "/edid", "rb").read()[:128]
        except OSError:
            continue
        yield conn, buses.get(edid), edid


def _store(update=None):
    try:
        data = json.load(open(STORE))
    except (OSError, ValueError):
        data = {}
    if update:
        data.update(update)
        try:
            os.makedirs(os.path.dirname(STORE), exist_ok=True)
            json.dump(data, open(STORE, "w"))
        except OSError:
            pass
    return data


def edid_name(edid):
    i = edid.find(b"\0\0\0\xfc\0")
    return edid[i + 5:i + 18].split(b"\n")[0].decode(errors="ignore").strip() if i >= 0 else ""


def _cec_for(conn):
    """/dev/cecN whose parent is this DRM connector (DP-CEC tunnel), or the only CEC adapter for an HDMI port."""
    devs = glob.glob("/sys/class/cec/cec*")
    for d in devs:
        if re.sub(r"^card\d+-", "", os.path.basename(os.path.realpath(d + "/device"))) == conn:
            return "/dev/" + os.path.basename(d)
    # ponytail: a lone USB-CEC adapter is assumed to sit on the HDMI screen; map by phys addr if two ever exist
    return "/dev/" + os.path.basename(devs[0]) if len(devs) == 1 and conn.startswith("HDMI") else None


def _cec(dev, *args):
    try:
        return subprocess.run(["cec-ctl", "-d", dev, *args], capture_output=True, text=True, timeout=6).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def cec_read(dev):
    """-> (power, ours) ; power on|standby|None, ours True/False/None (is the TV showing our source?)"""
    info = _cec(dev, "--playback")  # claim a playback logical address (idempotent)
    me = re.search(r"Physical Address\s*:\s*([0-9a-f.]+)", info)
    pw = re.search(r"pwr-state:\s*(\w+)", _cec(dev, "--to", "0", "--give-device-power-status"))
    src = re.search(r"phys-addr:\s*([0-9a-f.]+)", _cec(dev, "--to", "15", "--request-active-source",
                                                          "--wait-for-msgs", "--monitor-time", "2"))
    # the active source answers by broadcast; the TV itself answers 0.0.0.0 while showing its tuner/apps
    power = {"on": "on", "standby": "standby"}.get(pw.group(1)) if pw else None
    ours = (src.group(1) == me.group(1)) if (src and me) else None
    return power, ours


def cec_wake(dev, take_input):
    me = re.search(r"Physical Address\s*:\s*([0-9a-f.]+)", _cec(dev, "--playback"))
    _cec(dev, "--to", "0", "--image-view-on")  # TV on (and, per spec, to us)
    if take_input and me:
        _cec(dev, "--active-source", f"phys-addr={me.group(1)}")
    return "woken (CEC)"


NET = "/var/lib/nvegpu/screen-net.json"  # {"enabled": bool, "tvs": {EDID hex: {ip, mac, key, input}}}
FOREGROUND = "ssap://com.webos.applicationManager/getForegroundAppInfo"


def _net(edid):
    """The paired network TV for this screen, only while the TV control extra is switched on."""
    try:
        d = json.load(open(NET))
    except (OSError, ValueError):
        return None
    return d.get("tvs", {}).get(edid.hex()) if d.get("enabled") else None


def webos(ip, uri, payload=None, key=None, wait=5, perms=()):
    """One LG webOS (SSAP) call over its websocket -> (client key, response payload); (None, None) if the TV
    is not answering (standby). Without a key the TV shows an "allow" prompt and `wait` must cover it."""
    try:
        ctx = ssl.create_default_context(); ctx.check_hostname = False; ctx.verify_mode = ssl.CERT_NONE  # self-signed TV cert
        s = ctx.wrap_socket(socket.create_connection((ip, 3001), timeout=wait), server_hostname=ip)
    except OSError:
        return None, None
    try:
        s.sendall(f"GET / HTTP/1.1\r\nHost: {ip}:3001\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: "
                  f"{base64.b64encode(os.urandom(16)).decode()}\r\nSec-WebSocket-Version: 13\r\n\r\n".encode())
        head = b""
        while b"\r\n\r\n" not in head:
            head += s.recv(1) or b"\r\n\r\n"
        if b" 101 " not in head.split(b"\r\n")[0]:
            return None, None

        def send(obj):
            data, mask = json.dumps(obj).encode(), os.urandom(4)
            n = len(data)
            s.sendall(bytes([0x81]) + (bytes([0x80 | n]) if n < 126 else bytes([0xFE]) + struct.pack(">H", n))
                      + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))

        def recv():
            def rd(k):
                b = b""
                while len(b) < k:
                    c = s.recv(k - len(b))
                    if not c:
                        raise OSError("closed")
                    b += c
                return b
            while True:
                b1, b2 = rd(2); n = b2 & 0x7F
                n = struct.unpack(">H", rd(2))[0] if n == 126 else struct.unpack(">Q", rd(8))[0] if n == 127 else n
                data = rd(n)
                if b1 & 0x0F == 0x8:
                    raise OSError("closed")
                if b1 & 0x0F == 0x1:  # skip ping/pong
                    return json.loads(data)

        reg = {"pairingType": "PROMPT", "manifest": {"manifestVersion": 1, "appVersion": "1.0", "permissions": [
            "CONTROL_POWER", "CONTROL_INPUT_TV", "READ_INPUT_DEVICE_LIST", "READ_RUNNING_APPS", "LAUNCH", *perms]}}
        if key:
            reg["client-key"] = key
        send({"type": "register", "id": "reg", "payload": reg})
        while True:
            m = recv()
            if m.get("type") == "registered":
                key = m["payload"]["client-key"]; break
            if m.get("type") == "error":
                return None, None
        send({"type": "request", "id": "cmd", "uri": uri, **({"payload": payload} if payload else {})})
        return key, recv().get("payload", {})
    except (OSError, ValueError, KeyError):
        return None, None
    finally:
        s.close()


def _net_read(tv):
    r = webos(tv["ip"], FOREGROUND, key=tv["key"])[1]
    if r is None:
        return "off"  # a webOS TV in standby drops off the network
    return "in-use" if r.get("appId") == "com.webos.app." + tv["input"].lower().replace("_", "") else "other-input"


def _net_wake(tv, take_input):
    if webos(tv["ip"], FOREGROUND, key=tv["key"])[1] is None:
        if not take_input:
            # an off TV can't say which input it would come up on (usually its tuner): powering it on is only
            # right when we are also switching it to us
            return "off - left alone"
        mac = bytes.fromhex(tv["mac"].replace(":", ""))
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as u:
            u.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
            for _ in range(3):
                u.sendto(b"\xff" * 6 + mac * 16, ("255.255.255.255", 9))
        for _ in range(25):
            time.sleep(1)
            if webos(tv["ip"], FOREGROUND, key=tv["key"])[1] is not None:
                break
        else:
            return "no answer to wake-on-LAN"
    if take_input:
        webos(tv["ip"], "ssap://tv/switchInput", {"inputId": tv["input"]}, key=tv["key"])
    elif _net_read(tv) == "other-input":
        return "on another input - left alone"
    return "woken (network)"


def find():
    """LG webOS TVs (port 3001 open) on this machine's /24."""
    try:
        me = subprocess.run(["ip", "-4", "route", "get", "1.1.1.1"], capture_output=True, text=True).stdout.split(" src ")[1].split()[0]
    except (OSError, IndexError):
        return []
    net = me.rsplit(".", 1)[0]

    def probe(i):
        try:
            socket.create_connection((f"{net}.{i}", 3001), timeout=0.5).close(); return f"{net}.{i}"
        except OSError:
            return None
    with concurrent.futures.ThreadPoolExecutor(64) as ex:
        return [ip for ip in ex.map(probe, range(1, 255)) if ip]


def pair(ip, conn):
    """Ask the TV to allow us (prompt on the TV, 60 s), learn its MAC and which input is ours, store it for CONNECTOR."""
    edid = next((e for c, _, e in screens() if c == conn), None)
    if edid is None:
        return f"{conn} is not connected"
    key, inputs = webos(ip, "ssap://tv/getExternalInputList", wait=60, perms=("CONTROL_AUDIO"))
    if not key:
        return "not allowed on the TV (or no answer) - choose Allow on the TV's prompt"
    hdmi = [d["id"] for d in inputs.get("devices", []) if d.get("connected") and d["id"].startswith("HDMI")]
    fg = (webos(ip, FOREGROUND, key=key)[1] or {}).get("appId", "")
    cur = [d["id"] for d in inputs.get("devices", []) if fg == d.get("appId")]
    # ponytail: ours = the only connected HDMI input, else the one on screen now; ask for it if two TVs ever share a PC
    our = hdmi[0] if len(hdmi) == 1 else (cur[0] if cur else None)
    if not our:
        return "switch the TV to the PC's input, then pair again"
    socket.create_connection((ip, 3001), timeout=2).close()  # fills the ARP cache for the MAC below
    mac = re.search(r"lladdr ([0-9a-f:]{17})", subprocess.run(["ip", "neigh", "show", ip], capture_output=True, text=True).stdout)
    try:
        d = json.load(open(NET))
    except (OSError, ValueError):
        d = {"enabled": True}
    d.setdefault("tvs", {})[edid.hex()] = {"ip": ip, "mac": mac.group(1) if mac else "", "key": key, "input": our}
    os.makedirs(os.path.dirname(NET), exist_ok=True)
    json.dump(d, open(NET, "w"))
    os.chmod(NET, 0o644)  # the desktop watcher runs as the user
    return f"paired: {conn} is on {our.replace('_', ' ')}"


def read(conn, bus, edid):
    """-> (state, power, input) ; state = in-use | other-input | off | standby | unknown"""
    tv = _net(edid)
    if tv:
        return _net_read(tv), None, None
    cec = _cec_for(conn)
    if cec:
        power, ours = cec_read(cec)
        if power == "standby":
            return "off", power, None
        if power == "on" and ours is not None:
            return ("in-use" if ours else "other-input"), power, None
    if bus is None:
        return "unknown", None, None
    power, src = getvcp(bus, 0xD6), getvcp(bus, 0x60)
    if src is not None:
        src &= 0xFF  # high byte is vendor noise on some screens
    name = INPUTS.get(src, "")
    # Only certain cases count: an HDMI signal can only land on an HDMI input. A DP output can reach an
    # HDMI input through an adapter, so DP + "HDMI" is NOT proof of another input. Same-type inputs
    # (HDMI 1 vs HDMI 2) look alike over DDC/CI - telling those apart is what the CEC path is for.
    if conn.startswith("HDMI") and name and not name.startswith("HDMI"):
        return "other-input", power, src
    if src is not None and (conn.startswith("HDMI") and name.startswith("HDMI")
                            or conn.startswith("DP") and name.startswith(("DisplayPort", "USB-C"))):
        _store({conn + ":" + edid.hex(): src})  # certainly ours: what Wake switches back to
    if power in (2, 3, 4, 5):
        return "standby", power, src
    return ("in-use" if src is not None or power == 1 else "unknown"), power, src


def wake(conn, bus, edid, take_input=False):
    tv = _net(edid)
    if tv:
        return _net_wake(tv, take_input)
    r = _cec_wake(conn, take_input)   # "TV remote (CEC)" on and CONN is that TV: power state, wake, our input
    if r:
        return r
    cec = _cec_for(conn)
    if cec:
        if not take_input and read(conn, bus, edid)[0] == "other-input":
            return "on another input - left alone"
        return cec_wake(cec, take_input)
    if bus is None:
        return "no DDC/CI - can't wake"
    st = read(conn, bus, edid)[0]
    if st == "other-input" and not take_input:
        return "on another input - left alone"
    ok = setvcp(bus, 0xD6, 1)
    src = _store().get(conn + ":" + edid.hex())
    if take_input and src is not None and getvcp(bus, 0x60) not in (None, src):
        ok = setvcp(bus, 0x60, src) and ok
    return "woken" if ok else "write failed"


def settle():
    """Only one external screen: it is the one to use, so turn it on and bring it to our input."""
    found = list(screens())
    if len(found) == 1 and read(*found[0])[0] in ("other-input", "off", "standby"):
        print(found[0][0], wake(*found[0], take_input=True))


def _kwin_layout(conn):
    """KDE's main-screen order and scale for a screen, so turning it back on restores both (KDE brings a re-enabled
    screen back as a secondary screen at its default scale: a TV that was the main screen lost the taskbar)."""
    try:
        o = next(x for x in json.loads(subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=10).stdout)["outputs"] if x.get("name") == conn)
        return {"priority": int(o["priority"]), "scale": float(o["scale"])}
    except Exception:
        return {}


def _kwin_enable(conn, on, layout=None):
    extra = "".join(f" output.{conn}.{k}.{v:g}" for k, v in (layout or {}).items())
    os.system(f"kscreen-doctor output.{conn}.{'enable' if on else 'disable'}{extra} >/dev/null 2>&1")


def _kwin_outputs():
    try:
        return [o["name"] for o in json.loads(subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=10).stdout)["outputs"] if o.get("connected")]
    except Exception:
        return []


def _reference_path():
    """The NVIDIA reference path (Legion Go SteamOS / CachyOS): not Bazzite, not ROG Ally / XG Mobile, not the AMD / Intel install,
    not NV GPU Buddy. The picked-screen-only rule at login runs there only; every other setup keeps what KWin shows."""
    rd = lambda f: open(f).read() if os.path.exists(f) else ""
    if "bazzite" in rd("/etc/os-release").lower() or os.path.exists("/var/lib/nvegpu/xg-mobile-seen"): return False
    if rd("/etc/nv-egpu-buddy/gpu-vendor").strip() == "amd" or rd("/etc/nv-egpu-buddy/track").strip() == "nv-gpu-buddy": return False
    return subprocess.run(["/usr/local/sbin/egpu-detect", "--device"], capture_output=True, text=True).stdout.strip() != "rog-ally"


def only(conn):
    """Desktop (KWin): CONN is the only screen showing an image; every other screen KWin drives goes off, in one
    KWin change (the owner's rule: picking a screen in the app = an image on that screen alone). The handheld's own
    panel is on the other GPU when the desktop runs on the eGPU, so it is not KWin's to switch: panel-off does that."""
    names = _kwin_outputs()
    if conn not in names:
        return f"{conn} is not a screen KWin drives"
    on, off = [f"output.{conn}.enable", f"output.{conn}.priority.1"], [f"output.{n}.disable" for n in names if n != conn]
    if _reference_path() and off:
        # NVIDIA reference path: one KWin change that turned the monitor on AND the TV off (DP-7 5120x1440@144 HDR,
        # HDMI-A-1 off; RTX 5060 Ti, 2026-11-10) hit "Flip event timeout on head 0" in nvidia-drm and the monitor stayed
        # black until its cable was replugged. The picked screen on first, the others off once it is up: two smaller changes.
        subprocess.run(["kscreen-doctor"] + on, capture_output=True, timeout=20)
        time.sleep(4)   # ponytail: fixed settle; poll KWin for the output's first frame if 4 s ever proves short
        subprocess.run(["kscreen-doctor"] + off, capture_output=True, timeout=20)
    else:
        subprocess.run(["kscreen-doctor"] + on + off, capture_output=True, timeout=20)
    if not conn.startswith("eDP") and not any(n.startswith("eDP") for n in names):
        subprocess.run(["sudo", "-n", "/usr/local/sbin/nv-egpu-buddy-privileged", "panel-off"], capture_output=True, timeout=20)
    return "only " + conn


def _connected():
    """(connector, EDID) of every connected non-panel output, from the kernel's own copy: no I2C."""
    out = []
    for node in sorted(glob.glob("/sys/class/drm/card*-*")):
        conn = re.sub(r"^card\d+-", "", os.path.basename(node))
        if conn.startswith(("eDP", "LVDS", "DSI", "Writeback")):
            continue
        try:
            if open(node + "/status").read().strip() == "connected":
                out.append((conn, open(node + "/edid", "rb").read()[:128]))
        except OSError:
            pass
    return tuple(out)


def watch():
    """Desktop (KWin) only - Game Mode picks its screens at attach (nv-egpu-buddy-mount)."""
    names, last, ours, seen_once = set(), {}, {}, {}   # ours: screens this watcher disabled -> their KDE layout
    if subprocess.run(["which", "kscreen-doctor"], capture_output=True).returncode:
        print("no kscreen-doctor (not KDE Plasma): desktop screen rule off", flush=True); return
    # With one external screen, no I2C in the 5 s loop (every machine; first seen on the XG Mobile). After a desktop
    # screen-off / wake, every EDID read on the monitor's bus blanked a Dell U3415W on DisplayPort for a moment (XG Mobile RTX 5070 Ti Laptop,
    # NVIDIA 610.57.04 open, SteamOS 3.9.5; GitHub issue #6 by akamel001). The kernel's connector status and EDID are read
    # each pass instead, and the I2C scan runs only when that set changes. Two or more screens: unchanged.
    # the screen picked in the plugin / desktop app (NVIDIA reference path: the file exists only there): once per
    # desktop login that screen alone shows an image, as Game Mode does. KWin can still be starting: wait for it.
    try:
        pick = open("/var/lib/nvegpu/game-screen").read().strip() if _reference_path() else ""
    except OSError:
        pick = ""
    for _ in range(12 if pick else 0):
        if os.system("pgrep -x 'gamescope(-wl)?' >/dev/null") == 0 or pick in _kwin_outputs():
            break
        time.sleep(5)
    if pick and os.system("pgrep -x 'gamescope(-wl)?' >/dev/null") != 0 and pick in _kwin_outputs():
        print(f"{pick}: picked screen -> {only(pick)}", flush=True)
    seen = None
    while True:
        if os.system("pgrep -x 'gamescope(-wl)?' >/dev/null") != 0:
            cur = _connected()
            if cur == seen and len(cur) <= 1:
                time.sleep(5); continue
            seen = cur
            found = list(screens())
            now = {f[0] for f in found}
            if now - names:
                settle()  # something was plugged in
            names = now
            if len(found) > 1:
                for conn, bus, edid in found:
                    st = read(conn, bus, edid)[0]
                    if st == "unknown" and conn in last:
                        continue  # a read that failed this time is not news
                    if st == last.get(conn):
                        continue  # act on changes only, so a manual KDE change is never fought
                    if seen_once.get(conn) != st:
                        seen_once[conn] = st; continue  # a new state must hold for two passes (10 s): a TV reads "off" for a
                        # moment while it powers up with the dock, and a disable + enable 7 s apart left the eGPU head dark
                    last[conn] = st
                    use = st not in ("other-input", "off")
                    enabled = any(open(n).read().strip() == "enabled" for n in glob.glob(f"/sys/class/drm/card*-{conn}/enabled"))
                    others = [c for c, _, _ in found if c != conn and any(open(n).read().strip() == "enabled"
                              for n in glob.glob(f"/sys/class/drm/card*-{c}/enabled"))]
                    # Only ever undo our own change: re-enable a screen this watcher disabled, never one KDE (or
                    # the user) turned off. A KDE-side output toggle on the eGPU can leave the link dark.
                    if not use and enabled and others:  # never switch off the last lit screen
                        print(f"{conn}: {st} -> disable", flush=True)
                        ours[conn] = _kwin_layout(conn); _kwin_enable(conn, False)
                    elif use and not enabled and conn in ours:
                        print(f"{conn}: {st} -> enable (we disabled it)", flush=True)
                        _kwin_enable(conn, True, ours.pop(conn))
        time.sleep(5)


# ---- TV controls (volume / mute) and "Turn the TV off at Safe Detach" (both opt-in, off by default; NET's
# "cec_remote" and "off_at_detach"). Two routes: the eGPU's own CEC adapter through SteamOS's CEC service (cecd; the
# remote part follows cec-mote by xXJSONDeruloXx, BSD-3) and a paired LG webOS TV over the network. Neither touches
# /dev/cec* itself: cecd owns the adapter, and Safe Detach releases it before the GPU driver goes (egpu-generic).
CECD = "com.steampowered.CecDaemon1"


def _settings():
    try:
        return json.load(open(NET))
    except (OSError, ValueError):
        return {}


def _steamos():
    """SteamOS's CEC service (cecd) is there: what the remote talks to (SteamOS, or any system that ships it)."""
    return any(os.access(os.path.join(d, "steamos-readonly"), os.X_OK) for d in ("/usr/bin", "/usr/sbin", "/usr/local/bin")) or \
        any(os.path.exists(f) for f in ("/usr/lib/systemd/user/cecd.service", "/etc/systemd/user/cecd.service"))


def egpu_cec():
    """N of /dev/cecN for the TV the eGPU feeds: the eGPU's own CEC (AMD / Intel: DP-CEC on its connector or a
    CEC-capable adapter on it), else a USB-CEC adapter; never one of the handheld's own GPU."""
    try:
        bdf = subprocess.run(["/usr/local/sbin/egpu-detect"], capture_output=True, text=True, timeout=10).stdout.split()[0]
    except (OSError, IndexError, subprocess.TimeoutExpired):
        return None
    cecs = sorted(glob.glob("/sys/bus/cec/devices/cec*"))   # cec is a bus: <parent device>/cecN
    for c in cecs:
        if f"/{bdf}/" in os.path.realpath(c) + "/":
            return int(re.sub(r"\D", "", os.path.basename(c)))
    # Any eGPU brand: a USB-CEC adapter (e.g. Pulse-Eight) sits in the HDMI cable between the eGPU and the TV; NVIDIA
    # cards expose no CEC of their own. A CEC adapter on the handheld's own GPU (its USB-C port) is a different screen.
    for c in cecs:
        if "/usb" in os.path.realpath(c):
            return int(re.sub(r"\D", "", os.path.basename(c)))
    return None


def _cecd(n, *args, timeout=6):
    """busctl --user against cecd's device CecN, as the session user (cecd runs in the user's session)."""
    env = {"PATH": "/usr/bin:/bin", "XDG_RUNTIME_DIR": "/run/user/1000", "DBUS_SESSION_BUS_ADDRESS": "unix:path=/run/user/1000/bus"}
    cmd = ["busctl", "--user", *args[:1], CECD, f"/com/steampowered/CecDaemon1/Devices/Cec{n}", CECD + ".CecDevice1", *args[1:]]
    if os.getuid() == 0:
        cmd = ["runuser", "-u", pwd.getpwuid(1000).pw_name, "--", "env", *[f"{k}={v}" for k, v in env.items()], *cmd]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env)
        return r.returncode == 0, r.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return False, ""


def _lg_tv():
    """The paired LG TV that is connected to us right now (EDID from the kernel: no I2C), only with TV control on."""
    d = _settings()
    if not d.get("enabled"):
        return None
    for _, edid in _connected():
        if edid.hex() in d.get("tvs", {}):
            return d["tvs"][edid.hex()]
    return None


NVCEC = "/etc/modprobe.d/egpu-buddy-dp-cec.conf"   # NVIDIA CEC (patched driver 180): nvidia_drm dp_cec=1


def nv_cec_state():
    """NVIDIA install: whether the patched driver offers DP CEC, the option is set, and the loaded driver has it on."""
    if open("/etc/nv-egpu-buddy/gpu-vendor").read().strip() == "amd" if os.path.exists("/etc/nv-egpu-buddy/gpu-vendor") else False:
        return {"nvidia": False, "supported": False, "on": False, "loaded": False, "rebuild": ""}
    try:
        rb = json.load(open("/run/nvegpu/driver-rebuild.json")).get("state", "")   # running / done / failed (this boot)
    except (OSError, ValueError):
        rb = ""
    par = "/sys/module/nvidia_drm/parameters/dp_cec"
    sup = os.path.exists(par) or "dp_cec:" in subprocess.run(["modinfo", "-p", "nvidia_drm"], capture_output=True, text=True).stdout
    loaded = os.path.exists(par) and open(par).read().strip() in ("Y", "1")
    return {"nvidia": True, "supported": sup, "on": os.path.exists(NVCEC), "loaded": loaded, "rebuild": rb}


def remote_routes():
    d, out = _settings(), []
    if d.get("cec_remote") and _steamos() and egpu_cec() is not None:
        out.append("cec")
    if _lg_tv():
        out.append("lg")
    return out


def _edid_pa(conn):
    """The HDMI physical address in a screen's EDID (HDMI vendor block, OUI 00-0C-03): the TV port it sits on."""
    for f in glob.glob(f"/sys/class/drm/card*-{conn}/edid"):
        try:
            e = open(f, "rb").read()
        except OSError:
            continue
        i = e.find(b"\x03\x0c\x00", 128)
        if i > 0 and i + 5 <= len(e):
            return (e[i + 3] << 8) | e[i + 4]
    return None


def cec_power(n):
    """The TV's power state over CEC (Give Device Power Status -> Report Power Status), through cecd's
    SendReceiveRawMessage: "on", "standby", or None when this cecd or the TV doesn't answer."""
    ok, out = _cecd(n, "call", "SendReceiveRawMessage", "ayyyq", "1", "143", "0", "144", "1500")
    v = out.split()
    if ok and len(v) >= 4 and v[2] == "144":
        return {"0": "on", "2": "on"}.get(v[3], "standby")   # 2 = turning on
    return None


def cec_on_input(n, take_input=True):
    """TV on (only if it isn't) and onto our HDMI input (SetActiveSource with our own physical address: the TV
    picks the right port itself, whatever it is numbered)."""
    pw = cec_power(n)
    if pw != "on":
        _cecd(n, "call", "Wake"); time.sleep(2)
    if take_input:
        ok, pa = _cecd(n, "get-property", "PhysicalAddress")
        if ok and len(pa.split()) == 2:
            _cecd(n, "call", "SetActiveSource", *pa.split())
    return ("was " + pw if pw else "power state unknown") + (", woken" if pw != "on" else "") + (", our input" if take_input else "")


def _cec_wake(conn, take_input):
    """Moving Game Mode / the desktop to CONN with "TV remote (CEC)" on: only when CONN is the TV on the CEC link
    (the screen's EDID physical address is the one cecd reports)."""
    if "cec" not in remote_routes():
        return None
    n = egpu_cec()
    ok, pa = _cecd(n, "get-property", "PhysicalAddress")
    if not ok or len(pa.split()) != 2 or _edid_pa(conn) != int(pa.split()[1]):
        return None
    return "CEC: " + cec_on_input(n, take_input)


def tvkey(key):
    """Volume up / down / mute / on / off on the TV: CEC first (the eGPU's adapter), else the paired LG TV."""
    routes = remote_routes()
    if key in ("on", "off", "input"):
        if "cec" in routes:
            n = egpu_cec()
            if key == "off" and _cecd(n, "call", "Standby", "y", "0")[0]:
                return "ok (CEC): TV off"
            if key in ("on", "input"):
                return "ok (CEC): " + cec_on_input(n, True)
        if "lg" in routes:
            tv = _lg_tv()
            if key == "off":
                if (webos(tv["ip"], "ssap://system/turnOff", key=tv["key"], wait=4)[1] or {}).get("returnValue"):
                    return "ok (LG): TV off"
                return "the TV did not answer (already off?)"
            r = _net_wake(tv, True)   # wake-on-LAN (if off), then our HDMI input (the TV control tricks' own wake)
            return "ok (LG): " + r
        return "no TV to control" if not routes else "the TV did not answer"
    if "cec" in routes:
        n = egpu_cec(); ok, out = _cecd(n, "get-property", "AudioLogicalAddress")
        la = out.split()[-1] if ok and out else "0"
        ok, _ = _cecd(n, "call", {"up": "VolumeUp", "down": "VolumeDown", "mute": "Mute"}[key], "y", la)
        if ok:
            return "ok (CEC)"
    if "lg" in routes:
        tv = _lg_tv()
        if key == "mute":
            st = webos(tv["ip"], "ssap://audio/getStatus", key=tv["key"], perms=("CONTROL_AUDIO",))[1] or {}
            uri, pl = "ssap://audio/setMute", {"mute": not st.get("mute", False)}
        else:
            uri, pl = {"up": "ssap://audio/volumeUp", "down": "ssap://audio/volumeDown"}[key], None
        r = webos(tv["ip"], uri, pl, key=tv["key"], perms=("CONTROL_AUDIO",), wait=8)[1]
        if r and r.get("returnValue"):
            return "ok (LG)"
        return "the TV did not allow it: choose Allow on the TV, or Pair again in Setup > Extras"
    return "no TV to control" if not routes else "the TV did not answer"


def tvoff():
    """Safe Detach, only with "Turn the TV off at Safe Detach" on: TV to standby while it can still be reached."""
    if not _settings().get("off_at_detach"):
        return "off at detach: not enabled"
    routes = remote_routes()
    if "cec" in routes and _cecd(egpu_cec(), "call", "Standby", "y", "0")[0]:
        return "TV standby (CEC)"
    if "lg" in routes:
        tv = _lg_tv()
        if (webos(tv["ip"], "ssap://system/turnOff", key=tv["key"], wait=4)[1] or {}).get("returnValue"):
            return "TV off (LG)"
    return "TV not reached"


def main(argv):
    cmd, want = (argv[1] if len(argv) > 1 else "list"), argv[2:]
    if cmd == "tvctl" and want in (["on"], ["off"]):   # TV control tricks on / off (the file is root's; the app and the plugin both switch it)
        try: d = json.load(open(NET))
        except (OSError, ValueError): d = {}
        d["enabled"] = want[0] == "on"
        os.makedirs(os.path.dirname(NET), exist_ok=True); json.dump(d, open(NET, "w")); os.chmod(NET, 0o644)
        print("TV control " + want[0]); return 0
    if cmd == "tvset" and len(want) == 2 and want[0] == "nvidia_dp_cec" and want[1] in ("on", "off"):
        # takes effect the next time the NVIDIA driver loads (eGPU plugged in again, or a restart)
        if want[1] == "on":
            open(NVCEC, "w").write("# EGPU Buddy: HDMI-CEC through a CEC-capable DisplayPort-to-HDMI adapter (patched nvidia-drm)\noptions nvidia_drm dp_cec=1\n")
        elif os.path.exists(NVCEC):
            os.remove(NVCEC)
        print(f"nvidia_dp_cec {want[1]}"); return 0
    if cmd in ("tvset",) and len(want) == 2 and want[0] in ("cec_remote", "off_at_detach") and want[1] in ("on", "off"):
        d = _settings(); d[want[0]] = want[1] == "on"
        os.makedirs(os.path.dirname(NET), exist_ok=True); json.dump(d, open(NET, "w")); os.chmod(NET, 0o644)
        print(f"{want[0]} {want[1]}"); return 0
    if cmd == "tvkey" and want in (["up"], ["down"], ["mute"], ["on"], ["off"], ["input"]):
        print(tvkey(want[0])); return 0
    if cmd == "tvoff":
        print(tvoff()); return 0
    if cmd == "tvremote":   # what the plugin shows: which routes work right now
        d = _settings()
        print(json.dumps({"routes": remote_routes(), "cec_remote": bool(d.get("cec_remote")), "off_at_detach": bool(d.get("off_at_detach")),
                          "cec_here": _steamos() and egpu_cec() is not None, "nv_cec": nv_cec_state()})); return 0
    take_input = "--input" in want
    want = [w for w in want if w != "--input"]
    found = [s for s in screens() if not want or s[0] in want]
    if cmd == "list":
        for conn, bus, edid in found:
            st, power, src = read(conn, bus, edid)
            print(json.dumps({"connector": conn, "state": st, "ddc": bus is not None,
                              "input": INPUTS.get(src, src), "power": power,
                              "name": edid_name(edid)}))
        return 0
    if cmd == "state":
        if not found:
            print("disconnected"); return 0
        st = read(*found[0])[0]
        print(st)
        return 1 if st == "other-input" else 0
    if cmd == "wake":
        for s in found:
            print(s[0], wake(*s, take_input=take_input))
        return 0
    if cmd == "replug":
        # Software unplug + replug: the screen drops out of the compositor and comes back with a fresh link training.
        # Brings back a DisplayPort monitor that sits in "no signal" while the GPU is scanning out to it (seen on the
        # NVIDIA eGPU after a desktop re-login; before, only pulling the cable fixed it). Desktop only: what gamescope
        # does when its screen vanishes is untested.
        if os.system("pgrep -x 'gamescope(-wl)?' >/dev/null") == 0:
            print("Game Mode is running: replug is desktop-only"); return 1
        for conn, _, _ in found:
            for st in glob.glob(f"/sys/class/drm/card*-{conn}/status"):
                open(st, "w").write("off"); time.sleep(3); open(st, "w").write("detect")
            print(conn, "replugged")
        return 0
    if cmd == "only" and len(want) == 1:
        print(only(want[0])); return 0
    if cmd == "settle":
        settle(); return 0
    if cmd == "find":
        print("\n".join(find())); return 0
    if cmd == "pair" and len(want) == 2:
        print(pair(*want)); return 0
    if cmd == "watch":
        watch()
    if cmd == "selftest":  # the input rule without hardware: (connector, power, input) -> state
        global getvcp, _store
        real = getvcp, _store
        _store = lambda update=None: {}
        for conn, power, src, want in [("HDMI-A-1", 1, 0x0F, "other-input"), ("HDMI-A-1", 1, 0x11, "in-use"),
                                       ("DP-7", 1, 0x12, "in-use"),  # DP->HDMI adapter: not proof of another input
                                       ("HDMI-A-1", 1, 0x1B, "other-input"), ("DP-7", 1, 0x10, "in-use"),
                                       ("DP-7", 1, 0x1B, "in-use"), ("DP-7", 4, 0x10, "standby"),
                                       ("HDMI-A-1", None, None, "unknown")]:
            getvcp = lambda n, c, p=power, i=src: p if c == 0xD6 else i
            got = read(conn, 0, b"")[0]
            assert got == want, (conn, power, src, got, want)
        assert read("HDMI-A-1", None, b"")[0] == "unknown"
        getvcp, _store = real
        print("ok"); return 0
    print(__doc__); return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
