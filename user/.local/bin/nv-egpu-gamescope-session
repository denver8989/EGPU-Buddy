#!/usr/bin/env bash
set -euo pipefail

detect_nvidia_gpu_bdf() {
  local dev vendor class
  for dev in /sys/bus/pci/devices/*; do
    [ -r "$dev/vendor" ] || continue
    vendor=$(cat "$dev/vendor" 2>/dev/null || true)
    [ "$vendor" = "0x10de" ] || continue
    class=$(cat "$dev/class" 2>/dev/null || true)
    case "$class" in
      0x030000|0x030200) basename "$dev" ;;
    esac
  done | sort -V | head -n 1
}

# The fallback address is the development handheld's slot. Take it only when it
# really holds an NVIDIA GPU: every "is this connector the eGPU's?" test compares
# against this address, so a wrong value would attribute someone else's external
# display (a USB-C monitor, XR glasses) to an eGPU that is not there.
# Vendor-neutral eGPU test (the definition egpu-detect uses): a display-class PCI
# device that does not drive the built-in panel. NOT an "is it NVIDIA" test — an
# AMD or Intel eGPU must still pass. What it excludes is everything that is not a
# GPU at all, and the built-in GPU, whose connectors carry USB-C monitors and XR
# glasses and must never be handed to the eGPU path.
_is_display_class() { case "$(cat "/sys/bus/pci/devices/${1:-none}/class" 2>/dev/null)" in 0x0300*|0x0302*|0x0380*) return 0 ;; esac; return 1; }
_internal_gpu_bdf() { local c dev
  for c in /sys/class/drm/card*-eDP-*; do
    [ -e "$c" ] || continue
    dev=$(readlink -f "${c%-eDP-*}/device" 2>/dev/null) && { basename "$dev"; return 0; }
  done; return 1; }
is_egpu_bdf() {
  [ -n "${1:-}" ] || return 1
  _is_display_class "$1" || return 1
  [ "$1" != "$(_internal_gpu_bdf || true)" ]
}
nvidia_at_bdf() { [ "$(cat "/sys/bus/pci/devices/$1/vendor" 2>/dev/null)" = "0x10de" ]; }   # only for the NVIDIA-specific fallback address below
FALLBACK_GPU=${EGPU_FALLBACK_BDF:-0000:62:00.0}
EGPU_PCI=${EGPU_PCI_BDF:-$(detect_nvidia_gpu_bdf)}
if [ -z "$EGPU_PCI" ] && nvidia_at_bdf "$FALLBACK_GPU"; then EGPU_PCI=$FALLBACK_GPU; fi
# the built-in GPU is whichever drives the panel (0000:c2:00.0 on the Legion Go 2, elsewhere on an ROG Ally X); the old
# literal left igpu_card empty on other handhelds, so the handheld-screen route never ran and stock gamescope took the eGPU
IGPU_PCI=${IGPU_PCI:-$(_internal_gpu_bdf || echo 0000:c2:00.0)}
PANEL=${EGPU_PANEL_CONNECTOR:-eDP-1}
# Opt-in (plugin: Settings > Performance boost (M3)): the eGPU renders, a screen driven by the handheld's own GPU shows
# it (the built-in screen, or a USB-C display such as XR glasses). Off unless this file says so; only with an eGPU.
HANDHELD_CFG=/var/lib/nvegpu/handheld-screen.json
XGPU_LIB="$HOME/.local/lib/nv-egpu-buddy/xpw/libxpw.so"
# prints "<connector> <card> <WxH> <transfer>" when the option is on and its screen is connected to the handheld's GPU
handheld_passthrough_target() {
  [ -r "$HANDHELD_CFG" ] && [ -r "$XGPU_LIB" ] || return 1
  local en conn tr card mode
  read -r en conn tr < <(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(int(bool(d.get("enabled"))), d.get("connector") or "-", d.get("transfer") or "pyrowave")' "$HANDHELD_CFG" 2>/dev/null) || return 1
  [ "$en" = 1 ] && [ "$conn" != - ] || return 1
  card=$(basename "$(ls -d /sys/class/drm/card[0-9]*-"$PANEL" 2>/dev/null | head -1)"); card=${card%%-*}
  [ -n "$card" ] && [ "$(cat "/sys/class/drm/$card-$conn/status" 2>/dev/null)" = connected ] || return 1
  mode=$(head -1 "/sys/class/drm/$card-$conn/modes" 2>/dev/null); [ -n "$mode" ] || return 1
  printf '%s %s %s %s\n' "$conn" "$card" "$mode" "$tr"
}
# The handheld's own screen picked in the plugin ("Show Game Mode on the handheld screen"): Game Mode stays on the
# handheld GPU and games render on the eGPU (see the handheld route below).
# The handheld's own screen, or a screen on its USB-C port (XR glasses, a portable monitor), picked in the plugin: prints it.
handheld_screen() {
  local p c; p=$(cat /var/lib/nvegpu/game-screen 2>/dev/null); [ -n "$p" ] || return 1
  [ "$p" = "$PANEL" ] && { echo "$p"; return 0; }
  c=$(basename "$(ls -d /sys/class/drm/card[0-9]*-"$PANEL" 2>/dev/null | head -1)"); c=${c%%-*}
  [ -n "$c" ] && [ "$(cat "/sys/class/drm/$c-$p/status" 2>/dev/null)" = connected ] && { echo "$p"; return 0; }
  return 1
}
handheld_chosen() { handheld_screen >/dev/null; }
STOCK_GAMESCOPE_SESSION=${STOCK_GAMESCOPE_SESSION:-/usr/lib/steamos/gamescope-session}
PROFILE_HELPER=${EGPU_DISPLAY_PROFILE_HELPER:-/home/deck/.local/bin/egpu-display-profile.sh}
SHIM_DIR=${NV_EGPU_GAMESCOPE_SHIM_DIR:-/home/deck/.local/lib/nv-egpu-buddy/gamescope-shim}
FORMAT_FILTER=${NV_EGPU_GAMESCOPE_FORMAT_FILTER:-/home/deck/.local/lib/nv-egpu-buddy/nv-egpu-gamescope-format-filter.so}
EGPU_WAIT_SECONDS=${EGPU_GAMESCOPE_EGPU_WAIT_SECONDS:-25}
EGPU_PROBE_SECONDS=${EGPU_GAMESCOPE_EGPU_PROBE_SECONDS:-5}
EGPU_GAMESCOPE_HDR=${NV_EGPU_GAMESCOPE_HDR:-0}
# refresh cap for the eGPU output; 0 = none (use the display's best mode). The 60 Hz cap of the corruption era is gone
# since the GBM-scanout gamescope; set NV_EGPU_GAMESCOPE_MAX_REFRESH in the drop-in to cap again.
EGPU_GAMESCOPE_MAX_REFRESH=${NV_EGPU_GAMESCOPE_MAX_REFRESH:-0}
SDR_CLAMP=${NV_EGPU_GAMESCOPE_SDR_CLAMP:-/home/deck/.local/bin/nv-egpu-gamescope-sdr-clamp}
STEAM_SCALE_CLAMP=${NV_EGPU_GAMESCOPE_STEAM_SCALE_CLAMP_BIN:-/home/deck/.local/bin/nv-egpu-gamescope-steam-scale-clamp}

log() {
  printf 'nv-egpu-gamescope-session: %s\n' "$*" >&2
}

# A Game Mode reload is the moment to finish an update that was staged because the eGPU was in use:
# the previous session is gone and this one has not taken the display yet. Requiring a detach — or a
# reboot — to update the software that manages the eGPU is absurd, so it happens here instead.
# Refused automatically (and silently left for later) if the eGPU is actually presenting.
apply_staged_update() {
  local out
  [ -x /usr/local/sbin/nv-egpu-buddy-privileged ] || return 0
  [ "$(cat /etc/nv-egpu-buddy/version 2>/dev/null)" \
    != "$(cat /home/deck/.local/share/steamos-egpu-buddy/VERSION 2>/dev/null)" ] || return 0
  out=$(timeout 300 sudo -n /usr/local/sbin/nv-egpu-buddy-privileged apply-staged-update 2>&1) || true
  [ -n "$out" ] && log "staged update: $(printf '%s' "$out" | tr '\n' ' ')"
  return 0
}
apply_staged_update

card_for_pci() {
  local pci=$1 card fallback=
  # A GPU can carry MORE THAN ONE DRM card: a stale card survives a driver reload or a
  # remove/rescan cycle, and it has NO connectors. Taking the first one aimed gamescope at
  # the dead card, which exited instantly and crash-looped the whole session into a black
  # screen (Legion Go 1, card1 and card2 both on 0000:65:00.0, only card2 had outputs).
  # So: pick the card that has connectors.
  for card in /sys/bus/pci/devices/"$pci"/drm/card*; do
    [ -e "$card" ] || continue
    case "${card##*/}" in card[0-9]*) ;; *) continue ;; esac
    [ -n "$fallback" ] || fallback=${card##*/}
    if compgen -G "/sys/class/drm/${card##*/}-*" >/dev/null 2>&1; then
      printf '/dev/dri/%s\n' "${card##*/}"
      return 0
    fi
  done
  [ -n "$fallback" ] || return 1
  printf '/dev/dri/%s\n' "$fallback"
}

connected_egpu_outputs() {
  local node base output device
  # A display belongs to an eGPU only if the card driving it really is an eGPU.
  # Checked here, not just where the address is resolved: a wrong address must
  # never be able to hand an ordinary external display (USB-C monitor, XR
  # glasses, dock) to the eGPU path.
  is_egpu_bdf "$EGPU_PCI" || return 0
  for node in /sys/class/drm/card*-*; do
    [ -e "$node/status" ] || continue
    [ "$(cat "$node/status" 2>/dev/null)" = "connected" ] || continue
    base=${node##*/}
    output=$(printf '%s\n' "$base" | sed -E 's/^card[0-9]+-//')
    [ -n "$output" ] || continue
    [ "$output" != "$PANEL" ] || continue
    case "$output" in
      Writeback-*) continue ;;
    esac
    device=$(readlink -f "$node/device/device" 2>/dev/null || true)
    case "$device" in
      */"$EGPU_PCI") printf '%s\n' "$output" ;;
    esac
  done | sort -u
}

bar1_size_bytes() {
  local start end _flags resource="/sys/bus/pci/devices/$EGPU_PCI/resource"
  [ -r "$resource" ] || { printf '0\n'; return; }
  read -r start end _flags < <(sed -n '2p' "$resource" 2>/dev/null)
  case "$start:$end" in
    0x*:0x*) ;;
    *) printf '0\n'; return ;;
  esac
  [ "$end" != "0x0000000000000000" ] || { printf '0\n'; return; }
  [ $((end)) -ge $((start)) ] || { printf '0\n'; return; }
  printf '%s\n' $((end - start + 1))
}

bar1_full() {
  [ "$(bar1_size_bytes)" -ge 17179869184 ]
}

# A small BAR1 is a PERFORMANCE limit, not a reason to refuse the eGPU. It used to be part of
# the readiness gate, which meant that on any boot where the BAR could not be resized — and it
# cannot be resized at all once the driver is bound, or when the platform's hotplug window has
# no room for it — Game Mode silently stayed on the built-in screen with a working eGPU sitting
# right there. The CachyOS machine this project was developed on runs with ReBAR off entirely
# and is fine. What actually proves the GPU is healthy is NVML responding, which the attach
# hook already gates on: a wedged init cannot answer it.
bar1_note() {
  bar1_full && return 0
  log "BAR1 is $(( $(bar1_size_bytes) / 1048576 ))MiB, not resized (lower performance over Thunderbolt, but the eGPU is used anyway)"
  return 0
}

connector_order() {
  local output first=1
  # the screen picked in the plugin ("Show Game Mode on ...") goes first while it is connected
  local pref outs; pref=$(cat /var/lib/nvegpu/game-screen 2>/dev/null); outs=$(connected_egpu_outputs)
  if [ -n "$pref" ] && printf '%s\n' $outs | grep -qx "$pref"; then outs="$pref $(printf '%s\n' $outs | grep -vx "$pref")"; fi
  for output in $outs; do
    if [ "$first" -eq 1 ]; then
      printf '%s' "$output"
      first=0
    else
      printf ',%s' "$output"
    fi
  done
  if [ "$first" -eq 1 ]; then
    printf '*,%s\n' "$PANEL"
  else
    printf ',*,%s\n' "$PANEL"
  fi
}

clear_egpu_env() {
  unset NV_EGPU_GAMESCOPE_GENERIC_VK MESA_VK_DEVICE_SELECT
  [ "${NV_EGPU_GENERIC_SYSMEM:-}" = 1 ] && unset DXVK_CONFIG VKD3D_CONFIG NV_EGPU_GENERIC_SYSMEM
  unset DISPLAY
  unset WAYLAND_DISPLAY
  unset WAYLAND_SOCKET
  unset XAUTHORITY
  unset OUTPUT_CONNECTOR
  unset KWIN_DRM_DEVICES
  unset WLR_DRM_DEVICES
  unset DRI_PRIME
  unset VK_DRIVER_FILES
  unset VK_ICD_FILENAMES
  unset __EGL_VENDOR_LIBRARY_FILENAMES
  unset __GLX_VENDOR_LIBRARY_NAME
  unset GAMESCOPE_FORCE_GENERAL_QUEUE
  unset PROTON_ENABLE_NVAPI
  unset DXVK_ENABLE_NVAPI
  unset PROTON_HIDE_NVIDIA_GPU
  unset DXVK_HDR
  unset ENABLE_HDR_WSI
  unset PROTON_ENABLE_HDR
  unset STEAM_GAMESCOPE_HDR_SUPPORTED
  unset STEAM_DISPLAY_REFRESH_LIMITS
  unset NV_EGPU_GAMESCOPE_OUTPUT_WIDTH
  unset NV_EGPU_GAMESCOPE_OUTPUT_HEIGHT
  unset NV_EGPU_GAMESCOPE_NESTED_WIDTH
  unset NV_EGPU_GAMESCOPE_NESTED_HEIGHT
  unset NV_EGPU_GAMESCOPE_NESTED_REFRESH
  unset NV_EGPU_GAMESCOPE_FORCE_8BIT
  unset NV_EGPU_GAMESCOPE_FORCE_LINEAR
  unset NV_EGPU_GAMESCOPE_MAX_BLOCK_HEIGHT
  unset NV_EGPU_GAMESCOPE_DISABLE_MODIFIERS
  unset NV_EGPU_GAMESCOPE_HDMI_REDUCED_BLANKING
  unset NV_EGPU_GAMESCOPE_DRM_SYNC_GUARDS
  unset NV_EGPU_GAMESCOPE_FORMAT_FILTER_ENABLE
  unset NV_EGPU_GAMESCOPE_FORMAT_FILTER
  unset NV_EGPU_GAMESCOPE_STEAM_SCALE_CLAMP
  unset NV_EGPU_GAMESCOPE_STEAM_SCALE_CLAMP_BIN
  unset STEAM_GAMESCOPE_FORCE_HDR_DEFAULT
  unset STEAM_GAMESCOPE_FORCE_OUTPUT_TO_HDR10PQ_DEFAULT
  # GBM-scanout gamescope build is an NVIDIA-only workaround: handheld/iGPU sessions use the stock binary
  unset NV_EGPU_BUDDY_GAMESCOPE_BIN
  unset gamescope_drm_gbm_scanout
}

clear_session_env() {
  unset DISPLAY
  unset WAYLAND_DISPLAY
  unset WAYLAND_SOCKET
  unset XAUTHORITY
}

refresh_egpu_target() {
  local detected
  detected=${EGPU_PCI_BDF:-$(detect_nvidia_gpu_bdf)}
  # Keep the previously resolved address (a surprise unplug takes the device off
  # the bus mid-session), but never invent one that was never verified as NVIDIA.
  [ -n "$detected" ] || detected=${EGPU_PCI:-}
  EGPU_PCI=$detected
}

refresh_egpu_state() {
  refresh_egpu_target
  egpu_card=$(card_for_pci "$EGPU_PCI" || true)
  igpu_card=$(card_for_pci "$IGPU_PCI" || true)
  outputs=$(connected_egpu_outputs | paste -sd, -)
  bar1_bytes=$(bar1_size_bytes)
}

egpu_requested_by_env_file() {
  local conf_file="/home/deck/.config/environment.d/10-egpu-gamescope-output.conf"
  [ -r "$conf_file" ] || return 1
  grep -Eq '^(OUTPUT_CONNECTOR|KWIN_DRM_DEVICES)=' "$conf_file"
}

egpu_pci_present() {
  refresh_egpu_target
  [ -n "$EGPU_PCI" ] || return 1
  # Vendor-checked: the fallback address is only correct on the development
  # handheld. On any other machine that slot may hold an unrelated device
  # (a USB-C display controller, a storage bridge) and must not read as an eGPU.
  [ "$(cat "/sys/bus/pci/devices/$EGPU_PCI/vendor" 2>/dev/null)" = "0x10de" ]
}

# ROG Ally / XG Mobile (each detected on its own): only route Game Mode to the eGPU while the NVIDIA driver holds it and
# the shim has not seen it fail. nouveau holding the card (beta driver trial) or a GPU that stopped answering made every
# gamescope start die at vkCreateInstance, and the session restarted it every 2 s on a black screen until a forced
# restart (ROG Xbox Ally X report). Then the handheld screen is used instead. Elsewhere the readiness test is as tested.
ALLYXGM=0; { [ "$(/usr/local/sbin/egpu-detect --device 2>/dev/null)" = rog-ally ] || [ -e /var/lib/nvegpu/xg-mobile-seen ]; } && ALLYXGM=1
GPUFAULT=${XDG_RUNTIME_DIR:-/run/user/1000}/nv-egpu-buddy/egpu-gpufault
allyxgm_egpu_usable() {
  [ "$ALLYXGM" = 1 ] || return 0
  local drv; drv=$(basename "$(readlink -f "/sys/bus/pci/devices/$EGPU_PCI/driver" 2>/dev/null)")
  local why=""
  [ "$drv" = nvidia ] || why="the eGPU $EGPU_PCI is not held by the NVIDIA driver (${drv:-none})"
  [ -z "$why" ] && [ -e "$GPUFAULT" ] && why="the eGPU stopped answering (gamescope crash loop); until it is attached or plugged in again"
  [ -z "$why" ] && return 0
  [ "${_allyxgm_said:-}" = "$why" ] || { log "$why: handheld routing"; _allyxgm_said=$why; }
  return 1
}

egpu_native_ready() {
  refresh_egpu_state
  [ -n "$egpu_card" ] &&
    [ -n "$igpu_card" ] &&
    { [ -n "$outputs" ] || handheld_passthrough_target >/dev/null || handheld_chosen; } &&
    [ -r /usr/share/vulkan/icd.d/nvidia_icd.json ] &&
    allyxgm_egpu_usable
}

wait_for_egpu_native_ready() {
  local elapsed=0 requested=0 announced=0

  egpu_requested_by_env_file && egpu_pci_present && requested=1   # a stale env file must not cost 25s when no eGPU is on the bus
  while [ "$elapsed" -lt "$EGPU_WAIT_SECONDS" ]; do
    if egpu_native_ready; then
      if [ "$announced" -eq 1 ]; then
        log "eGPU became Game Mode ready after ${elapsed}s: $outputs"
      fi
      return 0
    fi

    if [ "$requested" -eq 0 ]; then
      if egpu_pci_present; then
        requested=1
      elif [ "$elapsed" -ge "$EGPU_PROBE_SECONDS" ]; then
        return 1
      fi
    fi

    if [ "$announced" -eq 0 ]; then
      # Say which of the two waits this is. The old message always claimed the full eGPU
      # wait, even when no eGPU was on the bus and it was about to give up after
      # EGPU_PROBE_SECONDS — which reads in the logs like a 25s stall that never happened.
      if [ "$requested" -eq 1 ]; then
        log "waiting up to ${EGPU_WAIT_SECONDS}s for NVIDIA-native Game Mode routing"
      else
        log "checking for an eGPU (up to ${EGPU_PROBE_SECONDS}s); handheld routing if none appears"
      fi
      announced=1
    fi
    if [ "$requested" -eq 1 ] && ! egpu_pci_present; then
      log "eGPU left the bus while waiting (surprise removal): handheld routing now"
      break
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done

  refresh_egpu_state
  if [ "$requested" -eq 1 ] && [ "$elapsed" -ge "$EGPU_WAIT_SECONDS" ]; then
    log "eGPU wait timed out; falling back to handheld gamescope routing"
  fi
  if ! lspci -Dn 2>/dev/null | grep -qE '0300: 10de:'; then
    # no eGPU on the bus: drop attach-time routing left in the user manager (would pin the next desktop login to a missing card)
    systemctl --user unset-environment KWIN_DRM_DEVICES KWIN_RENDER_NODES VK_DRIVER_FILES VK_ICD_FILENAMES \
      __EGL_VENDOR_LIBRARY_FILENAMES __GLX_VENDOR_LIBRARY_NAME OUTPUT_CONNECTOR >/dev/null 2>&1 || true
  fi
  return 1
}

use_ultrawide_nested_canvas() {
  local output node request

  if [ "${NV_EGPU_GAMESCOPE_NATIVE_STEAM_CANVAS:-0}" = "1" ]; then
    return 1
  fi

  request=${NV_EGPU_GAMESCOPE_SYNTHETIC_GAME_CANVAS:-auto}
  case "$request" in
    auto|1|true|yes|on) ;;
    *) return 1 ;;
  esac

  # only the screen gamescope will drive (first in the order, the plugin's choice first) - not any connected one:
  # with an ultrawide AND a TV plugged in, Game Mode on the TV got the ultrawide's 32:9 canvas
  output=$(connector_order | cut -d, -f1)
  for node in /sys/class/drm/card*-"$output"; do
    [ -r "$node/modes" ] && grep -Fxq "5120x1440" "$node/modes" && return 0
  done
  return 1
}

best_sysfs_mode() {
  local output=$1 node mode
  for node in /sys/class/drm/card*-"$output"; do
    [ -r "$node/modes" ] || continue
    mode=$(awk '
      match($0, /^([0-9]+)x([0-9]+)$/, m) {
        width = m[1] + 0
        height = m[2] + 0
        rank = (width == 4096 && height == 2160) ? 3839 : width   # cinema DCI 4K ranks under a TV panel 3840x2160
        score = (rank * 1000000000) + (width * height)
        if (score > best_score) {
          best_score = score
          best_width = width
          best_height = height
        }
      }
      END {
        if (best_width != "") {
          print best_width " " best_height
        }
      }
    ' "$node/modes")
    [ -n "$mode" ] || continue
    printf '%s\n' "$mode"
    return 0
  done
  return 1
}

best_egpu_drm_mode() {
  local output=$1
  command -v modetest >/dev/null 2>&1 || return 1
  modetest -M nvidia-drm -c 2>/dev/null | awk -v output="$output" -v max_refresh="$EGPU_GAMESCOPE_MAX_REFRESH" '
    $0 ~ "connected[[:space:]]+" output "[[:space:]]" {
      in_connector = 1
      next
    }
    in_connector && /^  props:/ {
      exit
    }
    in_connector && /^  #[0-9]+/ {
      refresh = $3 + 0
      width = $4 + 0
      height = $8 + 0
      if (max_refresh != "" && (max_refresh + 0) > 0 && refresh > (max_refresh + 0.5)) {
        next
      }
      rank = (width == 4096 && height == 2160) ? 3839 : width   # cinema DCI 4K ranks under a TV panel 3840x2160
      score = (rank * 1000000000) + (width * height * 1000) + refresh
      if (score > best_score) {
        best_score = score
        best_width = width
        best_height = height
        best_refresh = refresh
      }
    }
    END {
      if (best_width != "") {
        printf "%s %s %.0f\n", best_width, best_height, best_refresh
      }
    }
  '
}

stage_gamescope_native_mode() {
  local output mode width height refresh
  # ROG Ally / XG Mobile only: right after boot the monitor behind the XG Mobile can be connected before its EDID has been
  # read, and the kernel then lists only its no-EDID fallback modes. Game Mode was staged at 1024x768 on a 5120x1440
  # Odyssey G9 (ROG Xbox Ally X report: a huge interface between thick black bars). Wait for the EDID (up to 20 s).
  if [ "$ALLYXGM" = 1 ]; then
    local o n i
    o=$(connector_order | tr , '\n' | grep -vxE '\*|eDP-[0-9]+' | head -1)
    for i in $(seq 1 20); do
      n=""; for n in /sys/class/drm/card*-"$o"; do [ -e "$n/edid" ] && break; done
      [ -n "$o" ] && [ -e "$n/edid" ] || break
      [ "$(head -c 8 "$n/edid" 2>/dev/null | wc -c)" -gt 0 ] && break
      [ "$i" = 1 ] && log "$o: connected but no EDID yet (only the fallback modes): waiting for it before staging the mode"
      sleep 1
    done
  fi
  # in Game Mode's own order (the plugin's choice first): the mode must be the screen gamescope drives
  for output in $(connector_order | tr , '\n' | grep -vxE '\*|eDP-[0-9]+'); do
    mode=$(best_egpu_drm_mode "$output" || true)
    if [ -z "$mode" ]; then
      mode=$(best_sysfs_mode "$output" || true)
    fi
    [ -n "$mode" ] || continue
    set -- $mode
    width=$1
    height=$2
    refresh=${3:-}
    export NV_EGPU_GAMESCOPE_OUTPUT_WIDTH="$width"
    export NV_EGPU_GAMESCOPE_OUTPUT_HEIGHT="$height"
    if [ -n "$refresh" ]; then
      export NV_EGPU_GAMESCOPE_NESTED_REFRESH="$refresh"
      export STEAM_DISPLAY_REFRESH_LIMITS="40,$refresh"
      log "staging Game Mode output ${width}x${height}@${refresh} on $output"
    else
      export STEAM_DISPLAY_REFRESH_LIMITS=40,60
      log "staging Game Mode output ${width}x${height} on $output"
    fi
    return 0
  done
  return 1
}

nohdr_stock_gamescope_session() {
  local dir out tmp
  dir="${XDG_RUNTIME_DIR:-/tmp}/nv-egpu-buddy"
  out="$dir/gamescope-session-nohdr"
  tmp="$out.tmp.$$"
  mkdir -p "$dir"
  awk '
    /^export STEAM_GAMESCOPE_HDR_SUPPORTED=1$/ {
      print "export STEAM_GAMESCOPE_HDR_SUPPORTED=0"
      next
    }
    /^export STEAM_USE_MANGOAPP=1$/ {
      print "export STEAM_USE_MANGOAPP=0"
      next
    }
    /^export STEAM_MANGOAPP_PRESETS_SUPPORTED=1$/ {
      print "export STEAM_MANGOAPP_PRESETS_SUPPORTED=0"
      next
    }
    /^export STEAM_MANGOAPP_HORIZONTAL_SUPPORTED=1$/ {
      print "export STEAM_MANGOAPP_HORIZONTAL_SUPPORTED=0"
      next
    }
    /^export STEAM_GAMESCOPE_COLOR_MANAGED=1$/ {
      print "export STEAM_GAMESCOPE_COLOR_MANAGED=0"
      next
    }
    /^export STEAM_GAMESCOPE_VIRTUAL_WHITE=1$/ {
      print "export STEAM_GAMESCOPE_VIRTUAL_WHITE=0"
      next
    }
    /^export STEAM_GAMESCOPE_VRR_SUPPORTED=1$/ {
      print "export STEAM_GAMESCOPE_VRR_SUPPORTED=0"
      next
    }
    /^export STEAM_GAMESCOPE_HAS_TEARING_SUPPORT=1$/ {
      print "export STEAM_GAMESCOPE_HAS_TEARING_SUPPORT=0"
      next
    }
    /^export STEAM_GAMESCOPE_TEARING_SUPPORTED=1$/ {
      print "export STEAM_GAMESCOPE_TEARING_SUPPORTED=0"
      next
    }
    /^[[:space:]]*export STEAM_GAMESCOPE_FORCE_HDR_DEFAULT=1$/ {
      sub(/=1$/, "=0")
      print
      next
    }
    /^[[:space:]]*export STEAM_GAMESCOPE_FORCE_OUTPUT_TO_HDR10PQ_DEFAULT=1$/ {
      sub(/=1$/, "=0")
      print
      next
    }
    /^[[:space:]]*export GAMESCOPE_WAYLAND_DISPLAY="\$response_wl_display"$/ {
      print
      print "    if [ -x \"${NV_EGPU_GAMESCOPE_SDR_CLAMP:-/home/deck/.local/bin/nv-egpu-gamescope-sdr-clamp}\" ]; then"
      print "      \"${NV_EGPU_GAMESCOPE_SDR_CLAMP:-/home/deck/.local/bin/nv-egpu-gamescope-sdr-clamp}\" >/tmp/nv-egpu-gamescope-sdr-clamp.log 2>&1 &"
      print "    fi"
      next
    }
    { print }
  ' "$STOCK_GAMESCOPE_SESSION" > "$tmp"
  chmod 700 "$tmp"
  mv "$tmp" "$out"
  printf '%s\n' "$out"
}

disable_steam_gamescope_hdr_config() {
  local config timestamp backup real seen=""
  timestamp=$(date +%Y%m%d_%H%M%S)
  for config in /home/deck/.local/share/Steam/config/config.vdf /home/deck/.steam/steam/config/config.vdf; do
    [ -f "$config" ] || continue
    real=$(readlink -f "$config" 2>/dev/null || printf '%s' "$config")
    case " $seen " in
      *" $real "*) continue ;;
    esac
    seen="$seen $real"
    backup="${config}.bak-nv-egpu-hdr-off-${timestamp}"
    cp -a "$config" "$backup"
    perl -0pi -e '
      s{
        ("HDREnabled"\s*\{)
        (.*?)
        (\n\s*\})
      }{
        my ($head, $body, $tail) = ($1, $2, $3);
        $body =~ s/("[^"]+"\s+)"1"/$1"0"/g;
        $head . $body . $tail;
      }egsx
    ' "$config"
  done
}

# non-NVIDIA eGPU (egpu-detect: "BDF VENDOR CARD") with a DRM card and a connected output
gen_bdf=; gen_vendor=; gen_card=; gen_outputs=
generic_egpu_ready() {
  [ "$(cat /etc/nv-egpu-buddy/gpu-vendor 2>/dev/null)" = amd ] || return 1   # walled off: the AMD / Intel install only
  [ -x /usr/local/sbin/egpu-detect ] || return 1
  read -r gen_bdf gen_vendor gen_card < <(/usr/local/sbin/egpu-detect 2>/dev/null) || return 1
  [ -n "$gen_card" ] && [ "$gen_vendor" != nvidia ] || return 1
  gen_outputs=$(for n in /sys/class/drm/"$gen_card"-*; do [ "$(cat "$n/status" 2>/dev/null)" = connected ] && printf '%s ' "${n##*/"$gen_card"-}"; done)
  [ -n "$gen_outputs" ]
}

egpu_card=
igpu_card=
outputs=
bar1_bytes=0
stock_session="$STOCK_GAMESCOPE_SESSION"

# SAFETY NET: a Vulkan driver pin that names a file which no longer exists makes the loader report "Found no drivers",
# and then NOTHING that uses Vulkan starts — not a game, not the compositor. That state can be left behind by any detach
# (the NVIDIA ICD is hidden while the card is away) or by an older version of this software. Repair it at session start.
for _v in VK_DRIVER_FILES VK_ICD_FILENAMES; do
  eval "_p=\${$_v:-}"
  if [ -n "${_p:-}" ] && [ ! -r "${_p%%:*}" ]; then
    unset "$_v"; systemctl --user unset-environment "$_v" >/dev/null 2>&1 || true
    logger -t egpu-buddy "repaired stale $_v (pointed at ${_p%%:*}, which does not exist)" 2>/dev/null || true
  fi
done
unset _v _p
# A "this GPU only" Vulkan pin (MESA_VK_DEVICE_SELECT=...!) or a DRI_PRIME choice is only ever set below, for this session's
# route. Inherited from an earlier one (the user manager keeps a session's environment) it could name an eGPU that is gone
# and leave gamescope with no GPU at all: never take it over.
# (the AMD / Intel install only: an NVIDIA setup starts exactly as it always did)
if [ "$(cat /etc/nv-egpu-buddy/gpu-vendor 2>/dev/null)" = amd ]; then
  unset MESA_VK_DEVICE_SELECT DRI_PRIME; systemctl --user unset-environment MESA_VK_DEVICE_SELECT DRI_PRIME >/dev/null 2>&1 || true
fi

# which session type is running: read by egpu-surprise-recover (gamescope itself dies with the card, so it cannot be asked)
# Only claim the session marker if a desktop is NOT on screen. SteamOS keeps this session's target
# active (and relaunches it) behind a running desktop, and each relaunch used to overwrite the
# marker with "gamemode" — so a cable pull on the desktop was recovered as Game Mode.
pgrep -U 1000 -x kwin_wayland >/dev/null 2>&1 ||
  printf gamemode > "${XDG_RUNTIME_DIR:-/run/user/1000}/egpu-session-type" 2>/dev/null || true
  # Keep the login manager's fallback pointing at the session actually in use, so that if this
  # session dies the machine comes back to Game Mode rather than somewhere else. The desktop attach
  # path sets the same knob to "desktop" for the mirror-image reason. DETECTION-GATED: steamosctl
  # exists only on SteamOS; CachyOS is untouched.
  # A real Game Mode session removes the desktop fallback pin, so Game Mode is the default again.
  sudo -n /usr/local/sbin/nv-egpu-buddy-privileged session-fallback game >/dev/null 2>&1 || true
# A Safe Detach restarts this session ON PURPOSE for the handheld screen, with the NVIDIA userspace already hidden: the eGPU
# can never become "ready" then, and the result is ignored below anyway. Waiting cost ~30 s of dark screen per detach.
if [ -e "${XDG_RUNTIME_DIR:-/run/user/1000}/egpu-detach-mode" ] || [ -e /run/nvegpu/gm-detach-pending ]; then
  log "Safe Detach in progress: handheld routing without waiting for the eGPU"; refresh_egpu_state
else
  wait_for_egpu_native_ready || refresh_egpu_state
fi
# ROG Ally / XG Mobile: a card the NVIDIA driver does not hold, or one that stopped answering, is not a Game Mode target
[ -n "$egpu_card" ] && ! allyxgm_egpu_usable && egpu_card=""

# NV-EGPU-Buddy safe detach (Game Mode): while the marker exists the relaunched session must NOT take the eGPU
# even though it is still on the bus (the detach helper removes it once this session is up on the panel).
detach_mode=0; { [ -e "${XDG_RUNTIME_DIR:-/run/user/1000}/egpu-detach-mode" ] || [ -e /run/nvegpu/gm-detach-pending ]; } && detach_mode=1
rm -f "${XDG_RUNTIME_DIR:-/run/user/1000}/nv-egpu-buddy/xgpu-active"
# (|| true: under set -e a failed lookup in the last command of this list would end the session script)
xgpu_target=""; [ "$detach_mode" = 0 ] && [ -n "$egpu_card" ] && { xgpu_target=$(handheld_passthrough_target) || xgpu_target=""; }
# the built-in screen only while no monitor is on the eGPU (that monitor is the better screen); a chosen USB-C screen always
if [ -n "$outputs" ] && [ "${xgpu_target%% *}" = "$PANEL" ]; then xgpu_target=""; fi
if [ "$detach_mode" = 0 ] && [ -n "$egpu_card" ] && [ -n "$igpu_card" ] && [ -z "$xgpu_target" ] && { handheld_chosen || [ -z "$outputs" ]; } &&
   [ -r /usr/share/vulkan/icd.d/nvidia_icd.json ]; then
  # Handheld screen with the eGPU rendering the games: gamescope composites on the handheld GPU and drives its screen
  # (the stock route), Steam and its games get the eGPU's drivers. Also the route when no monitor is on the eGPU: the
  # session used to put gamescope on the eGPU with no screen at all, and the handheld only showed the text console.
  clear_egpu_env
  clear_session_env
  export PATH="$SHIM_DIR:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin"
  hh=$(handheld_screen || echo "$PANEL")
  export OUTPUT_CONNECTOR="$hh"; [ "$hh" = "$PANEL" ] || OUTPUT_CONNECTOR="$hh,$PANEL"   # back to the built-in screen if it goes
  # games render through Vulkan (Proton, native) -> the eGPU. Steam's own interface (OpenGL/EGL) stays on the handheld
  # GPU like the compositor: drawn on the eGPU it reached gamescope unsynchronised (black, flickering on cursor moves).
  export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/nvidia_icd.json VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json
  export PROTON_ENABLE_NVAPI=1
  export NV_EGPU_GAMESCOPE_HANDHELD_GPU=1   # the shim keeps gamescope itself on the handheld GPU
  sudo -n /usr/local/sbin/nv-egpu-buddy-privileged panel-on >/dev/null 2>&1 || true
  log "handheld screen: Game Mode on $hh, games rendered on the eGPU ($( handheld_chosen && echo chosen in the plugin || echo no monitor on the eGPU ))"
elif [ "$detach_mode" = 0 ] && [ -n "$egpu_card" ] && [ -n "$igpu_card" ] && { [ -n "$outputs" ] || [ -n "$xgpu_target" ]; } && bar1_note && [ -r /usr/share/vulkan/icd.d/nvidia_icd.json ]; then
  clear_session_env
  [ -n "$xgpu_target" ] && EGPU_GAMESCOPE_HDR=0   # the passthrough carries 8-bit SDR frames
  export PATH="$SHIM_DIR:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin"
  export OUTPUT_CONNECTOR
  OUTPUT_CONNECTOR=$(connector_order)
  export KWIN_DRM_DEVICES="$egpu_card:$igpu_card"
  export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/nvidia_icd.json
  export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json
  export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json
  export __GLX_VENDOR_LIBRARY_NAME=nvidia
  export PROTON_ENABLE_NVAPI=1
  export DXVK_ENABLE_NVAPI=1
  export PROTON_HIDE_NVIDIA_GPU=0
  export NV_EGPU_GAMESCOPE_FORMAT_FILTER_ENABLE=${NV_EGPU_GAMESCOPE_FORMAT_FILTER_ENABLE:-1}
  if [ "$NV_EGPU_GAMESCOPE_FORMAT_FILTER_ENABLE" = "1" ]; then
    export NV_EGPU_GAMESCOPE_FORMAT_FILTER="$FORMAT_FILTER"
    export NV_EGPU_GAMESCOPE_FORCE_8BIT=${NV_EGPU_GAMESCOPE_FORCE_8BIT:-1}
    export NV_EGPU_GAMESCOPE_FORCE_LINEAR=${NV_EGPU_GAMESCOPE_FORCE_LINEAR:-0}
    export NV_EGPU_GAMESCOPE_MAX_BLOCK_HEIGHT=${NV_EGPU_GAMESCOPE_MAX_BLOCK_HEIGHT:-0}
    export NV_EGPU_GAMESCOPE_DISABLE_MODIFIERS=${NV_EGPU_GAMESCOPE_DISABLE_MODIFIERS:-0}
    export NV_EGPU_GAMESCOPE_HDMI_REDUCED_BLANKING=${NV_EGPU_GAMESCOPE_HDMI_REDUCED_BLANKING:-0}
    log "NVIDIA eGPU Gamescope format filter enabled: 8-bit scanout, lowest block height, no linear/no reduced-blanking rewrite"
  else
    unset NV_EGPU_GAMESCOPE_FORMAT_FILTER
    unset NV_EGPU_GAMESCOPE_FORCE_8BIT
    unset NV_EGPU_GAMESCOPE_FORCE_LINEAR
    unset NV_EGPU_GAMESCOPE_MAX_BLOCK_HEIGHT
    unset NV_EGPU_GAMESCOPE_DISABLE_MODIFIERS
    unset NV_EGPU_GAMESCOPE_HDMI_REDUCED_BLANKING
    log "NVIDIA eGPU Gamescope format filter disabled; set NV_EGPU_GAMESCOPE_FORMAT_FILTER_ENABLE=1 for diagnostics"
  fi
  # 2026-09-11: the Lua hook (~/.config/gamescope/scripts/zz-nv-egpu-sync.lua) is what implements these; the
  # explicit-sync disable is the non-laggy corruption fix, the syncobj wait guard is the laggy fallback (opt-in).
  export NV_EGPU_GAMESCOPE_DISABLE_EXPLICIT_SYNC=${NV_EGPU_GAMESCOPE_DISABLE_EXPLICIT_SYNC:-0}   # 2026-09-11: =1 breaks the gamescope WSI layer hook on 610/5060Ti ("non-hooked swapchain" dialog)
  export NV_EGPU_GAMESCOPE_DRM_SYNC_GUARDS=${NV_EGPU_GAMESCOPE_DRM_SYNC_GUARDS:-0}
  export NV_EGPU_GAMESCOPE_STEAM_SCALE_CLAMP=${NV_EGPU_GAMESCOPE_STEAM_SCALE_CLAMP:-1}
  export NV_EGPU_GAMESCOPE_STEAM_SCALE_CLAMP_BIN="$STEAM_SCALE_CLAMP"
  unset NV_EGPU_GAMESCOPE_OUTPUT_WIDTH
  unset NV_EGPU_GAMESCOPE_OUTPUT_HEIGHT
  unset NV_EGPU_GAMESCOPE_NESTED_WIDTH
  unset NV_EGPU_GAMESCOPE_NESTED_HEIGHT
  unset NV_EGPU_GAMESCOPE_NESTED_REFRESH
  stage_gamescope_native_mode || export STEAM_DISPLAY_REFRESH_LIMITS=40,60
  export NV_EGPU_GAMESCOPE_DISABLE_LAYERS=${NV_EGPU_GAMESCOPE_DISABLE_LAYERS:-1}
  export NV_EGPU_GAMESCOPE_FORCE_COMPOSITION=${NV_EGPU_GAMESCOPE_FORCE_COMPOSITION:-1}
  # 2026-08-21: default OFF. Disabling gamescope colour management makes the SDR
  # Game Mode UI colours wrong/oversaturated (gamescope #2242). Keep CM enabled.
  export NV_EGPU_GAMESCOPE_DISABLE_COLOR_MANAGEMENT=${NV_EGPU_GAMESCOPE_DISABLE_COLOR_MANAGEMENT:-0}
  if use_ultrawide_nested_canvas; then
    export NV_EGPU_GAMESCOPE_OUTPUT_WIDTH=${NV_EGPU_GAMESCOPE_OUTPUT_WIDTH:-5120}
    export NV_EGPU_GAMESCOPE_OUTPUT_HEIGHT=${NV_EGPU_GAMESCOPE_OUTPUT_HEIGHT:-1440}
    export NV_EGPU_GAMESCOPE_NESTED_WIDTH=3840
    export NV_EGPU_GAMESCOPE_NESTED_HEIGHT=1080
    export NV_EGPU_GAMESCOPE_NESTED_REFRESH=${NV_EGPU_GAMESCOPE_NESTED_REFRESH:-60}
    export STEAM_DISPLAY_REFRESH_LIMITS="40,$NV_EGPU_GAMESCOPE_NESTED_REFRESH"
    log "using 3840x1080 nested Steam canvas on native 5120x1440 eGPU output @$NV_EGPU_GAMESCOPE_NESTED_REFRESH"
  fi
  if [ "$EGPU_GAMESCOPE_HDR" = "1" ]; then
    # 2026-09-11: do NOT export DXVK_HDR=1 session-wide. It made every SDR game (Black Flag) run a
    # 10-bit HDR-flavoured swapchain and publish HDR metadata -> grey picture + green flashes at start.
    # Steam adds DXVK_HDR per game when its HDR toggle is on; stock session does not export it either.
    unset DXVK_HDR
    unset ENABLE_HDR_WSI
    unset PROTON_ENABLE_HDR
    unset STEAM_GAMESCOPE_FORCE_HDR_DEFAULT
    unset STEAM_GAMESCOPE_FORCE_OUTPUT_TO_HDR10PQ_DEFAULT
  else
    export DXVK_HDR=0
    export ENABLE_HDR_WSI=0
    export PROTON_ENABLE_HDR=0
    export gamescope_hdr_enabled=0
    export gamescope_adaptive_sync=0
    export gamescope_tearing_enabled=0
    export NV_EGPU_GAMESCOPE_SDR_CLAMP="$SDR_CLAMP"
    export STEAM_GAMESCOPE_HDR_SUPPORTED=0
    export STEAM_GAMESCOPE_COLOR_MANAGED=0
    export STEAM_GAMESCOPE_VIRTUAL_WHITE=0
    export STEAM_GAMESCOPE_FORCE_HDR_DEFAULT=0
    export STEAM_GAMESCOPE_FORCE_OUTPUT_TO_HDR10PQ_DEFAULT=0
    disable_steam_gamescope_hdr_config
    stock_session=$(nohdr_stock_gamescope_session)
    log "NVIDIA eGPU Game Mode HDR exposure disabled; set NV_EGPU_GAMESCOPE_HDR=1 to opt in"
  fi
  if [ -x "$PROFILE_HELPER" ]; then
    "$PROFILE_HELPER" hdr-repair >/tmp/nv-egpu-buddy-gamescope-prestart.log 2>&1 || true
  fi
  if [ "${NV_EGPU_GAMESCOPE_STEAM_SCALE_CLAMP:-1}" != "0" ] && [ -x "$STEAM_SCALE_CLAMP" ]; then
    "$STEAM_SCALE_CLAMP" >/tmp/nv-egpu-gamescope-steam-scale-clamp.log 2>&1 &
  fi
  if [ -n "$xgpu_target" ]; then
    read -r xgpu_conn xgpu_card xgpu_mode xgpu_transfer <<<"$xgpu_target"
    xgpu_transfer=pyrowave   # M2 raw copy dropped (no gain in real sessions, first-launch freezes)
    export GAMESCOPE_PREFER_DRM="/dev/dri/$xgpu_card"               # the handheld's GPU drives the screen
    export GAMESCOPE_XGPU_PANEL="${xgpu_mode}@0,$xgpu_conn"         # native size, highest refresh it offers
    export GAMESCOPE_XGPU_MODE="$xgpu_transfer" GAMESCOPE_XGPU_LIB="$XGPU_LIB"
    export gamescope_drm_gbm_scanout=1
    export NV_EGPU_GAMESCOPE_XGPU_DRIVERS=/usr/share/vulkan/icd.d/nvidia_icd.json:/usr/share/vulkan/icd.d/radeon_icd.json
    export NV_EGPU_GAMESCOPE_HDR=0
    export OUTPUT_CONNECTOR="$xgpu_conn"
    unset NV_EGPU_GAMESCOPE_OUTPUT_WIDTH NV_EGPU_GAMESCOPE_OUTPUT_HEIGHT NV_EGPU_GAMESCOPE_NESTED_WIDTH NV_EGPU_GAMESCOPE_NESTED_HEIGHT NV_EGPU_GAMESCOPE_NESTED_REFRESH STEAM_DISPLAY_REFRESH_LIMITS
    mkdir -p "${XDG_RUNTIME_DIR:-/run/user/1000}/nv-egpu-buddy"; : > "${XDG_RUNTIME_DIR:-/run/user/1000}/nv-egpu-buddy/xgpu-active"
    # the built-in screen is the picture now: make sure an earlier eGPU session did not leave it dark
    [ "$xgpu_conn" = "$PANEL" ] && { sudo -n /usr/local/sbin/nv-egpu-buddy-privileged panel-on >/dev/null 2>&1 || true; }
    log "handheld passthrough: Game Mode on $xgpu_conn ($xgpu_card, $xgpu_mode) rendered on the eGPU, transfer $xgpu_transfer"
  else
    unset GAMESCOPE_PREFER_DRM GAMESCOPE_XGPU_PANEL GAMESCOPE_XGPU_MODE GAMESCOPE_XGPU_LIB NV_EGPU_GAMESCOPE_XGPU_DRIVERS
  fi
elif [ "$detach_mode" = 0 ] && generic_egpu_ready; then
  # EXPERIMENTAL (untested hardware): non-NVIDIA eGPU (AMD/Intel, Mesa). No GBM-scanout build, format filter or
  # NVIDIA ICD pinning: stock gamescope, pointed at the eGPU's DRM card, games on the same GPU via DRI_PRIME.
  clear_egpu_env
  clear_session_env
  # RX 9070 / 9070 XT (1002:7550) on the AMD / Intel install only: its full memory window, while nothing has the card open
  # yet (egpu-generic rebar: a 256 MiB window behind the USB4 dock hung its copy engine; Legion Go 1 + TBGAA, CachyOS)
  if [ "$(cat /etc/nv-egpu-buddy/gpu-vendor 2>/dev/null)" = amd ] &&
     [ "$(cat "/sys/bus/pci/devices/$gen_bdf/vendor" 2>/dev/null):$(cat "/sys/bus/pci/devices/$gen_bdf/device" 2>/dev/null)" = 0x1002:0x7550 ]; then
    timeout 150 sudo -n /usr/local/sbin/egpu-generic rebar >/dev/null 2>&1 || true
    gen_card=$(ls "/sys/bus/pci/devices/$gen_bdf/drm" 2>/dev/null | grep -m1 '^card' || echo "$gen_card")
    log "RX 9070 / 9070 XT: memory window $(lspci -vs "$gen_bdf" 2>/dev/null | sed -n 's/.*Region 0:.*\[size=\([^]]*\)\].*/\1/p' | head -1) ($gen_card)"
  fi
  # the screen picked in the plugin goes first. "|| true": with no screen ever picked the file does not exist, and under
  # set -e the failed cat ended this script, so every Game Mode start on an AMD eGPU died here (black screen, restart loop;
  # first real AMD eGPU, Legion Go 1 + RX 6800 XT, 2026-10-24)
  gen_pref=$(cat /var/lib/nvegpu/game-screen 2>/dev/null || true)
  case " $gen_outputs " in *" $gen_pref "*) [ -n "$gen_pref" ] && gen_outputs="$gen_pref $(printf '%s\n' $gen_outputs | grep -vx "$gen_pref")" ;; esac
  export OUTPUT_CONNECTOR="$(printf '%s,' $gen_outputs)*,${PANEL}"
  export WLR_DRM_DEVICES="/dev/dri/$gen_card"
  export DRI_PRIME="pci-$(printf '%s' "$gen_bdf" | tr ':.' '__')!"
  # gamescope picks the GPU it drives from the Vulkan device it chooses, not from WLR_DRM_DEVICES; with an AMD eGPU next
  # to an AMD built-in GPU both use the same Vulkan driver, so name the eGPU (the shim adds --prefer-vk-device, nothing else)
  export PATH="$SHIM_DIR:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin"
  export NV_EGPU_GAMESCOPE_GENERIC_VK="$(cut -c3- "/sys/bus/pci/devices/$gen_bdf/vendor" 2>/dev/null):$(cut -c3- "/sys/bus/pci/devices/$gen_bdf/device" 2>/dev/null)"
  # Vulkan sees ONLY the eGPU (Mesa: a trailing "!" exposes nothing else), the AMD counterpart of the NVIDIA route's
  # driver-file pin: with two AMD GPUs on one driver, nothing in this session can route through the handheld's chip.
  # (Without the "!" this variable outranks DRI_PRIME's own "!" and made the built-in GPU visible again.)
  export MESA_VK_DEVICE_SELECT="$NV_EGPU_GAMESCOPE_GENERIC_VK!"
  # CPU-written GPU buffers in system RAM, not in the eGPU's VRAM. With the full 16 GB BAR, DXVK / vkd3d-proton put the
  # buffers a game rewrites every frame straight into VRAM; across USB4 every CPU access to them crosses the cable and the
  # game's render thread stalls on it: RX 6800 XT in CALX at 20 % busy, UnityGfxDeviceWorker maxing a CPU core, 24-37 fps.
  # After a sleep the driver had moved those buffers to system RAM and the same scene ran at 80+ fps with the GPU 70-98 %
  # busy (Legion Go 1 + AG02, flight recorder 0.7.187, reproduced twice). These are the two translation layers' own switches
  # for exactly that (DXVK ships the first as a per-game fix, e.g. Assassin's Creed 3 / Black Flag); a value the user set wins.
  # Not on an RX 9070 / 9070 XT (1002:7550): with these set, its copy engine hung 8 s into RE Requiem every time (sdma0
  # timeout, GPU reset, VRAM lost, device off the bus; Legion Go 1, CachyOS, 0.7.203; the power tuning was already off),
  # and the same card is stable under all-ways-eGPU, which sets neither. It gets Proton's defaults (that card only).
  if [ "$(cat /etc/nv-egpu-buddy/gpu-vendor 2>/dev/null)" = amd ] && [ "$NV_EGPU_GAMESCOPE_GENERIC_VK" = 1002:7550 ]; then
    log "RX 9070 / 9070 XT: Proton's own buffer placement (no DXVK_CONFIG / VKD3D_CONFIG from EGPU Buddy)"
  elif [ "$(cat /etc/nv-egpu-buddy/gpu-vendor 2>/dev/null)" = amd ]; then
    case "${DXVK_CONFIG:-}" in *cachedDynamicResources*) ;; *) export DXVK_CONFIG="${DXVK_CONFIG:+$DXVK_CONFIG; }d3d11.cachedDynamicResources = a" ;; esac
    case "${VKD3D_CONFIG:-}" in *upload_hvv*) ;; *) export VKD3D_CONFIG="${VKD3D_CONFIG:+$VKD3D_CONFIG,}no_upload_hvv" ;; esac
    export NV_EGPU_GENERIC_SYSMEM=1
    log "eGPU over USB4: CPU-written game buffers in system RAM (DXVK_CONFIG='$DXVK_CONFIG' VKD3D_CONFIG='$VKD3D_CONFIG')"
  fi
  log "generic eGPU route: $gen_vendor $gen_bdf ($gen_card) outputs: $gen_outputs"
else
  clear_egpu_env
  export OUTPUT_CONNECTOR="*,${PANEL}"
  if [ "$detach_mode" = 1 ]; then
    # pin gamescope + Vulkan/EGL to the built-in AMD card so nothing in this session holds the eGPU nodes
    _amd=$(basename "$(ls -d /sys/class/drm/card[0-9]*-"$PANEL" 2>/dev/null | head -1)"); _amd=${_amd%%-*}; [ -n "$_amd" ] && _amd=/dev/dri/$_amd
    [ -n "$_amd" ] && export KWIN_DRM_DEVICES="$_amd"
    # a Mesa eGPU shares the driver with the built-in GPU: only an explicit device list keeps gamescope off it
    case "$(/usr/local/sbin/egpu-detect 2>/dev/null)" in ""|*" nvidia "*|*" nvidia") ;; *) [ -n "$_amd" ] && export WLR_DRM_DEVICES="$_amd"
      # an AMD / Intel eGPU uses the same Vulkan driver file as the built-in GPU, so the radeon pin below does not keep
      # this session off it: expose ONLY the built-in GPU to Vulkan, or gamescope may open the eGPU and the detach waits
      _hv=$(cut -c3- "/sys/class/drm/${_amd#/dev/dri/}/device/vendor" 2>/dev/null); _hd=$(cut -c3- "/sys/class/drm/${_amd#/dev/dri/}/device/device" 2>/dev/null)
      [ "$(cat /etc/nv-egpu-buddy/gpu-vendor 2>/dev/null)" = amd ] && [ -n "$_hv" ] && [ -n "$_hd" ] && export MESA_VK_DEVICE_SELECT="$_hv:$_hd!" ;; esac
    export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/radeon_icd.json VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.json
    export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json __GLX_VENDOR_LIBRARY_NAME=mesa
  fi
  # ROG Ally / XG Mobile only (every other machine unchanged): an NVIDIA eGPU bound to the driver whose init is wedged
  # (the attach's health gate: NVML does not answer) is left on the bus. Game Mode on the handheld then still loaded the
  # NVIDIA Vulkan driver, which hung asking that card for its devices: gamescope never came up, the session timed out
  # three times, black screen until a forced restart (ROG Xbox Ally X report on 0.7.197). The same pin as Safe Detach's
  # handheld session above: Vulkan and EGL on the built-in GPU, for this session only.
  if [ "$detach_mode" != 1 ] && [ -z "${VK_DRIVER_FILES:-}" ] && { [ "$(/usr/local/sbin/egpu-detect --device 2>/dev/null)" = rog-ally ] || [ -e /var/lib/nvegpu/xg-mobile-seen ]; }; then
    _nv=; for _d in /sys/bus/pci/devices/*; do
      [ "$(cat "$_d/vendor" 2>/dev/null)" = 0x10de ] || continue
      case "$(cat "$_d/class" 2>/dev/null)" in 0x0300*|0x0302*) ;; *) continue ;; esac
      [ "$(basename "$(readlink -f "$_d/driver" 2>/dev/null)")" = nvidia ] && { _nv=${_d##*/}; break; }
    done
    if [ -n "$_nv" ] && ! timeout 5 nvidia-smi -i "$_nv" --query-gpu=name --format=csv,noheader >/dev/null 2>&1; then
      export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/radeon_icd.json VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.json
      export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json __GLX_VENDOR_LIBRARY_NAME=mesa
      log "the NVIDIA eGPU $_nv does not answer (wedged init): Game Mode on the handheld with Vulkan/EGL on the built-in GPU only"
    fi
    unset _nv _d
  fi
fi

if [ "${1:-}" = "--print-env" ] || [ "${NV_EGPU_GAMESCOPE_SESSION_PRINT_ENV:-0}" = "1" ]; then
  printf 'EGPU_PCI=%s\n' "$EGPU_PCI"
  printf 'BAR1_BYTES=%s\n' "$bar1_bytes"
  printf 'BAR1_FULL=%s\n' "$(bar1_full && printf true || printf false)"
  printf 'OUTPUT_CONNECTOR=%s\n' "${OUTPUT_CONNECTOR:-}"
  printf 'KWIN_DRM_DEVICES=%s\n' "${KWIN_DRM_DEVICES:-}"
  printf 'VK_DRIVER_FILES=%s\n' "${VK_DRIVER_FILES:-}"
  printf 'VK_ICD_FILENAMES=%s\n' "${VK_ICD_FILENAMES:-}"
  printf 'DXVK_HDR=%s\n' "${DXVK_HDR:-}"
  printf 'NV_EGPU_GAMESCOPE_HDR=%s\n' "$EGPU_GAMESCOPE_HDR"
  printf 'NV_EGPU_GAMESCOPE_MAX_REFRESH=%s\n' "$EGPU_GAMESCOPE_MAX_REFRESH"
  printf 'NV_EGPU_GAMESCOPE_OUTPUT_WIDTH=%s\n' "${NV_EGPU_GAMESCOPE_OUTPUT_WIDTH:-}"
  printf 'NV_EGPU_GAMESCOPE_OUTPUT_HEIGHT=%s\n' "${NV_EGPU_GAMESCOPE_OUTPUT_HEIGHT:-}"
  printf 'NV_EGPU_GAMESCOPE_NESTED_WIDTH=%s\n' "${NV_EGPU_GAMESCOPE_NESTED_WIDTH:-}"
  printf 'NV_EGPU_GAMESCOPE_NESTED_HEIGHT=%s\n' "${NV_EGPU_GAMESCOPE_NESTED_HEIGHT:-}"
  printf 'NV_EGPU_GAMESCOPE_NESTED_REFRESH=%s\n' "${NV_EGPU_GAMESCOPE_NESTED_REFRESH:-}"
  printf 'NV_EGPU_GAMESCOPE_DISABLE_LAYERS=%s\n' "${NV_EGPU_GAMESCOPE_DISABLE_LAYERS:-}"
  printf 'NV_EGPU_GAMESCOPE_FORCE_COMPOSITION=%s\n' "${NV_EGPU_GAMESCOPE_FORCE_COMPOSITION:-}"
  printf 'NV_EGPU_GAMESCOPE_DISABLE_COLOR_MANAGEMENT=%s\n' "${NV_EGPU_GAMESCOPE_DISABLE_COLOR_MANAGEMENT:-}"
  printf 'NV_EGPU_GAMESCOPE_FORMAT_FILTER=%s\n' "${NV_EGPU_GAMESCOPE_FORMAT_FILTER:-}"
  printf 'NV_EGPU_GAMESCOPE_FORCE_8BIT=%s\n' "${NV_EGPU_GAMESCOPE_FORCE_8BIT:-}"
  printf 'NV_EGPU_GAMESCOPE_FORCE_LINEAR=%s\n' "${NV_EGPU_GAMESCOPE_FORCE_LINEAR:-}"
  printf 'NV_EGPU_GAMESCOPE_MAX_BLOCK_HEIGHT=%s\n' "${NV_EGPU_GAMESCOPE_MAX_BLOCK_HEIGHT:-}"
  printf 'NV_EGPU_GAMESCOPE_DISABLE_MODIFIERS=%s\n' "${NV_EGPU_GAMESCOPE_DISABLE_MODIFIERS:-}"
  printf 'NV_EGPU_GAMESCOPE_HDMI_REDUCED_BLANKING=%s\n' "${NV_EGPU_GAMESCOPE_HDMI_REDUCED_BLANKING:-}"
  printf 'NV_EGPU_GAMESCOPE_DRM_SYNC_GUARDS=%s\n' "${NV_EGPU_GAMESCOPE_DRM_SYNC_GUARDS:-}"
  printf 'NV_EGPU_GAMESCOPE_SDR_CLAMP=%s\n' "$SDR_CLAMP"
  printf 'NV_EGPU_GAMESCOPE_STEAM_SCALE_CLAMP=%s\n' "${NV_EGPU_GAMESCOPE_STEAM_SCALE_CLAMP:-}"
  printf 'NV_EGPU_GAMESCOPE_STEAM_SCALE_CLAMP_BIN=%s\n' "$STEAM_SCALE_CLAMP"
  printf 'STOCK_GAMESCOPE_SESSION=%s\n' "$stock_session"
  printf 'STEAM_DISPLAY_REFRESH_LIMITS=%s\n' "${STEAM_DISPLAY_REFRESH_LIMITS:-}"
  exit 0
fi

# Breadcrumb for the support report (read-only for everything else): this PID becomes the stock session and then gamescope
# (each one execs the next), so the report can tell whether THIS wrapper started the running gamescope, and with what.
{ mkdir -p "${XDG_RUNTIME_DIR:-/run/user/1000}/nv-egpu-buddy" && printf '%s\n' "pid=$$" "time=$(date '+%F %T')" "stock_session=$stock_session" \
    "detach_mode=$detach_mode" "egpu_card=$egpu_card" "igpu_card=$igpu_card" "outputs=$outputs" "OUTPUT_CONNECTOR=${OUTPUT_CONNECTOR:-}" \
    "HANDHELD_GPU=${NV_EGPU_GAMESCOPE_HANDHELD_GPU:-0}" "XGPU=${GAMESCOPE_XGPU_MODE:-}" "VK_DRIVER_FILES=${VK_DRIVER_FILES:-}" "PATH=$PATH" \
    > "${XDG_RUNTIME_DIR:-/run/user/1000}/nv-egpu-buddy/session-wrapper"; } 2>/dev/null || true
# diagnostics: NV_EGPU_DIAG=1 in /run/nvegpu/diag turns on Proton + Vulkan loader logging for every game of this session
if [ -e /run/nvegpu/diag ]; then export PROTON_LOG=1 VK_LOADER_DEBUG=error,warn WINEDEBUG=-all,+vulkan; fi   # NV_EGPU_DIAG_PROTON_LOG
# Boot straight onto the eGPU left the handheld panel LIT: turning it off only ever happened on
# the hot-plug switch path (egpu-gamemode-switch), never when the session started on the eGPU in
# the first place. Same rule in both: if the picture is on an eGPU output, the panel goes dark.
# egpu-panel refuses to darken it when no eGPU is mounted, so this cannot leave a screenless machine.
(
  sleep 8
  # handheld screen with the eGPU attached: the sound comes back to the handheld too (it was left on the eGPU's HDMI)
  if [ "${NV_EGPU_GAMESCOPE_HANDHELD_GPU:-0}" = 1 ]; then
    # on the handheld's USB-C screen (XR glasses): the built-in screen goes dark, as it does for an eGPU monitor
    case "${OUTPUT_CONNECTOR%%,*}" in eDP-*) ;; *) sudo -n /usr/local/sbin/nv-egpu-buddy-privileged panel-off >/dev/null 2>&1 &&
      log "handheld panel off (Game Mode is on ${OUTPUT_CONNECTOR%%,*})" ;; esac
    [ -x "$HOME/.local/bin/egpu-audio.sh" ] && log "audio: $("$HOME/.local/bin/egpu-audio.sh" local "${OUTPUT_CONNECTOR%%,*}" 2>&1 | tr '\n' ' ')"
    exit 0
  fi
  case "${OUTPUT_CONNECTOR:-}" in ""|"*"|eDP-1|eDP-1,*|"*",*) exit 0 ;; esac
  sudo -n /usr/local/sbin/nv-egpu-buddy-privileged panel-off >/dev/null 2>&1 &&
    log "handheld panel off (Game Mode is on ${OUTPUT_CONNECTOR%%,*})"
  # Sound follows the picture here as well. Booting WITH the eGPU attached never runs the attach
  # hook's session step, so without this the picture moved to the monitor and the sound stayed on
  # the handheld's speakers — which is exactly what happened on a real boot.
  [ -x "$HOME/.local/bin/egpu-audio.sh" ] &&
    log "audio: $("$HOME/.local/bin/egpu-audio.sh" follow 2>&1 | tr '\n' ' ')"
) &

# panel watchdog: after a relogin gamescope can start with an inactive libseat seat (no modeset, handheld stays dark).
# If the panel is still disabled 12s in and no eGPU is on the bus (on the eGPU the panel is meant to be off), bounce the VT once.
(
  sleep 12
  pgrep -x gamescope-wl >/dev/null 2>&1 || exit 0
  lspci -Dn 2>/dev/null | grep -qE '0300: 10de:' && exit 0
  /usr/local/sbin/egpu-detect >/dev/null 2>&1 && exit 0
  [ "$(cat /sys/class/drm/card*-eDP-1/enabled 2>/dev/null | head -1)" = disabled ] || exit 0
  log "panel still disabled 12s after gamescope start -> vt-bounce (paused libseat seat)"
  sudo -n /usr/local/sbin/nv-egpu-buddy-privileged vt-bounce >/dev/null 2>&1 || true
) &
exec "$stock_session"
