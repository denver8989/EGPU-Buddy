#!/usr/bin/env bash
# SteamOS EGPU Buddy: "Keep the TV off during Steam Link and Moonlight streams" (TV options, off by default).
# A Home press sent from Steam Link reaches Steam like a local one, and Steam asks Valve's CEC service (cecd) to wake
# the TV. While a stream runs, cecd is stopped and held (it cannot be started on demand either), so nothing wakes the
# TV; it is started again when the stream ends. Streams are read from the hosts' own logs, as steamos-cec-toolkit does
# (MIT, github.com/Twsts/steamos-cec-toolkit): Steam's streaming_log.txt and Sunshine's / Apollo's log.
# Only a stream that STARTED after this service did counts: the logs keep the last session's "started" line across
# restarts, which held cecd from boot on (report 2SRB2T). Every systemctl call is --no-block: this service stops with
# the Game Mode session, and a waiting "start cecd" on the way out deadlocked that restart for 90 s (TV stuck on the
# boot logo, attach hanging).
# ponytail: re-reads the logs every 3 s (small files); an inotify watch if they ever grow large.
set -u
START=$(date +%s)
H=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/egpu-stream-hold
D=$HOME/.config/systemd/user/cecd.service.d/egpu-buddy-stream.conf
if [ ! -e "$D" ]; then
  mkdir -p "${D%/*}"; printf '%s\n' "# SteamOS EGPU Buddy: no cecd during a Steam Link / Moonlight stream" "[Unit]" "ConditionPathExists=!$H" > "$D"
  systemctl --user --no-block daemon-reload
fi
# a stream counts when the newest start/stop line is a start, and it is newer than this service ([YYYY-MM-DD HH:MM:SS])
live(){ local l t; l=$(grep -a -h -E "$1" "${@:3}" 2>/dev/null | tail -1); [[ $l == *"$2"* ]] || return 1
  t=$(date -d "$(grep -o -E '[0-9]{4}-[0-9]{2}-[0-9]{2}[ T][0-9:]{8}' <<<"$l" | head -1)" +%s 2>/dev/null) || return 1
  [ "$t" -ge "$START" ]; }
was=0; rm -f "$H"
trap 'rm -f "$H"; [ "$was" = 1 ] && systemctl --user --no-block start cecd.service' EXIT
while sleep 3; do
  now=0
  live '>>> (Starting|Stopped) (desktop|game) stream' Starting "$HOME/.local/share/Steam/logs/streaming_log.txt" && now=1
  live 'CLIENT (CONNECTED|DISCONNECTED)' ' CONNECTED' "$HOME"/.config/sunshine/sunshine.log "$HOME"/.config/apollo/*.log && now=1
  [ "$now" = "$was" ] && continue
  if [ "$now" = 1 ]; then : > "$H"; systemctl --user --no-block stop cecd.service; logger -t egpu-stream-cec "stream started: TV wake held"
  else rm -f "$H"; systemctl --user --no-block start cecd.service; logger -t egpu-stream-cec "stream ended: TV wake back"; fi
  was=$now
done
