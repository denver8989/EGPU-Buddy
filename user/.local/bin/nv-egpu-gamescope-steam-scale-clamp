#!/usr/bin/env bash
set -uo pipefail

# Steam can recalculate this external gamescope display as a 49" TV and relaunch
# Big Picture with a 2.4x CEF scale. On a 5120x1440 panel that leaves the UI
# with a 2125x598 viewport, causing cropped and overlapping elements.

[ "${NV_EGPU_GAMESCOPE_STEAM_SCALE_CLAMP:-1}" != "0" ] || exit 0

# Two modes. "fixed" = the three numbers below, tuned on the Legion Go 2 with its 49" panel (kept there unchanged).
# "lowest" = every other machine: automatic scaling OFF and the slider at its LOWEST position, i.e. ScaleFactor := the
# MinScaleFactor that Steam itself computed for that display. No number is invented, so it fits any monitor.
mode=${NV_EGPU_STEAM_UI_SCALE_MODE:-}
# The tuned numbers belong to the 5120x1440 49" panel, not to the handheld: they are used wherever that output is staged
# (the session wrapper exports the detected output size), and always on the Legion Go 2 as before. Anything else: lowest.
if [ -z "$mode" ]; then
  if [ "$(/usr/local/sbin/egpu-detect --device 2>/dev/null)" = legion-go-2 ] || [ "${NV_EGPU_GAMESCOPE_OUTPUT_WIDTH:-}x${NV_EGPU_GAMESCOPE_OUTPUT_HEIGHT:-}" = 5120x1440 ]; then mode=fixed; else mode=lowest; fi
fi
scale=${NV_EGPU_STEAM_UI_SCALE:-1.27981042861938477}
min_scale=${NV_EGPU_STEAM_UI_MIN_SCALE:-0.711512446403503418}
max_scale=${NV_EGPU_STEAM_UI_MAX_SCALE:-3.40971922874450684}
fast_attempts=${NV_EGPU_STEAM_SCALE_CLAMP_FAST_ATTEMPTS:-45}
interval=${NV_EGPU_STEAM_SCALE_CLAMP_INTERVAL:-10}
live_interval=${NV_EGPU_STEAM_SCALE_CLAMP_LIVE_INTERVAL:-300}
runtime_dir=${XDG_RUNTIME_DIR:-/tmp}
lock_file="$runtime_dir/nv-egpu-gamescope-steam-scale-clamp.lock"
timestamp=$(date +%Y%m%d_%H%M%S)

log() {
  printf 'nv-egpu-gamescope-steam-scale-clamp: %s\n' "$*" >&2
}
# ROG Ally / XG Mobile only: never "lowest". It ran whenever a Game Mode start was not (yet) at 5120x1440 - the seconds at
# 1024x768 before the monitor's EDID arrived - and wrote Steam's minimum (0.711) into EVERY external screen's entry, the
# Odyssey G9's included; since 0.7.183 the live step pushed it into Steam too (ROG Xbox Ally X report on 0.7.191: G9 at
# ScaleFactor 0.711). There the scale is only set when Game Mode really runs at 5120x1440, otherwise left to Steam.
if [ "$mode" = lowest ] && { [ "$(/usr/local/sbin/egpu-detect --device 2>/dev/null)" = rog-ally ] || [ -e /var/lib/nvegpu/xg-mobile-seen ]; }; then
  log "ROG Ally / XG Mobile: Game Mode is not at 5120x1440 (${NV_EGPU_GAMESCOPE_OUTPUT_WIDTH:-?}x${NV_EGPU_GAMESCOPE_OUTPUT_HEIGHT:-?}): Steam's scale left as it is"
  exit 0
fi

mkdir -p "$runtime_dir" 2>/dev/null || true
exec 9>"$lock_file"
if ! flock -n 9; then
  exit 0
fi

unique_existing_files() {
  local seen="" path real
  for path in "$@"; do
    [ -f "$path" ] || continue
    real=$(readlink -f "$path" 2>/dev/null || printf '%s' "$path")
    case " $seen " in
      *" $real "*) continue ;;
    esac
    seen="$seen $real"
    printf '%s\n' "$path"
  done
}

sanitize_config() {
  local config tmp backup
  while IFS= read -r config; do
    [ -n "$config" ] || continue
    grep -qF 'External: ' "$config" || continue

    tmp=$(mktemp)
    cp "$config" "$tmp"
    NV_EGPU_STEAM_UI_MODE="$mode" \
    NV_EGPU_STEAM_UI_MIN_SCALE="$min_scale" \
    NV_EGPU_STEAM_UI_MAX_SCALE="$max_scale" \
    NV_EGPU_STEAM_UI_SCALE="$scale" \
    perl -0pi -e '
      my $min = $ENV{"NV_EGPU_STEAM_UI_MIN_SCALE"};
      my $max = $ENV{"NV_EGPU_STEAM_UI_MAX_SCALE"};
      my $scale = $ENV{"NV_EGPU_STEAM_UI_SCALE"};
      my $mode = $ENV{"NV_EGPU_STEAM_UI_MODE"};
      # "lowest": slider at the minimum Steam computed for this display; leave Min/Max/Auto alone
      sub lowest {
        my ($body, $indent) = @_;
        return $body unless $body =~ /"MinScaleFactor"[ \t]*"([0-9.]+)"/;
        return set_key($body, "ScaleFactor", $1, $indent);
      }

      sub set_key {
        my ($body, $key, $value, $indent) = @_;
        if ($body =~ s/(\n[ \t]*"\Q$key\E"[ \t]*")[^"]*(")/$1$value$2/s) {
          return $body;
        }
        return $body . "\n" . $indent . "\"" . $key . "\"\t\t\"" . $value . "\"";
      }

      s{(\n([ \t]*)"Current"[ \t]*\n\2\{)(.*?)(\n\2\})}{
        my ($open, $indent, $body, $close) = ($1, $2, $3, $4);
        if ($body =~ /"name"[ \t]*"External: .*?\|\|\|Windowed"/s) {
          my $key_indent = $indent . "\t";
          if ($mode eq "lowest") { $body = lowest($body, $key_indent); } else {
          $body = set_key($body, "MinScaleFactor", $min, $key_indent);
          $body = set_key($body, "MaxScaleFactor", $max, $key_indent);
          $body = set_key($body, "AutoScaleFactor", $scale, $key_indent);
          $body = set_key($body, "ScaleFactor", $scale, $key_indent);
          }
        }
        $open . $body . $close;
      }egs;

      s{(\n([ \t]*)"External: [^\n]*?\|\|\|Windowed"[ \t]*\n\2\{)(.*?)(\n\2\})}{
        my ($open, $indent, $body, $close) = ($1, $2, $3, $4);
        my $key_indent = $indent . "\t";
        if ($mode eq "lowest") { $body = lowest($body, $key_indent); } else {
        $body = set_key($body, "MinScaleFactor", $min, $key_indent);
        $body = set_key($body, "MaxScaleFactor", $max, $key_indent);
        $body = set_key($body, "AutoScaleFactor", $scale, $key_indent);
        $body = set_key($body, "ScaleFactor", $scale, $key_indent);
        }
        $open . $body . $close;
      }egs;
    ' "$tmp"

    if ! cmp -s "$tmp" "$config"; then
      backup="$config.bak-nv-egpu-steam-scale-clamp-$timestamp"
      [ -e "$backup" ] || cp -a "$config" "$backup"
      cat "$tmp" > "$config"
      log "set the Steam UI scale in $config (mode $mode)"
    fi
    rm -f "$tmp"
  done <<EOF
$(unique_existing_files \
  $HOME/.local/share/Steam/config/config.vdf \
  $HOME/.steam/steam/config/config.vdf)
EOF
}

config_signature() {
  local config
  while IFS= read -r config; do
    [ -n "$config" ] || continue
    stat -Lc '%n:%Y:%s' "$config" 2>/dev/null || true
  done <<EOF | paste -sd ';' -
$(unique_existing_files \
  $HOME/.local/share/Steam/config/config.vdf \
  $HOME/.steam/steam/config/config.vdf)
EOF
}

steamwebhelper_signature() {
  pgrep -u "$(id -u)" -x steamwebhelper 2>/dev/null | sort -n | paste -sd, -
}

# ROG Ally / XG Mobile only (ultrawide report, ROG Xbox Ally X + XG Mobile): in "lowest" mode the live scale is the minimum
# Steam computed for this display (read back from its config), not the Legion Go 2's tuned number above, which was forced
# onto that monitor live although the mode said otherwise. Every other machine keeps exactly what it did before.
lowest_scale() {
  local config v
  for config in $(unique_existing_files $HOME/.local/share/Steam/config/config.vdf $HOME/.steam/steam/config/config.vdf); do
    v=$(perl -0ne 'while (/"External: [^\n]*?\|\|\|Windowed"\s*\{(.*?)\n\s*\}/sg) { my $b=$1; if ($b =~ /"MinScaleFactor"\s*"([0-9.]+)"/) { $m=$1 } } print $m if defined $m' "$config" 2>/dev/null)
    [ -n "$v" ] && { printf '%s\n' "$v"; return 0; }
  done
  return 1
}

# ROG Ally / XG Mobile only: stock SteamOS has no node, so the live step below never ran there and only the config edit
# applied, which Steam overrides when it decides the 49" monitor is a TV (huge interface with a black area: ROG Xbox
# Ally X + Odyssey G9 report, "node missing (live scale not applied)"). The same call through Python, which SteamOS has.
set_live_scale_py() {
  NV_EGPU_STEAM_UI_SCALE="$1" python3 - <<'PY' 2>&1 | while read -r _l; do log "live scale (python): $_l"; done
import base64, json, os, socket, struct, urllib.request
scale = float(os.environ.get("NV_EGPU_STEAM_UI_SCALE", "1.27981042861938477"))
# the reply says what the page itself sees: its viewport in CSS pixels and the device scale, i.e. whether the scale took
# and how large Steam's own window is (5120x1440 / 1.28 = 4000x1125; a TV scale or a smaller Steam window shows here)
expr = ('(() => { const v = window.innerWidth + "x" + window.innerHeight + " @" + (window.devicePixelRatio || 0).toFixed(3) + " screen " + screen.width + "x" + screen.height;'
        ' if (typeof SteamClient !== "object" || !SteamClient._internal || typeof SteamClient._internal.SetForceDeviceScaleFactor !== "function") return "no-scale-api, viewport " + v;'
        ' SteamClient._internal.SetForceDeviceScaleFactor(%r); return "scale-set, viewport before " + v; })()' % scale)
def evaluate(url):
    host_port, path = url[len("ws://"):].split("/", 1)
    host, port = host_port.split(":")
    s = socket.create_connection((host, int(port)), timeout=2)
    key = base64.b64encode(os.urandom(16)).decode()
    s.sendall(("GET /%s HTTP/1.1\r\nHost: %s\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n\r\n" % (path, host_port, key)).encode())
    head = b""
    while b"\r\n\r\n" not in head:
        c = s.recv(4096)
        if not c: return
        head += c
    if b" 101 " not in head.split(b"\r\n", 1)[0]: return
    data = json.dumps({"id": 1, "method": "Runtime.evaluate", "params": {"expression": expr, "returnByValue": True}}).encode()
    n = len(data); hdr = bytes([0x81]) + (bytes([0x80 | n]) if n < 126 else bytes([0x80 | 126]) + struct.pack(">H", n) if n < 65536 else bytes([0x80 | 127]) + struct.pack(">Q", n))
    mask = os.urandom(4)
    s.sendall(hdr + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))
    buf = b""; s.settimeout(2)
    try:
        while True:
            c = s.recv(65536)
            if not c: break
            buf += c
            if len(buf) >= 2:
                n = buf[1] & 0x7f; o = 2
                if n == 126: n = struct.unpack(">H", buf[2:4])[0]; o = 4
                elif n == 127: n = struct.unpack(">Q", buf[2:10])[0]; o = 10
                if len(buf) >= o + n: buf = buf[o:o + n]; break
    except Exception: pass
    s.close()
    try: return str(json.loads(buf.decode("utf-8", "replace")).get("result", {}).get("result", {}).get("value", "no reply"))
    except Exception: return "no reply"
try:
    pages = json.load(urllib.request.urlopen("http://127.0.0.1:8080/json", timeout=2))
except Exception as e:
    print("Steam's debug port is not answering yet (%s)" % e.__class__.__name__); raise SystemExit
done = 0; seen = []
for pg in pages:
    if pg.get("webSocketDebuggerUrl") and any(t in pg.get("title", "") for t in ("Steam Big Picture Mode", "SharedJSContext")):
        try: r = evaluate(pg["webSocketDebuggerUrl"]); done += 1; seen.append("%s: %s" % (pg.get("title"), r))
        except Exception as e: print("page %r: %s" % (pg.get("title"), e))
print("scale %.3f sent to %d Steam page(s) of %d%s" % (scale, done, len(pages), "".join(" | " + x for x in seen)))
PY
}

set_live_scale() {
  local live=$scale ax=0
  { [ "$(/usr/local/sbin/egpu-detect --device 2>/dev/null)" = rog-ally ] || [ -e /var/lib/nvegpu/xg-mobile-seen ]; } && ax=1
  if [ "$mode" = lowest ] && [ "$ax" = 1 ]; then
    live=$(lowest_scale) || return 0
  fi
  if ! command -v node >/dev/null 2>&1; then
    [ "$ax" = 1 ] && command -v python3 >/dev/null 2>&1 && set_live_scale_py "$live"
    return 0
  fi
  NV_EGPU_STEAM_UI_SCALE="$live" node <<'NODE'
const http = require('http');
const net = require('net');
const crypto = require('crypto');

const scale = Number(process.env.NV_EGPU_STEAM_UI_SCALE || '1.27981042861938477');

function getPages() {
  return new Promise((resolve, reject) => {
    const req = http.get('http://127.0.0.1:8080/json', res => {
      let data = '';
      res.on('data', chunk => { data += chunk; });
      res.on('end', () => {
        try {
          resolve(JSON.parse(data));
        } catch (error) {
          reject(error);
        }
      });
    });
    req.setTimeout(1500, () => {
      req.destroy(new Error('timeout'));
    });
    req.on('error', reject);
  });
}

function encodeFrame(payload) {
  const data = Buffer.from(payload);
  let header;
  if (data.length < 126) {
    header = Buffer.alloc(2);
    header[1] = 0x80 | data.length;
  } else if (data.length < 65536) {
    header = Buffer.alloc(4);
    header[1] = 0x80 | 126;
    header.writeUInt16BE(data.length, 2);
  } else {
    header = Buffer.alloc(10);
    header[1] = 0x80 | 127;
    header.writeBigUInt64BE(BigInt(data.length), 2);
  }
  header[0] = 0x81;
  const mask = crypto.randomBytes(4);
  const frame = Buffer.concat([header, mask, data]);
  for (let i = 0; i < data.length; i++) {
    frame[header.length + 4 + i] ^= mask[i % 4];
  }
  return frame;
}

function decodeFrames(buffers, onText) {
  const combined = Buffer.concat(buffers.splice(0));
  let offset = 0;
  while (offset + 2 <= combined.length) {
    const b0 = combined[offset];
    const b1 = combined[offset + 1];
    let length = b1 & 0x7f;
    let pos = offset + 2;
    if (length === 126) {
      if (pos + 2 > combined.length) break;
      length = combined.readUInt16BE(pos);
      pos += 2;
    } else if (length === 127) {
      if (pos + 8 > combined.length) break;
      length = Number(combined.readBigUInt64BE(pos));
      pos += 8;
    }
    const masked = Boolean(b1 & 0x80);
    let mask;
    if (masked) {
      if (pos + 4 > combined.length) break;
      mask = combined.subarray(pos, pos + 4);
      pos += 4;
    }
    if (pos + length > combined.length) break;
    const payload = Buffer.from(combined.subarray(pos, pos + length));
    if (masked) {
      for (let i = 0; i < payload.length; i++) {
        payload[i] ^= mask[i % 4];
      }
    }
    if ((b0 & 0x0f) === 1) {
      onText(payload.toString());
    }
    offset = pos + length;
  }
  if (offset < combined.length) {
    buffers.push(combined.subarray(offset));
  }
}

function evaluate(wsUrl, expression) {
  const url = new URL(wsUrl);
  return new Promise((resolve, reject) => {
    const key = crypto.randomBytes(16).toString('base64');
    const socket = net.connect(Number(url.port), url.hostname);
    const buffers = [];
    let headers = Buffer.alloc(0);
    let upgraded = false;
    socket.setTimeout(2000);
    socket.on('connect', () => {
      socket.write([
        `GET ${url.pathname}${url.search} HTTP/1.1`,
        `Host: ${url.host}`,
        'Upgrade: websocket',
        'Connection: Upgrade',
        `Sec-WebSocket-Key: ${key}`,
        'Sec-WebSocket-Version: 13',
        '',
        ''
      ].join('\r\n'));
    });
    socket.on('data', chunk => {
      if (!upgraded) {
        headers = Buffer.concat([headers, chunk]);
        const end = headers.indexOf('\r\n\r\n');
        if (end < 0) return;
        const head = headers.subarray(0, end).toString();
        if (!/^HTTP\/1\.1 101/.test(head)) {
          reject(new Error(head.split('\r\n')[0] || 'websocket upgrade failed'));
          socket.destroy();
          return;
        }
        upgraded = true;
        socket.write(encodeFrame(JSON.stringify({
          id: 1,
          method: 'Runtime.evaluate',
          params: { expression, returnByValue: true, awaitPromise: true }
        })));
        const rest = headers.subarray(end + 4);
        if (rest.length) buffers.push(rest);
      } else {
        buffers.push(chunk);
      }
      decodeFrames(buffers, text => {
        let msg;
        try {
          msg = JSON.parse(text);
        } catch {
          return;
        }
        if (msg.id === 1) {
          socket.end();
          resolve(msg.result || msg.error || {});
        }
      });
    });
    socket.on('timeout', () => {
      socket.destroy(new Error('timeout'));
    });
    socket.on('error', reject);
  });
}

(async () => {
  const pages = await getPages();
  const expression = `
    (() => {
      if (typeof SteamClient !== "object" || !SteamClient._internal ||
          typeof SteamClient._internal.SetForceDeviceScaleFactor !== "function") {
        return "no-scale-api";
      }
      SteamClient._internal.SetForceDeviceScaleFactor(${scale});
      if (typeof SteamClient._internal.GetDisplayScaleFactors === "function") {
        return SteamClient._internal.GetDisplayScaleFactors();
      }
      return "scale-set";
    })()
  `;
  const targets = pages.filter(page =>
    page.webSocketDebuggerUrl && /Steam Big Picture Mode|SharedJSContext/.test(page.title || '')
  );
  await Promise.allSettled(targets.map(page => evaluate(page.webSocketDebuggerUrl, expression)));
})().catch(() => {});
NODE
}

attempt=0
last_config_signature=
last_steamwebhelper_signature=
last_live_check=0
while :; do
  now=$(date +%s)
  current_config_signature=$(config_signature)
  current_steamwebhelper_signature=$(steamwebhelper_signature)

  if [ "$attempt" -lt "$fast_attempts" ] ||
     [ "$current_config_signature" != "$last_config_signature" ]; then
    sanitize_config || true
    current_config_signature=$(config_signature)
  fi

  if [ "$attempt" -lt "$fast_attempts" ] ||
     [ "$current_steamwebhelper_signature" != "$last_steamwebhelper_signature" ] ||
     [ $((now - last_live_check)) -ge "$live_interval" ]; then
    set_live_scale || true
    last_live_check=$now
  fi

  last_config_signature=$current_config_signature
  last_steamwebhelper_signature=$current_steamwebhelper_signature

  attempt=$((attempt + 1))
  if [ "$attempt" -lt "$fast_attempts" ]; then
    sleep 1
    continue
  fi

  if ! pgrep -u "$(id -u)" -x steam >/dev/null 2>&1 &&
     ! pgrep -u "$(id -u)" -x steamwebhelper >/dev/null 2>&1; then
    exit 0
  fi
  sleep "$interval"
done
