#!/usr/bin/env python3
"""egpu-amd-tweaks - Adrenaline Settings (EXPERIMENTAL, AMD / Intel install only): the Windows Adrenalin graphics
settings that Linux can do for games on an AMD eGPU. Runs as the desktop user.

  egpu-amd-tweaks get            settings, choices, loader state (JSON)
  egpu-amd-tweaks set '<json>'   save (validated) and rewrite the files the loader reads
  egpu-amd-tweaks env            shell lines for a Game Mode session on the AMD eGPU route (loader + its switch)
  egpu-amd-tweaks off            switch it off completely (no loader in the next sessions)

The loader is the same one the NVIDIA settings use (libegpu-nvt.so). The session sets EGPU_AMD_TWEAKS=1 on its AMD eGPU
route only, where Vulkan sees the eGPU alone; the loader then hands amd-tweaks.env / amd-tweaks.dxvk.conf to each game
Steam starts. A value already set (launch option) is never replaced and a game's own dxvk.conf still wins. Nothing is
written and nothing loads until the user saves once; every setting on its default writes nothing for games.
Left to Steam (not repeated here): frame limit, tearing, VRR, HDR, scaling filter (FSR / NIS / integer) and sharpness.
"""
import json, os, shlex, sys

HOME = os.path.expanduser("~")
D = os.path.join(HOME, ".config/egpu-buddy")
CFG, ENVF, DXVKF = (os.path.join(D, f) for f in ("amd-tweaks.json", "amd-tweaks.env", "amd-tweaks.dxvk.conf"))
SHIM = os.path.join(HOME, ".local/lib/nv-egpu-buddy/nvt")

# key -> (default = no change, allowed values)
CHOICES = {
    "anti_lag": ("off", ["off", "on"]),
    "vsync": ("app", ["app", "off", "on"]),
    "aniso": (0, [0, 2, 4, 8, 16]),
    "shader_cache": ("default", ["default", "1", "5", "10", "unlimited"]),
    "gl_threaded": ("auto", ["auto", "on", "off"]),
}


def load():
    try:
        s = json.load(open(CFG))
    except (OSError, ValueError):
        s = {}
    return {k: (s.get(k) if s.get(k) in ok else d) for k, (d, ok) in CHOICES.items()}


def wanted(s):
    """(DXVK options, environment) for the chosen values; defaults add nothing."""
    dx, ev = {}, {}
    if s["anti_lag"] == "on":   # Radeon Anti-Lag: one frame queued ahead (DXVK, DirectX 9-11)
        dx["dxgi.maxFrameLatency"] = dx["d3d9.maxFrameLatency"] = "1"
    if s["vsync"] != "app":
        on = s["vsync"] == "on"
        dx["dxgi.syncInterval"] = dx["d3d9.presentInterval"] = "1" if on else "0"
        ev["VKD3D_SWAPCHAIN_PRESENT_MODE"] = "FIFO" if on else "IMMEDIATE"   # DirectX 12
        ev["MESA_VK_WSI_PRESENT_MODE"] = "fifo" if on else "immediate"        # Vulkan
        ev["vblank_mode"] = "3" if on else "0"                                 # OpenGL
    if s["aniso"]:
        a = str(s["aniso"])
        dx["d3d11.samplerAnisotropy"] = dx["d3d9.samplerAnisotropy"] = a
        ev["RADV_TEX_ANISO"] = a                                  # Vulkan (also DXVK / vkd3d-proton games)
        ev["AMD_TEX_ANISO"] = ev["R600_TEX_ANISO"] = a            # OpenGL (radeonsi reads either name)
    if s["shader_cache"] != "default":
        ev["MESA_SHADER_CACHE_MAX_SIZE"] = "1000G" if s["shader_cache"] == "unlimited" else s["shader_cache"] + "G"
    if s["gl_threaded"] != "auto":
        ev["mesa_glthread"] = "true" if s["gl_threaded"] == "on" else "false"
    return dx, ev


def write_files(s):
    dx, ev = wanted(s)
    os.makedirs(D, exist_ok=True)
    for path, text in ((ENVF, "".join(f"{k}={v}\n" for k, v in ev.items())), (DXVKF, "".join(f"{k} = {v}\n" for k, v in dx.items()))):
        tmp = path + ".tmp"
        open(tmp, "w").write(text)
        os.replace(tmp, path)


def shim_ok():
    return os.path.exists(os.path.join(SHIM, "lib64", "libegpu-nvt.so")) and os.path.exists(os.path.join(SHIM, "lib32", "libegpu-nvt.so"))


def steam_env():
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        try:
            if open(f"/proc/{p}/comm").read().strip() == "steam" and os.stat(f"/proc/{p}").st_uid == os.getuid():
                return dict(x.split("=", 1) for x in open(f"/proc/{p}/environ").read().split("\0") if "=" in x)
        except OSError:
            continue
    return {}


def get():
    s = load()
    e = steam_env()
    loader = "loaded" if e.get("EGPU_AMD_TWEAKS") == "1" and "libegpu-nvt.so" in e.get("LD_PRELOAD", "") else ("restart" if e else "no-steam")
    return {"settings": s, "defaults": {k: d for k, (d, _) in CHOICES.items()}, "enabled": os.path.exists(CFG),
            "active": s != {k: d for k, (d, _) in CHOICES.items()}, "loader": loader, "shim": shim_ok()}


def main(a):
    cmd = a[1] if len(a) > 1 else "get"
    if cmd == "get":
        print(json.dumps(get()))
    elif cmd == "set":
        try:
            new = json.loads(a[2]) if len(a) > 2 else {}
        except ValueError:
            new = None
        if not isinstance(new, dict) or any(k not in CHOICES or v not in CHOICES[k][1] for k, v in new.items()):
            print(json.dumps({"ok": False, "message": "invalid settings"})); return 1
        s = {**load(), **new}
        os.makedirs(D, exist_ok=True)
        json.dump(s, open(CFG, "w"))
        write_files(s)
        print(json.dumps({"ok": True}))
    elif cmd == "env":
        if os.path.exists(CFG) and shim_ok():
            write_files(load())
            cur = os.environ.get("LD_PRELOAD", "")
            if "libegpu-nvt.so" not in cur:
                print(f"export LD_PRELOAD={shlex.quote(os.path.join(SHIM, '$LIB', 'libegpu-nvt.so'))}{shlex.quote(':' + cur) if cur else ''}")
            print("export EGPU_AMD_TWEAKS=1")
    elif cmd == "off":
        for f in (CFG, ENVF, DXVKF):
            try:
                os.remove(f)
            except OSError:
                pass
        print(json.dumps({"ok": True}))
    else:
        print(__doc__); return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
