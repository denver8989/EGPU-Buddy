#!/usr/bin/env bash
# SteamOS EGPU Buddy — graphical installer / uninstaller (zenity; falls back to the terminal).
# Runs from the extracted release (.run) or a git checkout. Usage: steamos-egpu-buddy [--uninstall] [--no-gui]
set -uo pipefail
HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd); ROOT=$(cd "$HERE/.." && pwd)
VERSION=$(cat "$ROOT/VERSION" 2>/dev/null || echo dev)
LOG=/tmp/steamos-egpu-buddy-install.log; : > "$LOG"
GUI=1; ACTION=install; ADV=0
for a in "$@"; do case "$a" in --uninstall) ACTION=uninstall;; --no-gui) GUI=0;; --advanced) ADV=1;; esac; done
command -v zenity >/dev/null 2>&1 || GUI=0; [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] || GUI=0
say(){ echo "$*" | tee -a "$LOG"; }
# sudo without a terminal: ask the password with zenity (sudo -A) and reuse it for the whole run
if [ $GUI = 1 ]; then
  ASKPASS=$(mktemp); printf '#!/bin/sh\nzenity --password --title="SteamOS EGPU Buddy needs your password"\n' > "$ASKPASS"; chmod +x "$ASKPASS"; export SUDO_ASKPASS=$ASKPASS
  sudo(){ command sudo -A "$@"; }; export -f sudo
fi
msg(){ if [ $GUI = 1 ]; then zenity --info --title="SteamOS EGPU Buddy" --width=520 --text="$1"; else echo; echo "$1"; fi; }
err(){ if [ $GUI = 1 ]; then zenity --error --title="SteamOS EGPU Buddy" --width=520 --text="$1"; else echo "ERROR: $1" >&2; fi; }
ask(){ if [ $GUI = 1 ]; then zenity --question --title="SteamOS EGPU Buddy" --width=520 --text="$1"; else read -rp "$1 [y/N] " r; [ "${r,,}" = y ]; fi; }

. /etc/os-release 2>/dev/null; DISTRO=${ID:-unknown}; LIKE=${ID_LIKE:-}
ARCH_LIKE=0; case "$DISTRO $LIKE" in *arch*|*cachyos*|*steamos*) ARCH_LIKE=1;; esac
# the systems EGPU Buddy supports, each with its own install path in install.sh: SteamOS, CachyOS / Arch (pacman build),
# Bazzite (the driver built in a Fedora container). DRIVER_OK: the patched NVIDIA driver can be built here.
IS_BAZZITE=0; case "${ID:-} ${NAME:-}" in *[Bb]azzite*) IS_BAZZITE=1;; esac
DRIVER_OK=$ARCH_LIKE; [ $IS_BAZZITE = 1 ] && DRIVER_OK=1
SUPPORTED=0; { [ $ARCH_LIKE = 1 ] || [ $IS_BAZZITE = 1 ]; } && SUPPORTED=1
IMMUTABLE=0; command -v steamos-readonly >/dev/null 2>&1 && IMMUTABLE=1
STOCK_SESSION=""; for s in /usr/lib/steamos/gamescope-session /usr/bin/gamescope-session /usr/bin/gamescope-session-plus; do [ -f "$s" ] && { STOCK_SESSION=$s; break; }; done
HAS_TOOLCHAIN=0; command -v meson >/dev/null && command -v ninja >/dev/null && command -v cc >/dev/null && command -v cmake >/dev/null && HAS_TOOLCHAIN=1
HAS_DECKY=0; [ -d "$HOME/homebrew/plugins" ] && HAS_DECKY=1
HAS_PLASMALOGIN=0; [ -f /etc/plasmalogin.conf ] && HAS_PLASMALOGIN=1
GPU=$(lspci -Dn 2>/dev/null | awk '$2=="0300:" && $3 ~ /^10de:/{print $1; exit}')

banner="SteamOS EGPU Buddy $VERSION
Distro: $DISTRO (${LIKE:-no ID_LIKE})   immutable root: $([ $IMMUTABLE = 1 ] && echo yes || echo no)
Game Mode session script: ${STOCK_SESSION:-NOT FOUND}
NVIDIA GPU on the bus now: ${GPU:-none}
Build toolchain: $([ $HAS_TOOLCHAIN = 1 ] && echo present || echo missing)   Decky Loader: $([ $HAS_DECKY = 1 ] && echo present || echo missing)

Supported: SteamOS, CachyOS (Deckify) / Arch and Bazzite (tested hardware: see TESTED.md).$([ $SUPPORTED = 1 ] || printf '\nThis system (%s) is NOT one of them.' "$DISTRO")
This changes udev, systemd, sudoers and your Game Mode session. Everything replaced is backed up.
Log: $LOG"

# ---------------------------------------------------------------- SteamOS: the account may have no password
# sudo cannot work without one. Detect it (passwd -S: NP = no password, L = locked) and have the user set one first.
if [ "$(id -u)" != 0 ] && [ "$(passwd -S "$USER" 2>/dev/null | awk '{print $2}')" != P ]; then
  if [ $GUI = 1 ]; then
    msg "Your user account has no password, so the installer cannot get administrator rights (sudo).

A terminal will open now: type a new password twice at the prompts (nothing is shown while typing), then this installer continues. The Decky plugin route does not need this step."
    for term in konsole gnome-terminal xterm; do command -v $term >/dev/null 2>&1 && { T=$term; break; }; done
    [ -n "${T:-}" ] || { err "No terminal emulator found. Open one, run: passwd   then run this installer again."; exit 1; }
    case "$T" in konsole) konsole -e bash -c 'echo "Set a password for $USER (needed for sudo):"; passwd';; gnome-terminal) gnome-terminal --wait -- bash -c 'passwd';; *) xterm -e bash -c 'passwd';; esac
  else
    echo "Your user account has no password, so sudo cannot work. Set one now:"; passwd </dev/tty
  fi
  [ "$(passwd -S "$USER" 2>/dev/null | awk '{print $2}')" = P ] || { err "Still no password set; cannot continue."; exit 1; }
fi

# ---------------------------------------------------------------- uninstall
if [ "$ACTION" = uninstall ]; then
  ask "$banner

Remove SteamOS EGPU Buddy and restore the backed-up originals?" || exit 0
  [ $IMMUTABLE = 1 ] && sudo steamos-readonly disable
  if bash "$ROOT/uninstall.sh" >>"$LOG" 2>&1; then msg "Uninstalled. Reboot to return to the stock session."; else err "Uninstall reported errors; see $LOG"; fi
  [ $IMMUTABLE = 1 ] && sudo steamos-readonly enable
  exit 0
fi

# ---------------------------------------------------------------- an unsupported Linux distribution: explicit go-ahead first
if [ "$ACTION" != uninstall ] && [ $SUPPORTED = 0 ]; then
  ask "THIS LINUX DISTRIBUTION IS NOT SUPPORTED ($DISTRO${LIKE:+, like $LIKE})

EGPU Buddy supports SteamOS, CachyOS (Deckify) / Arch and Bazzite. Here the NVIDIA driver cannot be built, Game Mode may not be set up, and parts of the install may fail.

Install anyway, AT YOUR OWN RISK?" || exit 0
fi

# ---------------------------------------------------------------- untested hardware: explicit acceptance first
if untested=$(bash "$ROOT/system/usr/local/sbin/egpu-detect" --untested 2>/dev/null); then
  ask "NOT TESTED ON THIS HARDWARE

$untested

SteamOS EGPU Buddy was verified on Legion Go 1 and 2 and the ROG Xbox Ally X, with RTX 30 / 50 and RX 6800 XT / RX 9070 XT eGPUs, on CachyOS, SteamOS and Bazzite (see TESTED.md). On this system it may not work, may leave the screen dark, or may need a reboot to recover.

You install and test it AT YOUR OWN RISK. Continue?" || exit 0
  export EGPU_ACCEPT_UNTESTED=1
fi

# ---------------------------------------------------------------- GPU type (first install only)
# install.sh asks this in a terminal, but here its output goes to the progress window, where nobody would see the
# question: ask it here, as the Game Mode plugin does. An update keeps the type chosen before.
# The eGPU plugged in right now, if any, is the suggested answer; a choice that does not match it is asked again (an NVIDIA
# install with an AMD card on the bus runs the wrong path entirely).
_det=$(bash "$ROOT/system/usr/local/sbin/egpu-detect" 2>/dev/null | awk '{print $2}'); case "$_det" in nvidia) ;; amd|intel) _det=amd ;; *) _det= ;; esac
if [ -z "${EGPU_GPU_VENDOR:-}" ] && [ ! -s /etc/nv-egpu-buddy/gpu-vendor ]; then
  _n=TRUE; _a=FALSE; _d=1; [ "$_det" = amd ] && { _n=FALSE; _a=TRUE; _d=2; }
  _seen=""; [ -n "$_det" ] && _seen=" (found plugged in now: $([ "$_det" = amd ] && echo 'AMD / Intel' || echo NVIDIA))"
  if [ $GUI = 1 ]; then
    _v=$(zenity --list --radiolist --title="SteamOS EGPU Buddy" --width=560 --height=270 --text="Which GPU will be in the eGPU?$_seen" \
         --column=" " --column=Key --column="GPU" --hide-column=2 --print-column=2 \
         $_n nvidia "NVIDIA (builds the NVIDIA driver, several minutes)" $_a amd "AMD / Intel (no driver build)") || exit 0
  else
    printf 'Which GPU will be in the eGPU?%s\n  1) NVIDIA (builds the NVIDIA driver, several minutes)\n  2) AMD / Intel (no driver build)\nChoice [1/2, default %s]: ' "$_seen" "$_d"
    read -r _c || _c=$_d; case "${_c:-$_d}" in 2) _v=amd ;; *) _v=nvidia ;; esac
  fi
  _v=${_v:-nvidia}
  if [ -n "$_det" ] && [ "$_v" != "$_det" ]; then
    ask "The eGPU plugged in now is $([ "$_det" = amd ] && echo 'an AMD / Intel card' || echo 'an NVIDIA card'), but you chose $([ "$_v" = amd ] && echo 'AMD / Intel' || echo NVIDIA). The wrong choice leaves Game Mode on a black screen.

Use $([ "$_det" = amd ] && echo 'AMD / Intel' || echo NVIDIA) instead? (recommended)" && _v=$_det
  fi
  export EGPU_GPU_VENDOR=$_v
fi

# ---------------------------------------------------------------- component choice
ALL="core,session,gamescope,decky,bootpolicy,desktopapp$([ $DRIVER_OK = 1 ] && echo ,driver)"
if [ $ADV = 0 ]; then
  ask "$banner

Install everything now? Hot-plug core, Game Mode session integration, GBM-scanout gamescope, Decky plugin$([ $HAS_DECKY = 1 ] || echo ' (skipped: Decky Loader not found)'), boot policy, desktop app$([ $DRIVER_OK = 1 ] && echo ', the patched hot-unplug NVIDIA driver (built on this device, several minutes; not with an AMD / Intel eGPU)'). Missing NVIDIA packages and kernel parameters are written automatically (backups kept). Afterwards: reboot with the eGPU disconnected, then plug it in." || exit 0
  sel=$ALL; export EGPU_AUTO_YES=1
elif [ $GUI = 1 ]; then
  zenity --info --title="SteamOS EGPU Buddy" --width=560 --text="$banner" || exit 0
  sel=$(zenity --list --checklist --title="SteamOS EGPU Buddy — choose components" --width=760 --height=420 \
      --column=Install --column=Key --column=Component --column=Notes --hide-column=2 --print-column=2 --separator=, \
      TRUE  core      "eGPU hot-plug core"              "attach/detach scripts, udev, units, modprobe, sudoers rule" \
      TRUE  session   "Game Mode session integration"   "gamescope wrapper, shim, Steam env fix, UI scale clamp, HDR opt-in" \
      TRUE  gamescope "GBM-scanout gamescope (UI corruption fix)" "$([ $HAS_TOOLCHAIN = 1 ] && echo 'built from source' || echo 'prebuilt binary; falls back to distro gamescope if it cannot run')" \
      $([ $HAS_DECKY = 1 ] && echo TRUE || echo FALSE) decky "EGPU Buddy Decky plugin" "$([ $HAS_DECKY = 1 ] && echo 'Decky Loader found' || echo 'Decky Loader not found')" \
      $([ $HAS_PLASMALOGIN = 1 ] && echo TRUE || echo FALSE) bootpolicy "Boot into Game Mode with the eGPU attached" "$([ $HAS_PLASMALOGIN = 1 ] && echo 'plasmalogin autologin policy' || echo 'CachyOS/plasmalogin only')" \
      TRUE  desktopapp "EGPU Buddy desktop app"          "status, power limit, safe detach, re-attach (GTK/WebKit window, browser fallback)" \
      FALSE driver    "Patched nvidia-open driver (surprise-unplug fix)" "$([ $DRIVER_OK = 1 ] && echo 'built on this device (SteamOS, Arch / CachyOS, Bazzite)' || echo 'not available on this distro')") || exit 0
else
  echo "$banner"; echo; echo "Components: core session gamescope decky bootpolicy desktopapp driver"; read -rp "Install which? (comma list, default core,session,gamescope,decky,bootpolicy,desktopapp): " sel; sel=${sel:-core,session,gamescope,decky,bootpolicy,desktopapp}
fi
want(){ case ",$sel," in *",$1,"*) return 0;; *) return 1;; esac; }
want driver && [ $DRIVER_OK = 0 ] && { err "The patched driver can only be built on SteamOS, Arch / CachyOS and Bazzite. Deselect it."; exit 1; }
[ -z "$STOCK_SESSION" ] && want session && { err "No gamescope-session script found; the Game Mode integration cannot be installed here."; exit 1; }

# ---------------------------------------------------------------- other eGPU tools (all-ways-eGPU, egpu-switcher)
# the same offer the Game Mode plugin makes before it installs (install.sh carries out the answer)
if OT=$(bash "$ROOT/packaging/other-egpu-tools.sh" detect 2>/dev/null); then
  OT_NAMES=$(printf '%s\n' "$OT" | awk '{sub(/:$/,"",$2); print $2}' | paste -sd, -)
  if ask "$OT_NAMES is installed. It changes the same things as EGPU Buddy (primary GPU at boot, the Game Mode session), and the two together cause crashes.

Remove it now with its own uninstaller? (recommended)"; then export EGPU_REMOVE_OTHER_TOOLS=1
  elif ask "Install EGPU Buddy alongside $OT_NAMES anyway? This is not supported."; then export EGPU_KEEP_OTHER_TOOLS=1
  else msg "Nothing was changed."; exit 0; fi
fi

# ---------------------------------------------------------------- install with progress
run_install(){
  say "== SteamOS EGPU Buddy $VERSION install: $sel"
  [ $IMMUTABLE = 1 ] && { say "disabling read-only root"; sudo steamos-readonly disable; }
  export EGPU_COMPONENTS="$sel" STOCK_GAMESCOPE_SESSION="$STOCK_SESSION" EGPU_PREBUILT_GAMESCOPE="$ROOT/prebuilt/gamescope-gbm" EGPU_AUTO_YES="${EGPU_AUTO_YES:-0}"
  args=(); want gamescope || args+=(--no-gamescope); want driver && args+=(--with-driver)
  bash "$ROOT/install.sh" "${args[@]}"; rc=$?
  [ $IMMUTABLE = 1 ] && sudo steamos-readonly enable
  # keep a copy so the uninstaller works without the release file
  mkdir -p "$HOME/.local/share/applications"
  printf '[Desktop Entry]\nType=Application\nName=SteamOS EGPU Buddy Uninstaller\nExec=%s/.local/share/steamos-egpu-buddy/installer/steamos-egpu-buddy --uninstall\nIcon=dialog-warning\nCategories=System;\n' "$HOME" > "$HOME/.local/share/applications/steamos-egpu-buddy-uninstall.desktop"
  return $rc
}
if [ $ADV = 1 ] && ! command -v nvidia-smi >/dev/null 2>&1 && command -v pacman >/dev/null 2>&1; then
  ask "NVIDIA packages are missing. Install nvidia-open-dkms + nvidia-utils with pacman as part of this install? (needed before the eGPU is plugged in)" && export EGPU_AUTO_YES=1
fi
if [ $GUI = 1 ]; then
  ( run_install ) 2>&1 | tee -a "$LOG" | zenity --progress --pulsate --auto-close --no-cancel --title="SteamOS EGPU Buddy" --width=560 --text="Installing… (log: $LOG)"
  rc=${PIPESTATUS[0]}
else
  run_install; rc=$?
fi
if [ "$rc" = 0 ] && [ $ADV = 1 ] && ! /usr/local/sbin/egpu-kernel-cmdline --check >/dev/null 2>&1; then
  if ask "$(/usr/local/sbin/egpu-kernel-cmdline --check 2>&1)

Add the required kernel parameters to your bootloader configuration now? (backup kept; you must reboot before plugging the eGPU in)"; then
    sudo /usr/local/sbin/egpu-kernel-cmdline --apply >>"$LOG" 2>&1 && msg "Kernel parameters written. Reboot before connecting the eGPU." || err "Could not write the kernel parameters; see $LOG and README 'Kernel command line'."
  fi
fi
if [ "$rc" = 0 ]; then
  msg "Installed: $sel

Next: reboot with the eGPU DISCONNECTED, then plug it in once the session is up.
Uninstaller: application menu → 'SteamOS EGPU Buddy Uninstaller'.
Read TESTED.md for what is verified and what is not."
else
  err "Install failed (exit $rc). Nothing is half-applied without a backup; see $LOG"
fi
