#!/usr/bin/env bash
# SteamOS EGPU Buddy - this project's patched NVIDIA driver on Bazzite (Bazzite only; exits on anything else).
#
# Bazzite's handheld image (bazzite-deck) has no NVIDIA driver, and /usr is read-only with no compiler. So the driver is
# built on the device inside a Fedora container (podman) and laid over /usr as a systemd system extension:
#   - kernel modules: NVIDIA's open module source + this project's patches (packaging/nvidia-open-egpu-615, the same
#     patch set, in the same order, as everywhere else), built against kernel-devel for EXACTLY the running kernel
#     (fetch-kernel-devel.py: the kernel's own package registry), signed with this machine's key when Secure Boot is on;
#   - userspace: NVIDIA's own installer, unpacked by the same vendored recipes every other system uses
#     (build-userspace.sh), laid out the Fedora way; plus Fedora's open-source EGL platform libraries the recipe
#     depends on (egl-wayland, egl-wayland2, egl-gbm, egl-x11) where Bazzite does not have them;
#   - the module index (modules.dep ...) regenerated for Bazzite's modules plus ours.
# If Bazzite's NVIDIA image (bazzite-deck-nvidia) is installed instead and its driver is the patched version, only the
# kernel modules are replaced (userspace identical); with any other NVIDIA version nothing is done.
# The extension tree lives in /var/lib/nvegpu/bazzite/ext; only the link /etc/extensions/egpu-nvidia makes systemd merge
# it, and that link exists only while the build matches this boot and can load (--guard checks it at every boot BEFORE
# systemd-sysext merges anything). In every other case the system runs exactly as without the driver.
#   egpu-bazzite-driver --status | --build | --boot | --guard | --boot-ok | --enroll | --remove
set -u
. /etc/os-release 2>/dev/null; case "${ID:-} ${NAME:-}" in *[Bb]azzite*) ;; *) echo "not Bazzite"; exit 0 ;; esac
LIB=/usr/local/lib/egpu-buddy/bazzite; PKG=$LIB/nvidia-open-egpu-615
W=/var/lib/nvegpu/bazzite; KEYD=/var/lib/nvegpu/mok; NAME=egpu-nvidia; EXT=/var/lib/nvegpu/bazzite/ext; LINK=/etc/extensions/egpu-nvidia
LOG=/var/log/egpu-bazzite-driver.log; MOKPW=egpubuddy; IMG="registry.fedoraproject.org/fedora:${VERSION_ID:-44}"
EGL_PKGS="egl-wayland egl-wayland2 egl-gbm egl-x11"
K=$(uname -r); PV=$(sed -n 's/^pkgver=//p' "$PKG/PKGBUILD" 2>/dev/null)
say(){ printf '%s\n' "$*"; printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG" 2>/dev/null; }
host_nv(){ rpm -q --qf '%{VERSION}\n' nvidia-driver 2>/dev/null | grep -E '^[0-9]' | head -1; }   # Bazzite's own NVIDIA driver, if any
# full = no NVIDIA driver in the image (bazzite-deck); modules = the image's driver is our version; conflict = another
mode_now(){ local v; v=$(host_nv); if [ -z "$v" ]; then echo full; elif [ "$v" = "$PV" ]; then echo modules; else echo conflict; fi; }
sb_on(){ mokutil --sb-state 2>/dev/null | grep -qi 'SecureBoot enabled'; }
key_enrolled(){ [ -s "$KEYD/egpu-buddy.der" ] && mokutil --test-key "$KEYD/egpu-buddy.der" 2>/dev/null | grep -qi 'already enrolled'; }
key_pending(){ [ -s "$KEYD/egpu-buddy.der" ] && [ -e "$KEYD/queued" ] && ! key_enrolled; }
# built for this kernel, this version and this image's driver situation; with Secure Boot on, also signed (Secure Boot
# switched on after an unsigned build makes it "not built": the guard drops it and --boot builds it again, signed)
built(){ [ -s "$EXT/usr/lib/modules/$K/extra/nvidia/nvidia.ko.xz" ] && [ "$(cat "$EXT/.egpu-version" 2>/dev/null)" = "$PV $K $(mode_now)" ] \
         && { ! sb_on || [ -e "$EXT/.signed" ]; }; }
can_load(){ ! sb_on || key_enrolled; }
merged(){ [ -L "$LINK" ] && systemd-sysext status 2>/dev/null | grep -qw "$NAME"; }
nv_loaded(){ [ -d /sys/module/nvidia ]; }
# every removal below goes through this: a fixed prefix, never an empty or unrelated path
drop(){ local p; for p in "$@"; do case "$p" in /var/lib/nvegpu/bazzite*) rm -rf -- "${p:?}" ;; esac; done; }

make_key(){ # this machine's own module-signing key (Secure Boot only), kept root-only
  [ -s "$KEYD/egpu-buddy.der" ] && [ -s "$KEYD/egpu-buddy.priv" ] && return 0
  mkdir -p "$KEYD"; chmod 700 "$KEYD"
  cat > "$KEYD/x509.cnf" <<CNF
[ req ]
default_bits = 2048
distinguished_name = dn
prompt = no
x509_extensions = v3
[ dn ]
CN = SteamOS EGPU Buddy module signing ($(cut -c1-8 /etc/machine-id 2>/dev/null))
[ v3 ]
basicConstraints = critical,CA:FALSE
keyUsage = digitalSignature
extendedKeyUsage = codeSigning,1.3.6.1.4.1.2312.16.1.2
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid
CNF
  openssl req -new -x509 -nodes -days 36500 -config "$KEYD/x509.cnf" -outform DER \
    -keyout "$KEYD/egpu-buddy.priv" -out "$KEYD/egpu-buddy.der" >/dev/null 2>&1 || { say "could not create a signing key"; return 1; }
  chmod 600 "$KEYD/egpu-buddy.priv"; say "created this machine's module-signing key"
}

enroll(){ # ask the firmware to trust our key at the next boot (the MokManager blue screen asks for the password once)
  sb_on || { say "Secure Boot is off: no key enrollment needed"; return 0; }
  make_key || return 1
  key_enrolled && { say "the signing key is already enrolled"; return 0; }
  printf '%s\n%s\n' "$MOKPW" "$MOKPW" | mokutil --import "$KEYD/egpu-buddy.der" >/dev/null 2>&1 \
    && { touch "$KEYD/queued"; say "signing key queued: at the next reboot choose \"Enroll MOK\" -> Continue -> Yes, password: $MOKPW"; } \
    || { key_pending && say "the signing key is waiting for enrollment: reboot, choose \"Enroll MOK\", password: $MOKPW" || say "mokutil could not queue the signing key"; }
}

selinux_on(){ [ -e /sys/fs/selinux/enforce ]; }
LABELV=2   # .labeled holds this once every file carries its policy label (0.7.151 and older: see label)
labeled(){ ! selinux_on || [ "$(cat "$EXT/.labeled" 2>/dev/null)" = "$LABELV" ]; }
bad_labels(){ find "$1/usr" -printf '%Z %p\n' 2>/dev/null | grep -E '(container_file_t|unlabeled_t|var_lib_t|default_t)' | head -3; }
label(){ # SELinux: every file gets the label the policy gives the same path under / (as the Fedora sysexts project does)
  # -F: the build comes out of the container labeled container_file_t, a "customizable" type that setfiles otherwise
  # leaves alone (0.7.151 and older: dbus-broker could not read nvidia-dbus.conf, D-Bus failed, greenboot rebooted)
  selinux_on || return 0
  rm -f "$1/.labeled"; drop "$1/usr/share/dbus-1"   # nvidia-powerd's D-Bus policy: not needed for an eGPU, and D-Bus fails on any unreadable one
  local fc=/etc/selinux/targeted/contexts/files/file_contexts
  if command -v setfiles >/dev/null && [ -r "$fc" ]; then setfiles -F -r "$1" "$fc" "$1/usr" >>"$LOG" 2>&1; fi
  if [ -n "$(bad_labels "$1")" ] && command -v chcon >/dev/null; then   # fallback: the labels of the directories they stand in for
    local d; for d in lib/modules lib64 lib bin share; do [ -e "$1/usr/$d" ] && chcon -R -h --reference="/usr/$d" "$1/usr/$d" 2>>"$LOG"; done
    [ -d "$1/usr/lib/firmware" ] && chcon -R -h --reference=/usr/lib/firmware "$1/usr/lib/firmware" 2>>"$LOG"
  fi
  local b; b=$(bad_labels "$1")
  if [ -n "$b" ]; then say "could not give the driver files their SELinux labels (e.g. $(echo "$b" | head -1)): not switched on"; return 1; fi
  echo "$LABELV" > "$1/.labeled"
}

module_index(){ # <extension tree>: modules.dep & co for Bazzite's modules + ours (the extension's copy shadows the image's)
  local N=$1 T="$W/depmod"; drop "$T"; mkdir -p "$T/usr/lib/modules/$K"; ln -s usr/lib "$T/lib"
  cp -as "/usr/lib/modules/$K/." "$T/usr/lib/modules/$K/" 2>/dev/null
  rm -rf "${T:?}/usr/lib/modules/$K/extra/nvidia"; mkdir -p "$T/usr/lib/modules/$K/extra/nvidia"
  cp "$N/usr/lib/modules/$K/extra/nvidia/"*.ko.xz "$T/usr/lib/modules/$K/extra/nvidia/"
  rm -f "$T/usr/lib/modules/$K"/modules.{dep,dep.bin,alias,alias.bin,softdep,symbols,symbols.bin,builtin.bin,builtin.alias.bin,devname,weakdep}
  depmod -b "$T" "$K" 2>>"$LOG" || { drop "$T"; return 1; }
  local f; for f in "$T/usr/lib/modules/$K"/modules.*; do [ -f "$f" ] && [ ! -L "$f" ] && cp "$f" "$N/usr/lib/modules/$K/"; done
  drop "$T"; grep -q 'extra/nvidia/nvidia.ko.xz' "$N/usr/lib/modules/$K/modules.dep"
}

# The extension is only ever merged or taken away by systemd-sysext AT BOOT, never under a running session: on Bazzite's
# read-only /usr a live refresh remounts /usr under Game Mode (0.7.146: the screen went dark right after the install).
deactivate(){ [ -L "$LINK" ] || return 0; rm -f "$LINK"; say "the patched driver is switched off from the next boot"; return 0; }

activate(){
  built || { say "no patched driver built for kernel $K"; return 1; }
  can_load || { say "Secure Boot is on and the signing key is not enrolled yet: the driver stays off until it is"; return 1; }
  relabel || return 1
  systemctl enable systemd-sysext.service egpu-bazzite-driver-guard.service egpu-bazzite-boot-ok.service >/dev/null 2>&1
  [ -L "$LINK" ] || { mkdir -p /etc/extensions; ln -sfn "$EXT" "$LINK"; }   # systemd merges it from the next boot on
  if ! merged; then
    live_merge; local r=$?
    [ $r = 2 ] && return 1
    [ $r = 0 ] || { say "patched NVIDIA driver $PV ready for $K: active after the next reboot"; return 0; }
    verify && return 0
    capture "the driver was added but the system does not see it"
    live_unmerge; rm -f "$LINK"; return 1     # added live but not the driver it should be: out again, and off
  fi
  verify
}

live_merge(){ # as on SteamOS: merge now, no reboot. Only while no NVIDIA driver is loaded (nothing uses the files that
  # change) and with every label checked. The core services are checked right after; anything wrong -> unmerged again
  # at once and left to the next boot (where the boot guard and its safety net apply).
  nv_loaded && return 1; labeled || return 1
  local i ok=1; for i in 1 2 3; do systemd-sysext refresh >>"$LOG" 2>&1 && { ok=0; break; }; sleep 2; done
  [ $ok = 0 ] && merged || { say "could not add the driver to the running system: active after the next reboot"; return 1; }
  ldconfig 2>/dev/null
  busctl --system status >/dev/null 2>&1 && return 0
  # a failure seen LIVE is reported live: the details go into the log (and the support report) while the system still
  # runs, and the driver stays OFF - never left for a boot that could fail the same way with nobody able to report it
  capture "the system message bus did not answer after adding the driver"
  live_unmerge; rm -f "$LINK"; date '+%F %T' > "$W/auto-off2"
  say "the patched driver was taken out again and switched off (details in the support report)"; return 2
}
live_unmerge(){ rm -f "$LINK"; systemd-sysext refresh >>"$LOG" 2>&1; ldconfig 2>/dev/null; ln -sfn "$EXT" "$LINK"; }
capture(){ # <what failed>: what the system said in the last two minutes, into the driver log
  { echo "==== $(date '+%F %T') $1: system state ===="
    systemctl list-units --failed --no-legend --no-pager 2>&1 | head -20
    journalctl --no-pager -o short-monotonic --since "-2min" --grep 'avc:\s+denied' 2>&1 | tail -20
    journalctl --no-pager -o short-monotonic --since "-2min" -p warning 2>&1 | tail -60
    echo "==== end ===="; } >> "$LOG" 2>&1
}

relabel(){ # a build from 0.7.151 or older carries the container's labels: fix them in place (never while merged)
  labeled && return 0
  merged && { say "the driver files need new SELinux labels: done at the next boot"; return 1; }
  say "giving the driver files their SELinux labels"; label "$EXT"
}

verify(){ # merged by systemd at this boot: is what modprobe and the libraries see really the patched driver?
  local p; p=$(modinfo -k "$K" -n nvidia 2>/dev/null)
  # (modinfo prints /lib/modules/... on Fedora: /lib is a link to usr/lib, so the CONTENT is what is compared)
  if [ "$(modinfo -k "$K" -F version nvidia 2>/dev/null)" = "$PV" ] && [ -n "$p" ] && cmp -s "$p" "$EXT/usr/lib/modules/$K/extra/nvidia/nvidia.ko.xz" \
     && { [ "$(mode_now)" = modules ] || command -v nvidia-smi >/dev/null; }; then say "patched NVIDIA driver $PV active for $K"; return 0; fi
  say "the extension is merged but the system does not see the patched driver: switched off from the next boot"; deactivate; return 1
}

build(){
  local mode; mode=$(mode_now)
  [ "$mode" = conflict ] && { say "this Bazzite image has NVIDIA's driver $(host_nv); the patched driver is $PV. Use Bazzite's handheld image without NVIDIA (bazzite-deck): this project installs its own driver there"; return 3; }
  command -v podman >/dev/null || { say "podman is missing"; return 4; }
  if built; then say "patched driver for $K already built"; return 0; fi
  mkdir -p "$W"; local src="NVIDIA-kernel-module-source-$PV.tar.xz" sum
  sum=$(sed -n "s/^sha256sums=('\([0-9a-f]*\)'.*/\1/p" "$PKG/PKGBUILD")
  if ! { [ -s "$W/$src" ] && [ "$(sha256sum "$W/$src" | cut -d' ' -f1)" = "$sum" ]; }; then
    say "downloading NVIDIA's module source $PV"
    if ! { curl -fsSL --retry 3 -o "$W/$src.part" "https://download.nvidia.com/XFree86/NVIDIA-kernel-module-source/$src" \
           && [ "$(sha256sum "$W/$src.part" | cut -d' ' -f1)" = "$sum" ]; }; then
      drop "$W/$src.part"; say "NVIDIA source download failed or did not match its checksum"; return 5; fi
    mv "$W/$src.part" "$W/$src"
  fi
  if [ ! -s "$W/kernel-devel-$K.rpm" ]; then
    say "downloading kernel-devel for $K"; local o; for o in "$W"/kernel-devel-*.rpm; do drop "$o"; done
    python3 -I "$LIB/fetch-kernel-devel.py" "$K" "$W/kernel-devel-$K.rpm" >>"$LOG" 2>&1 || { say "kernel-devel for $K is not available (see $LOG)"; return 6; }
  fi
  local keyarg=(); if sb_on; then make_key || return 7; keyarg=(-v "$KEYD:/k:ro"); fi
  # what the container does: the modules always; the userspace once per driver version (full mode only); the EGL
  # platform libraries Bazzite lacks
  local steps="bash /b/build-modules.sh $K $PV" egl="" p
  if [ "$mode" = full ]; then
    [ "$(cat "$W/userspace/.version" 2>/dev/null)" = "$PV" ] || steps="$steps && bash /b/build-userspace.sh $PV"
    for p in $EGL_PKGS; do rpm -q "$p" >/dev/null 2>&1 || egl="$egl $p.x86_64"; rpm -q "$p.i686" >/dev/null 2>&1 || egl="$egl $p.i686"; done
    [ -n "$egl" ] && steps="$steps && bash /b/build-userspace.sh --egl$egl"
  fi
  say "building the patched NVIDIA driver $PV for $K in a Fedora container ($mode; several minutes, the first time ~1 GB of downloads)"
  podman run --rm --network host --security-opt label=disable -v "$W:/w" -v "$PKG:/p:ro" -v "$LIB:/b:ro" "${keyarg[@]}" \
    "$IMG" bash -c "set -e; $steps" >>"$LOG" 2>&1 || { say "the driver build failed (see $LOG); nothing was changed"; return 8; }
  if [ -d "$W/out/userspace/usr" ]; then drop "$W/userspace"; mv "$W/out/userspace" "$W/userspace"; fi
  local N="$EXT.new"; drop "$N"; mkdir -p "$N/usr/lib/modules/$K/extra/nvidia" "$N/usr/lib/extension-release.d"
  if [ "$mode" = full ]; then
    [ -d "$W/userspace/usr" ] || { say "no NVIDIA userspace was built"; drop "$N"; return 9; }
    cp -a --reflink=auto "$W/userspace/usr/." "$N/usr/"
    [ -d "$W/out/egl/usr" ] && cp -a --reflink=auto "$W/out/egl/usr/." "$N/usr/"
  fi
  cp "$W/out/$K"/*.ko.xz "$N/usr/lib/modules/$K/extra/nvidia/"
  module_index "$N" || { say "could not build the module index"; drop "$N"; return 10; }
  printf 'ID=_any\nARCHITECTURE=x86-64\n' > "$N/usr/lib/extension-release.d/extension-release.$NAME"
  echo "$PV $K $mode" > "$N/.egpu-version"; [ ${#keyarg[@]} -gt 0 ] && touch "$N/.signed"
  label "$N" || { drop "$N"; return 12; }
  if merged && ! nv_loaded; then   # the eGPU is not in use: take the old build out live and put the new one in
    rm -f "$LINK"; systemd-sysext refresh >>"$LOG" 2>&1
    if ! merged; then drop "$EXT.old"; mv "$EXT" "$EXT.old"; mv "$N" "$EXT"; drop "$EXT.old" "$W/kernel-devel-$K.rpm" "$W/out"
      say "built the patched NVIDIA driver $PV for $K ($mode)"; return 0; fi    # (the caller switches it on: activate)
    ln -sfn "$EXT" "$LINK"
  fi
  if merged; then drop "$EXT.staged"; mv "$N" "$EXT.staged"; say "built; takes over at the next boot (the driver is in use now)"; return 0; fi
  drop "$EXT.old"; [ -e "$EXT" ] && mv "$EXT" "$EXT.old"; mv "$N" "$EXT"; drop "$EXT.old"
  drop "$W/kernel-devel-$K.rpm" "$W/out"; say "built the patched NVIDIA driver $PV for $K ($mode)"
  return 0
}

status(){
  echo "kernel: $K · patched driver: ${PV:-?} · Bazzite's own NVIDIA driver: $(host_nv | grep . || echo none) · mode: $(mode_now)"
  local s="off"; if sb_on; then s="on"; if key_enrolled; then s="$s · signing key enrolled"; elif key_pending; then s="$s · signing key waiting for enrollment (reboot)"; else s="$s · signing key NOT enrolled"; fi; fi
  echo "Secure Boot: $s"
  echo "built for this kernel: $(built && echo yes || echo no) · SELinux labels: $(selinux_on || { echo "n/a"; false; } && { labeled && echo ok || echo "NOT set ($(bad_labels "$EXT" | head -1))"; }) · extension active: $(merged && echo yes || echo no)$([ -e "$W/auto-off2" ] && echo " · SWITCHED OFF after boots that hung ($(cat "$W/auto-off2"))")"
  echo "nvidia module modprobe loads: $(modinfo -k "$K" -n nvidia 2>/dev/null || echo none) (signer: $(modinfo -k "$K" -F signer nvidia 2>/dev/null || echo -)) · nvidia-smi: $(command -v nvidia-smi || echo none)"
  built && merged
}

case "${1:---status}" in
  --status) status ;;
  --build)
    [ "$(id -u)" = 0 ] || { echo "run as root"; exit 1; }
    rm -f "$W/auto-off" "$W/auto-off2"; build; rc=$?; [ $rc = 0 ] || exit $rc
    if sb_on && ! key_enrolled; then enroll; exit 11; fi
    activate ;;
  --boot)   # at every boot: a staged build takes over, a new kernel gets its driver (network permitting), never blocks
    [ "$(id -u)" = 0 ] || exit 1
    # a staged build (made while the eGPU was in use) is swapped in while no NVIDIA module is loaded, as on SteamOS
    # (apply_staged in install-steamos-sysext.sh): un-merge, swap, and activate below merges it again live
    if [ -d "$EXT.staged" ] && ! nv_loaded; then
      merged && { rm -f "$LINK"; systemd-sysext refresh >>"$LOG" 2>&1; }
      merged || { drop "$EXT.old"; [ -e "$EXT" ] && mv "$EXT" "$EXT.old"; mv "$EXT.staged" "$EXT"; drop "$EXT.old"; }
    fi
    built || deactivate                                         # built for another kernel / version / image: never merge it
    [ "$(mode_now)" = conflict ] && exit 0
    built || build || exit 0
    can_load || exit 0
    # (0.7.148's "auto-off" came from a miscount, not from hung boots: it is dropped, the driver goes back on)
    [ -e "$W/auto-off" ] && { rm -f "$W/auto-off"; echo 0 > "$W/boot-attempts"; say "0.7.148 switched the driver off by mistake (a boot was counted twice): switched back on"; }
    # boots that failed with a build whose files had the container's SELinux labels (0.7.151 and older): that was the
    # cause (D-Bus could not start, greenboot rebooted), fixed by relabel below: the driver goes back on
    [ -e "$W/auto-off2" ] && built && ! labeled && { rm -f "$W/auto-off2"; echo 0 > "$W/boot-attempts"; say "the earlier failed boots came from wrong SELinux labels on the driver files: relabelling and switching it back on"; }
    [ -e "$W/auto-off2" ] && { say "the patched driver was switched off after boots that hung ($(cat "$W/auto-off2")); reinstall from the plugin to try it again"; exit 0; }
    if merged; then verify || true; elif [ ! -L "$LINK" ]; then activate || true; fi ;;
  --enroll) enroll ;;
  --guard)  # early boot, before systemd-sysext merges: keep the link only if the build matches this boot and can load
    [ -L "$LINK" ] || exit 0
    # safety net: two boots in a row with the driver merged that never reached the login screen -> switch it off.
    # Counted once per boot (boot id): systemd can start this unit a second time in the same boot (0.7.148 counted the
    # first boot twice and switched a working driver off).
    bid=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null); [ "$(cat "$W/boot-counted" 2>/dev/null)" = "$bid" ] && exit 0
    n=$(cat "$W/boot-attempts" 2>/dev/null || echo 0); case "$n" in ''|*[!0-9]*) n=0 ;; esac
    if [ "$n" -ge 2 ]; then rm -f "$LINK"; echo 0 > "$W/boot-attempts"; date '+%F %T' > "$W/auto-off2"   # stays off until the next install (--build)
      say "boot guard: the last $n boots with the patched driver did not reach the login screen: switched it off (Bazzite runs as without it)"; exit 0; fi
    if [ -d "$EXT.staged" ]; then rm -f "$LINK"; exit 0; fi   # a new build waits: --boot swaps it in unmerged, the next boot merges it
    if built && ! labeled; then rm -f "$LINK"; echo 0 > "$W/boot-attempts"; say "boot guard: the driver files do not have their SELinux labels yet: left off (relabelled after this boot)"; exit 0; fi
    if ! { built && can_load; }; then rm -f "$LINK"; say "boot guard: the patched driver does not match this boot (kernel $K, Bazzite NVIDIA $(host_nv | grep . || echo none)): left off"; exit 0; fi
    echo $((n + 1)) > "$W/boot-attempts"; echo "$bid" > "$W/boot-counted"
    { tail -n 4 "$W/merged-boots" 2>/dev/null; echo "$bid"; } > "$W/merged-boots.new"; mv -f "$W/merged-boots.new" "$W/merged-boots"   # for the support report
    exit 0 ;;
  --boot-ok)  # the login screen started: the boot with the driver worked
    [ -L "$LINK" ] && { echo 0 > "$W/boot-attempts"; cat /proc/sys/kernel/random/boot_id > "$W/last-ok-boot" 2>/dev/null; }; exit 0 ;;
  --remove)   # the merged copy (if any) goes with the next boot; nothing is unmounted under the running session
    rm -f "$LINK"; systemctl disable egpu-bazzite-driver-guard.service egpu-bazzite-boot-ok.service >/dev/null 2>&1
    merged || drop "$W"
    say "patched driver removed (fully gone after the next reboot)" ;;
  *) echo "usage: $0 --status | --build | --boot | --guard | --boot-ok | --enroll | --remove"; exit 2 ;;
esac
