#!/usr/bin/env bash
# SteamOS EGPU Buddy - the patched NVIDIA kernel modules on Bazzite (Bazzite only; exits on anything else).
#
# Bazzite's NVIDIA handheld image (bazzite-deck-nvidia) ships NVIDIA's driver 615.78.08 (negativo17 userspace + ublue
# kmods, signed). The eGPU hot-plug/surprise-removal fixes of this project are KERNEL MODULE patches for exactly that
# version (packaging/nvidia-open-egpu-615, tested on 615.78.08). So on Bazzite nothing but the .ko files changes:
#   1. kernel-devel for EXACTLY the running kernel comes from the kernel's own package registry (fetch-kernel-devel.py),
#   2. the modules are built from NVIDIA's source + the same patches inside a Fedora container (podman; Bazzite has no
#      compiler and a read-only /usr), signed with this machine's own key when Secure Boot is on,
#   3. they are laid over Bazzite's own modules at the SAME paths through a systemd system extension, so module
#      dependency data, userspace, firmware and everything else stay Bazzite's. The extension tree lives in a private
#      store (/var/lib/nvegpu/bazzite/ext); only the link /etc/extensions/egpu-nvidia makes systemd merge it, and that
#      link exists only while the modules can load and match the image (--guard re-checks it at every boot BEFORE
#      systemd-sysext merges anything: an OS update with another NVIDIA version or kernel drops it).
# Safety: the extension is only activated when its modules will load (Secure Boot off, or our key enrolled), when the
# image's NVIDIA version equals the patched version, and only for the kernel it was built for. In every other case
# Bazzite's own driver is used, exactly as without this project.
#   egpu-bazzite-driver --status | --build | --boot | --guard | --enroll | --remove
set -u
. /etc/os-release 2>/dev/null; case "${ID:-} ${NAME:-}" in *[Bb]azzite*) ;; *) echo "not Bazzite"; exit 0 ;; esac
LIB=/usr/local/lib/egpu-buddy/bazzite; PKG=$LIB/nvidia-open-egpu-615
W=/var/lib/nvegpu/bazzite; KEYD=/var/lib/nvegpu/mok; NAME=egpu-nvidia; EXT=/var/lib/nvegpu/bazzite/ext; LINK=/etc/extensions/egpu-nvidia
LOG=/var/log/egpu-bazzite-driver.log; MOKPW=egpubuddy
K=$(uname -r); PV=$(sed -n 's/^pkgver=//p' "$PKG/PKGBUILD" 2>/dev/null)
say(){ printf '%s\n' "$*"; printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG" 2>/dev/null; }
nv_version(){ rpm -q --qf '%{VERSION}\n' nvidia-driver 2>/dev/null | grep -E '^[0-9]' | head -1; }
stock_module(){ rpm -q --whatprovides "kmod-nvidia-$K" >/dev/null 2>&1; }   # package kmod-nvidia provides kmod-nvidia-<kernel>
sb_on(){ mokutil --sb-state 2>/dev/null | grep -qi 'SecureBoot enabled'; }
key_enrolled(){ [ -s "$KEYD/egpu-buddy.der" ] && mokutil --test-key "$KEYD/egpu-buddy.der" 2>/dev/null | grep -qi 'already enrolled'; }
key_pending(){ [ -s "$KEYD/egpu-buddy.der" ] && [ -e "$KEYD/queued" ] && ! key_enrolled; }
built(){ [ -s "$EXT/usr/lib/modules/$K/extra/nvidia/nvidia.ko.xz" ] && [ "$(cat "$EXT/.egpu-version" 2>/dev/null)" = "$PV $K" ]; }
can_load(){ ! sb_on || key_enrolled; }
merged(){ [ -L "$LINK" ] && systemd-sysext status 2>/dev/null | grep -qw "$NAME"; }
refresh(){ local i; for i in 1 2 3; do systemd-sysext refresh >/dev/null 2>&1 && return 0; sleep 2; done; return 1; }
nv_loaded(){ [ -d /sys/module/nvidia ]; }
# every removal below goes through this: a fixed prefix, never an empty or unrelated path
drop(){ local p; for p in "$@"; do case "$p" in /var/lib/nvegpu/bazzite*) rm -rf -- "${p:?}" ;; esac; done; }

make_key(){ # this machine's own module-signing key (Secure Boot only), kept root-only
  [ -s "$KEYD/egpu-buddy.der" ] && [ -s "$KEYD/egpu-buddy.priv" ] && return 0
  mkdir -p "$KEYD"; chmod 700 "$KEYD"
  cat > "$KEYD/x509.cnf" <<CNF
[ req ]
default_bits = 2048
distinguished_name = dn
prompt = no
x509_extensions = v3
[ dn ]
CN = SteamOS EGPU Buddy module signing ($(cut -c1-8 /etc/machine-id 2>/dev/null))
[ v3 ]
basicConstraints = critical,CA:FALSE
keyUsage = digitalSignature
extendedKeyUsage = codeSigning,1.3.6.1.4.1.2312.16.1.2
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid
CNF
  openssl req -new -x509 -nodes -days 36500 -config "$KEYD/x509.cnf" -outform DER \
    -keyout "$KEYD/egpu-buddy.priv" -out "$KEYD/egpu-buddy.der" >/dev/null 2>&1 || { say "could not create a signing key"; return 1; }
  chmod 600 "$KEYD/egpu-buddy.priv"; say "created this machine's module-signing key"
}

enroll(){ # ask the firmware to trust our key at the next boot (the MokManager blue screen asks for the password once)
  sb_on || { say "Secure Boot is off: no key enrollment needed"; return 0; }
  make_key || return 1
  key_enrolled && { say "the signing key is already enrolled"; return 0; }
  printf '%s\n%s\n' "$MOKPW" "$MOKPW" | mokutil --import "$KEYD/egpu-buddy.der" >/dev/null 2>&1 \
    && { touch "$KEYD/queued"; say "signing key queued: at the next reboot choose \"Enroll MOK\" -> Continue -> Yes, password: $MOKPW"; } \
    || { key_pending && say "the signing key is waiting for enrollment: reboot, choose \"Enroll MOK\", password: $MOKPW" || say "mokutil could not queue the signing key"; }
}

label(){ # SELinux: the files get exactly the labels of the Bazzite files they stand in for
  command -v chcon >/dev/null || return 0
  chcon -R --reference="/usr/lib/modules/$K/extra/nvidia" "$1/usr/lib/modules" 2>/dev/null
  local f; for f in "$1"/usr/lib/modules/"$K"/extra/nvidia/*.ko.xz; do chcon --reference="/usr/lib/modules/$K/extra/nvidia/nvidia.ko.xz" "$f" 2>/dev/null; done
  chcon -R --reference=/usr/lib/os-release "$1/usr/lib/extension-release.d" 2>/dev/null
  chcon --reference=/usr/lib "$1/usr" "$1/usr/lib" 2>/dev/null; return 0
}

deactivate(){ [ -L "$LINK" ] || return 0; rm -f "$LINK"; nv_loaded || refresh; return 0; }

activate(){
  built || { say "no patched modules for kernel $K"; return 1; }
  [ "$(nv_version)" = "$PV" ] || { say "Bazzite's NVIDIA driver is $(nv_version), the patched modules are $PV: Bazzite's own driver stays"; deactivate; return 1; }
  can_load || { say "Secure Boot is on and the signing key is not enrolled yet: Bazzite's own driver stays until it is"; return 1; }
  systemctl enable systemd-sysext.service egpu-bazzite-driver-guard.service >/dev/null 2>&1
  mkdir -p /etc/extensions; ln -sfn "$EXT" "$LINK"            # from now on systemd merges it at every boot
  merged && return 0
  if nv_loaded; then say "the NVIDIA driver is in use: the patched modules take over at the next boot"; return 0; fi
  refresh || { say "systemd-sysext could not merge the extension"; return 1; }
  local p; p=$(modinfo -k "$K" -n nvidia 2>/dev/null)
  # (modinfo prints /lib/modules/... on Fedora: /lib is a link to usr/lib, so the CONTENT is what is compared)
  if [ "$(modinfo -k "$K" -F version nvidia 2>/dev/null)" = "$PV" ] && [ -n "$p" ] && cmp -s "$p" "$EXT/usr/lib/modules/$K/extra/nvidia/nvidia.ko.xz"; then say "patched NVIDIA modules active for $K"; return 0; fi
  say "the extension merged but modprobe does not see the patched modules: removed it, Bazzite's own driver stays"; deactivate; return 1
}

build(){
  local v; v=$(nv_version)
  { [ -n "$v" ] && stock_module; } || { say "this Bazzite image has no NVIDIA driver: switch to Bazzite's NVIDIA handheld image first (rpm-ostree rebase ostree-image-signed:docker://ghcr.io/ublue-os/bazzite-deck-nvidia:stable)"; return 2; }
  [ "$v" = "$PV" ] || { say "Bazzite's NVIDIA driver is $v; the patched modules exist for $PV only: Bazzite's own driver stays"; return 3; }
  command -v podman >/dev/null || { say "podman is missing"; return 4; }
  if built; then say "patched modules for $K already built"; return 0; fi
  mkdir -p "$W"; local src="NVIDIA-kernel-module-source-$PV.tar.xz" sum
  sum=$(sed -n "s/^sha256sums=('\([0-9a-f]*\)'.*/\1/p" "$PKG/PKGBUILD")
  if ! { [ -s "$W/$src" ] && [ "$(sha256sum "$W/$src" | cut -d' ' -f1)" = "$sum" ]; }; then
    say "downloading NVIDIA's module source $PV"
    if ! { curl -fsSL --retry 3 -o "$W/$src.part" "https://download.nvidia.com/XFree86/NVIDIA-kernel-module-source/$src" \
           && [ "$(sha256sum "$W/$src.part" | cut -d' ' -f1)" = "$sum" ]; }; then
      drop "$W/$src.part"; say "NVIDIA source download failed or did not match its checksum"; return 5; fi
    mv "$W/$src.part" "$W/$src"
  fi
  if [ ! -s "$W/kernel-devel-$K.rpm" ]; then
    say "downloading kernel-devel for $K"; local o; for o in "$W"/kernel-devel-*.rpm; do drop "$o"; done
    python3 -I "$LIB/fetch-kernel-devel.py" "$K" "$W/kernel-devel-$K.rpm" >>"$LOG" 2>&1 || { say "kernel-devel for $K is not available (see $LOG)"; return 6; }
  fi
  local keyarg=(); if sb_on; then make_key || return 7; keyarg=(-v "$KEYD:/k:ro"); fi
  say "building the patched NVIDIA modules for $K in a Fedora container (several minutes)"
  podman run --rm --network host --security-opt label=disable -v "$W:/w" -v "$PKG:/p:ro" -v "$LIB:/b:ro" "${keyarg[@]}" \
    "registry.fedoraproject.org/fedora:${VERSION_ID:-44}" bash /b/build-modules.sh "$K" "$PV" >>"$LOG" 2>&1 \
    || { say "the module build failed (see $LOG); Bazzite's own driver stays"; return 8; }
  local N="$EXT.new"; drop "$N"; mkdir -p "$N/usr/lib/modules/$K/extra/nvidia" "$N/usr/lib/extension-release.d"
  cp "$W/out/$K"/*.ko.xz "$N/usr/lib/modules/$K/extra/nvidia/"
  printf 'ID=_any\nARCHITECTURE=x86-64\n' > "$N/usr/lib/extension-release.d/extension-release.$NAME"
  echo "$PV $K" > "$N/.egpu-version"; label "$N"
  if merged && nv_loaded; then drop "$EXT.staged"; mv "$N" "$EXT.staged"; say "built; takes over at the next boot (the driver is in use now)"; return 0; fi
  drop "$EXT.old"; [ -e "$EXT" ] && mv "$EXT" "$EXT.old"; mv "$N" "$EXT"; drop "$EXT.old"
  drop "$W/kernel-devel-$K.rpm" "$W/out"; say "built the patched modules for $K"
  return 0
}

status(){
  echo "kernel: $K · Bazzite NVIDIA driver: $(nv_version || true) · patched modules: ${PV:-?}"
  local s="off"; if sb_on; then s="on"; if key_enrolled; then s="$s · signing key enrolled"; elif key_pending; then s="$s · signing key waiting for enrollment (reboot)"; else s="$s · signing key NOT enrolled"; fi; fi
  echo "Secure Boot: $s"
  echo "built for this kernel: $(built && echo yes || echo no) · extension active: $(merged && echo yes || echo no)"
  echo "nvidia module modprobe loads: $(modinfo -k "$K" -n nvidia 2>/dev/null || echo none) (signer: $(modinfo -k "$K" -F signer nvidia 2>/dev/null || echo -))"
  built && merged && [ "$(nv_version)" = "$PV" ]
}

case "${1:---status}" in
  --status) status ;;
  --build)
    [ "$(id -u)" = 0 ] || { echo "run as root"; exit 1; }
    build; rc=$?; [ $rc = 0 ] || exit $rc
    if sb_on && ! key_enrolled; then enroll; exit 10; fi
    activate ;;
  --boot)   # at every boot: a staged build takes over, a new kernel gets its modules (network permitting), never blocks
    [ "$(id -u)" = 0 ] || exit 1
    if [ -d "$EXT.staged" ] && ! nv_loaded; then drop "$EXT.old"; [ -e "$EXT" ] && mv "$EXT" "$EXT.old"; mv "$EXT.staged" "$EXT"; drop "$EXT.old"; [ -L "$LINK" ] && refresh; fi
    built || deactivate                                         # modules of another kernel: never merge them
    [ "$(nv_version)" = "$PV" ] || { deactivate; exit 0; }
    built || build || exit 0
    activate || true ;;
  --enroll) enroll ;;
  --guard)  # early boot, before systemd-sysext merges: keep the link only if the modules match this image and can load
    if [ -L "$LINK" ] && ! { built && [ "$(nv_version)" = "$PV" ] && can_load; }; then rm -f "$LINK"; say "boot guard: patched modules do not match this boot (kernel $K, NVIDIA $(nv_version)): Bazzite's own driver is used"; fi
    exit 0 ;;
  --remove)
    rm -f "$LINK"; nv_loaded || refresh; drop "$W"; systemctl disable egpu-bazzite-driver-guard.service >/dev/null 2>&1
    say "patched modules removed; Bazzite's own driver is used" ;;
  *) echo "usage: $0 --status | --build | --boot | --guard | --enroll | --remove"; exit 2 ;;
esac
