+bool CVulkanDevice::xgpuCopy( CVulkanTexture *pSrc, VkImage dstImage, VkBuffer dstBuffer, uint32_t uW, uint32_t uH, uint64_t ulWaitSeq, bool bSrcIsClient, uint32_t uDstOwner, VkImageLayout eDstLayout )
+{
+	VkCommandBuffer cmd = m_xgpuCmd;
+	// The copy engine is shared with the game. While a game loads (first start) it can hold the engine long enough
+	// that a frame's copy is not done in time; blocking here then stalls the compositor, the game waits for its
+	// frames to be shown, and the copy never gets the engine: a deadlock (Cyberpunk's engine watchdog fired after
+	// 120 s). So a copy gets a deadline; past it this frame is skipped (the screen keeps the previous picture), the
+	// copy finishes in the background and nothing new is queued until it has.
+	// the source of a copy that outlived its wait: kept alive (and so not handed back to the game) until the copy is done
+	static gamescope::Rc<CVulkanTexture> s_pPendingSrc;
+	if ( m_bXgpuPending )
+	{
+		if ( vk.GetFenceStatus( device(), m_xgpuFence ) != VK_SUCCESS )
+			return false;
+		m_bXgpuPending = false;
+		s_pPendingSrc = nullptr;
+	}
+	vk.ResetFences( device(), 1, &m_xgpuFence );
+	vk.ResetCommandBuffer( cmd, 0 );
+	VkCommandBufferBeginInfo bi = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO, .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT };
+	vk.BeginCommandBuffer( cmd, &bi );
+	VkImageSubresourceRange range = { .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT, .levelCount = 1, .layerCount = 1 };
+	// take the destination from its owner; the whole image is rewritten, so old contents are discarded
+	VkImageMemoryBarrier acquire[2] = {
+		{ .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+		  .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED, .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+		  .srcQueueFamilyIndex = uDstOwner, .dstQueueFamilyIndex = m_xgpuFamily, .image = dstImage, .subresourceRange = range },
+		// direct frames: the source is the game's own buffer (a foreign dmabuf) -> borrow it, contents kept
+		{ .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+		  .oldLayout = VK_IMAGE_LAYOUT_GENERAL, .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+		  .srcQueueFamilyIndex = VK_QUEUE_FAMILY_FOREIGN_EXT, .dstQueueFamilyIndex = m_xgpuFamily, .image = pSrc->vkImage(), .subresourceRange = range },
+	};
+	// a buffer destination (RAM) needs no ownership transfer: only the image barriers that apply are recorded
+	VkImageMemoryBarrier *pAcq = dstBuffer ? &acquire[1] : acquire;
+	uint32_t nAcq = ( dstBuffer ? 0 : 1 ) + ( bSrcIsClient ? 1 : 0 );
+	if ( nAcq )
+		vk.CmdPipelineBarrier( cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, nAcq, pAcq );
+	if ( dstBuffer )
+	{
+		VkBufferImageCopy region = { .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, .imageExtent = { uW, uH, 1 } };
+		vk.CmdCopyImageToBuffer( cmd, pSrc->vkImage(), VK_IMAGE_LAYOUT_GENERAL, dstBuffer, 1, &region );
+	}
+	else
+	{
+		VkImageCopy region = { .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+			.extent = { uW, uH, 1 } };
+		vk.CmdCopyImage( cmd, pSrc->vkImage(), VK_IMAGE_LAYOUT_GENERAL, dstImage, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region );
+	}
+	VkImageMemoryBarrier release[2] = { acquire[0], acquire[1] };
+	release[0].srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT; release[0].dstAccessMask = 0;
+	release[0].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL; release[0].newLayout = eDstLayout;
+	release[0].srcQueueFamilyIndex = m_xgpuFamily; release[0].dstQueueFamilyIndex = uDstOwner;
+	release[1].srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT; release[1].dstAccessMask = 0;
+	release[1].srcQueueFamilyIndex = m_xgpuFamily; release[1].dstQueueFamilyIndex = VK_QUEUE_FAMILY_FOREIGN_EXT;
+	if ( nAcq )
+		vk.CmdPipelineBarrier( cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0, 0, nullptr, 0, nullptr, nAcq, dstBuffer ? &release[1] : release );
+	vk.EndCommandBuffer( cmd );
+
+	// Never park a job that WAITS on the copy engine: it shares the engine with the game, and a copy-engine job sitting
+	// on a semaphore can hold the game's own uploads behind it while the composite it waits for depends on the game
+	// -> a cross-process deadlock (games hung at first launch, when they upload the most). The CPU waits for the
+	// composite instead (with a deadline) and the copy is only submitted once it can run straight away.
+	VkSemaphoreWaitInfo wi = { .sType = VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO, .semaphoreCount = 1, .pSemaphores = &m_scratchTimelineSemaphore, .pValues = &ulWaitSeq };
+	if ( vk.WaitSemaphores( device(), &wi, 50'000'000ull ) != VK_SUCCESS )
+	{
+		return false;   // recorded but never submitted; reset at the next use
+	}
+	VkSubmitInfo si = { .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO, .commandBufferCount = 1, .pCommandBuffers = &cmd };
+	if ( vk.QueueSubmit( m_xgpuQueue, 1, &si, m_xgpuFence ) != VK_SUCCESS )
+		return false;
+	// the DRM backend CPU-waits on the frame right after anyway; 50 ms = several frames, far above a normal copy (~2.5 ms)
+	VkResult res = vk.WaitForFences( device(), 1, &m_xgpuFence, VK_TRUE, 50'000'000ull );
+	if ( res == VK_TIMEOUT )
+	{
+		static uint32_t s_uStalls = 0;
+		if ( s_uStalls++ % 100 == 0 )
+			vk_log.infof( "XGPU: copy engine busy (game loading?): keeping the previous frame (%u times so far)", s_uStalls );
+		m_bXgpuPending = true;
+		s_pPendingSrc = gamescope::Rc<CVulkanTexture>( pSrc );
+	}
+	return res == VK_SUCCESS;
+}
