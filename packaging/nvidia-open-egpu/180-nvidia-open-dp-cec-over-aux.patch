+/* NV-EGPU-Buddy: a native AUX read/write of 1..16 bytes (DP CEC-tunneling) */
+NvBool nvDpAuxTransfer(NVConnectorEvoPtr pConnectorEvo, NvBool write,
+                       NvU32 address, NvU8 *data, NvU8 size, NvU8 *pDone)
+{
+    NV0073_CTRL_DP_AUXCH_CTRL_PARAMS params = { };
+    NVDevEvoPtr pDevEvo = pConnectorEvo->pDispEvo->pDevEvo;
+
+    if (size == 0 || size > NV0073_CTRL_DP_AUXCH_MAX_DATA_SIZE) {
+        return FALSE;
+    }
+
+    params.displayId = nvDpyIdToNvU32(pConnectorEvo->displayId);
+    params.cmd = DRF_DEF(0073_CTRL, _DP, _AUXCH_CMD_TYPE, _AUX);
+    params.cmd |= write ? DRF_DEF(0073_CTRL, _DP, _AUXCH_CMD_REQ_TYPE, _WRITE) :
+                          DRF_DEF(0073_CTRL, _DP, _AUXCH_CMD_REQ_TYPE, _READ);
+    params.addr = address;
+    if (write) {
+        nvkms_memcpy(params.data, data, size);
+    }
+    params.size = size - 1;   /* 0-based on input */
+
+    if (nvRmApiControl(nvEvoGlobal.clientHandle,
+                       pDevEvo->displayCommonHandle,
+                       NV0073_CTRL_CMD_DP_AUXCH_CTRL,
+                       &params, sizeof(params)) != NVOS_STATUS_SUCCESS) {
+        return FALSE;
+    }
+
+    if (params.size > size) {
+        return FALSE;
+    }
+    if (!write) {
+        nvkms_memcpy(data, params.data, params.size);
+    }
+    *pDone = (NvU8)params.size;
+    return TRUE;
+}
