+static void nv_drm_dp_cec_poll(struct work_struct *work)
+{
+    struct nv_drm_connector *nv_connector =
+        container_of(to_delayed_work(work), struct nv_drm_connector, cec_poll);
+    struct nv_drm_device *nv_dev = to_nv_device(nv_connector->base.dev);
+
+    if (READ_ONCE(nv_dev->inRemoval) || READ_ONCE(nv_dev->inSurpriseRemoval)) {
+        return;
+    }
+    /* cheap while the adapter is off: drm_dp_cec_irq returns before any AUX access */
+    drm_dp_cec_irq(&nv_connector->aux);
+    schedule_delayed_work(&nv_connector->cec_poll, msecs_to_jiffies(100));
+}
