+/* NV-EGPU-Buddy: native AUX for DP CEC-tunneling */
+static NvBool DpAuxTransfer
+(
+    struct NvKmsKapiDevice *device,
+    NvKmsKapiConnector connector,
+    NvBool write, NvU32 address, NvU8 *data, NvU32 *size
+)
+{
+    struct NvKmsDpAuxTransferParams params = { };
+
+    if (device == NULL || data == NULL || size == NULL ||
+        *size == 0 || *size > sizeof(params.request.data)) {
+        return NV_FALSE;
+    }
+
+    params.request.deviceHandle    = device->hKmsDevice;
+    params.request.dispHandle      = device->hKmsDisp;
+    params.request.connectorHandle = connector;
+    params.request.address         = address;
+    params.request.write           = write ? 1 : 0;
+    params.request.size            = (NvU8)*size;
+    if (write) {
+        nvkms_memcpy(params.request.data, data, *size);
+    }
+
+    if (!nvkms_ioctl_from_kapi(device->pKmsOpen, NVKMS_IOCTL_DP_AUX_TRANSFER,
+                               &params, sizeof(params))) {
+        return NV_FALSE;
+    }
+
+    if (!write) {
+        nvkms_memcpy(data, params.reply.data, params.reply.size);
+    }
+    *size = params.reply.size;
+    return NV_TRUE;
+}
