+static ssize_t nv_drm_dp_aux_transfer(struct drm_dp_aux *aux,
+                                      struct drm_dp_aux_msg *msg)
+{
+    struct nv_drm_connector *nv_connector =
+        container_of(aux, struct nv_drm_connector, aux);
+    struct nv_drm_device *nv_dev = to_nv_device(nv_connector->base.dev);
+    NvU32 size = msg->size;
+    NvBool write;
+
+    switch (msg->request) {
+    case DP_AUX_NATIVE_WRITE: write = NV_TRUE; break;
+    case DP_AUX_NATIVE_READ:  write = NV_FALSE; break;
+    default: return -EOPNOTSUPP;   /* native DPCD only (all the CEC helper uses) */
+    }
+
+    /* card going or gone (eGPU Safe Detach / cable pull): never touch it */
+    if (READ_ONCE(nv_dev->inRemoval) || READ_ONCE(nv_dev->inSurpriseRemoval) ||
+        nv_dev->pDevice == NULL) {
+        return -ENODEV;
+    }
+
+    if (size == 0) {
+        msg->reply = DP_AUX_NATIVE_REPLY_ACK;
+        return 0;
+    }
+    if (size > 16) {
+        size = 16;
+    }
+
+    if (!nvKms->dpAuxTransfer(nv_dev->pDevice, nv_connector->hConnector,
+                              write, msg->address, msg->buffer, &size)) {
+        return -EIO;
+    }
+
+    msg->reply = DP_AUX_NATIVE_REPLY_ACK;
+    return size;
+}
