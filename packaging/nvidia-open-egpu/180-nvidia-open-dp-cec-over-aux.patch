+    if (!nv_drm_dp_cec_module_param || nv_connector->cec ||
+        nv_connector->type != NVKMS_CONNECTOR_TYPE_DP ||
+        nv_connector->dpAddress[0] != '\0') {   /* SST DisplayPort connectors only */
