+    nv_connector->aux.dev = connector->dev->dev;
+    nv_connector->aux.drm_dev = connector->dev;
+    nv_connector->aux.transfer = nv_drm_dp_aux_transfer;
+    drm_dp_cec_register_connector(&nv_connector->aux, connector);
+    INIT_DELAYED_WORK(&nv_connector->cec_poll, nv_drm_dp_cec_poll);
+    nv_connector->cec = true;
+    schedule_delayed_work(&nv_connector->cec_poll, msecs_to_jiffies(100));
